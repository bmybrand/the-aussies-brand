{"id":515,"date":"2026-03-09T09:23:29","date_gmt":"2026-03-09T09:23:29","guid":{"rendered":"https:\/\/aiadvancements.dilatevps1.cloudsites.net.au\/?page_id=515"},"modified":"2026-08-10T17:04:53","modified_gmt":"2026-08-10T09:04:53","slug":"ai-development","status":"publish","type":"page","link":"https:\/\/aiadvancements.com.au\/ai-development\/","title":{"rendered":"AI Development"},"content":{"rendered":"    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\n        <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\n\n    <!-- BLOCK CODING STARTS HERE -->\n    <section \n        id=\"\" \n        data-name=\"acf_internal-hero\"\n        data-lazyload=\"1\" \n        class=\"relative \" \n        style=\"z-index: 0; background-color:#FFFFFF;\">\n        <div class=\"bg-color5 b1200:pt-200 b767:pt-180 pt-150\">\n            <div class=\"container\">\n                <div class=\"internal-hero-details max-w-[912px] mx-auto b1024:pb-24 b767:pb-20 pb-12\">\n\t\t\t\t\t                    <div class=\"text-center flex items-center mb-[44px]\">\n                        <div class=\"h-[32px] w-[32px] rounded-full bg-color2 flex items-center justify-center\">\n                            <svg width=\"19\" height=\"8\" viewBox=\"0 0 30 13\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M10.1112 0C10.1112 5.75168 5.57492 10.4294 0 10.4294V12.6557C5.60316 12.6557 10.3408 8.76349 11.8042 3.46214V12.6329H13.9649V0H10.11H10.1112Z\" fill=\"#131924\"\/><path d=\"M19.8559 0H16.001V12.6342H18.1617V3.46214C19.6251 8.76223 24.364 12.6557 29.9659 12.6557V10.4294C24.391 10.4294 19.8547 5.75041 19.8547 0H19.8559Z\" fill=\"#131924\"\/><\/svg>\n                        <\/div>\n\t\t\t\t\t\t        <h1 class=\" animate-watch standard__headline inline-flex font-semibold text-color1 bg-color4 py-[11px] px-6 rounded-3xl text-xs super-title\">Custom AI Software Development in Perth<\/h1>\n                        <\/div>\n\t\t\t\t\t\n                    \n                    \n                        <!-- HEADLINE + BELOW HEADLINE -->\n                        <div>\n                                    <h2 class=\"h1 animate-watch standard__headline block tracking-[-0.06em]\">AI Development <\/h2>\n                                        <h3 class=\"h3 animate-watch standard__headline block text-color1 b767:mb-10 b767:mt-10 mt-8\">We design and build custom AI software that automates complex tasks and improves operational efficiency. Our Perth-based team develops full-stack AI applications or integrates directly with your existing systems.<\/h3>\n    \n                            <div class=\"button-wrap inline-flex flex-col b767:flex-row gap-3 mt-[30px]\">\n                                            <a href=\"https:\/\/aiadvancements.com.au\/contact\/\" target=\"\" class=\"btn btn-solidcolor1 speak-btn flex items-center gap-3 overflow-hidden\">\n                <span class=\"block circle relative\"><\/span>\n                <span class=\"button-text z-10\">Speak to a human<\/span>\n            <\/a>\n                                                        <a href=\"\/#services\" target=\"\" class=\"btn outline-color1 text-center overflow-hidden relative z-10\">\n                Explore our AI services            <\/a>\n                                        <\/div>\n                        <\/div>\n\n                                    <\/div>\n            <\/div>\n            \n                        <div class=\"internal-hero-video video-expand-wrapper\">\n\n                <div class=\"hero-video-wrapper relative\">\n\n                    <!-- ===================== -->\n                    <!-- MEDIA -->\n                    <!-- ===================== -->\n                    <div class=\"desktop-media\">\n\n                        \n                        \n                            <!-- DESKTOP VIDEO -->\n                                                        <div class=\"hero-oembed desktop-only w-full h-full\">\n                                <iframe \n                                    src=\"https:\/\/player.vimeo.com\/video\/1192468513?autoplay=0&#038;muted=0&#038;background=0&#038;controls=1&#038;title=0&#038;byline=0&#038;portrait=0&#038;dnt=1&#038;sidedock=0\" \n                                    frameborder=\"0\" \n                                    allow=\"autoplay; fullscreen\" \n                                    allowfullscreen>\n                                <\/iframe>\n                            <\/div>\n\n                            <!-- MOBILE VIDEO -->\n                                                        <div class=\"hero-oembed mobile-only w-full h-full\">\n                                <iframe \n                                    src=\"https:\/\/player.vimeo.com\/video\/1192463009?autoplay=0&#038;muted=0&#038;background=0&#038;controls=1&#038;title=0&#038;byline=0&#038;portrait=0&#038;dnt=1&#038;sidedock=0\" \n                                    frameborder=\"0\" \n                                    allow=\"autoplay; fullscreen\" \n                                    allowfullscreen>\n                                <\/iframe>\n                            <\/div>\n\n                        \n                    <\/div>\n\n                    <!-- ===================== -->\n                    <!-- THUMBNAIL -->\n                    <!-- ===================== -->\n                                            <div class=\"video-thumbnail absolute inset-0 z-20\">\n                            <picture class=\"w-full h-full\"><source media=\"(min-width: 481px)\" srcset=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/05\/image-1-1.jpg\"><img decoding=\"async\" class=\"w-full h-full\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/05\/image-1-1.jpg\" alt=\"Sean Oldenburger, Director of AI Advancements, presenting custom AI development services for businesses\" style=\"object-fit:cover;object-position:center;\" loading=\"lazy\" width=\"1647\" height=\"915\" \/><\/picture>                        <\/div>\n                    \n                    <!-- ===================== -->\n                    <!-- PLAY BUTTON -->\n                    <!-- ===================== -->\n                                            <button class=\"video-toggle absolute inset-0 flex items-center justify-center z-30\">\n                            <span class=\"play-btn flex items-center justify-center\">\n                                <svg width=\"98\" height=\"98\" viewBox=\"0 0 98 98\" fill=\"none\">\n                                    <circle cx=\"49\" cy=\"49\" r=\"49\" fill=\"#FCFF6A\"\/>\n                                    <path d=\"M68 49L39.5 65.4545L39.5 32.5455L68 49Z\" fill=\"#131924\"\/>\n                                <\/svg>\n                            <\/span>\n                        <\/button>\n                    \n                <\/div>\n\n            <\/div>\n                    <\/div>\n    <\/section>\n    <!-- BLOCK CODING STARTS HERE -->\n\n    \n\n  <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\n    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\n\n  <!-- BLOCK CODING STARTS HERE -->\n  <style>\n    @media (max-width: 767px) {\n      .service-list-wrap {\n        height: unset !important;\n        min-height: 350px;\n      }\n      .service-list-wrap .service-list-title {\n        display: none !important;\n      }\n      .service-list-wrap .service-list-content {\n        position: relative !important;\n        top: auto !important;\n        bottom: auto !important;\n        left: auto !important;\n        right: auto !important;\n        transform: none !important;\n        opacity: 1 !important;\n        visibility: visible !important;\n        padding: 2em !important;\n      }\n    }\n  <\/style>\n  <section \n      id=\"\" \n      data-name=\"acf_development-services\"\n      data-lazyload=\"1\" \n      class=\"relative \" \n      style=\"z-index: 0;\">\n      <div id=\"services\" class=\"b767:py-100 py-80 ai-development-area\">\n        <div class=\"container\">\n            <div class=\"max-w-[668px] mx-auto mb-10 b1024:mb-20 text-center\">\n                                    <div class=\"subheading-wrap\">\n                                            <\/div>\n                                                    <div class=\"hero-heading mb-8 b767:mb-10\">\n                            <h2 class=\"h2 animate-watch standard__headline block\">Our AI Development services<\/h2>\n                        <\/div>\n                                                    <div class=\"font-normal\">\n                        <p>We do not sell pre-built AI products. Our team designs and engineers custom AI software, from websites and internal systems to advanced automation, built specifically for how your organisation works and deployed securely into your existing environment.<\/p>\n                    <\/div>\n                            <\/div>\n                            <div class=\"grid grid-cols-1 b767:grid-cols-2 b1200:grid-cols-3 gap-x-6 gap-y-8\">\n                                            <div class=\"service-list-wrap relative overflow-hidden rounded-full bg-[#EFEBE8] b1400:w-[437px] b1400:h-[437px] b1200:w-[364px] b1200:h-[364px] b1024:w-[480px] b1024:h-[480px] w-[350px] h-[350px] mx-auto\">\n                            <div class=\"service-list-title text-center\">\n\t\t\t\t\t\t\t\t\n                                                                    <h3 class=\"b1400:text-[35px] text-2xl leading-none\">\n                                        Computer vision                                    <\/h3>\n                                                            <\/div>\n                            <div class=\"service-list-content text-center w-full rounded-full h-full b1024:px-40 px-30 flex flex-col justify-center\">\n                                <div class=\"b1400:mb-6 b767:mb-4 mb-3 flex justify-center\">\n                                                                            <svg width=\"50\" height=\"30\" viewBox=\"0 0 30 13\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\">\n                                            <path d=\"M10.1112 0C10.1112 5.75168 5.57492 10.4294 0 10.4294V12.6557C5.60316 12.6557 10.3408 8.76349 11.8042 3.46214V12.6329H13.9649V0H10.11H10.1112Z\" fill=\"#131924\"\/>\n                                            <path d=\"M19.8559 0H16.001V12.6342H18.1617V3.46214C19.6251 8.76223 24.364 12.6557 29.9659 12.6557V10.4294C24.391 10.4294 19.8547 5.75041 19.8547 0H19.8559Z\" fill=\"#131924\"\/>\n                                        <\/svg>\n                                                                    <\/div>\n                                                                    <div class=\"h3 b1400:text-[35px] text-2xl leading-none\">\n                                        Computer vision                                    <\/div>\n                                                                                                    <div class=\"b1400:mt-6 b767:mt-4 mt-3 mx-auto max-w-[380px] text-xs b767:text-[14px] leading-[20px]\">\n                                        <p>We build custom computer vision models that detect, classify and interpret images or videos to automate tasks that currently require manual review. These solutions improve accuracy, speed and safety across your operations.<\/p>\n                                    <\/div>\n                                                                <div class=\"flex justify-center b767:mt-6 mt-3\">\n                                                                            <a class=\"btn small-btn btn-solidcolor3 flex justify-center items-center gap-2 overflow-hidden\" href=\"https:\/\/aiadvancements.com.au\/computer-vision\/\" target=\"_self\">\n                                            <span class=\"block circle relative\"><\/span>\n                                            <div class=\"button-text z-10\">Learn more<\/div>\n                                        <\/a>\n                                                                    <\/div>\n                            <\/div>\n                        <\/div>\n                                            <div class=\"service-list-wrap relative overflow-hidden rounded-full bg-[#EFEBE8] b1400:w-[437px] b1400:h-[437px] b1200:w-[364px] b1200:h-[364px] b1024:w-[480px] b1024:h-[480px] w-[350px] h-[350px] mx-auto\">\n                            <div class=\"service-list-title text-center\">\n\t\t\t\t\t\t\t\t\n                                                                    <h3 class=\"b1400:text-[35px] text-2xl leading-none\">\n                                        AI chatbots                                    <\/h3>\n                                                            <\/div>\n                            <div class=\"service-list-content text-center w-full rounded-full h-full b1024:px-40 px-30 flex flex-col justify-center\">\n                                <div class=\"b1400:mb-6 b767:mb-4 mb-3 flex justify-center\">\n                                                                            <svg width=\"50\" height=\"30\" viewBox=\"0 0 30 13\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\">\n                                            <path d=\"M10.1112 0C10.1112 5.75168 5.57492 10.4294 0 10.4294V12.6557C5.60316 12.6557 10.3408 8.76349 11.8042 3.46214V12.6329H13.9649V0H10.11H10.1112Z\" fill=\"#131924\"\/>\n                                            <path d=\"M19.8559 0H16.001V12.6342H18.1617V3.46214C19.6251 8.76223 24.364 12.6557 29.9659 12.6557V10.4294C24.391 10.4294 19.8547 5.75041 19.8547 0H19.8559Z\" fill=\"#131924\"\/>\n                                        <\/svg>\n                                                                    <\/div>\n                                                                    <div class=\"h3 b1400:text-[35px] text-2xl leading-none\">\n                                        AI chatbots                                    <\/div>\n                                                                                                    <div class=\"b1400:mt-6 b767:mt-4 mt-3 mx-auto max-w-[380px] text-xs b767:text-[14px] leading-[20px]\">\n                                        <p>We develop custom AI chatbots that integrate directly with your systems and rely only on your internal data, never training external models. These bots can be deployed as full-stack applications across web, mobile or cloud.<\/p>\n                                    <\/div>\n                                                                <div class=\"flex justify-center b767:mt-6 mt-3\">\n                                                                            <a class=\"btn small-btn btn-solidcolor3 flex justify-center items-center gap-2 overflow-hidden\" href=\"https:\/\/aiadvancements.com.au\/ai-chatbots\/\" target=\"_self\">\n                                            <span class=\"block circle relative\"><\/span>\n                                            <div class=\"button-text z-10\">Learn more<\/div>\n                                        <\/a>\n                                                                    <\/div>\n                            <\/div>\n                        <\/div>\n                                            <div class=\"service-list-wrap relative overflow-hidden rounded-full bg-[#EFEBE8] b1400:w-[437px] b1400:h-[437px] b1200:w-[364px] b1200:h-[364px] b1024:w-[480px] b1024:h-[480px] w-[350px] h-[350px] mx-auto\">\n                            <div class=\"service-list-title text-center\">\n\t\t\t\t\t\t\t\t\n                                                                    <h3 class=\"b1400:text-[35px] text-2xl leading-none\">\n                                        Call agents                                    <\/h3>\n                                                            <\/div>\n                            <div class=\"service-list-content text-center w-full rounded-full h-full b1024:px-40 px-30 flex flex-col justify-center\">\n                                <div class=\"b1400:mb-6 b767:mb-4 mb-3 flex justify-center\">\n                                                                            <svg width=\"50\" height=\"30\" viewBox=\"0 0 30 13\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\">\n                                            <path d=\"M10.1112 0C10.1112 5.75168 5.57492 10.4294 0 10.4294V12.6557C5.60316 12.6557 10.3408 8.76349 11.8042 3.46214V12.6329H13.9649V0H10.11H10.1112Z\" fill=\"#131924\"\/>\n                                            <path d=\"M19.8559 0H16.001V12.6342H18.1617V3.46214C19.6251 8.76223 24.364 12.6557 29.9659 12.6557V10.4294C24.391 10.4294 19.8547 5.75041 19.8547 0H19.8559Z\" fill=\"#131924\"\/>\n                                        <\/svg>\n                                                                    <\/div>\n                                                                    <div class=\"h3 b1400:text-[35px] text-2xl leading-none\">\n                                        Call agents                                    <\/div>\n                                                                                                    <div class=\"b1400:mt-6 b767:mt-4 mt-3 mx-auto max-w-[380px] text-xs b767:text-[14px] leading-[20px]\">\n                                        <p>Our AI call agents automate routine phone-based tasks such as updates, queries and data capture. They integrate seamlessly with your existing systems and are deployed securely within your Australian-based infrastructure.<\/p>\n                                    <\/div>\n                                                                <div class=\"flex justify-center b767:mt-6 mt-3\">\n                                                                            <a class=\"btn small-btn btn-solidcolor3 flex justify-center items-center gap-2 overflow-hidden\" href=\"https:\/\/aiadvancements.com.au\/phone-agents\/\" target=\"_self\">\n                                            <span class=\"block circle relative\"><\/span>\n                                            <div class=\"button-text z-10\">Learn more<\/div>\n                                        <\/a>\n                                                                    <\/div>\n                            <\/div>\n                        <\/div>\n                                            <div class=\"service-list-wrap relative overflow-hidden rounded-full bg-[#EFEBE8] b1400:w-[437px] b1400:h-[437px] b1200:w-[364px] b1200:h-[364px] b1024:w-[480px] b1024:h-[480px] w-[350px] h-[350px] mx-auto\">\n                            <div class=\"service-list-title text-center\">\n\t\t\t\t\t\t\t\t\n                                                                    <h3 class=\"b1400:text-[35px] text-2xl leading-none\">\n                                        AI Automation                                    <\/h3>\n                                                            <\/div>\n                            <div class=\"service-list-content text-center w-full rounded-full h-full b1024:px-40 px-30 flex flex-col justify-center\">\n                                <div class=\"b1400:mb-6 b767:mb-4 mb-3 flex justify-center\">\n                                                                            <svg width=\"50\" height=\"30\" viewBox=\"0 0 30 13\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\">\n                                            <path d=\"M10.1112 0C10.1112 5.75168 5.57492 10.4294 0 10.4294V12.6557C5.60316 12.6557 10.3408 8.76349 11.8042 3.46214V12.6329H13.9649V0H10.11H10.1112Z\" fill=\"#131924\"\/>\n                                            <path d=\"M19.8559 0H16.001V12.6342H18.1617V3.46214C19.6251 8.76223 24.364 12.6557 29.9659 12.6557V10.4294C24.391 10.4294 19.8547 5.75041 19.8547 0H19.8559Z\" fill=\"#131924\"\/>\n                                        <\/svg>\n                                                                    <\/div>\n                                                                    <div class=\"h3 b1400:text-[35px] text-2xl leading-none\">\n                                        AI Automation                                    <\/div>\n                                                                                                    <div class=\"b1400:mt-6 b767:mt-4 mt-3 mx-auto max-w-[380px] text-xs b767:text-[14px] leading-[20px]\">\n                                        <p>We engineer AI systems that automate repetitive work across your workflows, improving accuracy and freeing your team from manual effort. These automations can be delivered as standalone applications or tightly integrated into your existing tools.<\/p>\n                                    <\/div>\n                                                                <div class=\"flex justify-center b767:mt-6 mt-3\">\n                                                                            <a class=\"btn small-btn btn-solidcolor3 flex justify-center items-center gap-2 overflow-hidden\" href=\"https:\/\/aiadvancements.com.au\/ai-automation\/\" target=\"_self\">\n                                            <span class=\"block circle relative\"><\/span>\n                                            <div class=\"button-text z-10\">Learn more<\/div>\n                                        <\/a>\n                                                                    <\/div>\n                            <\/div>\n                        <\/div>\n                                            <div class=\"service-list-wrap relative overflow-hidden rounded-full bg-[#EFEBE8] b1400:w-[437px] b1400:h-[437px] b1200:w-[364px] b1200:h-[364px] b1024:w-[480px] b1024:h-[480px] w-[350px] h-[350px] mx-auto\">\n                            <div class=\"service-list-title text-center\">\n\t\t\t\t\t\t\t\t\n                                                                    <h3 class=\"b1400:text-[35px] text-2xl leading-none\">\n                                        AI reporting agents                                    <\/h3>\n                                                            <\/div>\n                            <div class=\"service-list-content text-center w-full rounded-full h-full b1024:px-40 px-30 flex flex-col justify-center\">\n                                <div class=\"b1400:mb-6 b767:mb-4 mb-3 flex justify-center\">\n                                                                            <svg width=\"50\" height=\"30\" viewBox=\"0 0 30 13\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\">\n                                            <path d=\"M10.1112 0C10.1112 5.75168 5.57492 10.4294 0 10.4294V12.6557C5.60316 12.6557 10.3408 8.76349 11.8042 3.46214V12.6329H13.9649V0H10.11H10.1112Z\" fill=\"#131924\"\/>\n                                            <path d=\"M19.8559 0H16.001V12.6342H18.1617V3.46214C19.6251 8.76223 24.364 12.6557 29.9659 12.6557V10.4294C24.391 10.4294 19.8547 5.75041 19.8547 0H19.8559Z\" fill=\"#131924\"\/>\n                                        <\/svg>\n                                                                    <\/div>\n                                                                    <div class=\"h3 b1400:text-[35px] text-2xl leading-none\">\n                                        AI reporting agents                                    <\/div>\n                                                                                                    <div class=\"b1400:mt-6 b767:mt-4 mt-3 mx-auto max-w-[380px] text-xs b767:text-[14px] leading-[20px]\">\n                                        <p>We develop AI agents that generate accurate, structured reports from raw data or documents in seconds. These systems improve consistency, reduce human error and support faster, data-driven decisions.<\/p>\n                                    <\/div>\n                                                                <div class=\"flex justify-center b767:mt-6 mt-3\">\n                                                                            <a class=\"btn small-btn btn-solidcolor3 flex justify-center items-center gap-2 overflow-hidden\" href=\"https:\/\/aiadvancements.com.au\/ai-reporting-agents\/\" target=\"_self\">\n                                            <span class=\"block circle relative\"><\/span>\n                                            <div class=\"button-text z-10\">Learn more<\/div>\n                                        <\/a>\n                                                                    <\/div>\n                            <\/div>\n                        <\/div>\n                                            <div class=\"service-list-wrap relative overflow-hidden rounded-full bg-[#EFEBE8] b1400:w-[437px] b1400:h-[437px] b1200:w-[364px] b1200:h-[364px] b1024:w-[480px] b1024:h-[480px] w-[350px] h-[350px] mx-auto\">\n                            <div class=\"service-list-title text-center\">\n\t\t\t\t\t\t\t\t\n                                                                    <h3 class=\"b1400:text-[35px] text-2xl leading-none\">\n                                        Looking for \u2028<br>something else?                                    <\/h3>\n                                                            <\/div>\n                            <div class=\"service-list-content text-center w-full rounded-full h-full b1024:px-40 px-30 flex flex-col justify-center\">\n                                <div class=\"b1400:mb-6 b767:mb-4 mb-3 flex justify-center\">\n                                                                            <svg width=\"50\" height=\"30\" viewBox=\"0 0 30 13\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\">\n                                            <path d=\"M10.1112 0C10.1112 5.75168 5.57492 10.4294 0 10.4294V12.6557C5.60316 12.6557 10.3408 8.76349 11.8042 3.46214V12.6329H13.9649V0H10.11H10.1112Z\" fill=\"#131924\"\/>\n                                            <path d=\"M19.8559 0H16.001V12.6342H18.1617V3.46214C19.6251 8.76223 24.364 12.6557 29.9659 12.6557V10.4294C24.391 10.4294 19.8547 5.75041 19.8547 0H19.8559Z\" fill=\"#131924\"\/>\n                                        <\/svg>\n                                                                    <\/div>\n                                                                    <div class=\"h3 b1400:text-[35px] text-2xl leading-none\">\n                                        Looking for \u2028<br>something else?                                    <\/div>\n                                                                                                    <div class=\"b1400:mt-6 b767:mt-4 mt-3 mx-auto max-w-[380px] text-xs b767:text-[14px] leading-[20px]\">\n                                        <p>The examples above illustrate how we commonly apply AI, and are not fixed solutions. Every engagement with us is fully custom, spanning new AI-enabled applications, websites with AI embedded, and deep integration into your existing platforms. <\/p>\n<p>All systems are engineered, deployed and hosted securely in Australia.<\/p>\n                                    <\/div>\n                                                                <div class=\"flex justify-center b767:mt-6 mt-3\">\n                                                                            <a class=\"btn small-btn btn-solidcolor3 flex justify-center items-center gap-2 overflow-hidden\" href=\"https:\/\/aiadvancements.com.au\/contact\/\" target=\"_self\">\n                                            <span class=\"block circle relative\"><\/span>\n                                            <div class=\"button-text z-10\">Contact us<\/div>\n                                        <\/a>\n                                                                    <\/div>\n                            <\/div>\n                        <\/div>\n                                    <\/div>\n                    <\/div>\n      <\/div>\n  <\/section>\n  <!-- BLOCK CODING STARTS HERE -->\n\n  \n\n  <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n \r\n  <!-- BLOCK CODING STARTS HERE -->\r\n<section\r\n      id=\"\"\r\n      data-name=\"acf_approach-tab\"\r\n      data-lazyload=\"1\"\r\n      class=\"relative \"\r\n      style=\"z-index: 0;\">\r\n    <div class=\"b1024:py-[124px] py-[80px] bg-color3 \" style=\"background-color: \">\r\n        <div class=\"container\">\r\n            <div class=\"max-w-[1130px] mx-auto\">\r\n                <div class=\"approach-title max-w-[664px] mx-auto b767:mb-[74px] mb-12 text-center \">\r\n                                            <div class=\"heading-wrap flex-1\">\r\n                                    <h2 class=\"h2 animate-watch standard__headline block mb-10\">How we develop your custom AI software<\/h2>\n                            <\/div>\r\n                                        <div class=\"summary-wrap ml-auto\">\r\n                                                    <div class=\"approach-text\">\r\n                                <p>Our development process is built around clarity and collaboration. We work closely with your team to understand the workflow you want to improve, then design and build a custom AI solution that fits seamlessly into your existing systems.<\/p>\n<p>Every project is engineered to be practical, secure, and deployable, giving you software that delivers measurable improvements from day one.<\/p>\n                            <\/div>\r\n                                                \r\n                                            <\/div>\r\n                <\/div>\r\n            <\/div>\r\n        <\/div>\r\n        <div class=\"approach-content\">\r\n\r\n            <!-- TAB BUTTONS -->\r\n            <div class=\"tab-button-group flex justify-center gap-6 mb-11\">\r\n                                                                                                <button class=\"tab-button\" data-tab=\"0\">\r\n                                                    <\/button>\r\n                                                <\/div>\r\n\r\n            <!-- TAB CONTENT -->\r\n            <div class=\"tab-contents\">\r\n\r\n                                                        \r\n                    <div class=\"tab-content-list transition-opacity duration-300\">\r\n\r\n                                                                            <div class=\"tab-content-row\">\r\n                                <div class=\"tab-content-inner gap-5 b767:gap-0 flex-col b767:flex-row\">\r\n                                    <div class=\"number-and-image w-full flex gap-4 justify-start b767:justify-between b767:w-2\/5\">\r\n                                        <div class=\"row-number text-[40px] b767:text-[80px] b991:text-[100px] leading-[1] text-[#131924]\">\r\n                                            01                                        <\/div>\r\n\r\n                                                                                                                            <div class=\"tab-content-image hidden b767:block\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/Free-consultation-and-problem-definition.jpg\" alt=\"Friendly AI consultant with glasses in dark shirt seated at a table, representing the first step of free consultation and problem definition\">\r\n                                            <\/div>\r\n                                        \r\n                                                                                    <div class=\"title-wraper b767:hidden\">\r\n                                                \r\n                                                                                                    <div class=\"h3 b767:hidden\">\r\n                                                        Free consultation and problem definition                                                    <\/div>\r\n                                                                                            <\/div>\r\n                                                                            <\/div>\r\n\r\n                                    <div class=\"tab-content-title w-full b767:w-1\/2 b767:pt-10 flex gap-3 items-center b767:block\">\r\n                                        \r\n                                                                                    <h3 class=\"hidden b767:block pb-[28px]\">\r\n                                                Free consultation and problem definition                                            <\/h3>\r\n                                        \r\n                                                                                                                            <div class=\"tab-content-image hidden b767:hidden\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/Free-consultation-and-problem-definition.jpg\" alt=\"Friendly AI consultant with glasses in dark shirt seated at a table, representing the first step of free consultation and problem definition\">\r\n                                            <\/div>\r\n                                        \r\n                                                                                    <div class=\"tab-content-description w-full b767:w-full\">\r\n                                                <p>We start by understanding your business, the workflow you want to improve, and the outcomes you\u2019re aiming for.<\/p>\n<p>This helps confirm that AI is solving the right problem and gives you clarity on the expected costs, benefits and feasibility before any commitment is made.<\/p>\n<p>If you haven\u2019t identified your highest-value AI use cases yet, we recommend you <a class=\"decorated-link\" href=\"https:\/\/aiadvancements.com.au\/ai-strategy\/\" target=\"_new\" rel=\"noopener\" data-start=\"1167\" data-end=\"1238\">start with an AI strategy<\/a> before moving into development.<\/p>\n                                            <\/div>\r\n                                                                            <\/div>\r\n                                <\/div>\r\n                            <\/div>\r\n\r\n                                                                            <div class=\"tab-content-row\">\r\n                                <div class=\"tab-content-inner gap-5 b767:gap-0 flex-col b767:flex-row\">\r\n                                    <div class=\"number-and-image w-full flex gap-4 justify-start b767:justify-between b767:w-2\/5\">\r\n                                        <div class=\"row-number text-[40px] b767:text-[80px] b991:text-[100px] leading-[1] text-[#131924]\">\r\n                                            02                                        <\/div>\r\n\r\n                                                                                                                            <div class=\"tab-content-image hidden b767:block\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/Paid-project-scoping-and-technical-planning.jpg\" alt=\"AI professional in dark shirt smiling during a consultation session, representing paid project scoping and technical planning services\">\r\n                                            <\/div>\r\n                                        \r\n                                                                                    <div class=\"title-wraper b767:hidden\">\r\n                                                \r\n                                                                                                    <div class=\"h3 b767:hidden\">\r\n                                                        Paid project scoping and technical planning                                                    <\/div>\r\n                                                                                            <\/div>\r\n                                                                            <\/div>\r\n\r\n                                    <div class=\"tab-content-title w-full b767:w-1\/2 b767:pt-10 flex gap-3 items-center b767:block\">\r\n                                        \r\n                                                                                    <h3 class=\"hidden b767:block pb-[28px]\">\r\n                                                Paid project scoping and technical planning                                            <\/h3>\r\n                                        \r\n                                                                                                                            <div class=\"tab-content-image hidden b767:hidden\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/Paid-project-scoping-and-technical-planning.jpg\" alt=\"AI professional in dark shirt smiling during a consultation session, representing paid project scoping and technical planning services\">\r\n                                            <\/div>\r\n                                        \r\n                                                                                    <div class=\"tab-content-description w-full b767:w-full\">\r\n                                                <p>All development projects begin with a paid scoping engagement ($2,000), which is credited towards later development costs. During this phase, we collaborate with your team and subject matter experts to thoroughly define the problem, identify data and integration requirements, assess security and privacy constraints, and determine the most suitable delivery approach.<\/p>\n<p>You receive a comprehensive proposal outlining the final scope, deliverables, timelines, risks and total cost.<\/p>\n                                            <\/div>\r\n                                                                            <\/div>\r\n                                <\/div>\r\n                            <\/div>\r\n\r\n                                                                            <div class=\"tab-content-row\">\r\n                                <div class=\"tab-content-inner gap-5 b767:gap-0 flex-col b767:flex-row\">\r\n                                    <div class=\"number-and-image w-full flex gap-4 justify-start b767:justify-between b767:w-2\/5\">\r\n                                        <div class=\"row-number text-[40px] b767:text-[80px] b991:text-[100px] leading-[1] text-[#131924]\">\r\n                                            03                                        <\/div>\r\n\r\n                                                                                                                            <div class=\"tab-content-image hidden b767:block\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/Design-development-and-deployment.jpg\" alt=\"Two AI developers in dark shirts collaborating on a laptop in a workshop setting, representing the AI development phase of design, development and deployment\">\r\n                                            <\/div>\r\n                                        \r\n                                                                                    <div class=\"title-wraper b767:hidden\">\r\n                                                \r\n                                                                                                    <div class=\"h3 b767:hidden\">\r\n                                                        Design, development and deployment                                                     <\/div>\r\n                                                                                            <\/div>\r\n                                                                            <\/div>\r\n\r\n                                    <div class=\"tab-content-title w-full b767:w-1\/2 b767:pt-10 flex gap-3 items-center b767:block\">\r\n                                        \r\n                                                                                    <h3 class=\"hidden b767:block pb-[28px]\">\r\n                                                Design, development and deployment                                             <\/h3>\r\n                                        \r\n                                                                                                                            <div class=\"tab-content-image hidden b767:hidden\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/Design-development-and-deployment.jpg\" alt=\"Two AI developers in dark shirts collaborating on a laptop in a workshop setting, representing the AI development phase of design, development and deployment\">\r\n                                            <\/div>\r\n                                        \r\n                                                                                    <div class=\"tab-content-description w-full b767:w-full\">\r\n                                                <p>Once approved, our engineering team begins building your AI solution, from model development through to application design and deployment. <\/p>\n<p>You receive weekly updates and progress sessions, ensuring the solution evolves with your feedback and aligns tightly with your operational needs.<\/p>\n                                            <\/div>\r\n                                                                            <\/div>\r\n                                <\/div>\r\n                            <\/div>\r\n\r\n                                                                            <div class=\"tab-content-row\">\r\n                                <div class=\"tab-content-inner gap-5 b767:gap-0 flex-col b767:flex-row\">\r\n                                    <div class=\"number-and-image w-full flex gap-4 justify-start b767:justify-between b767:w-2\/5\">\r\n                                        <div class=\"row-number text-[40px] b767:text-[80px] b991:text-[100px] leading-[1] text-[#131924]\">\r\n                                            04                                        <\/div>\r\n\r\n                                                                                                                            <div class=\"tab-content-image hidden b767:block\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/Ongoing-maintenance-and-support-optional.jpg\" alt=\"Technical professional in dark shirt working at a multi-monitor computer setup, representing ongoing maintenance and support for AI development\">\r\n                                            <\/div>\r\n                                        \r\n                                                                                    <div class=\"title-wraper b767:hidden\">\r\n                                                \r\n                                                                                                    <div class=\"h3 b767:hidden\">\r\n                                                        Ongoing maintenance and support (optional)                                                    <\/div>\r\n                                                                                            <\/div>\r\n                                                                            <\/div>\r\n\r\n                                    <div class=\"tab-content-title w-full b767:w-1\/2 b767:pt-10 flex gap-3 items-center b767:block\">\r\n                                        \r\n                                                                                    <h3 class=\"hidden b767:block pb-[28px]\">\r\n                                                Ongoing maintenance and support (optional)                                            <\/h3>\r\n                                        \r\n                                                                                                                            <div class=\"tab-content-image hidden b767:hidden\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/Ongoing-maintenance-and-support-optional.jpg\" alt=\"Technical professional in dark shirt working at a multi-monitor computer setup, representing ongoing maintenance and support for AI development\">\r\n                                            <\/div>\r\n                                        \r\n                                                                                    <div class=\"tab-content-description w-full b767:w-full\">\r\n                                                <p>After launch, we can continue to support and maintain your AI system to keep it secure, reliable and up to date. This ensures long-term performance as your workflows, data or business requirements evolve.<\/p>\n                                            <\/div>\r\n                                                                            <\/div>\r\n                                <\/div>\r\n                            <\/div>\r\n\r\n                                                \r\n                    <\/div>\r\n\r\n                                    \r\n            <\/div>\r\n\r\n            <!-- TAB BUTTONS -->\r\n            <div class=\"tab-button-group flex justify-center gap-6 mt-11\">\r\n                                                                                                <button class=\"tab-button\" data-tab=\"0\">\r\n                                                    <\/button>\r\n                                                <\/div>\r\n\r\n        <\/div>\r\n    <\/div>\r\n<\/section>\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n \r\n  \n\n  <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n  <section \r\n      id=\"\" \r\n      data-name=\"acf_logo-slider\"\r\n      data-lazyload=\"1\" \r\n      class=\"relative \" \r\n      style=\"z-index: 0;\">\r\n        <div class=\"logo-slider-area pt-[145px]\">\r\n            <div class=\"container\">\r\n                <div class=\"logo-slider-title text-center flex items-center justify-center mb-16 b767:mb-[72px]\">\r\n                    <div class=\"ls-title-icon h-[48px] w-[48px] rounded-full bg-color2 flex items-center justify-center\">\r\n                        <svg width=\"30\" height=\"13\" viewBox=\"0 0 30 13\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M10.1112 0C10.1112 5.75168 5.57492 10.4294 0 10.4294V12.6557C5.60316 12.6557 10.3408 8.76349 11.8042 3.46214V12.6329H13.9649V0H10.11H10.1112Z\" fill=\"#131924\"\/><path d=\"M19.8559 0H16.001V12.6342H18.1617V3.46214C19.6251 8.76223 24.364 12.6557 29.9659 12.6557V10.4294C24.391 10.4294 19.8547 5.75041 19.8547 0H19.8559Z\" fill=\"#131924\"\/><\/svg>\r\n                    <\/div>\r\n                    <div class=\"ls-title bg-color1 text-color4 px-6 h-[48px] flex items-center justify-center rounded-full text-xs b767:text-[18px] font-semibold\">Trusted by leading Perth businesses<\/div>\r\n                <\/div>\r\n            <\/div>\r\n                        <div class=\"logo_slider splide overflow-visible\">\r\n                <div class=\"splide__track overflow-visible\">\r\n                    <div class=\"splide__list flex\">\r\n                                                    <div class=\"splide__slide\">\r\n                                <div class=\"slider-logo h-full\">\r\n                                    <img decoding=\"async\"\r\n                                        loading=\"lazy\"\r\n                                        style=\"width: 160px; height: 70px;\"\r\n                                        width=\"160\"\r\n                                        height=\"70\"\r\n                                        class=\"h-[70px] b767:h-[100px] w-[160px] object-contain\"\r\n                                        src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/03\/49ff6bad96428f8f3ff88d4f9185fb66d85724ab.jpg\"\r\n                                        srcset=\"\"\r\n                                        sizes=\"auto, 160px\"\r\n                                        alt=\"Fortescue mining company logo - green circular icon with Fortescue company name text\" \/>\r\n                                <\/div>\r\n                            <\/div>\r\n                                                    <div class=\"splide__slide\">\r\n                                <div class=\"slider-logo h-full\">\r\n                                    <img decoding=\"async\"\r\n                                        loading=\"lazy\"\r\n                                        style=\"width: 160px; height: 70px;\"\r\n                                        width=\"160\"\r\n                                        height=\"70\"\r\n                                        class=\"h-[70px] b767:h-[100px] w-[160px] object-contain\"\r\n                                        src=\"https:\/\/aiadvancemen