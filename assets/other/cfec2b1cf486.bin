                                      sizes=\"auto, 160px\"\r\n                                        alt=\"\" \/>\r\n                                <\/div>\r\n                            <\/div>\r\n                                            <\/div>\r\n                <\/div>\r\n            <\/div>\r\n            \r\n            <div class=\"b1024:mb-[130px] mb-[80px]\"><\/div>\r\n                                    <div class=\"container\">\r\n                <div class=\"ls-border relative\"><\/div>\r\n            <\/div>\r\n                    <\/div>\r\n\r\n        <style>\r\n        .logo_slider .splide__list { will-change: transform; }\r\n        .logo_slider .splide__track { contain: layout;}\r\n        .slider-logo img {\r\n            aspect-ratio: 160 \/ 100;\r\n        }\r\n        <\/style>\r\n\r\n  <\/section>\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n\r\n  \n\n  <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n  <section \r\n      id=\"\" \r\n      data-name=\"acf_custom-project\"\r\n      data-lazyload=\"1\" \r\n      class=\"relative \" \r\n      style=\"z-index: 0;\">\r\n      <div class=\"b767:py-100 py-80\">\r\n        <div class=\"container\">\r\n                            <div class=\"subheading-wrap text-center\">\r\n                        <h2 class=\" animate-watch standard__headline inline-flex font-semibold text-color1 bg-color4 py-2 px-6 rounded-3xl text-xs b1024:mb-[90px] mb-10 !tracking-[-0.02em]\">AI software development projects<\/h2>\n                    <\/div>\r\n                        <div class=\"b1024:mb-[90px] mb-10 two-column-content\">\r\n                                    <div class=\"heading-wrap max-w-[900px] mx-auto text-center mb-10\">\r\n                                <h3 class=\"h2 animate-watch standard__headline block\">How purpose-built AI transforms everyday operations<\/h3>\n                        <\/div>\r\n                                                    <div class=\"summary-wrap text-center max-w-[669px] mx-auto\">\r\n                        <p>Our development projects turn complex processes into reliable, production-ready AI software. These case studies show how custom-built applications can automate routine tasks, improve accuracy, and create meaningful efficiency gains across large operations.<\/p>\n<p>Explore our <a href=\"https:\/\/aiadvancements.com.au\/case-studies\/\">AI development case studies<\/a> to see how we&#8217;ve built practical AI solutions for Australian organisations.<\/p>\n                    <\/div>\r\n                            <\/div>\r\n        <\/div>\r\n        <div class=\"splide project_slider\" aria-label=\"project slider\">\r\n            <div class=\"splide__track\">\r\n                <ul class=\"splide__list\">\r\n                    \r\n                            <li class=\"splide__slide\">\r\n                                <div class=\"bg-color4 b1400:py-100 b1400:px-[115px] b1200:p-80 b767:p-60 px-20 py-60 flex flex-col b1024:flex-row h-full text-center b767:text-start\">\r\n                                    \r\n                                    <!-- LEFT -->\r\n                                    <div class=\"flex flex-col justify-between b1024:w-[337px] b767:mb-10 mb-8 b1024:mb-0 gap-10\">\r\n                                        \r\n                                        <h3 class=\"b1024:text-[40px] text-3xl font-normal leading-none\">\r\n                                            Coursebox: The AI Course Creation Engine That Helped Raise $750K in Seed Funding                                        <\/h3>\r\n\r\n                                        <div>\r\n                                            <img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"683\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/ai-agent-1024x683.png\" class=\"w-full object-cover rounded-[10px] wp-post-image\" alt=\"Futuristic purple gradient illustration of an AI agent creating e-learning content types including Flip Card, Info Tab and Quiz modules, connected in a network diagram for AI Course Creation Agent\" srcset=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/ai-agent-1024x683.png 1024w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/ai-agent-300x200.png 300w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/ai-agent-768x512.png 768w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/ai-agent.png 1536w\" sizes=\"auto, (max-width: 1024px) 100vw, 1024px\" \/>                                        <\/div>\r\n\r\n                                    <\/div>\r\n\r\n                                    <!-- RIGHT -->\r\n                                    <div class=\"flex flex-col justify-between flex-1 b1400:pl-[86px] b1200:pl-60 b1400:ml-[86px] b1200:ml-[60px] b1024:pl-40 b1024:ml-10 b1024:border-l b1024:border-color1\">\r\n                                        \r\n                                        <div class=\"text-base\">\r\n                                            A multi-agent rebuild of Coursebox&#039;s course creation engine lifted output quality enough to help the platform close a $750K seed round.                                        <\/div>\r\n\r\n                                        <div class=\"flex mt-8\">\r\n                                            <a href=\"https:\/\/aiadvancements.com.au\/case-study\/ai-course-creation-agent\/\" class=\"btn btn-solidcolor1 flex justify-center items-center gap-2 overflow-hidden mx-auto b767:mx-0\">\r\n                                                <span class=\"block circle relative\"><\/span>\r\n                                                <div class=\"button-text z-10\">Read more<\/div>\r\n                                            <\/a>\r\n                                        <\/div>\r\n\r\n                                    <\/div>\r\n\r\n                                <\/div>\r\n                            <\/li>\r\n\r\n                        \r\n                            <li class=\"splide__slide\">\r\n                                <div class=\"bg-color4 b1400:py-100 b1400:px-[115px] b1200:p-80 b767:p-60 px-20 py-60 flex flex-col b1024:flex-row h-full text-center b767:text-start\">\r\n                                    \r\n                                    <!-- LEFT -->\r\n                                    <div class=\"flex flex-col justify-between b1024:w-[337px] b767:mb-10 mb-8 b1024:mb-0 gap-10\">\r\n                                        \r\n                                        <h3 class=\"b1024:text-[40px] text-3xl font-normal leading-none\">\r\n                                            Coursebox: AI-Generated Avatar Videos That Turn Any Course Into Engaging Visual Content &#8211; Instantly                                        <\/h3>\r\n\r\n                                        <div>\r\n                                            <img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"576\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/coursebox-1024x576.png\" class=\"w-full object-cover rounded-[10px] wp-post-image\" alt=\"Coursebox AI e-learning platform template showing a purple 3D box graduation cap logo alongside an AI-generated presenter avatar on a purple gradient background with course title and subtitle placeholder text\" srcset=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/coursebox-1024x576.png 1024w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/coursebox-300x169.png 300w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/coursebox-768x432.png 768w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/coursebox-1536x864.png 1536w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/coursebox.png 1919w\" sizes=\"auto, (max-width: 1024px) 100vw, 1024px\" \/>                                        <\/div>\r\n\r\n                                    <\/div>\r\n\r\n                                    <!-- RIGHT -->\r\n                                    <div class=\"flex flex-col justify-between flex-1 b1400:pl-[86px] b1200:pl-60 b1400:ml-[86px] b1200:ml-[60px] b1024:pl-40 b1024:ml-10 b1024:border-l b1024:border-color1\">\r\n                                        \r\n                                        <div class=\"text-base\">\r\n                                            An AI avatar video pipeline lets any Coursebox user publish a professional presenter-led course video, no camera, no studio, no editing.                                        <\/div>\r\n\r\n                                        <div class=\"flex mt-8\">\r\n                                            <a href=\"https:\/\/aiadvancements.com.au\/case-study\/ai-generated-avatar-videos\/\" class=\"btn btn-solidcolor1 flex justify-center items-center gap-2 overflow-hidden mx-auto b767:mx-0\">\r\n                                                <span class=\"block circle relative\"><\/span>\r\n                                                <div class=\"button-text z-10\">Read more<\/div>\r\n                                            <\/a>\r\n                                        <\/div>\r\n\r\n                                    <\/div>\r\n\r\n                                <\/div>\r\n                            <\/li>\r\n\r\n                        \r\n                            <li class=\"splide__slide\">\r\n                                <div class=\"bg-color4 b1400:py-100 b1400:px-[115px] b1200:p-80 b767:p-60 px-20 py-60 flex flex-col b1024:flex-row h-full text-center b767:text-start\">\r\n                                    \r\n                                    <!-- LEFT -->\r\n                                    <div class=\"flex flex-col justify-between b1024:w-[337px] b767:mb-10 mb-8 b1024:mb-0 gap-10\">\r\n                                        \r\n                                        <h3 class=\"b1024:text-[40px] text-3xl font-normal leading-none\">\r\n                                            WADSIH: Live Workshop Reports That Used to Take 4 Hours &#8211; Now Generated Instantly, While the Session Is Still Running                                        <\/h3>\r\n\r\n                                        <div>\r\n                                            <img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"576\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/automated-reporting-1024x576.jpg\" class=\"w-full object-cover rounded-[10px] wp-post-image\" alt=\"Large conference workshop room with many professional attendees seated at tables watching a presenter at the front with projection screens showing automated live workshop reporting AI visualization\" srcset=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/automated-reporting-1024x576.jpg 1024w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/automated-reporting-300x169.jpg 300w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/automated-reporting-768x432.jpg 768w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/automated-reporting-1536x864.jpg 1536w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/automated-reporting.jpg 1920w\" sizes=\"auto, (max-width: 1024px) 100vw, 1024px\" \/>                                        <\/div>\r\n\r\n                                    <\/div>\r\n\r\n                                    <!-- RIGHT -->\r\n                                    <div class=\"flex flex-col justify-between flex-1 b1400:pl-[86px] b1200:pl-60 b1400:ml-[86px] b1200:ml-[60px] b1024:pl-40 b1024:ml-10 b1024:border-l b1024:border-color1\">\r\n                                        \r\n                                        <div class=\"text-base\">\r\n                                            A live reporting tool turns a 4-hour post-workshop write-up into an instant, formatted report that&#039;s ready before participants leave the room.                                        <\/div>\r\n\r\n                                        <div class=\"flex mt-8\">\r\n                                            <a href=\"https:\/\/aiadvancements.com.au\/case-study\/automated-reporting\/\" class=\"btn btn-solidcolor1 flex justify-center items-center gap-2 overflow-hidden mx-auto b767:mx-0\">\r\n                                                <span class=\"block circle relative\"><\/span>\r\n                                                <div class=\"button-text z-10\">Read more<\/div>\r\n                                            <\/a>\r\n                                        <\/div>\r\n\r\n                                    <\/div>\r\n\r\n                                <\/div>\r\n                            <\/li>\r\n\r\n                        \r\n                            <li class=\"splide__slide\">\r\n                                <div class=\"bg-color4 b1400:py-100 b1400:px-[115px] b1200:p-80 b767:p-60 px-20 py-60 flex flex-col b1024:flex-row h-full text-center b767:text-start\">\r\n                                    \r\n                                    <!-- LEFT -->\r\n                                    <div class=\"flex flex-col justify-between b1024:w-[337px] b767:mb-10 mb-8 b1024:mb-0 gap-10\">\r\n                                        \r\n                                        <h3 class=\"b1024:text-[40px] text-3xl font-normal leading-none\">\r\n                                            Spacecubed: Turning Hours of Manual Company Research Into One Pasted URL and a Few Seconds                                        <\/h3>\r\n\r\n                                        <div>\r\n                                            <img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"683\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/extraction-agent-1024x683.png\" class=\"w-full object-cover rounded-[10px] wp-post-image\" alt=\"Colorful illustration of a smiling robot character surrounded by web browser, LinkedIn and Google Maps icons on vibrant abstract background, representing an AI Company Data Extraction Agent\" srcset=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/extraction-agent-1024x683.png 1024w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/extraction-agent-300x200.png 300w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/extraction-agent-768x512.png 768w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/extraction-agent.png 1536w\" sizes=\"auto, (max-width: 1024px) 100vw, 1024px\" \/>                                        <\/div>\r\n\r\n                                    <\/div>\r\n\r\n                                    <!-- RIGHT -->\r\n                                    <div class=\"flex flex-col justify-between flex-1 b1400:pl-[86px] b1200:pl-60 b1400:ml-[86px] b1200:ml-[60px] b1024:pl-40 b1024:ml-10 b1024:border-l b1024:border-color1\">\r\n                                        \r\n                                        <div class=\"text-base\">\r\n                                            Paste one company URL, get a complete profile back in seconds, an AI agent replaced hours of manual research for Spacecubed&#039;s Echo platform.                                        <\/div>\r\n\r\n                                        <div class=\"flex mt-8\">\r\n                                            <a href=\"https:\/\/aiadvancements.com.au\/case-study\/ai-company-data-extraction-agent\/\" class=\"btn btn-solidcolor1 flex justify-center items-center gap-2 overflow-hidden mx-auto b767:mx-0\">\r\n                                                <span class=\"block circle relative\"><\/span>\r\n                                                <div class=\"button-text z-10\">Read more<\/div>\r\n                                            <\/a>\r\n                                        <\/div>\r\n\r\n                                    <\/div>\r\n\r\n                                <\/div>\r\n                            <\/li>\r\n\r\n                        \r\n                            <li class=\"splide__slide\">\r\n                                <div class=\"bg-color4 b1400:py-100 b1400:px-[115px] b1200:p-80 b767:p-60 px-20 py-60 flex flex-col b1024:flex-row h-full text-center b767:text-start\">\r\n                                    \r\n                                    <!-- LEFT -->\r\n                                    <div class=\"flex flex-col justify-between b1024:w-[337px] b767:mb-10 mb-8 b1024:mb-0 gap-10\">\r\n                                        \r\n                                        <h3 class=\"b1024:text-[40px] text-3xl font-normal leading-none\">\r\n                                            Makoto: Real-Time Computer Vision That Turns Production Line Observation into Data-Driven Business Improvement                                        <\/h3>\r\n\r\n                                        <div>\r\n                                            <img loading=\"lazy\" decoding=\"async\" width=\"637\" height=\"358\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/computer-vision.png\" class=\"w-full object-cover rounded-[10px] wp-post-image\" alt=\"Overhead CCTV camera view from Reolink showing computer vision AI detecting and tracking small manufacturing parts with green ID-numbered bounding boxes and red safety zone boundary on a production workstation\" srcset=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/computer-vision.png 637w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/computer-vision-300x169.png 300w\" sizes=\"auto, (max-width: 637px) 100vw, 637px\" \/>                                        <\/div>\r\n\r\n                                    <\/div>\r\n\r\n                                    <!-- RIGHT -->\r\n                                    <div class=\"flex flex-col justify-between flex-1 b1400:pl-[86px] b1200:pl-60 b1400:ml-[86px] b1200:ml-[60px] b1024:pl-40 b1024:ml-10 b1024:border-l b1024:border-color1\">\r\n                                        \r\n                                        <div class=\"text-base\">\r\n                                            An on-premises computer vision system replaced days of manual clipboard timing with live, continuous production line data for Makoto&#039;s industrial clients.\n                                        <\/div>\r\n\r\n                                        <div class=\"flex mt-8\">\r\n                                            <a href=\"https:\/\/aiadvancements.com.au\/case-study\/computer-vision-production-line-monitoring\/\" class=\"btn btn-solidcolor1 flex justify-center items-center gap-2 overflow-hidden mx-auto b767:mx-0\">\r\n                                                <span class=\"block circle relative\"><\/span>\r\n                                                <div class=\"button-text z-10\">Read more<\/div>\r\n                                            <\/a>\r\n                                        <\/div>\r\n\r\n                                    <\/div>\r\n\r\n                                <\/div>\r\n                            <\/li>\r\n\r\n                        \r\n                            <li class=\"splide__slide\">\r\n                                <div class=\"bg-color4 b1400:py-100 b1400:px-[115px] b1200:p-80 b767:p-60 px-20 py-60 flex flex-col b1024:flex-row h-full text-center b767:text-start\">\r\n                                    \r\n                                    <!-- LEFT -->\r\n                                    <div class=\"flex flex-col justify-between b1024:w-[337px] b767:mb-10 mb-8 b1024:mb-0 gap-10\">\r\n                                        \r\n                                        <h3 class=\"b1024:text-[40px] text-3xl font-normal leading-none\">\r\n                                            Curtin University: Turning &#8220;Who Do I Even Talk To?&#8221; Into a Plain-English Search That Finds the Right Expert in Seconds                                        <\/h3>\r\n\r\n                                        <div>\r\n                                            <img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"683\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/curtin-ai-1024x683.png\" class=\"w-full object-cover rounded-[10px] wp-post-image\" alt=\"Curtin University AI Concierge home page with Find the Right Expert headline and search interface for discovering Curtin researchers and specialists, with sample queries for AI experts, geologists and renewable energy\" srcset=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/curtin-ai-1024x683.png 1024w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/curtin-ai-300x200.png 300w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/curtin-ai-768x512.png 768w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/curtin-ai.png 1536w\" sizes=\"auto, (max-width: 1024px) 100vw, 1024px\" \/>                                        <\/div>\r\n\r\n                                    <\/div>\r\n\r\n                                    <!-- RIGHT -->\r\n                                    <div class=\"flex flex-col justify-between flex-1 b1400:pl-[86px] b1200:pl-60 b1400:ml-[86px] b1200:ml-[60px] b1024:pl-40 b1024:ml-10 b1024:border-l b1024:border-color1\">\r\n                                        \r\n                                        <div class=\"text-base\">\r\n                                            An AI concierge lets corporate partners describe their problem in plain English and get matched with the right Curtin researcher in seconds, not hours.                                        <\/div>\r\n\r\n                                        <div class=\"flex mt-8\">\r\n                                            <a href=\"https:\/\/aiadvancements.com.au\/case-study\/ai-search-chatbot-curtin\/\" class=\"btn btn-solidcolor1 flex justify-center items-center gap-2 overflow-hidden mx-auto b767:mx-0\">\r\n                                                <span class=\"block circle relative\"><\/span>\r\n                                                <div class=\"button-text z-10\">Read more<\/div>\r\n                                            <\/a>\r\n                                        <\/div>\r\n\r\n                                    <\/div>\r\n\r\n                                <\/div>\r\n                            <\/li>\r\n\r\n                        \r\n                            <li class=\"splide__slide\">\r\n                                <div class=\"bg-color4 b1400:py-100 b1400:px-[115px] b1200:p-80 b767:p-60 px-20 py-60 flex flex-col b1024:flex-row h-full text-center b767:text-start\">\r\n                                    \r\n                                    <!-- LEFT -->\r\n                                    <div class=\"flex flex-col justify-between b1024:w-[337px] b767:mb-10 mb-8 b1024:mb-0 gap-10\">\r\n                                        \r\n                                        <h3 class=\"b1024:text-[40px] text-3xl font-normal leading-none\">\r\n                                            SettleIQ: Five of WA&#8217;s Leading Settlement Agencies, One AI Assistant Answering Hundreds of Property Law Questions Every Week                                        <\/h3>\r\n\r\n                                        <div>\r\n                                            <img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"683\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/settleiq-1024x683.png\" class=\"w-full object-cover rounded-[10px] wp-post-image\" alt=\"SettleIQ logo showing white geometric house icon with interlocking S-shaped design alongside settleIQ company name on dark navy blue background - AI legal chatbot for conveyancers\" srcset=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/settleiq-1024x683.png 1024w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/settleiq-300x200.png 300w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/settleiq-768x512.png 768w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/settleiq.png 1536w\" sizes=\"auto, (max-width: 1024px) 100vw, 1024px\" \/>                                        <\/div>\r\n\r\n                                    <\/div>\r\n\r\n                                    <!-- RIGHT -->\r\n                                    <div class=\"flex flex-col justify-between flex-1 b1400:pl-[86px] b1200:pl-60 b1400:ml-[86px] b1200:ml-[60px] b1024:pl-40 b1024:ml-10 b1024:border-l b1024:border-color1\">\r\n                                        \r\n                                        <div class=\"text-base\">\r\n                                            Five WA settlement agencies pooled their expertise into one AI assistant that answers hundreds of property law questions a week, with every answer cited to its source.                                        <\/div>\r\n\r\n                                        <div class=\"flex mt-8\">\r\n                                            <a href=\"https:\/\/aiadvancements.com.au\/case-study\/ai-legal-property-chatbot\/\" class=\"btn btn-solidcolor1 flex justify-center items-center gap-2 overflow-hidden mx-auto b767:mx-0\">\r\n                                                <span class=\"block circle relative\"><\/span>\r\n                                                <div class=\"button-text z-10\">Read more<\/div>\r\n                                            <\/a>\r\n                                        <\/div>\r\n\r\n                                    <\/div>\r\n\r\n                                <\/div>\r\n                            <\/li>\r\n\r\n                        \r\n                            <li class=\"splide__slide\">\r\n                                <div class=\"bg-color4 b1400:py-100 b1400:px-[115px] b1200:p-80 b767:p-60 px-20 py-60 flex flex-col b1024:flex-row h-full text-center b767:text-start\">\r\n                                    \r\n                                    <!-- LEFT -->\r\n                                    <div class=\"flex flex-col justify-between b1024:w-[337px] b767:mb-10 mb-8 b1024:mb-0 gap-10\">\r\n                                        \r\n                                        <h3 class=\"b1024:text-[40px] text-3xl font-normal leading-none\">\r\n                                            Scott Park Group: Using AI to Decode Thousands of AP Emails &#8211; and Build the Case for Automation                                        <\/h3>\r\n\r\n                                        <div>\r\n                                            <img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"683\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/scott-park-group-1024x683.png\" class=\"w-full object-cover rounded-[10px] wp-post-image\" alt=\"Scott Park Group logo with red company name text and red diamond shape with white star, overlaid on email envelope icons background representing AI-powered email analysis for the Scott Park Group\" srcset=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/scott-park-group-1024x683.png 1024w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/scott-park-group-300x200.png 300w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/scott-park-group-768x512.png 768w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/scott-park-group.png 1536w\" sizes=\"auto, (max-width: 1024px) 100vw, 1024px\" \/>                                        <\/div>\r\n\r\n                                    <\/div>\r\n\r\n                                    <!-- RIGHT -->\r\n                                    <div class=\"flex flex-col justify-between flex-1 b1400:pl-[86px] b1200:pl-60 b1400:ml-[86px] b1200:ml-[60px] b1024:pl-40 b1024:ml-10 b1024:border-l b1024:border-color1\">\r\n                                        \r\n                                        <div class=\"text-base\">\r\n                                            LLM-driven analysis of thousands of AP emails gave Scott Park Group a validated automation roadmap, without exposing a single piece of sensitive content.                                        <\/div>\r\n\r\n                                        <div class=\"flex mt-8\">\r\n                                            <a href=\"https:\/\/aiadvancements.com.au\/case-study\/ai-email-agent-case-study\/\" class=\"btn btn-solidcolor1 flex justify-center items-center gap-2 overflow-hidden mx-auto b767:mx-0\">\r\n                                                <span class=\"block circle relative\"><\/span>\r\n                                                <div class=\"button-text z-10\">Read more<\/div>\r\n                                            <\/a>\r\n                                        <\/div>\r\n\r\n                                    <\/div>\r\n\r\n                                <\/div>\r\n                            <\/li>\r\n\r\n                        \r\n                            <li class=\"splide__slide\">\r\n                                <div class=\"bg-color4 b1400:py-100 b1400:px-[115px] b1200:p-80 b767:p-60 px-20 py-60 flex flex-col b1024:flex-row h-full text-center b767:text-start\">\r\n                                    \r\n                                    <!-- LEFT -->\r\n                                    <div class=\"flex flex-col justify-between b1024:w-[337px] b767:mb-10 mb-8 b1024:mb-0 gap-10\">\r\n                                        \r\n                                        <h3 class=\"b1024:text-[40px] text-3xl font-normal leading-none\">\r\n                                            From Hours of Manual Work to Clinician-Ready ECG Reports &#8211; Generated in Minutes, Without Leaving Their Network                                        <\/h3>\r\n\r\n                                        <div>\r\n                                            <img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"683\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/ecg-report-1024x683.png\" class=\"w-full object-cover rounded-[10px] wp-post-image\" alt=\"Glowing blue ECG heartbeat waveform against dark background overlaid with an AI-generated ECG Report document showing clinical interpretation, patient data, ECG signal graph and classification probability, representing automated medical report generation\" srcset=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/ecg-report-1024x683.png 1024w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/ecg-report-300x200.png 300w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/ecg-report-768x512.png 768w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/ecg-report.png 1536w\" sizes=\"auto, (max-width: 1024px) 100vw, 1024px\" \/>                                        <\/div>\r\n\r\n                                    <\/div>\r\n\r\n                                    <!-- RIGHT -->\r\n                                    <div class=\"flex flex-col justify-between flex-1 b1400:pl-[86px] b1200:pl-60 b1400:ml-[86px] b1200:ml-[60px] b1024:pl-40 b1024:ml-10 b1024:border-l b1024:border-color1\">\r\n                                        \r\n                                        <div class=\"text-base\">\r\n                                            An offline AI pipeline turns ECG classification data into clinician-ready reports in minutes, down from hours, without a byte of patient data leaving Curtin&#039;s network.                                        <\/div>\r\n\r\n                                        <div class=\"flex mt-8\">\r\n                                            <a href=\"https:\/\/aiadvancements.com.au\/case-study\/ecg-report-automation\/\" class=\"btn btn-solidcolor1 flex justify-center items-center gap-2 overflow-hidden mx-auto b767:mx-0\">\r\n                                                <span class=\"block circle relative\"><\/span>\r\n                                                <div class=\"button-text z-10\">Read more<\/div>\r\n                                            <\/a>\r\n                                        <\/div>\r\n\r\n                                    <\/div>\r\n\r\n                                <\/div>\r\n                            <\/li>\r\n\r\n                        \r\n                            <li class=\"splide__slide\">\r\n                                <div class=\"bg-color4 b1400:py-100 b1400:px-[115px] b1200:p-80 b767:p-60 px-20 py-60 flex flex-col b1024:flex-row h-full text-center b767:text-start\">\r\n                                    \r\n                                    <!-- LEFT -->\r\n                                    <div class=\"flex flex-col justify-between b1024:w-[337px] b767:mb-10 mb-8 b1024:mb-0 gap-10\">\r\n                                        \r\n                                        <h3 class=\"b1024:text-[40px] text-3xl font-normal leading-none\">\r\n                                            Curtin University: Helping Thousands of International Research Students Find Answers &#8211; Instantly, Securely, In Any Language                                        <\/h3>\r\n\r\n                                        <div>\r\n                                            <img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"606\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/curtin-hdr-1024x606.png\" class=\"w-full object-cover rounded-[10px] wp-post-image\" alt=\"Curtin University HDR Student Assistant AI chatbot interface showing a response to how to enrol in HDR program with step-by-step instructions for Higher Degree by Research students\" srcset=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/curtin-hdr-1024x606.png 1024w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/curtin-hdr-300x177.png 300w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/curtin-hdr-768x454.png 768w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/curtin-hdr.png 1523w\" sizes=\"auto, (max-width: 1024px) 100vw, 1024px\" \/>                                        <\/div>\r\n\r\n                                    <\/div>\r\n\r\n                                    <!-- RIGHT -->\r\n                                    <div class=\"flex flex-col justify-between flex-1 b1400:pl-[86px] b1200:pl-60 b1400:ml-[86px] b1200:ml-[60px] b1024:pl-40 b1024:ml-10 b1024:border-l b1024:border-color1\">\r\n                                        \r\n                                        <div class=\"text-base\">\r\n                                            A fully offline AI chatbot gives Curtin&#039;s international research students source-cited answers, in any language, without a byte of data leaving the university.                                        <\/div>\r\n\r\n                                        <div class=\"flex mt-8\">\r\n                                            <a href=\"https:\/\/aiadvancements.com.au\/case-study\/curtin-hdr-ai-chatbot\/\" class=\"btn btn-solidcolor1 flex justify-center items-center gap-2 overflow-hidden mx-auto b767:mx-0\">\r\n                                                <span class=\"block circle relative\"><\/span>\r\n                                                <div class=\"button-text z-10\">Read more<\/div>\r\n                                            <\/a>\r\n                                        <\/div>\r\n\r\n                                    <\/div>\r\n\r\n                                <\/div>\r\n                            <\/li>\r\n\r\n                                        <\/ul>   \r\n            <\/div>\r\n        <\/div>\r\n    <\/div>\r\n  <\/section>\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n\r\n  \n\n  <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n  <section \r\n      id=\"\" \r\n      data-name=\"acf_testimonials\"\r\n      data-lazyload=\"1\" \r\n      class=\"relative \" \r\n      style=\"z-index: 0;\">\r\n        <div class=\"testimonials-area b1024:py-[120px] py-80 bg-color3\">\r\n            <div class=\"container\">\r\n                                    <div class=\"subheading-wrap text-center\">\r\n                                <h2 class=\" animate-watch standard__headline inline-flex font-semibold text-color1 bg-color2 py-2 px-6 rounded-3xl text-xs mx-auto b767:mx-0 b767:mb-16 mb-10\">Hear from the teams we work with<\/h2>\n                        <\/div>\r\n                                <div class=\"grid grid-cols-1 b767:grid-cols-2 gap-6 b1024:mb-[90px] mb-[70px] text-center b767:text-start max-w-[1130px] mx-auto\">\r\n                                            <div class=\"heading-wrap w-full b767:w-auto\">\r\n                                    <h3 class=\"h2 animate-watch standard__headline block\">Why WA teams <br>are working with us<\/h3>\n                            <\/div>\r\n                                                                <div class=\"summary-wrap text-center b767:text-start b1024:pl-[60px] b1400:pl-[116px]\">\r\n                            <p>Teams across WA trust AI Advancements to deliver AI systems that work in real environments. Here\u2019s what our clients say about working with our AI development team:<\/p>\n                        <\/div>\r\n                                    <\/div>\r\n            \r\n\r\n\r\n                \r\n                \r\n                <!-- SLIDER -->\r\n                <div class=\"testimonials-wrap pl-10 b767:pl-6 b1400:pl-0\">\r\n                    <div class=\"testimonials_slider splide overflow-visible\">\r\n                        <div class=\"splide__track overflow-visible\">\r\n                            <div class=\"splide__list flex\">\r\n\r\n                                \r\n                                <div class=\"splide__slide testimonial-box overflow-hidden bg-color5 rounded-[20px] b767:p-9 p-7 flex flex-col justify-between transition-transform duration-500 ease-out origin-bottom hover:scale-y-[1.05]\">\r\n\r\n                                    <div class=\"flex\">\r\n                                        <span class=\"box-number testimonial-box-number flex text-[10px] font-bold transition-all duration-700 h-[32px] w-[32px] rounded-full bg-color2 justify-center items-center\">\r\n                                            01                                        <\/span>\r\n                                                                                <div class=\"inline-flex z-10 font-semibold text-color4 bg-black py-2 px-6 rounded-3xl text-xs\">\r\n                                            Coursebox AI                                        <\/div>\r\n                                                                            <\/div>\r\n\r\n                                                                            <div class=\"b1600:py-[86px] z-10 b1024:py-60 py-40 b1600:px-60 b1400:px-40 font-medium leading-[150%] b767:text-[21px]\">\r\n                                            <p>\u201cAI Advancements did a fantastic job at implementing AI chatbot tutors in our online training course software. Our customers are always looking for innovative ways to engage their learners, and that is exactly what they get with this amazing tech.\u201d<\/p>\n                                        <\/div>\r\n                                    \r\n                                    <div class=\"z-10 flex justify-between items-end\">\r\n                                        <div>\r\n                                            <div class=\"font-bold leading-none\">Alex<\/div>\r\n                                                                                            <div>CMO of Coursebox AI<\/div>\r\n                                                                                    <\/div>\r\n                                                                                    <div class=\"\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/03\/6f13ba112b5398743526bc5a8e209f1138e8adb6.jpg\" \r\n                                                    alt=\"Coursebox AI e-learning platform small logo thumbnail with purple 3D box icon and company name\" \r\n                                                    class=\"h-[60px] w-auto rounded-[10px]\">\r\n                                            <\/div>\r\n                                                                            <\/div>\r\n\r\n                                <\/div>\r\n\r\n                                \r\n                                <div class=\"splide__slide testimonial-box overflow-hidden bg-color5 rounded-[20px] b767:p-9 p-7 flex flex-col justify-between transition-transform duration-500 ease-out origin-bottom hover:scale-y-[1.05]\">\r\n\r\n                                    <div class=\"flex\">\r\n                                        <span class=\"box-number testimonial-box-number flex text-[10px] font-bold transition-all duration-700 h-[32px] w-[32px] rounded-full bg-color2 justify-center items-center\">\r\n                                            02                                        <\/span>\r\n                                                                                <div class=\"inline-flex z-10 font-semibold text-color4 bg-black py-2 px-6 rounded-3xl text-xs\">\r\n                                            Spacecubed                                        <\/div>\r\n                                                                            <\/div>\r\n\r\n                                                                            <div class=\"b1600:py-[86px] z-10 b1024:py-60 py-40 b1600:px-60 b1400:px-40 font-medium leading-[150%] b767:text-[21px]\">\r\n                                            <p>\u201cI have used Sam and Sean&#8217;s services multiple times for AI-related software integrations. I have found them to be extremely capable, great communicators and deliver exceptional results. I would highly recommend them!\u201d<\/p>\n                                        <\/div>\r\n                                    \r\n                                    <div class=\"z-10 flex justify-between items-end\">\r\n                                        <div>\r\n                                            <div class=\"font-bold leading-none\">Nate<\/div>\r\n                                                                                            <div>Head of Impact, Spacecubed<\/div>\r\n                                                                                    <\/div>\r\n                                                                                    <div class=\"\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/logo-long.6140f18f1fef1decb086-scaled.png\" \r\n                                                    alt=\"Spacecubed logo - colorful geometric pinwheel icon in pink, yellow and teal with dark grey company name text on transparent background\" \r\n                                                    class=\"h-[60px] w-auto rounded-[10px]\">\r\n                                            <\/div>\r\n                                                                            <\/div>\r\n\r\n                                <\/div>\r\n\r\n                                \r\n                                <div class=\"splide__slide testimonial-box overflow-hidden bg-color5 rounded-[20px] b767:p-9 p-7 flex flex-col justify-between transition-transform duration-500 ease-out origin-bottom hover:scale-y-[1.05]\">\r\n\r\n                                    <div class=\"flex\">\r\n                                        <span class=\"box-number testimonial-box-number flex text-[10px] font-bold transition-all duration-700 h-[32px] w-[32px] rounded-full bg-color2 justify-center items-center\">\r\n                                            03                                        <\/span>\r\n                                                                                <div class=\"inline-flex z-10 font-semibold text-color4 bg-black py-2 px-6 rounded-3xl text-xs\">\r\n                                            Makoto Asia Pacific                                        <\/div>\r\n                                                                            <\/div>\r\n\r\n                                                                            <div class=\"b1600:py-[86px] z-10 b1024:py-60 py-40 b1600:px-60 b1400:px-40 font-medium leading-[150%] b767:text-[21px]\">\r\n                                            <p>\u201cPartnering with AIA has been an exciting journey to improve our data capture. We had a feeling that computer vision and machine learning would help us improve the accuracy and insights of our traditional data capture. This solution has supercharged our efforts with the client.\u201d<\/p>\n                                        <\/div>\r\n                                    \r\n                                    <div class=\"z-10 flex justify-between items-end\">\r\n                                        <div>\r\n                                            <div class=\"font-bold leading-none\">Daniel<\/div>\r\n                                                                                            <div>Consulting Partner at Makoto Asia Pacific<\/div>\r\n                                                                                    <\/div>\r\n                                                                                    <div class=\"\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/BrandIdentity.webp\" \r\n                                                    alt=\"Makoto Asia Pacific logo - Japanese kanji character with blue wave design alongside MAKOTO text with blue circle accent and Asia Pacific subtitle on transparent background\" \r\n                                                    class=\"h-[60px] w-auto rounded-[10px]\">\r\n                                            <\/div>\r\n                                                                            <\/div>\r\n\r\n                                <\/div>\r\n\r\n                                \r\n                                <div class=\"splide__slide testimonial-box overflow-hidden bg-color5 rounded-[20px] b767:p-9 p-7 flex flex-col justify-between transition-transform duration-500 ease-out origin-bottom hover:scale-y-[1.05]\">\r\n\r\n                                    <div class=\"flex\">\r\n                                        <span class=\"box-number testimonial-box-number flex text-[10px] font-bold transition-all duration-700 h-[32px] w-[32px] rounded-full bg-color2 justify-center items-center\">\r\n                                            04                                        <\/span>\r\n                                                                                <div class=\"inline-flex z-10 font-semibold text-color4 bg-black py-2 px-6 rounded-3xl text-xs\">\r\n                                            Curtin University                                        <\/div>\r\n                                                                            <\/div>\r\n\r\n                                                                            <div class=\"b1600:py-[86px] z-10 b1024:py-60 py-40 b1600:px-60 b1400:px-40 font-medium leading-[150%] text-[15px]\">\r\n                                            <p>\u201cWe highly commend the AI team at AI Advancements, particularly Sean and Sam, for their outstanding contributions to our research projects at Curtin University. They successfully delivered several AI solutions with professional quality, demonstrating technical excellence and strong attention to detail.<\/p>\n<p>What stood out most was their clear and responsive communication, as well as their genuine dedication to customer satisfaction. Throughout the collaboration, they provided valuable advice on the latest AI technologies, helping us significantly improve our workflow and decision-making processes.<\/p>\n<p>It was a pleasure working with a team so committed to both innovation and service. We look forward to future collaborations with AI Advancements.\u201d<\/p>\n                                        <\/div>\r\n                                    \r\n                                    <div class=\"z-10 flex justify-between items-end\">\r\n                                        <div>\r\n                                            <div class=\"font-bold leading-none\">Sonny Pham<\/div>\r\n                                                                                            <div>Associate Professor<\/div>\r\n                                                                                    <\/div>\r\n                                                                                    <div class=\"\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/03\/fe391a62f9a69290482800f8c1f2b1fd73ca9a57.jpg\" \r\n                                                    alt=\"Curtin University small logo thumbnail with gold shield emblem and university name text\" \r\n                                                    class=\"h-[60px] w-auto rounded-[10px]\">\r\n                                            <\/div>\r\n                                                                            <\/div>\r\n\r\n                                <\/div>\r\n\r\n                                \r\n                            <\/div>\r\n                        <\/div>\r\n                    <\/div>\r\n\r\n                    <div class=\"splide__arrows testimonals-nav flex justify-start gap-2 mt-4\">\r\n                          <button class=\"splide__arrow splide__arrow--prev w-[43px] h-[43px] group flex justify-center items-center rounded-[6px] bg-color1 hover:bg-color2 overflow-hidden transition duration-500 ease-in cursor-pointer hover:color1\" aria-label=\"go to previous slide\">\n    <span class=\"icon\">\n      <svg width=\"8\" height=\"9\" viewBox=\"0 0 8 9\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M0.5 3.16669C-0.166666 3.55159 -0.166667 4.51384 0.5 4.89874L5.75 7.92983C6.41667 8.31473 7.25 7.8336 7.25 7.0638L7.25 1.00163C7.25 0.231826 6.41667 -0.2493 5.75 0.135601L0.5 3.16669Z\" fill=\"#C2CEE8\"\/>\n      <\/svg>\n    <\/span>\n  <\/button>\n\n  <button class=\"splide__arrow splide__arrow--next w-[43px] h-[43px] group flex justify-center items-center rounded-[6px] bg-color1 hover:bg-color2 overflow-hidden transition duration-500 ease-in cursor-pointer hover:color1\" aria-label=\"go to next slide\">\n    <span class=\"icon\">\n      <svg width=\"8\" height=\"9\" viewBox=\"0 0 8 9\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M6.75 3.16669C7.41667 3.55159 7.41667 4.51384 6.75 4.89874L1.5 7.92983C0.833334 8.31473 5.4712e-07 7.8336 5.80769e-07 7.0638L8.45755e-07 1.00163C8.79404e-07 0.231826 0.833334 -0.2493 1.5 0.135601L6.75 3.16669Z\" fill=\"#C2CEE8\"\/><\/svg>\n    <\/span>\n  <\/button>\n                      <\/div>\r\n                <\/div>\r\n\r\n                            <\/div>\r\n        <\/div>\r\n\r\n  <\/section>\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n\r\n  \n\n  <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\n    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\n\n  <!-- BLOCK CODING STARTS HERE -->\n  <section \n      id=\"\" \n      data-name=\"acf_img-with-text\"\n      data-lazyload=\"1\" \n      class=\"relative \" \n      style=\"z-index: 0;\">\n      <div class=\"img-with-text-area relative b767:py-100 py-80\">\n        <div class=\"container relative\">\n            <div class=\"iwt-content-wrap grid grid-cols-1 b1024:grid-cols-2 items-center b1400:px-80\">\n                <div class=\"iwt-content b1024:pr-40 b1200:pr-80 b1400:pr-[100px] text-center b1024:text-start mb-14 b1024:mb-0\">\n                                            <div class=\"hero-heading\">\n                                <h2 class=\"h2 animate-watch standard__headline block mb-6 b767:mb-10\">Talk to our team about your AI development <br>project<\/h2>\n                            <\/div>\n                                                                <div class=\"hero-summary b1024:max-w-[438px] my-10 b1024:my-16\">\n                            <p>If you\u2019re exploring AI to automate routine tasks or build a new digital capability, our team can walk you through the smartest way to start.<\/p>\n<p>We\u2019ll help you shape a clear, practical development plan and show what a fully engineered AI solution could deliver inside your organisation.<\/p>\n                        <\/div>\n                                        <div class=\"button-wrap flex flex-col b767:flex-row items-center justify-center b1024:justify-start gap-3 overflow-hidden\">\n                                    <a href=\"https:\/\/aiadvancements.com.au\/contact\/\" target=\"\" class=\"btn btn-solidcolor1 speak-btn flex items-center gap-3 overflow-hidden\">\n                <span class=\"block circle relative\"><\/span>\n                <span class=\"button-text z-10\">Speak to us<\/span>\n            <\/a>\n                                                <a href=\"\/#services\" target=\"\" class=\"btn outline-color1 text-center overflow-hidden relative z-10\">\n                See our services            <\/a>\n                                <\/div>\n                <\/div>\n                <div class=\"iwt-img relative\">\n                                                                <div class=\"overlay-color2\"><\/div>\n                        <div class=\"overlay-color6\"><\/div>\n                        <div class=\"ai-text-two text-xs bg-color2 leading-none pt-[5px] pb-[6px] px-[9px] rounded-3xl\">&lt;ai.advancements&gt;<\/div>\n                                                                                    <picture class=\"w-full h-full\"><source media=\"(min-width: 481px)\" srcset=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/03\/Mask-group2.jpg\"><img decoding=\"async\" class=\"w-full h-full\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/03\/Mask-group2.jpg\" alt=\"Two smiling AI Advancements consultants, one with beard in foreground and another behind, representing the approachable AI Strategy consulting team\" style=\"object-fit:contain;object-position:center;\" loading=\"lazy\" width=\"553\" height=\"707\" \/><\/picture>                                    <\/div>\n            <\/div>\n        <\/div>\n      <\/div>\n  <\/section>\n  <!-- BLOCK CODING STARTS HERE -->\n\n  ","protected":false},"excerpt":{"rendered":"","protected":false},"author":5,"featured_media":0,"parent":0,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"","meta":{"_acf_changed":false,"footnotes":""},"class_list":["post-515","page","type-page","status-publish","hentry"],"acf":[],"_links":{"self":[{"href":"https:\/\/aiadvancements.com.au\/wp-json\/wp\/v2\/pages\/515","target