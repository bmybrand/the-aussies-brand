{"id":1021,"date":"2026-03-30T14:20:03","date_gmt":"2026-03-30T14:20:03","guid":{"rendered":"https:\/\/aiadvancements.dilatevps1.cloudsites.net.au\/?page_id=1021"},"modified":"2026-09-03T12:36:50","modified_gmt":"2026-09-03T04:36:50","slug":"contact","status":"publish","type":"page","link":"https:\/\/aiadvancements.com.au\/contact\/","title":{"rendered":"Contact"},"content":{"rendered":"    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\n        <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\n\n    <!-- BLOCK CODING STARTS HERE -->\n    <section \n        id=\"\" \n        data-name=\"acf_internal-hero\"\n        data-lazyload=\"1\" \n        class=\"relative \" \n        style=\"z-index: 0; background-color:#FFFFFF;\">\n        <div class=\"bg-color5 b1200:pt-200 b767:pt-180 pt-150\">\n            <div class=\"container\">\n                <div class=\"internal-hero-details max-w-[912px] mx-auto b1024:pb-24 b767:pb-20 pb-12\">\n\t\t\t\t\t                    <div class=\"text-center flex items-center mb-[44px]\">\n                        <div class=\"h-[32px] w-[32px] rounded-full bg-color2 flex items-center justify-center\">\n                            <svg width=\"19\" height=\"8\" viewBox=\"0 0 30 13\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M10.1112 0C10.1112 5.75168 5.57492 10.4294 0 10.4294V12.6557C5.60316 12.6557 10.3408 8.76349 11.8042 3.46214V12.6329H13.9649V0H10.11H10.1112Z\" fill=\"#131924\"\/><path d=\"M19.8559 0H16.001V12.6342H18.1617V3.46214C19.6251 8.76223 24.364 12.6557 29.9659 12.6557V10.4294C24.391 10.4294 19.8547 5.75041 19.8547 0H19.8559Z\" fill=\"#131924\"\/><\/svg>\n                        <\/div>\n\t\t\t\t\t\t        <h1 class=\" animate-watch standard__headline inline-flex font-semibold text-color1 bg-color4 py-[11px] px-6 rounded-3xl text-xs super-title\">Speak to a Human<\/h1>\n                        <\/div>\n\t\t\t\t\t\n                    \n                    \n                        <!-- HEADLINE + BELOW HEADLINE -->\n                        <div>\n                                    <h2 class=\"h1 animate-watch standard__headline block tracking-[-0.06em]\">Get in touch with AI Advancements<\/h2>\n                                        <h3 class=\"h3 animate-watch standard__headline block text-color1 b767:mb-10 b767:mt-10 mt-8\">If you\u2019re considering AI but aren\u2019t sure where to begin, get in touch. We\u2019ll assess your situation, ask the right questions, and help you determine what is genuinely worth pursuing.<br \/>\r\n<br \/>\r\nYou\u2019ll speak directly with our Perth-based team.<\/h3>\n    \n                            <div class=\"button-wrap inline-flex flex-col b767:flex-row gap-3 mt-[30px]\">\n                                                                                            <\/div>\n                        <\/div>\n\n                                    <\/div>\n            <\/div>\n            \n                    <\/div>\n    <\/section>\n    <!-- BLOCK CODING STARTS HERE -->\n\n    \n\n    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\n        <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\n\n    <!-- BLOCK CODING STARTS HERE -->\n    <section \n        id=\"\" \n        data-name=\"acf_contact-page-form\"\n        data-lazyload=\"1\" \n        class=\"relative \" \n        style=\"z-index: 0; background-color:#FFFFFF;\">\n        <div class=\"contact-page-form bg-color5 pb-80 b767:pb-100 overflow-hidden relative\">\n            <div class=\"rounded-efect b1200:h-[440px] b1200:w-[440px] b1024:h-[300px] b1024:w-[300px] bg-[#F6A24D] absolute top-0 b767:-left-[100px] -left-[60px] rounded-full hidden b1024:block\"><\/div>\n            <div class=\"container\">\n                <div class=\"max-w-[1130px] mx-auto\">\n                    <div class=\"contact-shortcode frontend form b1024:w-[783px] ml-auto\">\n                        <script>\nvar gform;gform||(document.addEventListener(\"gform_main_sc