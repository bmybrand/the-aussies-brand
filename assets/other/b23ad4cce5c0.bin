 );            visibilitySpan.id = \"gform_visibility_test_2\";            gformWrapperDiv.insertAdjacentElement( \"afterend\", visibilitySpan );        }        const visibilityTestDiv = document.getElementById( \"gform_visibility_test_2\" );        let postRenderFired = false;        function triggerPostRender() {            if ( postRenderFired ) {                return;            }            postRenderFired = true;            gform.core.triggerPostRenderEvents( 2, current_page );            if ( visibilityTestDiv ) {                visibilityTestDiv.parentNode.removeChild( visibilityTestDiv );            }        }        function debounce( func, wait, immediate ) {            var timeout;            return function() {                var context = this, args = arguments;                var later = function() {                    timeout = null;                    if ( !immediate ) func.apply( context, args );                };                var callNow = immediate && !timeout;                clearTimeout( timeout );                timeout = setTimeout( later, wait );                if ( callNow ) func.apply( context, args );            };        }        const debouncedTriggerPostRender = debounce( function() {            triggerPostRender();        }, 200 );        if ( visibilityTestDiv && visibilityTestDiv.offsetParent === null ) {            const observer = new MutationObserver( ( mutations ) => {                mutations.forEach( ( mutation ) => {                    if ( mutation.type === 'attributes' && visibilityTestDiv.offsetParent !== null ) {                        debouncedTriggerPostRender();                        observer.disconnect();                    }                });            });            observer.observe( document.body, {                attributes: true,                childList: false,                subtree: true,                attributeFilter: [ 'style', 'class' ],            });        } else {            triggerPostRender();        }    } );} );\n<\/script>\n                    <\/div>\n                <\/div>\n            <\/div>\n        <\/div>\n\t\t<style>\n            @media all and (min-width: 767.98px) {\n\t\t\t\t#field_2_1 .ginput_container.ginput_container_text {\n                    max-width: 78%;\n                }\n            }\n\t\t<\/style>\n    <\/section>\n    <!-- BLOCK CODING STARTS HERE -->\n\n    \n\n  <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n  <section \r\n      id=\"\" \r\n      data-name=\"acf_contact-information\"\r\n      data-lazyload=\"1\" \r\n      class=\"relative \" \r\n      style=\"z-index: 0;\">\r\n      <div class=\"bg-color5 b767:pb-120 pb-80\">\r\n            <div class=\"container !max-w-[1130px] mx-auto border-t border-color1\">\r\n                <div class=\"max-w-[898px] mx-auto b767:pt-90 pt-80\">\r\n                                                    <h2 class=\"h2 animate-watch standard__headline block mb-9 text-center\">Contact information<\/h2>\n                                            <div class=\"grid grid-cols-1 b767:grid-cols-2 b767:gap-[26px] gap-5\">\r\n                                                    <a href=\"mailto:info@aiadvancements.com.au\" class=\"bg-white p-30 rounded-2xl\">\r\n                                <span class=\"block font-medium mb-[6px]\">Email<\/span>\r\n                                <div class=\"b1024:text-[25px] text-xl\">info@aiadvancements.com.au<\/div>\r\n                            <\/a>\r\n                                                                            <a href=\"tel:0403 804 929\" class=\"bg-white p-30 rounded-2xl\">\r\n                                <span class=\"block font-medium mb-[6px]\">Phone<\/span>\r\n                                <div class=\"b1024:text-[25px] text-xl\">0403 804 929<\/div>\r\n                            <\/a>\r\n                                            <\/div>\r\n                                            <a href=\"https:\/\/www.google.com\/maps\/place\/Unit+2%2F125+Main+St,+Osborne+Park+WA+6017,+Australia\/@-31.9025411,115.8253063,17z\/data=!3m1!4b1!4m6!3m5!1s0x2a32af94c90571d9:0xa28a5d7fa24a6a16!8m2!3d-31.9025457!4d115.8278812!16s%2Fg%2F11m__qrz4t?entry=ttu&#038;g_ep=EgoyMDI2MDMyNC4wIKXMDSoASAFQAw%3D%3D\" target=\"_blank\" class=\"bg-white p-30 rounded-2xl w-full block b767:mt-[26px] mt-5\" rel=\"noopener\">\r\n                            <span class=\"block font-medium mb-[6px]\">Address<\/span>\r\n                            <div class=\"b1024:text-[25px] text-xl\">Unit 2\/125 Main St, Osborne Park WA 6017<\/div>\r\n                        <\/a>\r\n                                    <\/div>\r\n            <\/div>\r\n        <\/div>\r\n  <\/section>\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n\r\n  \n\n  <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\n    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\n\n  <!-- BLOCK CODING STARTS HERE -->\n  <section \n      id=\"\" \n      data-name=\"acf_conversation\"\n      data-lazyload=\"1\" \n      class=\"relative \" \n      style=\"z-index: 0;\">\n      <div class=\"py-80\">\n        <div class=\"container\">\n\t\t\t\n            \n            <div class=\"grid grid-cols-1 b1024:grid-cols-2 items-center bg-[#C2CEE8] max-w-[1130px] mx-auto\">\n                <div class=\"text-center b1024:text-start b767:p-80 py-14 px-5\">\n                                            <div class=\"hero-heading\">\n                                <h2 class=\"h2 animate-watch standard__headline block\">Rather have a conversation?<\/h2>\n                            <\/div>\n                                                                <div class=\"hero-summary my-8 font-normal b1024:max-w-[400px]\">\n                            <p>Sometimes it\u2019s easier to talk it through over the phone. Call us to speak directly with our Perth-based team.<\/p>\n                        <\/div>\n                                        <div class=\"button-wrap flex flex-col b767:flex-row items-center justify-center b1024:justify-start gap-3 overflow-hidden\">\n                                    <a href=\"tel:0403804929\" target=\"\" class=\"btn btn-solidcolor1 speak-btn flex items-center gap-3 overflow-hidden\">\n                <span class=\"block circle relative\"><\/span>\n                <span class=\"button-text z-10\">Call our team<\/span>\n            <\/a>\n                                                        <\/div>\n                <\/div>\n                <div class=\"h-full\">\n                                            <picture class=\"w-full h-full\"><source media=\"(min-width: 481px)\" srcset=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/03\/AIA_Brand-Identity-Guidelines-1.jpg\"><img decoding=\"async\" class=\"w-full h-full !object-cover\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/03\/AIA_Brand-Identity-Guidelines-1.jpg\" alt=\"Side profile close-up portrait of two AI Advancements team members in dark polo shirts, illustrating the brand identity guidelines for AI Advancements\" style=\"object-fit:contain;object-position:center;\" loading=\"lazy\" width=\"564\" height=\"472\" \/><\/picture>                                    <\/div>\n            <\/div>\n        <\/div>\n      <\/div>\n  <\/section>\n  <!-- BLOCK CODING STARTS HERE -->\n\n  \n\n  <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\n    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\n\n  <!-- BLOCK CODING STARTS HERE -->\n  <section \n      id=\"\" \n      data-name=\"acf_meet-us\"\n      data-lazyload=\"1\" \n      class=\"relative \" \n      style=\"z-index: 0;\">\n      <div class=\"\">\n        <div class=\"container\">\n            <div class=\"text-center max-w-[730px] mx-auto b1024:mb-14 mb-10\">\n                                            <h2 class=\"h2 animate-watch standard__headline block mb-9\">Meet us in person<\/h2>\n                                                        <div class=\"font-normal\">\n                        <p>Prefer to meet in person? We\u2019re Perth-based, and are happy to catch up at our Osborne Park office or come to you.<\/p>\n                    <\/div>\n                                <div class=\"button-wrap flex flex-col b767:flex-row items-center justify-center gap-3 overflow-hidden\">\n                                                        <\/div>\n            <\/div>\n        <\/div>\n        <div class=\"grid grid-cols-1 b767:grid-cols-2 items-center bg-[#C2CEE8]\">\n            <div class=\"h-full aspect-[1\/0.87]\">\n                                    <picture class=\"w-full h-full\"><source media=\"(min-width: 481px)\" srcset=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/03\/e2ae9abcf36338f787fb5a026c6a29292febccd01.jpg\"><img decoding=\"async\" class=\"w-full h-full !object-cover w-full h-full\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/03\/e2ae9abcf36338f787fb5a026c6a29292febccd01.jpg\" alt=\"AI Advancements team of five professionals in black polo shirts posing at their office reception desk in front of the dark blue AI Advancements branded company wall\" style=\"object-fit:contain;object-position:center;\" loading=\"lazy\" width=\"2560\" height=\"1706\" \/><\/picture>                            <\/div>\n                            <div class=\"office-map h-full\">\n                    <div id=\"map\" style=\"width:100%; height:100%;\"><\/div>    \n                <\/div>\n                    <\/div>\n                    <div class=\"absolute b1200:h-[370px] b1200:w-[370px] b1024:h-[250px] b1024:w-[250px] w-[220px] h-[220px] b767:-bottom-[80px] -bottom-[60px] left-1\/2 -translate-x-1\/2 bg-color2 rounded-full flex flex-col items-center justify-center b1200:px-50 px-30\">\n                <svg width=\"51\" height=\"22\" viewBox=\"0 0 51 22\" fill=\"n