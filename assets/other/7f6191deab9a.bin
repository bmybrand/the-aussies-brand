{"id":267,"date":"2026-03-06T20:42:43","date_gmt":"2026-03-06T20:42:43","guid":{"rendered":"https:\/\/aiadvancements.dilatevps1.cloudsites.net.au\/?page_id=267"},"modified":"2026-09-29T11:17:27","modified_gmt":"2026-09-29T03:17:27","slug":"about-us","status":"publish","type":"page","link":"https:\/\/aiadvancements.com.au\/about-us\/","title":{"rendered":"About Us"},"content":{"rendered":"    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\n        <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\n\n    <!-- BLOCK CODING STARTS HERE -->\n    <section \n        id=\"\" \n        data-name=\"acf_internal-hero\"\n        data-lazyload=\"1\" \n        class=\"relative \" \n        style=\"z-index: 0; background-color:#FFFFFF;\">\n        <div class=\"bg-color5 b1200:pt-200 b767:pt-180 pt-150\">\n            <div class=\"container\">\n                <div class=\"internal-hero-details max-w-[912px] mx-auto b1024:pb-24 b767:pb-20 pb-12\">\n\t\t\t\t\t                    <div class=\"text-center flex items-center mb-[44px]\">\n                        <div class=\"h-[32px] w-[32px] rounded-full bg-color2 flex items-center justify-center\">\n                            <svg width=\"19\" height=\"8\" viewBox=\"0 0 30 13\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M10.1112 0C10.1112 5.75168 5.57492 10.4294 0 10.4294V12.6557C5.60316 12.6557 10.3408 8.76349 11.8042 3.46214V12.6329H13.9649V0H10.11H10.1112Z\" fill=\"#131924\"\/><path d=\"M19.8559 0H16.001V12.6342H18.1617V3.46214C19.6251 8.76223 24.364 12.6557 29.9659 12.6557V10.4294C24.391 10.4294 19.8547 5.75041 19.8547 0H19.8559Z\" fill=\"#131924\"\/><\/svg>\n                        <\/div>\n\t\t\t\t\t\t        <h1 class=\" animate-watch standard__headline inline-flex font-semibold text-color1 bg-color4 py-[11px] px-6 rounded-3xl text-xs super-title\">Meet the AI Advancements Team , Perth&#8217;s AI Specialists<\/h1>\n                        <\/div>\n\t\t\t\t\t\n                    \n                    \n                        <!-- ALL THREE -->\n                        <div>\n                                    <h2 class=\"h1 animate-watch standard__headline block tracking-[-0.06em]\">About AI Advancements<\/h2>\n    \n                            <div class=\"grid grid-cols-1 b1024:grid-cols-2 b1024:mt-16 b767:mt-10 mt-8 b767:gap-y-10 gap-y-8\">\n                                <div class=\"flex flex-col justify-end\">\n                                    <div class=\"h-full\">\n                                                <h3 class=\"h3 animate-watch standard__headline block text-color1 b1024:mb-8 b1024:max-w-[550px]\">AI Advancements is a local Perth team of AI specialists who combine strong engineering capability with a practical, human approach. <\/h3>\n                                        <\/div>\n\n                                    <div class=\"button-wrap hidden b1024:inline-flex flex-col b600:flex-row gap-3 mt-[30px] b1024:items-end\">\n                                                    <a href=\"https:\/\/aiadvancements.com.au\/contact\/\" target=\"\" class=\"btn btn-solidcolor1 speak-btn flex items-center gap-3 overflow-hidden\">\n                <span class=\"block circle relative\"><\/span>\n                <span class=\"button-text z-10\">Speak to us<\/span>\n            <\/a>\n                                                                <a href=\"#services\" target=\"\" class=\"btn btn-secondary-alt outline-color1 text-center overflow-hidden relative z-10\">\n                Explore our services            <\/a>\n                                                <\/div>\n                                <\/div>\n\n                                <div class=\"b1024:pl-[52px] mb-10 b1024:mb-0\">\n                                    <p>Our backgrounds span computer vision, language models, full-stack development, strategy, governance, cybersecurity and project engineering, giving you a team that can understand your operations and build reliable AI systems around them.<\/p>\n<p>Every custom AI solution is developed in-house by people who care about quality, security and measurable outcomes for your organisation or business.<\/p>\n                                    <div class=\"button-wrap inline-flex b1024:hidden flex-col b767:flex-row gap-3 mt-[30px]\">\n                                                    <a href=\"https:\/\/aiadvancements.com.au\/contact\/\" target=\"\" class=\"btn btn-solidcolor1 speak-btn flex items-center gap-3 overflow-hidden\">\n                <span class=\"block circle relative\"><\/span>\n                <span class=\"button-text z-10\">Speak to us<\/span>\n            <\/a>\n                                                                <a href=\"#services\" target=\"\" class=\"btn btn-secondary-alt outline-color1 text-center overflow-hidden relative z-10\">\n                Explore our services            <\/a>\n                                                <\/div>\n                                <\/div>\n                            <\/div>\n                        <\/div>\n\n                                    <\/div>\n            <\/div>\n            \n                        <div class=\"internal-hero-video video-expand-wrapper\">\n\n                <div class=\"hero-video-wrapper relative\">\n\n                    <!-- ===================== -->\n                    <!-- MEDIA -->\n                    <!-- ===================== -->\n                    <div class=\"desktop-media\">\n\n                        \n                        \n                            <!-- FALLBACK IMAGE -->\n                            <picture class=\"w-full h-full\"><source media=\"(min-width: 481px)\" srcset=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/09\/AIA_280125_1925-scaled.jpg\"><img decoding=\"async\" class=\"w-full h-full\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/09\/AIA_280125_1925-scaled.jpg\" alt=\"\" style=\"object-fit:cover;object-position:center;\" loading=\"lazy\" width=\"2560\" height=\"1707\" \/><\/picture>\n                        \n                    <\/div>\n\n                    <!-- ===================== -->\n                    <!-- THUMBNAIL -->\n                    <!-- ===================== -->\n                    \n                    <!-- ===================== -->\n                    <!-- PLAY BUTTON -->\n                    <!-- ===================== -->\n                    \n                <\/div>\n\n            <\/div>\n                    <\/div>\n    <\/section>\n    <!-- BLOCK CODING STARTS HERE -->\n\n    \n\n  <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n  <section \r\n      id=\"\" \r\n      data-name=\"acf_our-story\"\r\n      data-lazyload=\"1\" \r\n      class=\"relative \" \r\n      style=\"z-index: 0;\">\r\n    <div class=\"b1024:pt-[108px] pt-80\">\r\n        <div class=\"container\">\r\n                <div class=\"grid grid-cols-1 b1024:grid-cols-2 gap-[25px]\">\r\n                    <div class=\"flex flex-col justify-between\">\r\n                        <div class=\"b1024:max-w-[438px] ml-auto b1200:mb-[60px] mb-8\">\r\n                                                            <div class=\"\">\r\n                                            <h2 class=\"h2 animate-watch standard__headline block b1200:mb-[98px] b767:mb-10 mb-7\">Our Story<\/h2>\n                                    <\/div>\r\n                                                                                                <h3 class=\"h3 animate-watch standard__headline block text-color1\">We founded AI Advancements to solve a problem we saw repeatedly across Australian organisations: while the potential of AI was obvious, there was a clear gap between experimentation and production-ready systems that businesses could trust.<\/h3>\n                                                        <\/div>\r\n                        <div class=\"our-story-left-img\">\r\n                                                            <picture class=\"w-full h-full\"><source media=\"(min-width: 481px)\" srcset=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/09\/AIA_280125_0455-scaled.jpg\"><img decoding=\"async\" class=\"w-full h-full\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/09\/AIA_280125_0455-scaled.jpg\" alt=\"\" style=\"object-fit:contain;object-position:center;\" loading=\"lazy\" width=\"1708\" height=\"2560\" \/><\/picture>                                                    <\/div>\r\n                    <\/div>\r\n                    <div class=\"flex flex-col justify-between\">\r\n                        <div>\r\n                            <div class=\"b1400:mb-[98px] b1200:mb-[85px] mb-6 hidden b1024:block pl-[42px]\">\r\n                                <svg width=\"57\" height=\"57\" viewBox=\"0 0 57 57\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><rect width=\"56.1721\" height=\"56.833\" rx=\"28.0861\" fill=\"#FCFF6A\"\/><path d=\"M27.6025 21.4423V35.6503H25.1719V25.3358C23.526 31.2983 18.1975 35.6766 11.8955 35.6766V33.1727C18.1657 33.1727 23.2676 27.9113 23.2676 21.4423H27.6025ZM34.2275 21.4423C34.2276 27.9098 39.3294 33.1727 45.5996 33.1727V35.6766C39.299 35.6766 33.9692 31.2969 32.3232 25.3358V35.6522H29.8926V21.4423H34.2275Z\" fill=\"#131924\"\/><\/svg>\r\n                            <\/div>\r\n                                                            <div class=\"summary-wrap font-medium b1024:max-w-[436px] b1200:mb-[60px] mb-8\">\r\n                                    <p>That gap became clear early in our careers. While studying advanced science and computer science at Curtin University, directors Sean Oldenburger and Samual Cunningham were already working on applied AI systems for government and industry. Through project and hackathon work with the Department of Fire and Emergency Services and the Department of Health, we saw the same pattern emerge: a strong interest in AI, but no practical, secure path to real deployment.<\/p>\n<p>The turning point came when Sean was embedded inside a major mining company, building an internal AI system that moved beyond prototypes and delivered measurable impact. That system went on to save the organisation more than $2 million per year. The value was undeniable, yet it highlighted a broader issue: Perth businesses lacked local, AI-native partners who could deliver meaningful outcomes without relying on off-the-shelf tools or theoretical advice.<\/p>\n                                <\/div>\r\n                                                    <\/div>\r\n                        <div class=\"our-story-right-img\">\r\n                                                            <picture class=\"w-full h-full\"><source media=\"(min-width: 481px)\" srcset=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/09\/AIA_280125_0498-scaled.jpg\"><img decoding=\"async\" class=\"w-full h-full\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/09\/AIA_280125_0498-scaled.jpg\" alt=\"\" style=\"object-fit:contain;object-position:center;\" loading=\"lazy\" width=\"2560\" height=\"1707\" \/><\/picture>                                                    <\/div>\r\n                    <\/div>\r\n                <\/div>\r\n        <\/div>\r\n    <\/div>\r\n\r\n\r\n  <\/section>\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n\r\n  \n\n  <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n  <section \r\n      id=\"\" \r\n      data-name=\"acf_text-column\"\r\n      data-lazyload=\"1\" \r\n      class=\"relative \" \r\n      style=\"z-index: 0;\">\r\n    <div class=\"b1024:py-[90px] py-80\">\r\n        <div class=\"container\">\r\n                            <div class=\"max-w-[900px] b767:columns-2 mx-auto\">\r\n                    <p>We founded AI Advancements as an AI-native company from day one. Not as a traditional consultancy adapting to AI, but as a team built specifically to design, build and integrate custom AI systems into real operational environments.<\/p>\n<p>Our focus was simple: to deliver high-quality AI that fits how organisations already work, with security, governance and long-term adoption built in.<\/p>\n<p>Our focus was simple: to deliver high-quality AI that fits how organisations already work, with security, governance and long-term adoption built in. For organisations still determining where AI can create the greatest value, our <a class=\"decorated-link\" href=\"https:\/\/aiadvancements.com.au\/ai-strategy\/\" target=\"_new\" rel=\"noopener\" data-start=\"2716\" data-end=\"2788\">AI strategy consulting<\/a> helps identify and prioritise the right opportunities before moving into implementation.<\/p>\n<p>Over the past two and a half years, we\u2019ve grown alongside our clients. What began with early applied projects has developed into long-term partnerships, delivering projects for more than 70 Australian organisations, including Endeavour Homes, LJ Hooker Settlements and Fortescue. As project scope and complexity increased, we expanded our team to include senior AI engineers and a dedicated AI governance lead, all Perth-based, full-time specialists.<\/p>\n<p>See our <a class=\"decorated-link\" href=\"https:\/\/aiadvancements.com.au\/case-studies\/?utm_source=chatgpt.com\" target=\"_new\" rel=\"noopener\" data-start=\"1112\" data-end=\"1178\">client case studies<\/a> to explore how we\u2019ve applied AI to real-world challenges across different industries.<\/p>\n<p>Today, we operate from our own office in Osborne Park, delivering enterprise-grade AI development, governance-aware deployment and trusted AI training across major organisations and regulated environments. We use AI internally every day to work faster, iterate smarter, and hold ourselves to the same standards we deliver to our clients.<\/p>\n                <\/div>\r\n                    <\/div>\r\n    <\/div>\r\n\r\n\r\n  <\/section>\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n\r\n  \n\n  <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n  <section \r\n      id=\"\" \r\n      data-name=\"acf_image-block\"\r\n      data-lazyload=\"1\" \r\n      class=\"relative \" \r\n      style=\"z-index: 0;\">\r\n        <div class=\"container relative\">\r\n            <div class=\"block-image\">\r\n                                    <picture class=\"w-full h-full\"><source media=\"(min-width: 481px)\" srcset=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/09\/AIA_280125_0430-scaled.jpg\"><img decoding=\"async\" class=\"w-full h-full\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/09\/AIA_280125_0430-scaled.jpg\" alt=\"\" style=\"object-fit:contain;object-position:center;\" loading=\"lazy\" width=\"2560\" height=\"1707\" \/><\/picture>                            <\/div>\r\n        <\/div>\r\n  <\/section>\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n\r\n  \n\n  <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n  <section \r\n      id=\"\" \r\n      data-name=\"acf_our-value\"\r\n      data-lazyload=\"1\" \r\n      class=\"relative \" \r\n      style=\"z-index: 0;\">\r\n      <div class=\"our-values-area pt-16 pb-80\">\r\n            <div class=\"container\">\r\n                                    <div class=\"our-value-title hero-heading\">\r\n                            <h2 class=\"h2 animate-watch standard__headline block mb-9\">Our Values<\/h2>\n                        <\/div>\r\n                                                <div class=\"grid grid-cols-1 b767:grid-cols-2 b1024:grid-cols-3 b1200:grid-cols-4 gap-y-10 gap-x-6\">\r\n                                            <div class=\"border-b border-color1 pb-40\">\r\n                            <div class=\"h-[59px] w-[59px] rounded-full bg-color2 flex items-center justify-center\">\r\n                                <svg width=\"33\" height=\"14\" viewBox=\"0 0 30 13\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M10.1112 0C10.1112 5.75168 5.57492 10.4294 0 10.4294V12.6557C5.60316 12.6557 10.3408 8.76349 11.8042 3.46214V12.6329H13.9649V0H10.11H10.1112Z\" fill=\"#131924\"\/><path d=\"M19.8559 0H16.001V12.6342H18.1617V3.46214C19.6251 8.76223 24.364 12.6557 29.9659 12.6557V10.4294C24.391 10.4294 19.8547 5.75041 19.8547 0H19.8559Z\" fill=\"#131924\"\/><\/svg>\r\n                            <\/div>\r\n                                                            <h3 class=\"h3 text-[24px] my-5\">\r\n                                    At the Forefront                                <\/h3>\r\n                                                                                        <div class=\"font-medium\">\r\n                                    <p>We live and breathe AI, building custom models, agents and applications from the ground up.<\/p>\n                                <\/div>\r\n                                                    <\/div>\r\n                                            <div class=\"border-b border-color1 pb-40\">\r\n                            <div class=\"h-[59px] w-[59px] rounded-full bg-color2 flex items-center justify-center\">\r\n                                <svg width=\"33\" height=\"14\" viewBox=\"0 0 30 13\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M10.1112 0C10.1112 5.75168 5.57492 10.4294 0 10.4294V12.6557C5.60316 12.6557 10.3408 8.76349 11.8042 3.46214V12.6329H13.9649V0H10.11H10.1112Z\" fill=\"#131924\"\/><path d=\"M19.8559 0H16.001V12.6342H18.1617V3.46214C19.6251 8.76223 24.364 12.6557 29.9659 12.6557V10.4294C24.391 10.4294 19.8547 5.75041 19.8547 0H19.8559Z\" fill=\"#131924\"\/><\/svg>\r\n                            <\/div>\r\n                                                            <h3 class=\"h3 text-[24px] my-5\">\r\n                                    Fast Action                                <\/h3>\r\n                                                                                        <div class=\"font-medium\">\r\n                                    <p>We move with urgency and clarity, engineering solutions that work in the real world and deliver measurable value quickly.<\/p>\n                                <\/div>\r\n                                                    <\/div>\r\n                                            <div class=\"border-b border-color1 pb-40\">\r\n                            <div class=\"h-[59px] w-[59px] rounded-full bg-color2 flex items-center justify-center\">\r\n                                <svg width=\"33\" height=\"14\" viewBox=\"0 0 30 13\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M10.1112 0C10.1112 5.75168 5.57492 10.4294 0 10.4294V12.6557C5.60316 12.6557 10.3408 8.76349 11.8042 3.46214V12.6329H13.9649V0H10.11H10.1112Z\" fill=\"#131924\"\/><path d=\"M19.8559 0H16.001V12.6342H18.1617V3.46214C19.6251 8.76223 24.364 12.6557 29.9659 12.6557V10.4294C24.391 10.4294 19.8547 5.75041 19.8547 0H19.8559Z\" fill=\"#131924\"\/><\/svg>\r\n                            <\/div>\r\n                                                            <h3 class=\"h3 text-[24px] my-5\">\r\n                                    Deeply Invested                                 <\/h3>\r\n                                                                                        <div class=\"font-medium\">\r\n                                    <p>Our clients work directly with our Perth-based engineers. We stay close to the problem, communicate openly, and treat every system we build as if it were our own.<\/p>\n                                <\/div>\r\n                                                    <\/div>\r\n                                            <div class=\"border-b border-color1 pb-40\">\r\n                            <div class=\"h-[59px] w-[59px] rounded-full bg-color2 flex items-center justify-center\">\r\n                                <svg width=\"33\" height=\"14\" viewBox=\"0 0 30 13\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M10.1112 0C10.1112 5.75168 5.57492 10.4294 0 10.4294V12.6557C5.60316 12.6557 10.3408 8.76349 11.8042 3.46214V12.6329H13.9649V0H10.11H10.1112Z\" fill=\"#131924\"\/><path d=\"M19.8559 0H16.001V12.6342H18.1617V3.46214C19.6251 8.76223 24.364 12.6557 29.9659 12.6557V10.4294C24.391 10.4294 19.8547 5.75041 19.8547 0H19.8559Z\" fill=\"#131924\"\/><\/svg>\r\n                            <\/div>\r\n                                                            <h3 class=\"h3 text-[24px] my-5\">\r\n                                    Complete Integrity                                <\/h3>\r\n                                                                                        <div class=\"font-medium\">\r\n                                    <p>We combine deep capability across computer vision, language models, full-stack development and AI governance to build secure, dependable systems, and we are clear and honest about what AI can and cannot do.<\/p>\n                                <\/div>\r\n                                                    <\/div>\r\n                                    <\/div>\r\n                            <\/div>\r\n        <\/div>\r\n  <\/section>\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n\r\n  \n\n  <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\n    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\n\n  <!-- BLOCK CODING STARTS HERE -->\n  <section \n      id=\"\" \n      data-name=\"acf_team-members\"\n      data-lazyload=\"1\" \n      class=\"relative \" \n      style=\"z-index: 0;\">\n    <div class=\"b1024:py-[124px] py-[80px] bg-color1\">\n        <div class=\"container\">\n            <div class=\"max-w-[1130px] mx-auto\">\n                <div class=\"max-w-[664px] mx-auto b767:mb-[74px] mb-12 text-center text-white\">\n                                            <div class=\"subheading-wrap block b1024:hidden\">\n                                                    <\/div>\n                                                                <div class=\"heading-wrap\">\n                                    <h2 class=\"h2 animate-watch standard__headline block mb-10\">Meet the team<\/h2>\n                            <\/div>\n                                                                                                                                <div class=\"summary-wrap\">\n                            <p>We\u2019re an AI-native Perth team who believe great AI comes from working closely with the people who use it. Above all, we\u2019re approachable, local, and committed to partnering with you face to face to deliver meaningful outcomes for your organisation.<\/p>\n                        <\/div>\n                                    <\/div>\n                <div class=\"grid grid-cols-1 b767:grid-cols-2 b1024:grid-cols-3 gap-y-9 gap-x-8\">\n                                            <div class=\"rounded-xl overflow-hidden\">\n                                                        <div class=\"team-wrap relative rounded-xl overflow-hidden\">\n                                <div class=\"team-member-img aspect-[1\/1.25] relative rounded-xl overflow-hidden\">\n                                    <img decoding=\"async\" \n                                        src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/03\/AIA_280125_0080-scaled-e1776145208215.webp\" \n                                        alt=\"Sean Oldenburger\"\n                                        class=\"w-full h-full object-cover object-top\"\n                                    >\n                                    <div class=\"member-shot-name lowercase text-xs font-medium bg-color2 text-color1 py-[6px] px-3 rounded-xl absolute top-[26px] left-16\">\n                                        <span><<\/span>meet.Sean<span>><\/span>\n                                    <\/div>\n                                <\/div>\n                                <div class=\"member-info text-color1 flex flex-col justify-between h-full\">\n                                    <div class=\"mb-4\">\n                                        <div class=\"text-[15px] b1200:text-base\">\n                                            <p>Sean Oldenburger is a computer vision and language model specialist who\u2019s delivered over 20 AI projects across mining, property, education, and healthcare. As Director of AI Advancements, he helps organisations move from AI curiosity to AI in production, quickly, pragmatically, and responsibly.<\/p>\n                                        <\/div>\n                                        <a \n                                        class=\"font-bold underline open-member-popup\"\n                                        href=\"#\"\n                                        data-name=\"Sean Oldenburger\"\n                                        data-designation=\"Director\"\n                                        data-bio=\"&lt;p&gt;Sean Oldenburger is a computer vision and language model specialist who\u2019s delivered over 20 AI projects across mining, property, education, and healthcare. As Director of AI Advancements, he helps organisations move from AI curiosity to AI in production, quickly, pragmatically, and responsibly.&lt;\/p&gt;\n&lt;p&gt;When he\u2019s not shipping AI systems, Sean is usually experimenting with the latest tools, breaking them, rebuilding them, and seeing what mischief they can cause in the real world. This has included everything from serious enterprise prototypes to turning unsuspecting colleagues into AI-generated comic characters.&lt;\/p&gt;\n&lt;p&gt;At 6\u201d7, he\u2019s hard to miss in the office, spends his spare time playing soccer and futsal, and regularly disappoints people who assume he must play basketball.&lt;\/p&gt;\n\"\n                                        data-image=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/03\/AIA_280125_0080-scaled-e1776145208215.webp\"\n                                        data-linkedin=\"https:\/\/www.linkedin.com\/in\/sean-oldenburger\/\"\n                                        >\n                                        Read more\n                                        <\/a>\n                                    <\/div>\n\t\t\t\t\t\t\t\t\t                                      <a class=\"relative z-50 w-[50px]\" href=\"https:\/\/www.linkedin.com\/in\/sean-oldenburger\/\" target=\"_blank\" rel=\"noopener\">\n                                          <svg width=\"50\" height=\"50\" viewBox=\"0 0 50 50\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><rect width=\"50\" height=\"50\" rx=\"25\" fill=\"#131924\"\/><path d=\"M35 26.0411V33V32.9763H31.0576V26.8013C31.0576 25.329 31.0339 23.4527 29.0152 23.4527C26.9964 23.4527 26.6638 25.0438 26.6638 26.7063V33H22.7214V20.3174H26.4978V22.0513H26.5451C27.0674 21.054 28.35 20.0089 30.2737 20.0089C34.2638 20.0089 35 22.6214 35 26.0415V26.0411ZM16.3089 33H20.2513V20.3174H16.3089V33ZM18.2799 14C17.0214 14 16 15.0214 16 16.2799C16 17.5384 17.0214 18.5835 18.2799 18.5835C19.5384 18.5835 20.5598 17.5384 20.5598 16.2799C20.5598 15.0214 19.5388 14 18.2799 14Z\" fill=\"white\"\/><\/svg>\n                                      <\/a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\n                                <\/div>\n                            <\/div>\n                            \n                            <div class=\"mt-5\">\n                                <h3 class=\"font-heading font-medium leading-[0.9] text-color4\">\n                                    Sean Oldenburger                                <\/h3>\n\n                                                                <div class=\"mt-1 font-medium text-color3\">\n                                    Director                                <\/div>\n                                                            <\/div>\n\n                        <\/div>\n                                            <div class=\"rounded-xl overflow-hidden\">\n                                                        <div class=\"team-wrap relative rounded-xl overflow-hidden\">\n                                <div class=\"team-member-img aspect-[1\/1.25] relative rounded-xl overflow-hidden\">\n                                    <img decoding=\"async\" \n                                        src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/03\/AIA_280125_0068-scaled-e1776145244709.webp\" \n                                        alt=\"Samuel Cunningham\"\n                                        class=\"w-full h-full object-cover object-top\"\n                                    >\n                                    <div class=\"member-shot-name lowercase text-xs font-medium bg-color2 text-color1 py-[6px] px-3 rounded-xl absolute top-[26px] left-16\">\n                                        <span><<\/span>meet.Samuel<span>><\/span>\n                                    <\/div>\n                                <\/div>\n                                <div class=\"member-info text-color1 flex flex-col justify-between h-full\">\n                                    <div class=\"mb-4\">\n                                        <div class=\"text-[15px] b1200:text-base\">\n                                            <p>Samuel is a full-stack software engineer specialising in large language models and agentic systems. He has years of experience creating AI applications from scratch across various industries, including property, education, and healthcare.<\/p>\n                                        <\/div>\n                                        <a \n                                        class=\"font-bold underline open-member-popup\"\n                                        href=\"#\"\n                                        data-name=\"Samuel Cunningham\"\n                                        data-designation=\"Director\"\n                                        data-bio=\"&lt;p&gt;Samuel is a full-stack software engineer specialising in large language models and agentic systems. He has years of experience creating AI applications from scratch across various industries, including property, education, and healthcare. Samuel is most passionate about building large multi-agent systems that push the limits of modern AI and unlock new possibilities.&lt;\/p&gt;\n&lt;p&gt;Samuel prides himself on acting like a genuine team member when working with clients, proactively generating ideas and continually asking questions to ensure the solution we create will address a genuine business need.&lt;\/p&gt;\n&lt;p&gt;Samuel loves discussing the future of AI and can often be found passionately preaching the benefits of the Model Context Protocol (MCP), an emerging protocol for standardising the way large language models work with external tools.&lt;\/p&gt;\n&lt;p&gt;Apart from AI, Samuel has a massive passion for strategy games and sports and is known for taking our company board game nights way too seriously.&lt;\/p&gt;\n\"\n                                        data-image=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/03\/AIA_280125_0068-scaled-e1776145244709.webp\"\n                                        data-linkedin=\"https:\/\/www.linkedin.com\/in\/samuel-cunningham-ai\/\"\n                                        >\n                                        Read more\n                                        <\/a>\n                                    <\/div>\n\t\t\t\t\t\t\t\t\t                                      <a class=\"relative z-50 w-[50px]\" href=\"https:\/\/www.linkedin.com\/in\/samuel-cunningham-ai\/\" target=\"_blank\" rel=\"noopener\">\n                                          <svg width=\"50\" height=\"50\" viewBox=\"0 0 50 50\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><rect width=\"50\" height=\"50\" rx=\"25\" fill=\"#131924\"\/><path d=\"M35 26.0411V33V32.9763H31.0576V26.8013C31.0576 25.329 31.0339 23.4527 29.0152 23.4527C26.9964 23.4527 26.6638 25.0438 26.6638 26.7063V33H22.7214V20.3174H26.4978V22.0513H26.5451C27.0674 21.054 28.35 20.0089 30.2737 20.0089C34.2638 20.0089 35 22.6214 35 26.0415V26.0411ZM16.3089 33H20.2513V20.3174H16.3089V33ZM18.2799 14C17.0214 14 16 15.0214 16 16.2799C16 17.5384 17.0214 18.5835 18.2799 18.5835C19.5384 18.5835 20.5598 17.5384 20.5598 16.2799C20.5598 15.0214 19.5388 14 18.2799 14Z\" fill=\"white\"\/><\/svg>\n                                      <\/a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\n                                <\/div>\n                            <\/div>\n                            \n                            <div class=\"mt-5\">\n                                <h3 class=\"font-heading font-medium leading-[0.9] text-color4\">\n                                    Samuel Cunningham                                <\/h3>\n\n                                                                <div class=\"mt-1 font-medium text-color3\">\n                                    Director                                <\/div>\n                                                            <\/div>\n\n                        <\/div>\n                                            <div class=\"rounded-xl overflow-hidden\">\n                                                        <div class=\"team-wrap relative rounded-xl overflow-hidden\">\n                                <div class=\"team-member-img aspect-[1\/1.25] relative rounded-xl overflow-hidden\">\n                                    <img decoding=\"async\" \n                                        src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/02\/DSC00096-scaled.jpg\" \n                                        alt=\"James Audcent\"\n                                        class=\"w-full h-full object-cover object-top\"\n                                    >\n                                    <div class=\"member-shot-name lowercase text-xs font-medium bg-color2 text-color1 py-[6px] px-3 rounded-xl absolute top-[26px] left-16\">\n                                        <span><<\/span>meet.James<span>><\/span>\n                                    <\/div>\n                                <\/div>\n                                <div class=\"member-info text-color1 flex flex-col justify-between h-full\">\n                                    <div class=\"mb-4\">\n                                        <div class=\"text-[15px] b1200:text-base\">\n                                            <p>James is a bit of an office dad. He\u2019s the resident Economist subscription holder, a proud soundbar owner, can be prone to pontification and loves a pun \u2013 he\u2019s even been hit with an egregious three-joke-a-day limit at a previous workplace.<\/p>\n                                        <\/div>\n                                        <a \n                                        class=\"font-bold underline open-member-popup\"\n                                        href=\"#\"\n                                        data-name=\"James Audcent\"\n                                        data-designation=\"Senior AI Engineer\"\n                                        data-bio=\"&lt;p&gt;A Computer and Data Science graduate of UWA, James previously launched WA\u2019s first tech consulting social enterprise, where he supported not-for-profit organisations to embrace emerging technologies.&lt;\/p&gt;\n&lt;p&gt;During his time there, he saved the sector over $100,000 in consulting fees, secured a State Government Innovation Booster Grant, and was named a finalist in the 2024 YACWA State Youth Awards. He\u2019s also currently serving on the board of the Mundaring Arts Centre and Midland Junction Arts Centre.&lt;\/p&gt;\n&lt;p&gt;James is a bit of an office dad. He\u2019s the resident Economist subscription holder, a proud soundbar owner, can be prone to pontification and loves a pun \u2013 he\u2019s even been hit with an egregious three-joke-a-day limit at a previous workplace.&lt;\/p&gt;\n\"\n                                        data-image=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/02\/DSC00096-scaled.jpg\"\n                                        data-linkedin=\"https:\/\/www.linkedin.com\/in\/james-audcent\"\n                                        >\n                                        Read more\n                                        <\/a>\n                                    <\/div>\n\t\t\t\t\t\t\t\t\t                                      <a class=\"relative z-50 w-[50px]\" href=\"https:\/\/www.linkedin.com\/in\/james-audcent\" target=\"_blank\" rel=\"noopener\">\n                                          <svg width=\"50\" height=\"50\" viewBox=\"0 0 50 50\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><rect width=\"50\" height=\"50\" rx=\"25\" fill=\"#131924\"\/><path d=\"M35 26.0411V33V32.9763H31.0576V26.8013C31.0576 25.329 31.0339 23.4527 29.0152 23.4527C26.9964 23.4527 26.6638 25.0438 26.6638 26.7063V33H22.7214V20.3174H26.4978V22.0513H26.5451C27.0674 21.054 28.35 20.0089 30.2737 20.0089C34.2638 20.0089 35 22.6214 35 26.0415V26.0411ZM16.3089 33H20.2513V20.3174H16.3089V33ZM18.2799 14C17.0214 14 16 15.0214 16 16.2799C16 17.5384 17.0214 18.5835 18.2799 18.5835C19.5384 18.5835 20.5598 17.5384 20.5598 16.2799C20.5598 15.0214 19.5388 14 18.2799 14Z\" fill=\"white\"\/><\/svg>\n                                      <\/a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\n                                <\/div>\n                            <\/div>\n                            \n                            <div class=\"mt-5\">\n                                <h3 class=\"font-heading font-medium leading-[0.9] text-color4\">\n                                    James Audcent                                <\/h3>\n\n                                                                <div class=\"mt-1 font-medium text-color3\">\n                                    Senior AI Engineer                                <\/div>\n                                                            <\/div>\n\n                        <\/div>\n                                            <div class=\"rounded-xl overflow-hidden\">\n                                                        <div class=\"team-wrap relative rounded-xl overflow-hidden\">\n                                <div class=\"team-member-img aspect-[1\/1.25] relative rounded-xl overflow-hidden\">\n                                    <img decoding=\"async\" \n                                        src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/01\/AIA_280125_0141-scaled-e1776145450192.webp\" \n                                        alt=\"Jason Luu\"\n                                        class=\"w-full h-full object-cover object-top\"\n                                    >\n                                    <div class=\"member-shot-name lowercase text-xs font-medium bg-color2 text-color1 py-[6px] px-3 rounded-xl absolute top-[26px] left-16\">\n                                        <span><<\/span>meet.Jason<span>><\/span>\n                                    <\/div>\n                                <\/div>\n                                <div class=\"member-info text-color1 flex flex-col justify-between h-full\">\n                                    <div class=\"mb-4\">\n                                        <div class=\"text-[15px] b1200:text-base\">\n                                            <p>Jason began his career as a project engineer before moving into software development. With a strong focus on cybersecurity, he has led initiatives to strengthen organisational security and ensure systems remain resilient.<\/p>\n                                        <\/div>\n                                        <a \n                                        class=\"font-bold underline open-member-popup\"\n                                        href=\"#\"\n                                        data-name=\"Jason Luu\"\n                                        data-designation=\"Senior AI Engineer\"\n                                        data-bio=\"&lt;p&gt;Jason began his career as a project engineer before moving into software development. With a strong focus on cybersecurity, he has led initiatives to strengthen organisational security and ensure systems remain resilient.&lt;\/p&gt;\n&lt;p&gt;He\u2019s passionate about building secure, scalable software that makes smart use of AI, and he values collaboration, innovation and staying ahead of emerging risks.&lt;\/p&gt;\n\"\n                                        data-image=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/01\/AIA_280125_0141-scaled-e1776145450192.webp\"\n                                        data-linkedin=\"https:\/\/www.linkedin.com\/in\/jason-luu-291b73109\/\"\n                                        >\n                                        Read more\n                                        <\/a>\n                                    <\/div>\n\t\t\t\t\t\t\t\t\t                                      <a class=\"relative z-50 w-[50px]\" href=\"https:\/\/www.linkedin.com\/in\/jason-luu-291b73109\/\" target=\"_blank\" rel=\"noopener\">\n                                          <svg width=\"50\" height=\"50\" viewBox=\"0 0 50 50\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><rect width=\"50\" height=\"50\" rx=\"25\" fill=\"#131924\"\/><path d=\"M35 26.0411V33V32.9763H31.0576V26.8013C31.0576 25.329 31.0339 23.4527 29.0152 23.4527C26.9964 23.4527 26.6638 25.0438 26.6638 26.7063V33H22.7214V20.3174H26.4978V22.0513H26.5451C27.0674 21.054 28.35 20.0089 30.2737 20.0089C34.2638 20.0089 35 22.6214 35 26.0415V26.0411ZM16.3089 33H20.2513V20.3174H16.3089V33ZM18.2799 14C17.0214 14 16 15.0214 16 16.2799C16 17.5384 17.0214 18.5835 18.2799 18.5835C19.5384 18.5835 20.5598 17.5384 20.5598 16.2799C20.5598 15.0214 19.5388 14 18.2799 14Z\" fill=\"white\"\/><\/svg>\n                                      <\/a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\n                                <\/div>\n                            <\/div>\n                            \n                            <div class=\"mt-5\">\n                                <h3 class=\"font-heading font-medium leading-[0.9] text-color4\">\n                                    Jason Luu                                <\/h3>\n\n                                                                <div class=\"mt-1 font-medium text-color3\">\n                                    Senior AI Engineer                                <\/div>\n                                                            <\/div>\n\n                        <\/div>\n                                            <div class=\"rounded-xl overflow-hidden\">\n                                                        <div class=\"team-wrap relative rounded-xl overflow-hidden\">\n                                <div class=\"team-member-img aspect-[1\/1.25] relative rounded-xl overflow-hidden\">\n                                    <img decoding=\"async\" \n                                        src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/01\/AIA_280125_0126-scaled.webp\" \n                                        alt=\"Julian Kristandi\"\n                                        class=\"w-full h-full object-cover object-top\"\n                                    >\n                                    <div class=\"member-shot-name lowercase text-xs font-medium bg-color2 text-color1 py-[6px] px-3 rounded-xl absolute top-[26px] left-16\">\n                                        <span><<\/span>meet.Julian<span>><\/span>\n                                    <\/div>\n                                <\/div>\n                                <div class=\"member-info text-color1 flex flex-col justify-between h-full\">\n                                    <div class=\"mb-4\">\n                                        <div class=\"text-[15px] b1200:text-base\">\n                                            <p>With over five years of experience in software development, Julian has delivered robust web and backend systems across enterprise environments, building dependable solutions that balance performance, clarity, and long-term maintainability.<\/p>\n                                        <\/div>\n                                        <a \n                                        class=\"font-bold underline open-member-popup\"\n                                        href=\"#\"\n                                        data-name=\"Julian Kristandi\"\n                                        data-designation=\"Senior AI Engineer\"\n                                        data-bio=\"&lt;p&gt;With over five years of experience in software development, Julian has delivered robust web and backend systems across enterprise environments, building dependable solutions that balance performance, clarity, and long-term maintainability. He is motivated by the practical application of artificial intelligence, translating complex capabilities into tools that genuinely improve how teams operate and make decisions.&lt;\/p&gt;\n&lt;p&gt;Beyond the technical world, Julian is an avid follower of soccer and basketball, enjoys playing tennis, and values staying active. He also prioritises meaningful time with friends and family, and is continually refining both his technical craft and personal discipline.&lt;\/p&gt;\n&lt;p&gt;Julian is driven by the belief that technology should serve people first. He is eager to explore how AI can be applied in ways that simplify complexity, expand access, and create meaningful improvements in everyday life.&lt;\/p&gt;\n\"\n                                        data-image=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/01\/AIA_280125_0126-scaled.webp\"\n                                        data-linkedin=\"https:\/\/www.linkedin.com\/in\/juliankristandi\"\n                                        >\n                                        Read more\n                                        <\/a>\n                                    <\/div>\n\t\t\t\t\t\t\t\t\t                                      <a class=\"relative z-50 w-[50px]\" href=\"https:\/\/www.linkedin.com\/in\/juliankristandi\" target=\"_blank\" rel=\"noopener\">\n                                          <svg width=\"50\" height=\"50\" viewBox=\"0 0 50 50\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><rect width=\"50\" height=\"50\" rx=\"25\" fill=\"#131924\"\/><path d=\"M35 26.0411V33V32.9763H31.0576V26.8013C31.0576 25.329 31.0339 23.4527 29.0152 23.4527C26.9964 23.4527 26.6638 25.0438 26.6638 26.7063V33H22.7214V20.3174H26.4978V22.0513H26.5451C27.0674 21.054 28.35 20.0089 30.2737 20.0089C34.2638 20.0089 35 22.6214 35 26.0415V26.0411ZM16.3089 33H20.2513V20.3174H16.3089V33ZM18.2799 14C17.0214 14 16 15.0214 16 16.2799C16 17.5384 17.0214 18.5835 18.2799 18.5835C19.5384 18.5835 20.5598 17.5384 20.5598 16.2799C20.5598 15.0214 19.5388 14 18.2799 14Z\" fill=\"white\"\/><\/svg>\n                                      <\/a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\n                                <\/div>\n                            <\/div>\n                            \n                            <div class=\"mt-5\">\n                                <h3 class=\"font-heading font-medium leading-[0.9] text-color4\">\n                                    Julian Kristandi                                <\/h3>\n\n                                                                <div class=\"mt-1 font-medium text-color3\">\n                                    Senior AI Engineer                                <\/div>\n                                                            <\/div>\n\n                        <\/div>\n                                            <div class=\"rounded-xl overflow-hidden\">\n                                                        <div class=\"team-wrap relative rounded-xl overflow-hidden\">\n                                <div class=\"team-member-img aspect-[1\/1.25] relative rounded-xl overflow-hidden\">\n                                    <img decoding=\"async\" \n                                        src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2025\/07\/DSC00086-scaled.jpg\" \n                                        alt=\"Jordan Allen\"\n                                        class=\"w-full h-full object-cover object-top\"\n                                    >\n                                    <div class=\"member-shot-name lowercase text-xs font-medium bg-color2 text-color1 py-[6px] px-3 rounded-xl absolute top-[26px] left-16\">\n                                        <span><<\/span>meet.Jordan<span>><\/span>\n                                    <\/div>\n                                <\/div>\n                                <div class=\"member-info text-color1 flex flex-col justify-between h-full\">\n                                    <div class=\"mb-4\">\n                                        <div class=\"text-[15px] b1200:text-base\">\n                                            <p>Jordan began his career as a graphic designer before transitioning into software development, bringing with him a genuine curiosity for how people interact with and integrate technology into their daily lives, bringing a fresh perspective on what a successful AI integration looks like for our clients.<\/p>\n                                        <\/div>\n                                        <a \n                                        class=\"font-bold underline open-member-popup\"\n                                        href=\"#\"\n                                        data-name=\"Jordan Allen\"\n                                        data-designation=\"AI Engineer\"\n                                        data-bio=\"&lt;p&gt;Jordan began his career as a graphic designer before transitioning into software development, bringing with him a genuine curiosity for how people interact with and integrate technology into their daily lives, bringing a fresh perspective on what a successful AI integration looks like for our clients.&lt;\/p&gt;\n&lt;p&gt;Outside of work, Jordan is an avid gardener, recently started a backyard chicken coop, and enjoys getting out on the trails with their spoodle.&lt;\/p&gt;\n\"\n                                        data-image=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2025\/07\/DSC00086-scaled.jpg\"\n                                        data-linkedin=\"https:\/\/www.linkedin.com\/in\/juliankristandi\"\n                                        >\n                                        Read more\n                                        <\/a>\n                                    <\/div>\n\t\t\t\t\t\t\t\t\t                                      <a class=\"relative z-50 w-[50px]\" href=\"https:\/\/www.linkedin.com\/in\/juliankristandi\" target=\"_blank\" rel=\"noopener\">\n                                          <svg width=\"50\" height=\"50\" viewBox=\"0 0 50 50\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><rect width=\"50\" height=\"50\" rx=\"25\" fill=\"#131924\"\/><path d=\"M35 26.0411V33V32.9763H31.0576V26.8013C31.0576 25.329 31.0339 23.4527 29.0152 23.4527C26.9964 23.4527 26.6638 25.0438 26.6638 26.7063V33H22.7214V20.3174H26.4978V22.0513H26.5451C27.0674 21.054 28.35 20.0089 30.2737 20.0089C34.2638 20.0089 35 22.6214 35 26.0415V26.0411ZM16.3089 33H20.2513V20.3174H16.3089V33ZM18.2799 14C17.0214 14 16 15.0214 16 16.2799C16 17.5384 17.0214 18.5835 18.2799 18.5835C19.5384 18.5835 20.5598 17.5384 20.5598 16.2799C20.5598 15.0214 19.5388 14 18.2799 14Z\" fill=\"white\"\/><\/svg>\n                                      <\/a>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\n                                <\/div>\n                            <\/div>\n                            \n                            <div class=\"mt-5\">\n                                <h3 class=\"font-heading font-medium leading-[0.9] text-color4\">\n                                    Jordan Allen                                <\/h3>\n\n                                                                <div class=\"mt-1 font-medium text-color3\">\n                                    AI Engineer                                <\/div>\n                                                            <\/div>\n\n                        <\/div>\n                                            <div class=\"rounded-xl overflow-hidden\">\n                                                        <div class=\"team-wrap relative rounded-xl overflow-hidden\">\n                                <div class=\"team-member-img aspect-[1\/1.25] relative rounded-xl overflow-hidden\">\n                                    <img decoding=\"async\" \n                                        src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/09\/WhatsApp-Image-2026-09-08-at-12.03.53-AM-2.webp\" \n                                        alt=\"Matthias Ong\"\n                                        class=\"w-full h-full object-cover object-top\"\n                                    >\n                                    <div class=\"member-shot-name lowercase text-xs font-medium bg-color2 text-color1 py-[6px] px-3 rounded-xl absolute top-[26px] left-16\">\n                                        <span><<\/span>meet.Matthias<span>><\/span>\n                                    <\/div>\n                                <\/div>\n                                <div class=\"member-info text-color1 flex flex-col justify-between h-full\">\n                                    <div class=\"mb-4\">\n                                        <div class=\"text-[15px] b1200:text-base\">\n                                            <p>Matthias joins us fresh out of The University of Melbourne. He&#8217;s a tinkerer by nature, the kind of person who constantly explores and builds with technology. At university he led technical projects for startup clients, automating the workflows that were slowing their teams down and delivering full-stack solutions for their users.<\/p>\n                                        <\/div>\n                                        <a \n                                        class=\"font-bold underline open-member-popup\"\n                                        href=\"#\"\n                                        data-name=\"Matthias Ong\"\n                                        data-designation=\"AI Engineer\"\n                                        data-bio=\"&lt;p&gt;Matthias joins us fresh out of The University of Melbourne. He&#8217;s a tinkerer by nature, the kind of person who constantly explores and builds with technology. At university he led technical projects for startup clients, automating the workflows that were slowing their teams down and delivering full-stack solutions for their users. Solving real world problems for clients is what draws him to AI, and he loves solving problems for our Perth clients!&lt;\/p&gt;\n&lt;p&gt;Outside of work, you will find him playing badminton with his friends, hiking in nature with his camera or volunteering in his community. His curiosity and beliefs shape how he approaches his work and the people around him.&lt;\/p&gt;\n\"\n                                        data-image=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/09\/WhatsApp-Image-2026-09-08-at-12.03.53-AM-2.webp\"\n                                        data-linkedin=\"\"\n                                        >\n                                        Read more\n                                        <\/a>\n                                    <\/div>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\n                                <\/div>\n                            <\/div>\n                            \n                            <div class=\"mt-5\">\n                                <h3 class=\"font-heading font-medium leading-[0.9] text-color4\">\n                                    Matthias Ong                                <\/h3>\n\n                                                                <div class=\"mt-1 font-medium text-color3\">\n                                    AI Engineer                                <\/div>\n                                                            <\/div>\n\n                        <\/div>\n                                    <\/div>\n                <!-- team member popup -->\n                <div class=\"member-popup bg-color4 fixed inset-0 flex items-center justify-center z-50 hidden\">\n                    <div class=\"popup-content  b1400:py-[150px] b1400:px-[140px] b1024:p-60 b767:px-5 b767:py-8 px-4 py-6 relative max-w-[1300px] w-full\">\n                        <button class=\"popup-close absolute top-12 right-4 text-xl\">\u2715<\/button>\n                        <div class=\"popup-content-wrap grid grid-cols-1 b1024:grid-cols-2 b1400:gap-x-[80px] b1200:gap-x-14 b1024:gap-10 gap-6 items-center\">\n                            <!-- LEFT IMAGE -->\n                            <div class=\"popup-image rounded-xl overflow-hidden\">\n                                <img decoding=\"async\" src=\"\" alt=\"\" class=\"w-full h-full object-cover object-top\">\n                            <\/div>\n                            <!-- RIGHT CONTENT -->\n                            <div class=\"popup-info flex flex-col text-center b1024:text-start\">\n                                <h2 class=\"popup-name font-heading tracking-[-0.06em] font-normal\"><\/h2>\n                                <div class=\"popup-designation mt-2 b1024:mb-6 mb-5\"><\/div>\n\t\t\t\t\t\t\t\t                                <div class=\"popup-bio b1200:mt-8 b1024:mt-6 b767:mt-5 text-xs b767:text-base\"><\/div>\n                            <\/div>\n                        <\/div>\n                    <\/div>\n                <\/div>\n                                <div class=\"team-bottom-content relative grid grid-cols-1 b767:grid-cols-2 gap-8 mt-[60px] pt-[80px] text-white\">\n                                            <div class=\"\">\n                            <h3 class=\"text-[40px] font-normal\">Join our team<\/h3>\n                            <div class=\"button-wrap inline-flex flex-col b767:flex-row gap-3 border border-white hover:border-color2 rounded-[35px] mt-7\">\n                                            <a href=\"#\" target=\"\" class=\"btn btn-solidcolor1 speak-btn flex items-center gap-3 overflow-hidden\">\n                <span class=\"block circle relative\"><\/span>\n                <span class=\"button-text z-10\">Open positions<\/span>\n            <\/a>\n                                                                        <\/div>\n                        <\/div>\n                                        <div class=\"\">\n                        <p>We\u2019re building one of WA\u2019s leading AI-native engineering teams, and we\u2019re always looking for curious, driven people who want to work on real AI systems that make a genuine impact. If you want to solve complex problems, grow fast, and work alongside experts in Perth, we\u2019d love to hear from you.<\/p>\n                    <\/div>\n                <\/div>\n                            <\/div>\n        <\/div>\n    <\/div>\n\n    <style>\n    @media (max-width: 1440px) {\n        .member-popup {\n            height: 100vh; \n            overflow-y: scroll;\n        }\n    }\n    @media (max-width: 1024px) {\n        .member-popup .popup-image {\n            height: 100%;\n        }\n        .member-popup .popup-image img {\n            width: 100%;\n            aspect-ratio: unset;\n        }\n        .member-popup .popup-close {\n            top: 4rem;\n        }\n    }\n    @media (max-width: 768px) {\n        .member-popup .popup-image {\n            height: auto;\n        }\n        .member-popup .popup-image img {\n            aspect-ratio: 1;\n            width: 250px;\n        }\n        .member-popup .popup-close {\n            top: 6rem;\n        }\n        .popup-linkedin {\n            max-width: unset;\n        }\n        .popup-content-wrap {\n            max-width: 550px;\n            margin: 0 auto;\n            padding: 2em 0;\n        }\n    }\n    @media (min-width: 1350px) {\n        .member-popup .popup-close {\n            top: 6rem;\n        }\n    }\n    <\/style>\n\n\n  <\/section>\n  <!-- BLOCK CODING STARTS HERE -->\n\n  \n\n  <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\n    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\n\n  <!-- BLOCK CODING STARTS HERE -->\n  <section \n      id=\"\" \n      data-name=\"acf_services\"\n      data-lazyload=\"1\" \n      class=\"relative \" \n      style=\"z-index: 0;\">\n      <div id=\"services\" class=\"b1024:py-130 b767:py-100 py-80 bg-color4\">\n        <div class=\"container\">\n                            <div class=\"subheading-wrap max-w-[900px] mx-auto b1024:mb-12 mb-8 text-center b1024:text-start\">\n                            <h2 class=\" animate-watch standard__headline inline-flex font-semibold text-color1 bg-[#FCFBFA] py-2 px-6 rounded-3xl text-xs mx-auto b767:mx-0\">Our services<\/h2>\n                    <\/div>\n                        <div class=\"grid grid-cols-1 b1024:grid-cols-2 gap-6 max-w-[900px] mx-auto mb-10 b1024:mb-16 text-center b1024:text-start\">\n                                    <div class=\"hero-heading\">\n                            <h3 class=\"h2 animate-watch standard__headline block\">Our AI expertise<\/h3>\n                        <\/div>\n                                                    <div class=\"hero-summary b1024:max-w-[437px]\">\n                        <p>As an AI-native team, we support organisations through every stage of their AI journey, from strategy and capability building to custom engineering and long-term transformation. Each service is delivered by specialists who understand both the technology and the realities of enterprise operations.<\/p>\n                    <\/div>\n                            <\/div>\n                            <div class=\"grid grid-cols-1 b767:grid-cols-2 gap-0 mx-auto max-w-[1130px]\">\n                                            <div class=\"service-list-wrap relative overflow-hidden rounded-full bg-[#FCFBFA] b1200:w-[565px] b1200:h-[565px] b1024:w-[489px] b1024:h-[489px] w-[325px] h-[325px] mx-auto\">\n                            <div class=\"service-list-title text-center\">\n                                                                    <h3 class=\"b1024:text-[40px] text-2xl\">\n                                        AI Strategy                                    <\/h3>\n                                                            <\/div>\n                            <div class=\"service-list-content text-center w-full rounded-full h-full b1024:px-60 px-30 flex flex-col justify-center\">\n                                <div class=\"b1024:mb-6 mb-4 flex justify-center\">\n                                    <svg width=\"50\" height=\"30\" viewBox=\"0 0 30 13\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M10.1112 0C10.1112 5.75168 5.57492 10.4294 0 10.4294V12.6557C5.60316 12.6557 10.3408 8.76349 11.8042 3.46214V12.6329H13.9649V0H10.11H10.1112Z\" fill=\"#131924\"\/><path d=\"M19.8559 0H16.001V12.6342H18.1617V3.46214C19.6251 8.76223 24.364 12.6557 29.9659 12.6557V10.4294C24.391 10.4294 19.8547 5.75041 19.8547 0H19.8559Z\" fill=\"#131924\"\/><\/svg>\n                                <\/div>\n                                                                    <div class=\"h3 b1024:text-[40px] text-2xl\">\n                                        AI Strategy                                    <\/div>\n                                                                                                    <div class=\"b1024:mt-6 mt-4 mx-auto max-w-[380px] text-xs b767:text-base font-medium\">\n                                        <p>We help you understand where AI adds real value, prioritise the strongest opportunities, and create a practical roadmap your organisation can act on with confidence.<\/p>\n                                    <\/div>\n                                                                <div class=\"flex justify-center mt-6\">\n                                                                            <a class=\"btn small-btn btn-solidcolor3 flex justify-center items-center gap-2 overflow-hidden\" href=\"https:\/\/aiadvancements.com.au\/ai-strategy\/\" target=\"_self\">\n                                            <span class=\"block circle relative\"><\/span>\n                                            <div class=\"button-text z-10\">Learn more<\/div>\n                                        <\/a>\n                                                                    <\/div>\n                            <\/div>\n                        <\/div>\n                                            <div class=\"service-list-wrap relative overflow-hidden rounded-full bg-[#FCFBFA] b1200:w-[565px] b1200:h-[565px] b1024:w-[489px] b1024:h-[489px] w-[325px] h-[325px] mx-auto\">\n                            <div class=\"service-list-title text-center\">\n                                                                    <h3 class=\"b1024:text-[40px] text-2xl\">\n                                        Custom AI Development                                    <\/h3>\n                                                            <\/div>\n                            <div class=\"service-list-content text-center w-full rounded-full h-full b1024:px-60 px-30 flex flex-col justify-center\">\n                                <div class=\"b1024:mb-6 mb-4 flex justify-center\">\n                                    <svg width=\"50\" height=\"30\" viewBox=\"0 0 30 13\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M10.1112 0C10.1112 5.75168 5.57492 10.4294 0 10.4294V12.6557C5.60316 12.6557 10.3408 8.76349 11.8042 3.46214V12.6329H13.9649V0H10.11H10.1112Z\" fill=\"#131924\"\/><path d=\"M19.8559 0H16.001V12.6342H18.1617V3.46214C19.6251 8.76223 24.364 12.6557 29.9659 12.6557V10.4294C24.391 10.4294 19.8547 5.75041 19.8547 0H19.8559Z\" fill=\"#131924\"\/><\/svg>\n                                <\/div>\n                                                                    <div class=\"h3 b1024:text-[40px] text-2xl\">\n                                        Custom AI Development                                    <\/div>\n                                                                                                    <div class=\"b1024:mt-6 mt-4 mx-auto max-w-[380px] text-xs b767:text-base font-medium\">\n                                        <p>We design, build and deploy bespoke AI software, from computer vision to automation and AI agents, engineered to fit your workflows and integrate securely with your systems.<\/p>\n                                    <\/div>\n                                                                <div class=\"flex justify-center mt-6\">\n                                                                            <a class=\"btn small-btn btn-solidcolor3 flex justify-center items-center gap-2 overflow-hidden\" href=\"https:\/\/aiadvancements.com.au\/ai-development\/\" target=\"_self\">\n                                            <span class=\"block circle relative\"><\/span>\n                                            <div class=\"button-text z-10\">Learn more<\/div>\n                                        <\/a>\n                                                                    <\/div>\n                            <\/div>\n                        <\/div>\n                                            <div class=\"service-list-wrap relative overflow-hidden rounded-full bg-[#FCFBFA] b1200:w-[565px] b1200:h-[565px] b1024:w-[489px] b1024:h-[489px] w-[325px] h-[325px] mx-auto\">\n                            <div class=\"service-list-title text-center\">\n                                                                    <h3 class=\"b1024:text-[40px] text-2xl\">\n                                        AI Training                                    <\/h3>\n                                                            <\/div>\n                            <div class=\"service-list-content text-center w-full rounded-full h-full b1024:px-60 px-30 flex flex-col justify-center\">\n                                <div class=\"b1024:mb-6 mb-4 flex justify-center\">\n                                    <svg width=\"50\" height=\"30\" viewBox=\"0 0 30 13\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M10.1112 0C10.1112 5.75168 5.57492 10.4294 0 10.4294V12.6557C5.60316 12.6557 10.3408 8.76349 11.8042 3.46214V12.6329H13.9649V0H10.11H10.1112Z\" fill=\"#131924\"\/><path d=\"M19.8559 0H16.001V12.6342H18.1617V3.46214C19.6251 8.76223 24.364 12.6557 29.9659 12.6557V10.4294C24.391 10.4294 19.8547 5.75041 19.8547 0H19.8559Z\" fill=\"#131924\"\/><\/svg>\n                                <\/div>\n                                                                    <div class=\"h3 b1024:text-[40px] text-2xl\">\n                                        AI Training                                    <\/div>\n                                                                                                    <div class=\"b1024:mt-6 mt-4 mx-auto max-w-[380px] text-xs b767:text-base font-medium\">\n                                        <p>We deliver clear, engaging AI training for teams of all sizes, helping your staff use AI safely, confidently and effectively in their daily work.<\/p>\n                                    <\/div>\n                                                                <div class=\"flex justify-center mt-6\">\n                                                                            <a class=\"btn small-btn btn-solidcolor3 flex justify-center items-center gap-2 overflow-hidden\" href=\"https:\/\/aiadvancements.com.au\/ai-training\/\" target=\"_self\">\n                                            <span class=\"block circle relative\"><\/span>\n                                            <div class=\"button-text z-10\">Learn more<\/div>\n                                        <\/a>\n                                                                    <\/div>\n                            <\/div>\n                        <\/div>\n                                            <div class=\"service-list-wrap relative overflow-hidden rounded-full bg-[#FCFBFA] b1200:w-[565px] b1200:h-[565px] b1024:w-[489px] b1024:h-[489px] w-[325px] h-[325px] mx-auto\">\n                            <div class=\"service-list-title text-center\">\n                                                                    <h3 class=\"b1024:text-[40px] text-2xl\">\n                                        AI Transformation                                    <\/h3>\n                                                            <\/div>\n                            <div class=\"service-list-content text-center w-full rounded-full h-full b1024:px-60 px-30 flex flex-col justify-center\">\n                                <div class=\"b1024:mb-6 mb-4 flex justify-center\">\n                                    <svg width=\"50\" height=\"30\" viewBox=\"0 0 30 13\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M10.1112 0C10.1112 5.75168 5.57492 10.4294 0 10.4294V12.6557C5.60316 12.6557 10.3408 8.76349 11.8042 3.46214V12.6329H13.9649V0H10.11H10.1112Z\" fill=\"#131924\"\/><path d=\"M19.8559 0H16.001V12.6342H18.1617V3.46214C19.6251 8.76223 24.364 12.6557 29.9659 12.6557V10.4294C24.391 10.4294 19.8547 5.75041 19.8547 0H19.8559Z\" fill=\"#131924\"\/><\/svg>\n                                <\/div>\n                                                                    <div class=\"h3 b1024:text-[40px] text-2xl\">\n                                        AI Transformation                                    <\/div>\n                                                                                                    <div class=\"b1024:mt-6 mt-4 mx-auto max-w-[380px] text-xs b767:text-base font-medium\">\n                                        <p>For large organisations with evolving needs, we embed our AI engineers directly into your team to deliver continuous progress and long-term capability.<\/p>\n                                    <\/div>\n                                                                <div class=\"flex justify-center mt-6\">\n                                                                            <a class=\"btn small-btn btn-solidcolor3 flex justify-center items-center gap-2 overflow-hidden\" href=\"https:\/\/aiadvancements.com.au\/ai-transformation\/\" target=\"_self\">\n                                            <span class=\"block circle relative\"><\/span>\n                                            <div class=\"button-text z-10\">Learn more<\/div>\n                                        <\/a>\n                                                                    <\/div>\n                            <\/div>\n                        <\/div>\n                                    <\/div>\n                    <\/div>\n      <\/div>\n  <\/section>\n  <!-- BLOCK CODING STARTS HERE -->\n\n  \n\n  <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\n    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\n\n  <!-- BLOCK CODING STARTS HERE -->\n  <section \n      id=\"\" \n      data-name=\"acf_img-with-text\"\n      data-lazyload=\"1\" \n      class=\"relative \" \n      style=\"z-index: 0;\">\n      <div class=\"img-with-text-area relative b767:py-100 py-80\">\n        <div class=\"container relative\">\n            <div class=\"iwt-content-wrap grid grid-cols-1 b1024:grid-cols-2 items-center b1400:px-80\">\n                <div class=\"iwt-content b1024:pr-40 b1200:pr-80 b1400:pr-[100px] text-center b1024:text-start mb-14 b1024:mb-0\">\n                                            <div class=\"hero-heading\">\n                                <h2 class=\"h2 animate-watch standard__headline block mb-6 b767:mb-10\">Let\u2019s talk about the advantage AI can <br>give you<\/h2>\n                            <\/div>\n                                                                <div class=\"hero-summary b1024:max-w-[438px] my-10 b1024:my-16\">\n                            <p>Working with a Perth team gives you direct access to the experts engineering your AI. We meet with you in person to uncover your strongest opportunities and develop the custom AI advantage your business is ready for.<\/p>\n                        <\/div>\n                                        <div class=\"button-wrap flex flex-col b767:flex-row items-center justify-center b1024:justify-start gap-3 overflow-hidden\">\n                                    <a href=\"https:\/\/aiadvancements.com.au\/contact\/\" target=\"\" class=\"btn btn-solidcolor1 speak-btn flex items-center gap-3 overflow-hidden\">\n                <span class=\"block circle relative\"><\/span>\n                <span class=\"button-text z-10\">Speak to our team<\/span>\n            <\/a>\n                                                <a href=\"#services\" target=\"\" class=\"btn outline-color1 text-center overflow-hidden relative z-10\">\n                Explore our services            <\/a>\n                                <\/div>\n                <\/div>\n                <div class=\"iwt-img relative\">\n                                                                                    <div class=\"overlay-border-color2\"><\/div>\n                        <div class=\"ai-text-three text-xs bg-color2 leading-none pt-[5px] pb-[6px] px-[9px] rounded-3xl\">&lt;ai.advancements&gt;<\/div>\n                                                                <picture class=\"w-full h-full\"><source media=\"(min-width: 481px)\" srcset=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/09\/AIA_280125_0818-scaled.jpg\"><img decoding=\"async\" class=\"w-full h-full\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/09\/AIA_280125_0818-scaled.jpg\" alt=\"\" style=\"object-fit:contain;object-position:center;\" loading=\"lazy\" width=\"1707\" height=\"2560\" \/><\/picture>                                    <\/div>\n            <\/div>\n        <\/div>\n      <\/div>\n  <\/section>\n  <!-- BLOCK CODING STARTS HERE -->\n\n  ","protected":false},"excerpt":{"rendered":"","protected":false},"author":5,"featured_media":0,"parent":0,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"","meta":{"_acf_changed":false,"footnotes":""},"class_list":["post-267","page","type-page","status-publish","hentry"],"acf":[],"_links":{"self":[{"href":"https:\/\/aiadvancements.com.au\/wp-json\/wp\/v2\/pages\/267","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/aiadvancements.com.au\/wp-json\/wp\/v2\/pages"}],"about":[{"href":"https:\/\/aiadvancements.com.au\/wp-json\/wp\/v2\/types\/page"}],"author":[{"embeddable":true,"href":"https:\/\/aiadvancements.com.au\/wp-json\/wp\/v2\/users\/5"}],"replies":[{"embeddable":true,"href":"https:\/\/aiadvancements.com.au\/wp-json\/wp\/v2\/comments?post=267"}],"version-history":[{"count":67,"href":"https:\/\/aiadvancements.com.au\/wp-json\/wp\/v2\/pages\/267\/revisions"}],"predecessor-version":[{"id":2779,"href":"https:\/\/aiadvancements.com.au\/wp-json\/wp\/v2\/pages\/267\/revisions\/2779"}],"wp:attachment":[{"href":"https:\/\/aiadvancements.com.au\/wp-json\/wp\/v2\/media?parent=267"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}