{"id":7,"date":"2025-12-25T10:10:25","date_gmt":"2025-12-25T10:10:25","guid":{"rendered":"https:\/\/aiadvancements.dilatevps1.cloudsites.net.au\/?page_id=7"},"modified":"2026-09-29T11:27:30","modified_gmt":"2026-09-29T03:27:30","slug":"home","status":"publish","type":"page","link":"https:\/\/aiadvancements.com.au\/","title":{"rendered":"Home"},"content":{"rendered":"  <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n  <section \r\n      id=\"\" \r\n      data-name=\"acf_main-banner\"\r\n      data-lazyload=\"1\" \r\n      class=\"relative wp-custom-css-002fef0f has-custom-css\" \r\n      style=\"z-index: 0;\">\r\n      <div class=\"main-banner relative text-color4 pb-16 b1400:pt-[400px] b767:pt-[300px] pt-[200px]\">\r\n        <div class=\"hero-bg\">\r\n                      <video autoplay muted loop playsinline width=\"100%\">\r\n                <source src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/landing_page_video-1080p-2.mp4\" type=\"video\/mp4\">\r\n            <\/video>\r\n                  <\/div>\r\n\r\n        <div class=\"container relative\">\r\n                      <div class=\"hero-subheading \\hero-animation\">\r\n                      <h1 class=\"h2 animate-watch standard__headline block mb-7 b767:mb-[49px] text-[10px] uppercase font-semibold !leading-[150%] tracking-[15%]\" style=\"height: 30px; overflow: hidden;\">Perth AI Agency Built for Real-World Delivery<\/h1>\n                <\/div>\r\n                                <div class=\"hero-heading \\hero-animation\">\r\n                      <h2 class=\"h1 animate-watch standard__headline font-normal block mb-6 b767:mb-10 b767:-tracking-[6px]\">AI that works<br \/>\r\nwhere your business<br \/>\r\nneeds it<\/h2>\n                <\/div>\r\n                    <div class=\"hero-bottom-content \\hero-animation flex flex-col b1024:flex-row b1024:items-end justify-between gap-10 b1024:gap-5\">\r\n              <div class=\"flex flex-col-reverse b767:flex-row b767:items-end gap-6 b1200:gap-10 b1400:gap-24\">\r\n                <div class=\"hero-btn relative\">\r\n                                        <a class=\"btn btn-solidcolor2 text-[20px] flex items-center gap-3 overflow-hidden\" href=\"#contact-form-popup\" target=\"_self\">\r\n                        <span class=\"circle-2\"><\/span>\r\n                        <div class=\"button-text\">Speak to a human<\/div>\r\n                        <div class=\"color-bg\"><\/div>\r\n                      <\/a>\r\n                                  <\/div>\r\n                                  <div class=\"hero-summary max-w-[370px] text-sm\">\r\n                    <p><span class=\"styles-module__ypzdS\">We\u2019re a Perth-based AI agency that helps you make sense of what\u2019s possible and where AI delivers the most value. We focus on measurable outcomes so your team gains efficiency, accuracy, and a genuine competitive edge.<\/span><\/p>\n                  <\/div>\r\n                              <\/div>\r\n                                <a class=\"page-link flex items-center justify-end gap-2 w-full max-w-full b1024:max-w-[30%] b1200:max-w-[40%] b1400:max-w-[578px] pb-8 b767:pb-12 relative\" href=\"#services\" target=\"_self\">\r\n                    Explore our AI Services                    <svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M1.30763 -1.01827e-05L1.32964 2.18405L10.0659 2.27209L3.62532e-05 12.3379L1.5758 13.9137L11.6416 3.84785L11.7297 12.5841L13.9137 12.6061L13.788 0.125759L1.30763 -1.01827e-05Z\" fill=\"#FCFF6A\"\/><\/svg>\r\n                  <\/a>\r\n                        <\/div>\r\n          \r\n\r\n        <\/div>\r\n      <\/div>\r\n  <\/section>\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n\r\n  \n\n  <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\n    <!-- GUTENBERG EDI