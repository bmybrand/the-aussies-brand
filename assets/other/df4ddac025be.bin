n        @media (min-width: 767px) {\r\n            [data-name=\"acf_case-study\"] .portfolio-page-thumbnail {\r\n                height: 30.3vw;\r\n            }\r\n        }\r\n        @media (min-width: 1024px) {\r\n            [data-name=\"acf_case-study\"] .portfolio-page-thumbnail {\r\n                height: 30.3vw;\r\n            }\r\n        }\r\n        @media (min-width: 1400px) {\r\n            [data-name=\"acf_case-study\"] .portfolio-page-thumbnail {\r\n                height: 446px;\r\n            }\r\n        }\r\n      <\/style>\r\n  <\/section>\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n\r\n  \n\n  <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n  <section \r\n      id=\"\" \r\n      data-name=\"acf_testimonials\"\r\n      data-lazyload=\"1\" \r\n      class=\"relative \" \r\n      style=\"z-index: 0;\">\r\n        <div class=\"testimonials-area b1024:py-[120px] py-80 bg-color3\">\r\n            <div class=\"container\">\r\n                                    <div class=\"subheading-wrap text-center\">\r\n                                <h2 class=\" animate-watch standard__headline inline-flex font-semibold text-color1 bg-color2 py-2 px-6 rounded-3xl text-xs mx-auto b767:mx-0 b767:mb-16 mb-10\">What our clients are saying<\/h2>\n                        <\/div>\r\n                                <div class=\"grid grid-cols-1 b767:grid-cols-2 gap-6 b1024:mb-[90px] mb-[70px] text-center b767:text-start max-w-[1130px] mx-auto\">\r\n                                            <div class=\"heading-wrap w-full b767:w-auto\">\r\n                                    <h3 class=\"h2 animate-watch standard__headline block\">Why WA teams <br>are working with us<\/h3>\n                            <\/div>\r\n                                                                <div class=\"summary-wrap text-center b767:text-start b1024:pl-[60px] b1400:pl-[116px]\">\r\n                            <p>WA organisations choose our AI integration agency for our local expertise, direct access to senior engineers, and our ability to deliver practical results quickly. Here are what some of our partners are saying:<\/p>\n                        <\/div>\r\n                                    <\/div>\r\n            \r\n\r\n\r\n                \r\n                \r\n                <!-- SLIDER -->\r\n                <div class=\"testimonials-wrap pl-10 b767:pl-6 b1400:pl-0\">\r\n                    <div class=\"testimonials_slider splide overflow-visible\">\r\n                        <div class=\"splide__track overflow-visible\">\r\n                            <div class=\"splide__list flex\">\r\n\r\n                                \r\n                                <div class=\"splide__slide testimonial-box overflow-hidden bg-color5 rounded-[20px] b767:p-9 p-7 flex flex-col justify-between transition-transform duration-500 ease-out origin-bottom hover:scale-y-[1.05]\">\r\n\r\n                                    <div class=\"flex\">\r\n                                        <span class=\"box-number testimonial-box-number flex text-[10px] font-bold transition-all duration-700 h-[32px] w-[32px] rounded-full bg-color2 justify-center items-center\">\r\n                                            01                                        <\/span>\r\n                                                                                <div class=\"inline-flex z-10 font-semibold text-color4 bg-black py-2 px-6 rounded-3xl text-xs\">\r\n                                            Spacecubed                                        <\/div>\r\n                                                                            <\/div>\r\n\r\n                                                                            <div class=\"b1600:py-[86px] z-10 b1024:py-60 py-40 b1600:px-60 b1400:px-40 font-medium leading-[150%] b767:text-[21px]\">\r\n                                            <p>&#8220;I have used Sam and Sean&#8217;s services multiple times for AI related software integrations. I have found them to be extremely capable, great communicators and deliver exceptional results. I would highly recommend them!&#8221;<\/p>\n                                        <\/div>\r\n                                    \r\n                                    <div class=\"z-10 flex justify-between items-end\">\r\n                                        <div>\r\n                                            <div class=\"font-bold leading-none\">Nate Sturcke<\/div>\r\n                                                                                    <\/div>\r\n                                                                                    <div class=\"\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/03\/3063c72fbc67d2422697c3a25ca7d92e3e365246.jpg\" \r\n                                                    alt=\"Spacecubed co-working space small logo thumbnail with colorful geometric pinwheel icon and company name\" \r\n                                                    class=\"h-[60px] w-auto rounded-[10px]\">\r\n                                            <\/div>\r\n                                                                            <\/div>\r\n\r\n                                <\/div>\r\n\r\n                                \r\n                                <div class=\"splide__slide testimonial-box overflow-hidden bg-color5 rounded-[20px] b767:p-9 p-7 flex flex-col justify-between transition-transform duration-500 ease-out origin-bottom hover:scale-y-[1.05]\">\r\n\r\n                                    <div class=\"flex\">\r\n                                        <span class=\"box-number testimonial-box-number flex text-[10px] font-bold transition-all duration-700 h-[32px] w-[32px] rounded-full bg-color2 justify-center items-center\">\r\n                                            02                                        <\/span>\r\n                                                                                <div class=\"inline-flex z-10 font-semibold text-color4 bg-black py-2 px-6 rounded-3xl text-xs\">\r\n                                            Fortescue                                        <\/div>\r\n                                                                            <\/div>\r\n\r\n                                                                            <div class=\"b1600:py-[86px] z-10 b1024:py-60 py-40 b1600:px-60 b1400:px-40 font-medium leading-[150%] b767:text-[21px]\">\r\n                                            <p>&#8220;Great experience working with AIA. Speed, execution and results!&#8221;<\/p>\n                                        <\/div>\r\n                                    \r\n                                    <div class=\"z-10 flex justify-between items-end\">\r\n                                        <div>\r\n                                            <div class=\"font-bold leading-none\">Dieter K. Haage<\/div>\r\n                                                                                    <\/div>\r\n                                                                                    <div class=\"\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/03\/49ff6bad96428f8f3ff88d4f9185fb66d85724ab.jpg\" \r\n                                                    alt=\"Fortescue mining company logo - green circular icon with Fortescue company name text\" \r\n                                                    class=\"h-[60px] w-auto rounded-[10px]\">\r\n                                            <\/div>\r\n                                                                            <\/div>\r\n\r\n                                <\/div>\r\n\r\n                                \r\n                                <div class=\"splide__slide testimonial-box overflow-hidden bg-color5 rounded-[20px] b767:p-9 p-7 flex flex-col justify-between transition-transform duration-500 ease-out origin-bottom hover:scale-y-[1.05]\">\r\n\r\n                                    <div class=\"flex\">\r\n                                        <span class=\"box-number testimonial-box-number flex text-[10px] font-bold transition-all duration-700 h-[32px] w-[32px] rounded-full bg-color2 justify-center items-center\">\r\n                                            03                                        <\/span>\r\n                                                                                <div class=\"inline-flex z-10 font-semibold text-color4 bg-black py-2 px-6 rounded-3xl text-xs\">\r\n                                            Coursebox                                        <\/div>\r\n                                                                            <\/div>\r\n\r\n                                                                            <div class=\"b1600:py-[86px] z-10 b1024:py-60 py-40 b1600:px-60 b1400:px-40 font-medium leading-[150%] b767:text-[21px]\">\r\n                                            <p>\u201cSam and Sean are super talented developers! Been a pleasure having them as part of our team to take our product to the next level\u201d<\/p>\n                                        <\/div>\r\n                                    \r\n                                    <div class=\"z-10 flex justify-between items-end\">\r\n                                        <div>\r\n                                            <div class=\"font-bold leading-none\">Alex Hey<\/div>\r\n                                                                                    <\/div>\r\n                                                                                    <div class=\"\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/coursebox-ai-1.jpg\" \r\n                                                    alt=\"Coursebox AI logo - purple 3D box cube icon with Coursebox company name text\" \r\n                                                    class=\"h-[60px] w-auto rounded-[10px]\">\r\n                                            <\/div>\r\n                                                                            <\/div>\r\n\r\n                                <\/div>\r\n\r\n                                \r\n                            <\/div>\r\n                        <\/div>\r\n                    <\/div>\r\n\r\n                    <div class=\"splide__arrows testimonals-nav flex justify-start gap-2 mt-4\">\r\n                          <button class=\"splide__arrow splide__arrow--prev w-[43px] h-[43px] group flex justify-center items-center rounded-[6px] bg-color1 hover:bg-color2 overflow-hidden transition duration-500 ease-in cursor-pointer hover:color1\" aria-label=\"go to previous slide\">\n    <span class=\"icon\">\n      <svg width=\"8\" height=\"9\" viewBox=\"0 0 8 9\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M0.5 3.16669C-0.166666 3.55159 -0.166667 4.51384 0.5 4.89874L5.75 7.92983C6.41667 8.31473 7.25 7.8336 7.25 7.0638L7.25 1.00163C7.25 0.231826 6.41667 -0.2493 5.75 0.135601L0.5 3.16669Z\" fill=\"#C2CEE8\"\/>\n      <\/svg>\n    <\/span>\n  <\/button>\n\n  <button class=\"splide__arrow splide__arrow--next w-[43px] h-[43px] group flex justify-center items-center rounded-[6px] bg-color1 hover:bg-color2 overflow-hidden transition duration-500 ease-in cursor-pointer hover:color1\" aria-label=\"go to next slide\">\n    <span class=\"icon\">\n      <svg width=\"8\" height=\"9\" viewBox=\"0 0 8 9\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M6.75 3.16669C7.41667 3.55159 7.41667 4.51384 6.75 4.89874L1.5 7.92983C0.833334 8.31473 5.4712e-07 7.8336 5.80769e-07 7.0638L8.45755e-07 1.00163C8.79404e-07 0.231826 0.833334 -0.2493 1.5 0.135601L6.75 3.16669Z\" fill=\"#C2CEE8\"\/><\/svg>\n    <\/span>\n  <\/button>\n                      <\/div>\r\n                <\/div>\r\n\r\n                            <\/div>\r\n        <\/div>\r\n\r\n  <\/section>\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n\r\n  \n\n  <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\n    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\n\n  <!-- BLOCK CODING STARTS HERE -->\n  <section \n      id=\"\" \n      data-name=\"acf_img-with-text\"\n      data-lazyload=\"1\" \n      class=\"relative \" \n      style=\"z-index: 0;\">\n      <div class=\"img-with-text-area relative b767:py-100 py-80\">\n        <div class=\"container relative\">\n            <div class=\"iwt-content-wrap grid grid-cols-1 b1024:grid-cols-2 items-center b1400:px-80\">\n                <div class=\"iwt-content b1024:pr-40 b1200:pr-80 b1400:pr-[100px] text-center b1024:text-start mb-14 b1024:mb-0\">\n                                            <div class=\"hero-heading\">\n                                <h2 class=\"h2 animate-watch standard__headline block mb-6 b767:mb-10\">Talk to real people <br>about what AI <br>could do for you<\/h2>\n                            <\/div>\n                                                                <div class=\"hero-summary b1024:max-w-[438px] my-10 b1024:my-16\">\n                            <p>We keep the AI adoption process simple, practical, and human, helping you understand what\u2019s possible and what will actually deliver value for your team.<\/p>\n<p>Don\u2019t know where to start, or have a rough idea that needs clearer direction? Our Perth-based AI consulting team helps you understand what\u2019s possible, turn it into an actionable plan, and choose the right path for your organisation.<\/p>\n<p>We can deliver the work as a defined project or provide long-term support \u2014 whichever approach suits your needs. Talk to us today.<\/p>\n                        <\/div>\n                                        <div class=\"button-wrap flex flex-col b767:flex-row items-center justify-center b1024:justify-start gap-3 overflow-hidden\">\n                                    <a href=\"#contact-form-popup\" target=\"\" class=\"btn btn-solidcolor1 speak-btn flex items-center gap-3 overflow-hidden\">\n                <span class=\"block circle relative\"><\/span>\n                <span class=\"button-text z-10\">Speak to us<\/span>\n            <\/a>\n                                                <a href=\"#services\" target=\"\" class=\"btn outline-color1 text-center overflow-hidden relative z-10\">\n                See our services            <\/a>\n                                <\/div>\n                <\/div>\n                <div class=\"iwt-img relative\">\n                                                                                                        <picture class=\"w-full h-full\"><source media=\"(min-width: 481px)\" srcset=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/09\/AIA_280125_1959-scaled.jpg\"><img decoding=\"async\" class=\"w-full h-full\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/09\/AIA_280125_1959-scaled.jpg\" alt=\"\" style=\"object-fit:contain;object-position:center;\" loading=\"lazy\" width=\"1707\" height=\"2560\" \/><\/picture>                                    <\/div>\n            <\/div>\n        <\/div>\n      <\/div>\n  <\/section>\n  <!-- BLOCK CODING STARTS HERE -->\n\n  ","protected":false},"excerpt":{"rendered":"","protected":false},"author":5,"featured_media":1086,"parent":0,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"","meta":{"_acf_changed":false,"footnotes":""},"class_list":["post-7","page","type-page","status-publish","has-post-thumbnail","hentry"],"acf":[],"_links":{"self":[{"href":"https:\/\/aiadvancements.com.au\/wp-json\/wp\/v2\/pages\/7","target