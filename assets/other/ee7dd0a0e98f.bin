{"id":1090,"date":"2026-03-31T13:36:33","date_gmt":"2026-03-31T13:36:33","guid":{"rendered":"https:\/\/aiadvancements.dilatevps1.cloudsites.net.au\/?page_id=1090"},"modified":"2026-09-29T16:13:43","modified_gmt":"2026-09-29T08:13:43","slug":"case-studies","status":"publish","type":"page","link":"https:\/\/aiadvancements.com.au\/case-studies\/","title":{"rendered":"Case studies"},"content":{"rendered":"    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\n        <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\n\n    <!-- BLOCK CODING STARTS HERE -->\n    <section \n        id=\"\" \n        data-name=\"acf_internal-hero\"\n        data-lazyload=\"1\" \n        class=\"relative \" \n        style=\"z-index: 0; background-color:#FFFFFF;\">\n        <div class=\"bg-color5 b1200:pt-200 b767:pt-180 pt-150\">\n            <div class=\"container\">\n                <div class=\"internal-hero-details max-w-[912px] mx-auto b1024:pb-24 b767:pb-20 pb-12\">\n\t\t\t\t\t                    <div class=\"text-center flex items-center mb-[44px]\">\n                        <div class=\"h-[32px] w-[32px] rounded-full bg-color2 flex items-center justify-center\">\n                            <svg width=\"19\" height=\"8\" viewBox=\"0 0 30 13\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M10.1112 0C10.1112 5.75168 5.57492 10.4294 0 10.4294V12.6557C5.60316 12.6557 10.3408 8.76349 11.8042 3.46214V12.6329H13.9649V0H10.11H10.1112Z\" fill=\"#131924\"\/><path d=\"M19.8559 0H16.001V12.6342H18.1617V3.46214C19.6251 8.76223 24.364 12.6557 29.9659 12.6557V10.4294C24.391 10.4294 19.8547 5.75041 19.8547 0H19.8559Z\" fill=\"#131924\"\/><\/svg>\n                        <\/div>\n\t\t\t\t\t\t        <h1 class=\" animate-watch standard__headline inline-flex font-semibold text-color1 bg-color4 py-[11px] px-6 rounded-3xl text-xs super-title\">AI Case Studies: Real Results for Perth &#038; Australian Organisations<\/h1>\n                        <\/div>\n\t\t\t\t\t\n                    \n                    \n                        <!-- HEADLINE + BELOW HEADLINE -->\n                        <div>\n                                    <h2 class=\"h1 animate-watch standard__headline block tracking-[-0.06em]\">Case studies<\/h2>\n                                        <h3 class=\"h3 animate-watch standard__headline block text-color1 b767:mb-10 b767:mt-10 mt-8\">Here you will find real-world AI implementation examples from projects we\u2019ve delivered.<br \/>\r\n<br \/>\r\nThese case studies share why the work started, how the systems were designed, and how teams are using them today.<\/h3>\n    \n                            <div class=\"button-wrap inline-flex flex-col b767:flex-row gap-3 mt-[30px]\">\n                                                                                            <\/div>\n                        <\/div>\n\n                                    <\/div>\n            <\/div>\n            \n                    <\/div>\n    <\/section>\n    <!-- BLOCK CODING STARTS HERE -->\n\n    \n\n  <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\n    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\n\n  <!-- BLOCK CODING STARTS HERE -->\n  <section \n      id=\"\" \n      data-name=\"acf_all-case-studies\"\n      data-lazyload=\"1\" \n      class=\"relative \" \n      style=\"z-index: 0;\">\n      <div class=\"py-80\">\n        <div class=\"container\">\n            <div class=\"flex flex-col b1024:flex-row items-center justify-between b1200:gap-10 b1024:gap-8 gap-10 b767:mb-[70px] mb-10\">\n\n                <!-- FILTER -->\n                <div class=\"case-study-filter text-center flex b1200:gap-8 gap-4\">\n                    <div class=\"font-semibold\">Filter<\/div>\n                    <form method=\"GET\" action=\"\" class=\"b1400:w-[359px] b1200:w-[250px] b600:w-[200px] w-[250px]\">\n                        <!-- preserves active button filter across industry reloads -->\n                        <input type=\"hidden\" name=\"case_filter\" id=\"case-filter-hidden\" value=\"\">\n                        <select name=\"industry\" onchange=\"this.form.submit()\" class=\"border-b border-color1 bg-transparent w-full pb-[11px]\">\n                            <option value=\"\">-Select Industry &#8211;<\/option>\n\n                            <option value=\"commercial\" >Commercial<\/option><option value=\"conservation\" >Conservation<\/option><option value=\"construction\" >Construction<\/option><option value=\"education\" >Education<\/option><option value=\"energy\" >Energy<\/option><option value=\"finance\" >Finance<\/option><option value=\"government\" >Government<\/option><option value=\"health\" >Health<\/option><option value=\"legal\" >Legal<\/option><option value=\"local-government\" >Local government<\/option><option value=\"marketing\" >Marketing<\/option><option value=\"mining\" >Mining<\/option><option value=\"not-for-profit\" >Not-for-profit<\/option><option value=\"sport\" >Sport<\/option>                        <\/select>\n                    <\/form>\n                <\/div>\n\n                <!-- BUTTON LINKS -->\n                                <div class=\"flex flex-wrap b1024:flex-nowrap b1200:gap-3 gap-2 justify-center\">\n                                        <button type=\"button\" class=\"multicolumn-tab control case-pages font-semibold text-color1 bg-color4 py-2 px-4 rounded-3xl text-xs text-center hover:bg-color2 transition b1200:min-w-[134px] min-w-[130px]\" data-filter=\"all\">All<\/button>\n                                        <button type=\"button\" class=\"multicolumn-tab control case-pages font-semibold text-color1 bg-color4 py-2 px-4 rounded-3xl text-xs text-center hover:bg-color2 transition b1200:min-w-[134px] min-w-[130px]\" data-filter=\".ai-training\">AI Training<\/button>\n                                        <button type=\"button\" class=\"multicolumn-tab control case-pages font-semibold text-color1 bg-color4 py-2 px-4 rounded-3xl text-xs text-center hover:bg-color2 transition b1200:min-w-[134px] min-w-[130px]\" data-filter=\".ai-strategy\">AI Strategy<\/button>\n                                        <button type=\"button\" class=\"multicolumn-tab control case-pages font-semibold text-color1 bg-color4 py-2 px-4 rounded-3xl text-xs text-center hover:bg-color2 transition b1200:min-w-[134px] min-w-[130px]\" data-filter=\".ai-development\">AI Development<\/button>\n                                        <button type=\"button\" class=\"multicolumn-tab control case-pages font-semibold text-color1 bg-color4 py-2 px-4 rounded-3xl text-xs text-center hover:bg-color2 transition b1200:min-w-[134px] min-w-[130px]\" data-filter=\".ai-transformation\">AI Transformation<\/button>\n                                    <\/div>\n            <\/div>\n\n\t\t\t<div id=\"case-results\">\n            \n\n            <div class=\"grid grid-cols-1 b767:grid-cols-2 b1024:grid-cols-3 gap-x-6 gap-y-16\">\n\n                            \n                    \n                    <div class=\"case-study-box ai-development legal relative group flex flex-col justify-between cursor-pointer\">\n                        <div>\n\t\t\t\t\t\t\t<div class=\"portfolio-page-thumbnail mb-6 overflow-hidden rounded-[16px] relative\">\n\t\t\t\t\t\t\t\t<img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"576\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/sale-of-land-1024x576.avif\" class=\"w-full aspect-[1\/0.65] transition-transform duration-1000 ease-in-out group-hover:scale-[1.2] wp-post-image\" alt=\"\" srcset=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/sale-of-land-1024x576.avif 1024w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/sale-of-land-300x169.avif 300w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/sale-of-land-768x432.avif 768w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/sale-of-land.avif 1280w\" sizes=\"auto, (max-width: 1024px) 100vw, 1024px\" \/>\t\t\t\t\t\t\t<\/div>\n\n\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t<div class=\"meta-cat flex gap-2 mb-4\">\n\t\t\t\t\t\t\t\t\t<span class=\"inline-flex font-semibold text-color1 bg-color4 py-[6px] px-3 rounded-3xl text-xs\">AI Development<\/span><span class=\"inline-flex font-semibold text-color1 bg-color4 py-[6px] px-3 rounded-3xl text-xs\">Legal<\/span>\t\t\t\t\t\t\t\t<\/div>\n\n\t\t\t\t\t\t\t\t<h3 class=\"font-medium normal-case\">SettleIQ: Extending an AI Conveyancing Chatbot to Automatically Review Sale-of-Land Contracts<\/h3>\n\n\t\t\t\t\t\t\t\t<div class=\"post-date flex gap-3 text-xs font-normal\">\n\t\t\t\t\t\t\t\t\t<span>21 Aug 2026<\/span> |\n\t\t\t\t\t\t\t\t\t<span>\n\t\t\t\t\t\t\t\t\t\t5 min read\t\t\t\t\t\t\t\t\t<\/span>\n\t\t\t\t\t\t\t\t<\/div>\n\n\t\t\t\t\t\t\t\t<div class=\"mt-4 mb-6\">\n\t\t\t\t\t\t\t\t\t<p>Extending an existing AI conveyancing chatbot so conveyancers can automatically review sale-of-land contracts for buyers and sellers.<\/p>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\t<\/div>\n                        <div>\n                            <a href=\"https:\/\/aiadvancements.com.au\/case-study\/settleiq-extending-an-ai-conveyancing-chatbot-to-automatically-review-sale-of-land-contracts\/\" class=\"case-link btn btn-solidcolor1 inline-flex items-center gap-2 overflow-hidden min-w-0\">\n                                <span class=\"circle relative\"><\/span>\n                                <span class=\"button-text z-10\">Read more<\/span>\n                            <\/a>\n                        <\/div>\n                    <\/div>\n\n                \n                    \n                    <div class=\"case-study-box ai-transformation mining relative group flex flex-col justify-between cursor-pointer\">\n                        <div>\n\t\t\t\t\t\t\t<div class=\"portfolio-page-thumbnail mb-6 overflow-hidden rounded-[16px] relative\">\n\t\t\t\t\t\t\t\t<img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"756\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/07\/fortescue.png\" class=\"w-full aspect-[1\/0.65] transition-transform duration-1000 ease-in-out group-hover:scale-[1.2] wp-post-image\" alt=\"\" srcset=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/07\/fortescue.png 1024w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/07\/fortescue-300x221.png 300w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/07\/fortescue-768x567.png 768w\" sizes=\"auto, (max-width: 1024px) 100vw, 1024px\" \/>\t\t\t\t\t\t\t<\/div>\n\n\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t<div class=\"meta-cat flex gap-2 mb-4\">\n\t\t\t\t\t\t\t\t\t<span class=\"inline-flex font-semibold text-color1 bg-color4 py-[6px] px-3 rounded-3xl text-xs\">AI Transformation<\/span><span class=\"inline-flex font-semibold text-color1 bg-color4 py-[6px] px-3 rounded-3xl text-xs\">Mining<\/span>\t\t\t\t\t\t\t\t<\/div>\n\n\t\t\t\t\t\t\t\t<h3 class=\"font-medium normal-case\">Fortescue: Scaling AI Across Autonomous Mining Operations &#8211; From Pilot to Production<\/h3>\n\n\t\t\t\t\t\t\t\t<div class=\"post-date flex gap-3 text-xs font-normal\">\n\t\t\t\t\t\t\t\t\t<span>3 Jul 2026<\/span> |\n\t\t\t\t\t\t\t\t\t<span>\n\t\t\t\t\t\t\t\t\t\t5 min read\t\t\t\t\t\t\t\t\t<\/span>\n\t\t\t\t\t\t\t\t<\/div>\n\n\t\t\t\t\t\t\t\t<div class=\"mt-4 mb-6\">\n\t\t\t\t\t\t\t\t\t<p>An embedded AI partnership with Fortescue&#8217;s fleet control team is saving three hours a day on one automation alone, with near-zero error rate.<\/p>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\t<\/div>\n                        <div>\n                            <a href=\"https:\/\/aiadvancements.com.au\/case-study\/fortescue-scaling-ai-across-autonomous-mining-operations-from-pilot-to-production\/\" class=\"case-link btn btn-solidcolor1 inline-flex items-center gap-2 overflow-hidden min-w-0\">\n                                <span class=\"circle relative\"><\/span>\n                                <span class=\"button-text z-10\">Read more<\/span>\n                            <\/a>\n                        <\/div>\n                    <\/div>\n\n                \n                    \n                    <div class=\"case-study-box ai-development energy relative group flex flex-col justify-between cursor-pointer\">\n                        <div>\n\t\t\t\t\t\t\t<div class=\"portfolio-page-thumbnail mb-6 overflow-hidden rounded-[16px] relative\">\n\t\t\t\t\t\t\t\t<img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"683\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/amplitude-1024x683.jpg\" class=\"w-full aspect-[1\/0.65] transition-transform duration-1000 ease-in-out group-hover:scale-[1.2] wp-post-image\" alt=\"\" srcset=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/amplitude-1024x683.jpg 1024w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/amplitude-300x200.jpg 300w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/amplitude-768x512.jpg 768w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/amplitude-1536x1024.jpg 1536w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/amplitude-2048x1365.jpg 2048w\" sizes=\"auto, (max-width: 1024px) 100vw, 1024px\" \/>\t\t\t\t\t\t\t<\/div>\n\n\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t<div class=\"meta-cat flex gap-2 mb-4\">\n\t\t\t\t\t\t\t\t\t<span class=\"inline-flex font-semibold text-color1 bg-color4 py-[6px] px-3 rounded-3xl text-xs\">AI Development<\/span><span class=\"inline-flex font-semibold text-color1 bg-color4 py-[6px] px-3 rounded-3xl text-xs\">Energy<\/span>\t\t\t\t\t\t\t\t<\/div>\n\n\t\t\t\t\t\t\t\t<h3 class=\"font-medium normal-case\">Amplitude Energy: Giving the Finance Team a Week Back Every Month on Balance Sheet Reconciliation<\/h3>\n\n\t\t\t\t\t\t\t\t<div class=\"post-date flex gap-3 text-xs font-normal\">\n\t\t\t\t\t\t\t\t\t<span>24 Jun 2026<\/span> |\n\t\t\t\t\t\t\t\t\t<span>\n\t\t\t\t\t\t\t\t\t\t5 min read\t\t\t\t\t\t\t\t\t<\/span>\n\t\t\t\t\t\t\t\t<\/div>\n\n\t\t\t\t\t\t\t\t<div class=\"mt-4 mb-6\">\n\t\t\t\t\t\t\t\t\t<p>How an AI agent gives Amplitude Energy&#8217;s finance team a week back every month on balance sheet reconciliation \u2014 without touching sign-off controls.<\/p>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\t<\/div>\n                        <div>\n                            <a href=\"https:\/\/aiadvancements.com.au\/case-study\/amplitude-energy-giving-the-finance-team-a-week-back-every-month-on-balance-sheet-reconciliation\/\" class=\"case-link btn btn-solidcolor1 inline-flex items-center gap-2 overflow-hidden min-w-0\">\n                                <span class=\"circle relative\"><\/span>\n                                <span class=\"button-text z-10\">Read more<\/span>\n                            <\/a>\n                        <\/div>\n                    <\/div>\n\n                \n                    \n                    <div class=\"case-study-box ai-transformation construction relative group flex flex-col justify-between cursor-pointer\">\n                        <div>\n\t\t\t\t\t\t\t<div class=\"portfolio-page-thumbnail mb-6 overflow-hidden rounded-[16px] relative\">\n\t\t\t\t\t\t\t\t<img loading=\"lazy\" decoding=\"async\" width=\"1000\" height=\"750\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/unisol-12.jpg\" class=\"w-full aspect-[1\/0.65] transition-transform duration-1000 ease-in-out group-hover:scale-[1.2] wp-post-image\" alt=\"\" srcset=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/unisol-12.jpg 1000w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/unisol-12-300x225.jpg 300w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/unisol-12-768x576.jpg 768w\" sizes=\"auto, (max-width: 1000px) 100vw, 1000px\" \/>\t\t\t\t\t\t\t<\/div>\n\n\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t<div class=\"meta-cat flex gap-2 mb-4\">\n\t\t\t\t\t\t\t\t\t<span class=\"inline-flex font-semibold text-color1 bg-color4 py-[6px] px-3 rounded-3xl text-xs\">AI Transformation<\/span><span class=\"inline-flex font-semibold text-color1 bg-color4 py-[6px] px-3 rounded-3xl text-xs\">Construction<\/span>\t\t\t\t\t\t\t\t<\/div>\n\n\t\t\t\t\t\t\t\t<h3 class=\"font-medium normal-case\">Unisol Solar &amp; Electrical: Giving a Small Business Owner 1\u20132 Hours a Day Back From Admin<\/h3>\n\n\t\t\t\t\t\t\t\t<div class=\"post-date flex gap-3 text-xs font-normal\">\n\t\t\t\t\t\t\t\t\t<span>18 Jun 2026<\/span> |\n\t\t\t\t\t\t\t\t\t<span>\n\t\t\t\t\t\t\t\t\t\t5 min read\t\t\t\t\t\t\t\t\t<\/span>\n\t\t\t\t\t\t\t\t<\/div>\n\n\t\t\t\t\t\t\t\t<div class=\"mt-4 mb-6\">\n\t\t\t\t\t\t\t\t\t<p>Proof AI transformation isn&#8217;t just an enterprise story \u2014 1 to 2 hours a day back for a small solar and electrical business owner.<\/p>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\t<\/div>\n                        <div>\n                            <a href=\"https:\/\/aiadvancements.com.au\/case-study\/unisol-solar-electrical-giving-a-small-business-owner-1-2-hours-a-day-back-from-admin\/\" class=\"case-link btn btn-solidcolor1 inline-flex items-center gap-2 overflow-hidden min-w-0\">\n                                <span class=\"circle relative\"><\/span>\n                                <span class=\"button-text z-10\">Read more<\/span>\n                            <\/a>\n                        <\/div>\n                    <\/div>\n\n                \n                    \n                    <div class=\"case-study-box ai-training energy relative group flex flex-col justify-between cursor-pointer\">\n                        <div>\n\t\t\t\t\t\t\t<div class=\"portfolio-page-thumbnail mb-6 overflow-hidden rounded-[16px] relative\">\n\t\t\t\t\t\t\t\t<img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"768\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/20260525_115702-1024x768.jpg\" class=\"w-full aspect-[1\/0.65] transition-transform duration-1000 ease-in-out group-hover:scale-[1.2] wp-post-image\" alt=\"\" srcset=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/20260525_115702-1024x768.jpg 1024w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/20260525_115702-300x225.jpg 300w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/20260525_115702-768x576.jpg 768w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/20260525_115702-1536x1152.jpg 1536w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/20260525_115702-2048x1536.jpg 2048w\" sizes=\"auto, (max-width: 1024px) 100vw, 1024px\" \/>\t\t\t\t\t\t\t<\/div>\n\n\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t<div class=\"meta-cat flex gap-2 mb-4\">\n\t\t\t\t\t\t\t\t\t<span class=\"inline-flex font-semibold text-color1 bg-color4 py-[6px] px-3 rounded-3xl text-xs\">AI Training<\/span><span class=\"inline-flex font-semibold text-color1 bg-color4 py-[6px] px-3 rounded-3xl text-xs\">Energy<\/span>\t\t\t\t\t\t\t\t<\/div>\n\n\t\t\t\t\t\t\t\t<h3 class=\"font-medium normal-case\">Chevron: Hands-On Copilot Training Built Around the Instrument Engineering Team&#8217;s Own Work<\/h3>\n\n\t\t\t\t\t\t\t\t<div class=\"post-date flex gap-3 text-xs font-normal\">\n\t\t\t\t\t\t\t\t\t<span>26 May 2026<\/span> |\n\t\t\t\t\t\t\t\t\t<span>\n\t\t\t\t\t\t\t\t\t\t5 min read\t\t\t\t\t\t\t\t\t<\/span>\n\t\t\t\t\t\t\t\t<\/div>\n\n\t\t\t\t\t\t\t\t<div class=\"mt-4 mb-6\">\n\t\t\t\t\t\t\t\t\t<p>Hands-on Copilot training built around Chevron&#8217;s own instrument specs and spreadsheets, not stock examples.<\/p>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\t<\/div>\n                        <div>\n                            <a href=\"https:\/\/aiadvancements.com.au\/case-study\/chevron-hands-on-copilot-training-built-around-the-instrument-engineering-teams-own-work\/\" class=\"case-link btn btn-solidcolor1 inline-flex items-center gap-2 overflow-hidden min-w-0\">\n                                <span class=\"circle relative\"><\/span>\n                                <span class=\"button-text z-10\">Read more<\/span>\n                            <\/a>\n                        <\/div>\n                    <\/div>\n\n                \n                    \n                    <div class=\"case-study-box ai-training mining relative group flex flex-col justify-between cursor-pointer\">\n                        <div>\n\t\t\t\t\t\t\t<div class=\"portfolio-page-thumbnail mb-6 overflow-hidden rounded-[16px] relative\">\n\t\t\t\t\t\t\t\t<img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"768\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/20260514_084026-1024x768.jpg\" class=\"w-full aspect-[1\/0.65] transition-transform duration-1000 ease-in-out group-hover:scale-[1.2] wp-post-image\" alt=\"\" srcset=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/20260514_084026-1024x768.jpg 1024w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/20260514_084026-300x225.jpg 300w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/20260514_084026-768x576.jpg 768w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/20260514_084026-1536x1152.jpg 1536w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/20260514_084026-2048x1536.jpg 2048w\" sizes=\"auto, (max-width: 1024px) 100vw, 1024px\" \/>\t\t\t\t\t\t\t<\/div>\n\n\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t<div class=\"meta-cat flex gap-2 mb-4\">\n\t\t\t\t\t\t\t\t\t<span class=\"inline-flex font-semibold text-color1 bg-color4 py-[6px] px-3 rounded-3xl text-xs\">AI Training<\/span><span class=\"inline-flex font-semibold text-color1 bg-color4 py-[6px] px-3 rounded-3xl text-xs\">Mining<\/span>\t\t\t\t\t\t\t\t<\/div>\n\n\t\t\t\t\t\t\t\t<h3 class=\"font-medium normal-case\">Rio Tinto: A Copilot Workshop Built Around Real Safety Data, Not Generic Demos<\/h3>\n\n\t\t\t\t\t\t\t\t<div class=\"post-date flex gap-3 text-xs font-normal\">\n\t\t\t\t\t\t\t\t\t<span>15 May 2026<\/span> |\n\t\t\t\t\t\t\t\t\t<span>\n\t\t\t\t\t\t\t\t\t\t5 min read\t\t\t\t\t\t\t\t\t<\/span>\n\t\t\t\t\t\t\t\t<\/div>\n\n\t\t\t\t\t\t\t\t<div class=\"mt-4 mb-6\">\n\t\t\t\t\t\t\t\t\t<p>A Copilot workshop built entirely around Rio Tinto&#8217;s own safety data, not generic AI demos.<\/p>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\t<\/div>\n                        <div>\n                            <a href=\"https:\/\/aiadvancements.com.au\/case-study\/rio-tinto-a-copilot-workshop-built-around-real-safety-data-not-generic-demos\/\" class=\"case-link btn btn-solidcolor1 inline-flex items-center gap-2 overflow-hidden min-w-0\">\n                                <span class=\"circle relative\"><\/span>\n                                <span class=\"button-text z-10\">Read more<\/span>\n                            <\/a>\n                        <\/div>\n                    <\/div>\n\n                \n                    \n                    <div class=\"case-study-box ai-training mining relative group flex flex-col justify-between cursor-pointer\">\n                        <div>\n\t\t\t\t\t\t\t<div class=\"portfolio-page-thumbnail mb-6 overflow-hidden rounded-[16px] relative\">\n\t\t\t\t\t\t\t\t<img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"768\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/20260324_120652-1024x768.jpg\" class=\"w-full aspect-[1\/0.65] transition-transform duration-1000 ease-in-out group-hover:scale-[1.2] wp-post-image\" alt=\"\" srcset=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/20260324_120652-1024x768.jpg 1024w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/20260324_120652-300x225.jpg 300w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/20260324_120652-768x576.jpg 768w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/20260324_120652-1536x1152.jpg 1536w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/20260324_120652-2048x1536.jpg 2048w\" sizes=\"auto, (max-width: 1024px) 100vw, 1024px\" \/>\t\t\t\t\t\t\t<\/div>\n\n\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t<div class=\"meta-cat flex gap-2 mb-4\">\n\t\t\t\t\t\t\t\t\t<span class=\"inline-flex font-semibold text-color1 bg-color4 py-[6px] px-3 rounded-3xl text-xs\">AI Training<\/span><span class=\"inline-flex font-semibold text-color1 bg-color4 py-[6px] px-3 rounded-3xl text-xs\">Mining<\/span>\t\t\t\t\t\t\t\t<\/div>\n\n\t\t\t\t\t\t\t\t<h3 class=\"font-medium normal-case\">BHP: An On-Site Copilot Workshop That Turned a Surveying Team Into AI Agent Builders<\/h3>\n\n\t\t\t\t\t\t\t\t<div class=\"post-date flex gap-3 text-xs font-normal\">\n\t\t\t\t\t\t\t\t\t<span>26 Mar 2026<\/span> |\n\t\t\t\t\t\t\t\t\t<span>\n\t\t\t\t\t\t\t\t\t\t5 min read\t\t\t\t\t\t\t\t\t<\/span>\n\t\t\t\t\t\t\t\t<\/div>\n\n\t\t\t\t\t\t\t\t<div class=\"mt-4 mb-6\">\n\t\t\t\t\t\t\t\t\t<p>A two-hour, hands-on Copilot workshop that turned BHP&#8217;s surveying team into people who can build their own AI agents.<\/p>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\t<\/div>\n                        <div>\n                            <a href=\"https:\/\/aiadvancements.com.au\/case-study\/bhp-an-on-site-copilot-workshop-that-turned-a-surveying-team-into-ai-agent-builders\/\" class=\"case-link btn btn-solidcolor1 inline-flex items-center gap-2 overflow-hidden min-w-0\">\n                                <span class=\"circle relative\"><\/span>\n                                <span class=\"button-text z-10\">Read more<\/span>\n                            <\/a>\n                        <\/div>\n                    <\/div>\n\n                \n                    \n                    <div class=\"case-study-box ai-transformation legal relative group flex flex-col justify-between cursor-pointer\">\n                        <div>\n\t\t\t\t\t\t\t<div class=\"portfolio-page-thumbnail mb-6 overflow-hidden rounded-[16px] relative\">\n\t\t\t\t\t\t\t\t<img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"576\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/ChatGPT-Image-Aug-19-2026-04_12_10-PM-1024x576.png\" class=\"w-full aspect-[1\/0.65] transition-transform duration-1000 ease-in-out group-hover:scale-[1.2] wp-post-image\" alt=\"\" srcset=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/ChatGPT-Image-Aug-19-2026-04_12_10-PM-1024x576.png 1024w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/ChatGPT-Image-Aug-19-2026-04_12_10-PM-300x169.png 300w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/ChatGPT-Image-Aug-19-2026-04_12_10-PM-768x432.png 768w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/ChatGPT-Image-Aug-19-2026-04_12_10-PM-1536x864.png 1536w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/ChatGPT-Image-Aug-19-2026-04_12_10-PM.png 1672w\" sizes=\"auto, (max-width: 1024px) 100vw, 1024px\" \/>\t\t\t\t\t\t\t<\/div>\n\n\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t<div class=\"meta-cat flex gap-2 mb-4\">\n\t\t\t\t\t\t\t\t\t<span class=\"inline-flex font-semibold text-color1 bg-color4 py-[6px] px-3 rounded-3xl text-xs\">AI Transformation<\/span><span class=\"inline-flex font-semibold text-color1 bg-color4 py-[6px] px-3 rounded-3xl text-xs\">Legal<\/span>\t\t\t\t\t\t\t\t<\/div>\n\n\t\t\t\t\t\t\t\t<h3 class=\"font-medium normal-case\">3Lines: Teaching Regi to Read Handwritten Notes and Scanned Documents<\/h3>\n\n\t\t\t\t\t\t\t\t<div class=\"post-date flex gap-3 text-xs font-normal\">\n\t\t\t\t\t\t\t\t\t<span>6 Mar 2026<\/span> |\n\t\t\t\t\t\t\t\t\t<span>\n\t\t\t\t\t\t\t\t\t\t5 min read\t\t\t\t\t\t\t\t\t<\/span>\n\t\t\t\t\t\t\t\t<\/div>\n\n\t\t\t\t\t\t\t\t<div class=\"mt-4 mb-6\">\n\t\t\t\t\t\t\t\t\t<p>Teaching an AI compliance reviewer to read handwritten notes and scanned documents &#8211; turning an 8-hour, $1,600 job into a 10-minute, $5 one.<\/p>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\t<\/div>\n                        <div>\n                            <a href=\"https:\/\/aiadvancements.com.au\/case-study\/3lines-teaching-regi-to-read-handwritten-notes-and-scanned-documents\/\" class=\"case-link btn btn-solidcolor1 inline-flex items-center gap-2 overflow-hidden min-w-0\">\n                                <span class=\"circle relative\"><\/span>\n                                <span class=\"button-text z-10\">Read more<\/span>\n                            <\/a>\n                        <\/div>\n                    <\/div>\n\n                \n                    \n                    <div class=\"case-study-box ai-strategy mining relative group flex flex-col justify-between cursor-pointer\">\n                        <div>\n\t\t\t\t\t\t\t<div class=\"portfolio-page-thumbnail mb-6 overflow-hidden rounded-[16px] relative\">\n\t\t\t\t\t\t\t\t<img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"683\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/mitsui-1024x683.jpeg\" class=\"w-full aspect-[1\/0.65] transition-transform duration-1000 ease-in-out group-hover:scale-[1.2] wp-post-image\" alt=\"\" srcset=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/mitsui-1024x683.jpeg 1024w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/mitsui-300x200.jpeg 300w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/mitsui-768x512.jpeg 768w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/mitsui-1536x1024.jpeg 1536w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/mitsui-2048x1366.jpeg 2048w\" sizes=\"auto, (max-width: 1024px) 100vw, 1024px\" \/>\t\t\t\t\t\t\t<\/div>\n\n\t\t\t\t\t\t\t<div>\n\t\t\t\t\t\t\t\t<div class=\"meta-cat flex gap-2 mb-4\">\n\t\t\t\t\t\t\t\t\t<span class=\"inline-flex font-semibold text-color1 bg-color4 py-[6px] px-3 rounded-3xl text-xs\">AI Strategy<\/span><span class=\"inline-flex font-semibold text-color1 bg-color4 py-[6px] px-3 rounded-3xl text-xs\">Mining<\/span>\t\t\t\t\t\t\t\t<\/div>\n\n\t\t\t\t\t\t\t\t<h3 class=\"font-medium normal-case\">Mitsui: Scoping a Roadmap to Cut Maintenance Costs by up to 30% and Boost Planner Productivity by 70%<\/h3>\n\n\t\t\t\t\t\t\t\t<div class=\"post-date flex gap-3 text-xs font-normal\">\n\t\t\t\t\t\t\t\t\t<span>5 Jan 2026<\/span> |\n\t\t\t\t\t\t\t\t\t<span>\n\t\t\t\t\t\t\t\t\t\t5 min read\t\t\t\t\t\t\t\t\t<\/span>\n\t\t\t\t\t\t\t\t<\/div>\n\n\t\t\t\t\t\t\t\t<div class=\"mt-4 mb-6\">\n\t\t\t\t\t\t\t\t\t<p>How we scoped a three-part AI roadmap that could cut Mitsui&#8217;s maintenance costs by up to 30% and slash planner search time by 90%.<\/p>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\t\t<\/div>\n\t\t\t\t\t\t<\/div>\n                        <div>\n                            <a href=\"https:\/\/aiadvancements.com.au\/case-study\/mitsui-scoping-a-roadmap-to-cut-maintenance-costs-by-up-to-30-and-boost-planner-productivity-by-70\/\" class=\"case-link btn btn-solidcolor1 inline-flex items-center gap-2 overflow-hidden min-w-0\">\n                                <span class=\"circle relative\"><\/span>\n                                <span class=\"button-text z-10\">Read more<\/span>\n                            <\/a>\n                        <\/div>\n                    <\/div>\n\n                            \n            <\/div>\n\n            \n\n            \n            <div class=\"blog-pagination flex items-center justify-between gap-4 pt-30 border-t border-color1 mt-20\">\n\n                <!-- PREV -->\n                                    <span class=\"pagination-prev w-[93px] h-[46px] flex items-center justify-center rounded-full opacity-40 cursor-not-allowed font-bold text-[14px] gap-2 bg-color4\">\n                        Prev\n                    <\/span>\n                \n\n                <!-- NUMBERS -->\n   