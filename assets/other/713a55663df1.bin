{"id":553,"date":"2026-03-10T07:34:10","date_gmt":"2026-03-10T07:34:10","guid":{"rendered":"https:\/\/aiadvancements.dilatevps1.cloudsites.net.au\/?page_id=553"},"modified":"2026-09-24T14:16:10","modified_gmt":"2026-09-24T06:16:10","slug":"ai-transformation","status":"publish","type":"page","link":"https:\/\/aiadvancements.com.au\/ai-transformation\/","title":{"rendered":"AI Transformation"},"content":{"rendered":"    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\n        <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\n\n    <!-- BLOCK CODING STARTS HERE -->\n    <section \n        id=\"\" \n        data-name=\"acf_internal-hero\"\n        data-lazyload=\"1\" \n        class=\"relative \" \n        style=\"z-index: 0; background-color:#FFFFFF;\">\n        <div class=\"bg-color5 b1200:pt-200 b767:pt-180 pt-150\">\n            <div class=\"container\">\n                <div class=\"internal-hero-details max-w-[912px] mx-auto b1024:pb-24 b767:pb-20 pb-12\">\n\t\t\t\t\t                    <div class=\"text-center flex items-center mb-[44px]\">\n                        <div class=\"h-[32px] w-[32px] rounded-full bg-color2 flex items-center justify-center\">\n                            <svg width=\"19\" height=\"8\" viewBox=\"0 0 30 13\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M10.1112 0C10.1112 5.75168 5.57492 10.4294 0 10.4294V12.6557C5.60316 12.6557 10.3408 8.76349 11.8042 3.46214V12.6329H13.9649V0H10.11H10.1112Z\" fill=\"#131924\"\/><path d=\"M19.8559 0H16.001V12.6342H18.1617V3.46214C19.6251 8.76223 24.364 12.6557 29.9659 12.6557V10.4294C24.391 10.4294 19.8547 5.75041 19.8547 0H19.8559Z\" fill=\"#131924\"\/><\/svg>\n                        <\/div>\n\t\t\t\t\t\t        <h1 class=\" animate-watch standard__headline inline-flex font-semibold text-color1 bg-color4 py-[11px] px-6 rounded-3xl text-xs super-title\">AI Transformation for Perth &#038; Australian Enterprise<\/h1>\n                        <\/div>\n\t\t\t\t\t\n                    \n                    \n                        <!-- HEADLINE + BELOW HEADLINE -->\n                        <div>\n                                    <h2 class=\"h2 animate-watch standard__headline block tracking-[-0.06em]\">AI Transformation<\/h2>\n                                        <h3 class=\"h3 animate-watch standard__headline block text-color1 b767:mb-10 b767:mt-10 mt-8\">Our AI transformation service embeds our Perth-based engineers into your organisation for long-term, hands-on delivery. We work inside your business each week to build, refine, and scale the AI systems that move your enterprise forward.<\/h3>\n    \n                            <div class=\"button-wrap inline-flex flex-col b767:flex-row gap-3 mt-[30px]\">\n                                            <a href=\"https:\/\/aiadvancements.com.au\/contact\/\" target=\"\" class=\"btn btn-solidcolor1 speak-btn flex items-center gap-3 overflow-hidden\">\n                <span class=\"block circle relative\"><\/span>\n                <span class=\"button-text z-10\">Speak to a human<\/span>\n            <\/a>\n                                                        <a href=\"\/#services\" target=\"\" class=\"btn outline-color1 text-center overflow-hidden relative z-10\">\n                Explore our AI services            <\/a>\n                                        <\/div>\n                        <\/div>\n\n                                    <\/div>\n            <\/div>\n            \n                        <div class=\"internal-hero-video video-expand-wrapper\">\n\n                <div class=\"hero-video-wrapper relative\">\n\n                    <!-- ===================== -->\n                    <!-- MEDIA -->\n                    <!-- ===================== -->\n                    <div class=\"desktop-media\">\n\n                        \n                        \n                            <!-- DESKTOP VIDEO -->\n                                                        <div class=\"hero-oembed desktop-only w-full h-full\">\n                                <iframe \n                                    src=\"https:\/\/player.vimeo.com\/video\/1184749387?autoplay=0&#038;muted=0&#038;background=0&#038;controls=1&#038;title=0&#038;byline=0&#038;portrait=0&#038;dnt=1&#038;sidedock=0\" \n                                    frameborder=\"0\" \n                                    allow=\"autoplay; fullscreen\" \n                                    allowfullscreen>\n                                <\/iframe>\n                            <\/div>\n\n                            <!-- MOBILE VIDEO -->\n                                                        <div class=\"hero-oembed mobile-only w-full h-full\">\n                                <iframe \n                                    src=\"https:\/\/player.vimeo.com\/video\/1184744770?autoplay=0&#038;muted=0&#038;background=0&#038;controls=1&#038;title=0&#038;byline=0&#038;portrait=0&#038;dnt=1&#038;sidedock=0\" \n                                    frameborder=\"0\" \n                                    allow=\"autoplay; fullscreen\" \n                                    allowfullscreen>\n                                <\/iframe>\n                            <\/div>\n\n                        \n                    <\/div>\n\n                    <!-- ===================== -->\n                    <!-- THUMBNAIL -->\n                    <!-- ===================== -->\n                                            <div class=\"video-thumbnail absolute inset-0 z-20\">\n                            <picture class=\"w-full h-full\"><source media=\"(min-width: 481px)\" srcset=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/46c8f2f39a9c1531924ea195b9e4af578c7259b11.jpg\"><img decoding=\"async\" class=\"w-full h-full\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/46c8f2f39a9c1531924ea195b9e4af578c7259b11.jpg\" alt=\"Two professionals engaged in discussion at a modern co-working space, one wearing a navy AI Advancements polo shirt and laughing, photographed in a collaborative AI strategy meeting\" style=\"object-fit:cover;object-position:center;\" loading=\"lazy\" width=\"2560\" height=\"1707\" \/><\/picture>                        <\/div>\n                    \n                    <!-- ===================== -->\n                    <!-- PLAY BUTTON -->\n                    <!-- ===================== -->\n                                            <button class=\"video-toggle absolute inset-0 flex items-center justify-center z-30\">\n                            <span class=\"play-btn flex items-center justify-center\">\n                                <svg width=\"98\" height=\"98\" viewBox=\"0 0 98 98\" fill=\"none\">\n                                    <circle cx=\"49\" cy=\"49\" r=\"49\" fill=\"#FCFF6A\"\/>\n                                    <path d=\"M68 49L39.5 65.4545L39.5 32.5455L68 49Z\" fill=\"#131924\"\/>\n                                <\/svg>\n                            <\/span>\n                        <\/button>\n                    \n                <\/div>\n\n            <\/div>\n                    <\/div>\n    <\/section>\n    <!-- BLOCK CODING STARTS HERE -->\n\n    \n\n  <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n  <section \r\n      id=\"\" \r\n      data-name=\"acf_building-ai-transformation\"\r\n      data-lazyload=\"1\" \r\n      class=\"relative \" \r\n      style=\"z-index: 0;\">\r\n      <div class=\"b767:py-100 py-80 b1400:py-[130px]\">\r\n        <div class=\"container\">\r\n            <div class=\"text-center mb-10 b1024:mb-[60px] max-w-[894px] mx-auto\">\r\n                                                                                        <div class=\"hero-heading\">\r\n                                <h2 class=\"h2 animate-watch standard__headline block mb-6 b767:mb-10\">Our approach to building your AI transformation<\/h2>\n                        <\/div>\r\n                            <\/div>\r\n            <div class=\"flex flex-col b1024:flex-row max-w-[1130px] mx-auto\">\r\n                <div class=\"flex-1 b1200:pr-[148px] b1024:pr-20 mb-10 b1024:mb-0 text-center b1024:text-start\">\r\n                    <div class=\"flex justify-center b1024:justify-start\">\r\n                        <svg width=\"57\" height=\"57\" viewBox=\"0 0 57 57\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><rect width=\"56.1721\" height=\"56.833\" rx=\"28.0861\" fill=\"#FCFF6A\"\/><path d=\"M27.6025 21.4423V35.6503H25.1719V25.3358C23.526 31.2983 18.1975 35.6766 11.8955 35.6766V33.1727C18.1657 33.1727 23.2676 27.9113 23.2676 21.4423H27.6025ZM34.2266 21.4423C34.2266 27.9098 39.3294 33.1727 45.5996 33.1727V35.6766C39.299 35.6766 33.9692 31.2969 32.3232 25.3358V35.6522H29.8926V21.4423H34.2266Z\" fill=\"#131924\"\/><\/svg>\r\n                    <\/div>\r\n                                                    <h3 class=\"h3 animate-watch standard__headline block text-color1 mb-8 b1024:mt-10 mt-8 tracking-[0]\">Our transformation model removes uncertainty by placing our AI engineers directly inside your organisation.<\/h3>\n                                                                    <div class=\"hero-summary\">\r\n                            <p>We work with your team each week to understand your priorities, shape the direction, and dynamically build the AI systems that create meaningful operational change, even when the full scope is not known at the start.<\/p>\n<p>This long-term, time-and-materials model gives you the flexibility enterprises need.<\/p>\n<p>The scope evolves with your needs, ensuring you get continuous progress, not a fixed project that stops too soon.<\/p>\n                        <\/div>\r\n                                        <div class=\"button-wrap flex justify-center b1024:justify-start mt-10\">\r\n                                    <a href=\"https:\/\/aiadvancements.com.au\/contact\/\" target=\"\" class=\"btn btn-solidcolor1 speak-btn flex items-center gap-3 overflow-hidden\">\n                <span class=\"block circle relative\"><\/span>\n                <span class=\"button-text z-10\">Speak to us<\/span>\n            <\/a>\n                                <\/div>\r\n                <\/div>\r\n                <div class=\"transformation-img relative b1200:max-w-[668px] b1024:max-w-[500px]\">\r\n                                            <picture class=\"w-full h-full\"><source media=\"(min-width: 481px)\" srcset=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/03\/AIA_Brand-Identity-Guidelines-2.jpg\"><img decoding=\"async\" class=\"w-full h-full\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/03\/AIA_Brand-Identity-Guidelines-2.jpg\" alt=\"Side profile portrait of two AI Advancements professionals in dark polo shirts looking attentively forward, used for AI Transformation service page brand identity\" style=\"object-fit:contain;object-position:center;\" loading=\"lazy\" width=\"668\" height=\"690\" \/><\/picture>                                    <\/div>\r\n            <\/div>\r\n        <\/div>\r\n      <\/div>\r\n  <\/section>\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n\r\n  \n\n  <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n  <section \r\n      id=\"\" \r\n      data-name=\"acf_transformation-work\"\r\n      data-lazyload=\"1\" \r\n      class=\"relative \" \r\n      style=\"z-index: 0;\">\r\n      <div class=\"b767:py-100 py-80 b1400:py-[130px] bg-color4\">\r\n        <div class=\"container\">\r\n            <div class=\"flex flex-col b1024:flex-row max-w-[1130px] mx-auto\">\r\n                <div class=\"flex-1 flex flex-col justify-between b1024:pr-6 b767:mb-10 mb-6 b1024:mb-0\">\r\n                    <div class=\"text-center b767:text-start\">\r\n                                                                                                                                <div class=\"hero-heading\">\r\n                                        <h2 class=\"h2 animate-watch standard__headline block mb-6 b767:mb-10\">How AI Transformation works for your business<\/h2>\n                                <\/div>\r\n                                                                                    <h3 class=\"h3 animate-watch standard__headline block text-color1 mb-8 b1024:max-w-[326px] tracking-[0] text-[24px]\">Our AI transformation work is delivered as a long-term, time and materials engagement, typically running for 6 to 24 months.\u00a0<\/h3>\n                                                <\/div>\r\n                    <div class=\"flex justify-center b767:justify-start\">\r\n                        <svg width=\"57\" height=\"57\" viewBox=\"0 0 57 57\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><rect width=\"56.1721\" height=\"56.833\" rx=\"28.0861\" fill=\"#FCFF6A\"\/><path d=\"M27.6025 21.4423V35.6503H25.1719V25.3358C23.526 31.2983 18.1975 35.6766 11.8955 35.6766V33.1727C18.1657 33.1727 23.2676 27.9113 23.2676 21.4423H27.6025ZM34.2266 21.4423C34.2266 27.9098 39.3294 33.1727 45.5996 33.1727V35.6766C39.299 35.6766 33.9692 31.2969 32.3232 25.3358V35.6522H29.8926V21.4423H34.2266Z\" fill=\"#131924\"\/><\/svg>\r\n                    <\/div>\r\n                <\/div>\r\n                <div class=\"b1024:max-w-[668px] grid grid-cols-1 b767:grid-cols-2 gap-x-6 gap-y-8 text-center b767:text-start\">\r\n                    <div class=\"flex flex-col justify-between\">\r\n                                                    <div class=\"hero-summary\">\r\n                                <p>We embed directly into your organisation, working alongside your teams to identify, build and scale AI systems that deliver real operational value.<\/p>\n<p>Rather than following a fixed scope, the engagement evolves as priorities change, allowing us to achieve early wins, integrate AI into existing workflows, and continuously refine performance as systems are adopted in the real world.<\/p>\n<p>Over time, this approach enables multiple AI systems to move into production, supported by governance, training and regular review, ensuring AI becomes a practical, trusted part of how your organisation operates day to day.<\/p>\n<p>For organisations that need to establish their priorities and roadmap before moving into long-term implementation, our <a class=\"decorated-link\" href=\"https:\/\/aiadvancements.com.au\/ai-strategy\/\" target=\"_new\" rel=\"noopener\" data-start=\"1000\" data-end=\"1065\">AI strategy roadmap<\/a> provides a practical starting point.<\/p>\n<p>Speak to us to understand how an AI transformation engagement works, and whether it\u2019s the right fit for your organisation.<\/p>\n                            <\/div>\r\n                                                <div class=\"button-wrap flex justify-center b1024:justify-start mt-8\">\r\n                                        <a href=\"https:\/\/aiadvancements.com.au\/contact\/\" target=\"\" class=\"btn btn-solidcolor1 speak-btn flex items-center gap-3 overflow-hidden\">\n                <span class=\"block circle relative\"><\/span>\n                <span class=\"button-text z-10\">Speak to us<\/span>\n            <\/a>\n                                                                <\/div>\r\n                    <\/div>\r\n                    <div class=\"transformation-work-img\">\r\n                                                    <picture class=\"w-full h-full\"><source media=\"(min-width: 481px)\" srcset=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/03\/a556703c4879c39343821cc0fccc3bde6fd0a474.webp\"><img decoding=\"async\" class=\"w-full h-full\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/03\/a556703c4879c39343821cc0fccc3bde6fd0a474.webp\" alt=\"Close-up of hands typing on a professional mechanical keyboard with red accent keys on a wooden desk, representing AI-driven digital transformation and productivity\" style=\"object-fit:contain;object-position:center;\" loading=\"lazy\" width=\"2560\" height=\"1707\" \/><\/picture>                                            <\/div>\r\n                <\/div>\r\n            <\/div>\r\n        <\/div>\r\n      <\/div>\r\n  <\/section>\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n\r\n  \n\n  <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n  <section \r\n      id=\"\" \r\n      data-name=\"acf_logo-slider\"\r\n      data-lazyload=\"1\" \r\n      class=\"relative \" \r\n      style=\"z-index: 0;\">\r\n        <div class=\"logo-slider-area pt-[145px]\">\r\n            <div class=\"container\">\r\n                <div class=\"logo-slider-title text-center flex items-center justify-center mb-16 b767:mb-[72px]\">\r\n                    <div class=\"ls-title-icon h-[48px] w-[48px] rounded-full bg-color2 flex items-center justify-center\">\r\n                        <svg width=\"30\" height=\"13\" viewBox=\"0 0 30 13\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M10.1112 0C10.1112 5.75168 5.57492 10.4294 0 10.4294V12.6557C5.60316 12.6557 10.3408 8.76349 11.8042 3.46214V12.6329H13.9649V0H10.11H10.1112Z\" fill=\"#131924\"\/><path d=\"M19.8559 0H16.001V12.6342H18.1617V3.46214C19.6251 8.76223 24.364 12.6557 29.9659 12.6557V10.4294C24.391 10.4294 19.8547 5.75041 19.8547 0H19.8559Z\" fill=\"#131924\"\/><\/svg>\r\n                    <\/div>\r\n                    <div class=\"ls-title bg-color1 text-color4 px-6 h-[48px] flex items-center justify-center rounded-full text-xs b767:text-[18px] font-semibold\">Trusted by leading Perth businesses<\/div>\r\n                <\/div>\r\n            <\/div>\r\n                        <div class=\"logo_slider splide overflow-visible\">\r\n                <div class=\"splide__track overflow-visible\">\r\n                    <div class=\"splide__list flex\">\r\n                                                    <div class=\"splide__slide\">\r\n                                <div class=\"slider-logo h-full\">\r\n                                    <img decoding=\"async\"\r\n                                        loading=\"lazy\"\r\n                                        style=\"width: 160px; height: 70px;\"\r\n                                        width=\"160\"\r\n                                        height=\"70\"\r\n                                        class=\"h-[70px] b767:h-[100px] w-[160px] object-contain\"\r\n                                        src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/03\/49ff6bad96428f8f3ff88d4f9185fb66d85724ab.jpg\"\r\n                                        srcset=\"\"\r\n                                        sizes=\"auto, 160px\"\r\n                                        alt=\"Fortescue mining company logo - green circular icon with Fortescue company name text\" \/>\r\n                                <\/div>\r\n                            <\/div>\r\n                                                    <div class=\"splide__slide\">\r\n                                <div class=\"slider-logo h-full\">\r\n                                    <img decoding=\"async\"\r\n                                        loading=\"lazy\"\r\n                                        style=\"width: 160px; height: 70px;\"\r\n                                        width=\"160\"\r\n                                        height=\"70\"\r\n                                        class=\"h-[70px] b767:h-[100px] w-[160px] object-contain\"\r\n                                        src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/BHP_2017_logo.svg-300x115.png\"\r\n              