                        width=\"160\"\r\n                                        height=\"70\"\r\n                                        class=\"h-[70px] b767:h-[100px] w-[160px] object-contain\"\r\n                                        src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/WhatsApp-Image-2026-08-13-at-13.00.41-270x300.webp\"\r\n                                        srcset=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/WhatsApp-Image-2026-08-13-at-13.00.41-270x300.webp 270w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/WhatsApp-Image-2026-08-13-at-13.00.41-768x853.webp 768w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/WhatsApp-Image-2026-08-13-at-13.00.41.webp 800w\"\r\n                                        sizes=\"auto, 160px\"\r\n                                        alt=\"\" \/>\r\n                                <\/div>\r\n                            <\/div>\r\n                                                    <div class=\"splide__slide\">\r\n                                <div class=\"slider-logo h-full\">\r\n                                    <img decoding=\"async\"\r\n                                        loading=\"lazy\"\r\n                                        style=\"width: 160px; height: 70px;\"\r\n                                        width=\"160\"\r\n                                        height=\"70\"\r\n                                        class=\"h-[70px] b767:h-[100px] w-[160px] object-contain\"\r\n                                        src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/images-300x72.png\"\r\n                                        srcset=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/images-300x72.png 300w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/images.png 738w\"\r\n                                        sizes=\"auto, 160px\"\r\n                                        alt=\"\" \/>\r\n                                <\/div>\r\n                            <\/div>\r\n                                            <\/div>\r\n                <\/div>\r\n            <\/div>\r\n            \r\n            <div class=\"b1024:mb-[130px] mb-[80px]\"><\/div>\r\n                                    <div class=\"container\">\r\n                <div class=\"ls-border relative\"><\/div>\r\n            <\/div>\r\n                    <\/div>\r\n\r\n        <style>\r\n        .logo_slider .splide__list { will-change: transform; }\r\n        .logo_slider .splide__track { contain: layout;}\r\n        .slider-logo img {\r\n            aspect-ratio: 160 \/ 100;\r\n        }\r\n        <\/style>\r\n\r\n  <\/section>\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n\r\n  \n\n  <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n  <section \r\n      id=\"\" \r\n      data-name=\"acf_custom-project\"\r\n      data-lazyload=\"1\" \r\n      class=\"relative \" \r\n      style=\"z-index: 0;\">\r\n      <div class=\"b767:py-100 py-80\">\r\n        <div class=\"container\">\r\n                            <div class=\"subheading-wrap text-center\">\r\n                        <h2 class=\" animate-watch standard__headline inline-flex font-semibold text-color1 bg-color4 py-2 px-6 rounded-3xl text-xs b1024:mb-[90px] mb-10 !tracking-[-0.02em]\">Our AI transformation for enterprise projects<\/h2>\n                    <\/div>\r\n                        <div class=\"b1024:mb-[90px] mb-10 \">\r\n                                    <div class=\"heading-wrap max-w-[900px] mx-auto text-center mb-10\">\r\n                                <h3 class=\"h2 animate-watch standard__headline block\">What AI transformation looks like <br \/>\r\nin the real world<\/h3>\n                        <\/div>\r\n                                                    <div class=\"summary-wrap text-center max-w-[669px] mx-auto\">\r\n                        <p>A transformation partnership delivers agile, continuous progress, not a one-off build. These case studies show how embedded AI expertise can streamline workflows, strengthen accuracy, and increase capacity across large, complex operations.<\/p>\n<p>Our work with Fortescue demonstrates <a class=\"decorated-link\" href=\"https:\/\/aiadvancements.com.au\/case-study\/fortescue-scaling-ai-across-autonomous-mining-operations-from-pilot-to-production\/?utm_source=chatgpt.com\" target=\"_new\" rel=\"noopener\" data-start=\"637\" data-end=\"828\">how we scaled AI across Fortescue&#8217;s autonomous mining operations<\/a>, from an initial pilot through to production.<\/p>\n<p>Explore our <a class=\"decorated-link\" href=\"https:\/\/aiadvancements.com.au\/case-studies\/?utm_source=chatgpt.com\" target=\"_new\" rel=\"noopener\" data-start=\"593\" data-end=\"670\">AI transformation case studies<\/a> to see how we&#8217;ve helped Australian organisations scale AI in real-world environments.<\/p>\n                    <\/div>\r\n                            <\/div>\r\n        <\/div>\r\n        <div class=\"splide project_slider\" aria-label=\"project slider\">\r\n            <div class=\"splide__track\">\r\n                <ul class=\"splide__list\">\r\n                    \r\n                            <li class=\"splide__slide\">\r\n                                <div class=\"bg-color4 b1400:py-100 b1400:px-[115px] b1200:p-80 b767:p-60 px-20 py-60 flex flex-col b1024:flex-row h-full text-center b767:text-start\">\r\n                                    \r\n                                    <!-- LEFT -->\r\n                                    <div class=\"flex flex-col justify-between b1024:w-[337px] b767:mb-10 mb-8 b1024:mb-0 gap-10\">\r\n                                        \r\n                                        <h3 class=\"b1024:text-[40px] text-3xl font-normal leading-none\">\r\n                                            Fortescue: Scaling AI Across Autonomous Mining Operations &#8211; From Pilot to Production                                        <\/h3>\r\n\r\n                                        <div>\r\n                                            <img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"756\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/07\/fortescue.png\" class=\"w-full object-cover rounded-[10px] wp-post-image\" alt=\"\" srcset=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/07\/fortescue.png 1024w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/07\/fortescue-300x221.png 300w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/07\/fortescue-768x567.png 768w\" sizes=\"auto, (max-width: 1024px) 100vw, 1024px\" \/>                                        <\/div>\r\n\r\n                                    <\/div>\r\n\r\n                                    <!-- RIGHT -->\r\n                                    <div class=\"flex flex-col justify-between flex-1 b1400:pl-[86px] b1200:pl-60 b1400:ml-[86px] b1200:ml-[60px] b1024:pl-40 b1024:ml-10 b1024:border-l b1024:border-color1\">\r\n                                        \r\n                                        <div class=\"text-base\">\r\n                                            An embedded AI partnership with Fortescue&#039;s fleet control team is saving three hours a day on one automation alone, with near-zero error rate.                                        <\/div>\r\n\r\n                                        <div class=\"flex mt-8\">\r\n                                            <a href=\"https:\/\/aiadvancements.com.au\/case-study\/fortescue-scaling-ai-across-autonomous-mining-operations-from-pilot-to-production\/\" class=\"btn btn-solidcolor1 flex justify-center items-center gap-2 overflow-hidden mx-auto b767:mx-0\">\r\n                                                <span class=\"block circle relative\"><\/span>\r\n                                                <div class=\"button-text z-10\">Read more<\/div>\r\n                                            <\/a>\r\n                                        <\/div>\r\n\r\n                                    <\/div>\r\n\r\n                                <\/div>\r\n                            <\/li>\r\n\r\n                        \r\n                            <li class=\"splide__slide\">\r\n                                <div class=\"bg-color4 b1400:py-100 b1400:px-[115px] b1200:p-80 b767:p-60 px-20 py-60 flex flex-col b1024:flex-row h-full text-center b767:text-start\">\r\n                                    \r\n                                    <!-- LEFT -->\r\n                                    <div class=\"flex flex-col justify-between b1024:w-[337px] b767:mb-10 mb-8 b1024:mb-0 gap-10\">\r\n                                        \r\n                                        <h3 class=\"b1024:text-[40px] text-3xl font-normal leading-none\">\r\n                                            Glass Co Metro: A Board-Ready AI Roadmap That Delivered $100K+ in Value Within Two Months                                        <\/h3>\r\n\r\n                                        <div>\r\n                                            <img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"683\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/glassco-metro-1024x683.png\" class=\"w-full object-cover rounded-[10px] wp-post-image\" alt=\"Glass Co Metro company logo showing a black star in a square frame icon with bold company name, alongside AI Advancements logo and AI Strategy service label\" srcset=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/glassco-metro-1024x683.png 1024w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/glassco-metro-300x200.png 300w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/glassco-metro-768x512.png 768w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/glassco-metro.png 1536w\" sizes=\"auto, (max-width: 1024px) 100vw, 1024px\" \/>                                        <\/div>\r\n\r\n                                    <\/div>\r\n\r\n                                    <!-- RIGHT -->\r\n                                    <div class=\"flex flex-col justify-between flex-1 b1400:pl-[86px] b1200:pl-60 b1400:ml-[86px] b1200:ml-[60px] b1024:pl-40 b1024:ml-10 b1024:border-l b1024:border-color1\">\r\n                                        \r\n                                        <div class=\"text-base\">\r\n                                            A board-ready roadmap narrowed 20+ AI ideas to 7 investment-ready use cases, two of which delivered over $100K in value within two months of build.                                        <\/div>\r\n\r\n                                        <div class=\"flex mt-8\">\r\n                                            <a href=\"https:\/\/aiadvancements.com.au\/case-study\/ai-tech-assessment-and-roadmap\/\" class=\"btn btn-solidcolor1 flex justify-center items-center gap-2 overflow-hidden mx-auto b767:mx-0\">\r\n                                                <span class=\"block circle relative\"><\/span>\r\n                                                <div class=\"button-text z-10\">Read more<\/div>\r\n                                            <\/a>\r\n                                        <\/div>\r\n\r\n                                    <\/div>\r\n\r\n                                <\/div>\r\n                            <\/li>\r\n\r\n                                        <\/ul>   \r\n            <\/div>\r\n        <\/div>\r\n    <\/div>\r\n  <\/section>\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n\r\n  \n\n  <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n  <section \r\n      id=\"\" \r\n      data-name=\"acf_testimonials\"\r\n      data-lazyload=\"1\" \r\n      class=\"relative \" \r\n      style=\"z-index: 0;\">\r\n        <div class=\"testimonials-area b1024:py-[120px] py-80 bg-color3\">\r\n            <div class=\"container\">\r\n                                    <div class=\"subheading-wrap text-center\">\r\n                                <h2 class=\" animate-watch standard__headline inline-flex font-semibold text-color1 bg-color2 py-2 px-6 rounded-3xl text-xs mx-auto b767:mx-0 b767:mb-16 mb-10\">Hear from the teams we work with<\/h2>\n                        <\/div>\r\n                                <div class=\"grid grid-cols-1 b767:grid-cols-2 gap-6 b1024:mb-[90px] mb-[70px] text-center b767:text-start max-w-[1130px] mx-auto\">\r\n                                            <div class=\"heading-wrap w-full b767:w-auto\">\r\n                                    <h3 class=\"h2 animate-watch standard__headline block\">Why WA enterprises choose us<\/h3>\n                            <\/div>\r\n                                                                <div class=\"summary-wrap text-center b767:text-start b1024:pl-[60px] b1400:pl-[116px]\">\r\n                            <p>Teams across WA partner with AI Advancements to deliver and scale AI across their operations. Here\u2019s what our clients say about working with our team for AI Transformation:<\/p>\n                        <\/div>\r\n                                    <\/div>\r\n            \r\n\r\n\r\n                \r\n                                <!-- GRID -->\r\n                <div class=\"flex flex-wrap gap-3 max-w-[1130px] mx-auto mt-8 b767:mt-0 \r\n                    \">\r\n\r\n                    \r\n                    <div class=\"testimonial-box overflow-hidden bg-color5 rounded-[20px] b767:p-9 p-7 flex flex-col justify-between\r\n                    w-full b767:w-[calc(50%-6px)]\">\r\n\r\n                        <div class=\"flex gap-3\">\r\n                            <span class=\"box-number testimonial-box-number flex text-[10px] font-bold h-[32px] w-[32px] rounded-full bg-color2 justify-center items-center\">\r\n                                01                            <\/span>\r\n\r\n                                                        <div class=\"inline-flex z-10 font-semibold text-color4 bg-black py-2 px-6 rounded-3xl text-xs\">\r\n                                Fortescue                            <\/div>\r\n                                                    <\/div>\r\n\r\n                                                    <div class=\"b1600:py-[86px] z-10 b1024:py-60 py-40 b1600:px-60 b1400:px-40 font-medium leading-[150%] b767:text-[21px]\">\r\n                                <p>&#8220;Great experience working with AIA. Speed, execution and results!&#8221;<\/p>\n                            <\/div>\r\n                        \r\n                        <div class=\"z-10 flex justify-between items-end\">\r\n                            <div>\r\n                                <div class=\"font-bold leading-none\">Dieter K. Haage<\/div>\r\n                                                            <\/div>\r\n                                                            <div class=\"\">\r\n                                    <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/03\/49ff6bad96428f8f3ff88d4f9185fb66d85724ab.jpg\" \r\n                                        alt=\"Fortescue mining company logo - green circular icon with Fortescue company name text\" \r\n                                        width=\"auto\" \r\n                                        height=\"60\"\r\n                                        class=\"h-[60px] w-auto rounded-[10px]\">\r\n                                <\/div>\r\n                                                    <\/div>\r\n\r\n                    <\/div>\r\n\r\n                    \r\n                    <div class=\"testimonial-box overflow-hidden bg-color5 rounded-[20px] b767:p-9 p-7 flex flex-col justify-between\r\n                    w-full b767:w-[calc(50%-6px)]\">\r\n\r\n                        <div class=\"flex gap-3\">\r\n                            <span class=\"box-number testimonial-box-number flex text-[10px] font-bold h-[32px] w-[32px] rounded-full bg-color2 justify-center items-center\">\r\n                                02                            <\/span>\r\n\r\n                                                        <div class=\"inline-flex z-10 font-semibold text-color4 bg-black py-2 px-6 rounded-3xl text-xs\">\r\n                                Coursebox AI                            <\/div>\r\n                                                    <\/div>\r\n\r\n                                                    <div class=\"b1600:py-[86px] z-10 b1024:py-60 py-40 b1600:px-60 b1400:px-40 font-medium leading-[150%] b767:text-[21px]\">\r\n                                <p>\u201cWe were blown away by how fast Sean was able to get the AI video generator live in Coursebox. It will really make the online courses that our customers create more engaging and personal, without the hassle and expense of filming their own videos.\u201d<\/p>\n                            <\/div>\r\n                        \r\n                        <div class=\"z-10 flex justify-between items-end\">\r\n                            <div>\r\n                                <div class=\"font-bold leading-none\">Travis<\/div>\r\n                                                                    <div>CEO of Coursebox AI<\/div>\r\n                                                            <\/div>\r\n                                                            <div class=\"\">\r\n                                    <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/coursebox-ai-1.jpg\" \r\n                                        alt=\"Coursebox AI logo - purple 3D box cube icon with Coursebox company name text\" \r\n                                        width=\"auto\" \r\n                                        height=\"60\"\r\n                                        class=\"h-[60px] w-auto rounded-[10px]\">\r\n                                <\/div>\r\n                                                    <\/div>\r\n\r\n                    <\/div>\r\n\r\n                    \r\n                <\/div>\r\n                            <\/div>\r\n        <\/div>\r\n\r\n  <\/section>\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n\r\n  \n\n  <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\n    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\n\n  <!-- BLOCK CODING STARTS HERE -->\n  <section \n      id=\"\" \n      data-name=\"acf_img-with-text\"\n      data-lazyload=\"1\" \n      class=\"relative \" \n      style=\"z-index: 0;\">\n      <div class=\"img-with-text-area relative b767:py-100 py-80\">\n        <div class=\"container relative\">\n            <div class=\"iwt-content-wrap grid grid-cols-1 b1024:grid-cols-2 items-center b1400:px-80\">\n                <div class=\"iwt-content b1024:pr-40 b1200:pr-80 b1400:pr-[100px] text-center b1024:text-start mb-14 b1024:mb-0\">\n                                            <div class=\"hero-heading\">\n                                <h2 class=\"h2 animate-watch standard__headline block mb-6 b767:mb-10\">Talk to our team about your AI Transformation<\/h2>\n                            <\/div>\n                                                                <div class=\"hero-summary b1024:max-w-[438px] my-10 b1024:my-16\">\n                            <p>Hiring is tight, workloads are growing, and your teams need more capacity than headcount alone can provide. Our embedded AI Transformation model gives you the dedicated engineering power to modernise your operations from the inside out, consistently and at pace.<\/p>\n<p>Speak with us, and we\u2019ll help you understand where an embedded AI team adds the most value and how quickly you can start seeing results.<\/p>\n                        <\/div>\n                                        <div class=\"button-wrap flex flex-col b767:flex-row items-center justify-center b1024:justify-start gap-3 overflow-hidden\">\n                                    <a href=\"https:\/\/aiadvancements.com.au\/contact\/\" target=\"\" class=\"btn btn-solidcolor1 speak-btn flex items-center gap-3 overflow-hidden\">\n                <span class=\"block circle relative\"><\/span>\n                <span class=\"button-text z-10\">Speak to us<\/span>\n            <\/a>\n                                                <a href=\"\/#services\" target=\"\" class=\"btn outline-color1 text-center overflow-hidden relative z-10\">\n                See our services            <\/a>\n                                <\/div>\n                <\/div>\n                <div class=\"iwt-img relative\">\n                                                                <div class=\"overlay-color2\"><\/div>\n                        <div class=\"overlay-color6\"><\/div>\n                        <div class=\"ai-text-two text-xs bg-color2 leading-none pt-[5px] pb-[6px] px-[9px] rounded-3xl\">&lt;ai.advancements&gt;<\/div>\n                                                                                    <picture class=\"w-full h-full\"><source media=\"(min-width: 481px)\" srcset=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/03\/Mask-group2.jpg\"><img decoding=\"async\" class=\"w-full h-full\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/03\/Mask-group2.jpg\" alt=\"Two smiling AI Advancements consultants, one with beard in foreground and another behind, representing the approachable AI Strategy consulting team\" style=\"object-fit:contain;object-position:center;\" loading=\"lazy\" width=\"553\" height=\"707\" \/><\/picture>                                    <\/div>\n            <\/div>\n        <\/div>\n      <\/div>\n  <\/section>\n  <!-- BLOCK CODING STARTS HERE -->\n\n  ","protected":false},"excerpt":{"rendered":"","protected":false},"author":5,"featured_media":0,"parent":0,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"","meta":{"_acf_changed":false,"footnotes":""},"class_list":["post-553","page","type-page","status-publish","hentry"],"acf":[],"_links":{"self":[{"href":"https:\/\/aiadvancements.com.au\/wp-json\/wp\/v2\/pages\/553","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/aiadvancements.com.au\/wp-json\/wp\/v2\/pages"}],"about":[{"href":"https:\/\/aiadvancements.com.au\/wp-json\/wp\/v2\/types\/page"}],"author":[{"embeddable":true,"href":"https:\/\/aiadvancements.com.au\/wp-json\/wp\/v2\/users\/5"}],"replies":[{"embeddable":true,"href":"https:\/\/aiadvancements.com.au\/wp-json\/wp\/v2\/comments?post=553"}],"version-history":[{"count":31,"href":"https:\/\/aiadvancements.com.au\/wp-json\/wp\/v2\/pages\/553\/revisions"}],"predecessor-version":[{"id":2746,"href":"https:\/\/aiadvancements.com.au\/wp-json\/wp\/v2\/pages\/553\/revisions\/2746"}],"wp:attachment":[{"href":"https:\/\/aiadvancements.com.au\/wp-json\/wp\/v2\/media?parent=553"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}