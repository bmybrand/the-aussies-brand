     width=\"160\"\r\n                                        height=\"70\"\r\n                                        class=\"h-[70px] b767:h-[100px] w-[160px] object-contain\"\r\n                                        src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/WhatsApp-Image-2026-08-13-at-13.00.41-270x300.webp\"\r\n                                        srcset=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/WhatsApp-Image-2026-08-13-at-13.00.41-270x300.webp 270w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/WhatsApp-Image-2026-08-13-at-13.00.41-768x853.webp 768w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/WhatsApp-Image-2026-08-13-at-13.00.41.webp 800w\"\r\n                                        sizes=\"auto, 160px\"\r\n                                        alt=\"\" \/>\r\n                                <\/div>\r\n                            <\/div>\r\n                                                    <div class=\"splide__slide\">\r\n                                <div class=\"slider-logo h-full\">\r\n                                    <img decoding=\"async\"\r\n                                        loading=\"lazy\"\r\n                                        style=\"width: 160px; height: 70px;\"\r\n                                        width=\"160\"\r\n                                        height=\"70\"\r\n                                        class=\"h-[70px] b767:h-[100px] w-[160px] object-contain\"\r\n                                        src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/images-300x72.png\"\r\n                                        srcset=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/images-300x72.png 300w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/images.png 738w\"\r\n                                        sizes=\"auto, 160px\"\r\n                                        alt=\"\" \/>\r\n                                <\/div>\r\n                            <\/div>\r\n                                            <\/div>\r\n                <\/div>\r\n            <\/div>\r\n            \r\n            <div class=\"b1024:mb-[130px] mb-[80px]\"><\/div>\r\n                                <\/div>\r\n\r\n        <style>\r\n        .logo_slider .splide__list { will-change: transform; }\r\n        .logo_slider .splide__track { contain: layout;}\r\n        .slider-logo img {\r\n            aspect-ratio: 160 \/ 100;\r\n        }\r\n        <\/style>\r\n\r\n  <\/section>\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n\r\n  \n\n  <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n  <section \r\n      id=\"\" \r\n      data-name=\"acf_testimonials\"\r\n      data-lazyload=\"1\" \r\n      class=\"relative \" \r\n      style=\"z-index: 0;\">\r\n        <div class=\"testimonials-area b1024:py-[120px] py-80 bg-color3\">\r\n            <div class=\"container\">\r\n                                    <div class=\"subheading-wrap text-center\">\r\n                                <h2 class=\" animate-watch standard__headline inline-flex font-semibold text-color1 bg-color2 py-2 px-6 rounded-3xl text-xs mx-auto b767:mx-0 b767:mb-16 mb-10\">Hear from organisations improving reporting with AI<\/h2>\n                        <\/div>\r\n                                <div class=\"grid grid-cols-1 b767:grid-cols-2 gap-6 b1024:mb-[90px] mb-[70px] text-center b767:text-start max-w-[1130px] mx-auto\">\r\n                                            <div class=\"heading-wrap w-full b767:w-auto\">\r\n                                    <h3 class=\"h2 animate-watch standard__headline block\">AI chatbots engineered for real business environments<\/h3>\n                            <\/div>\r\n                                                                <div class=\"summary-wrap text-center b767:text-start b1024:pl-[60px] b1400:pl-[116px]\">\r\n                            <p>WA organisations work with us because our AI chatbots are purpose-built for their environments, integrating cleanly with existing systems and delivering reliable customer support without sacrificing human judgement.<\/p>\n                        <\/div>\r\n                                    <\/div>\r\n            \r\n\r\n\r\n                \r\n                                <!-- GRID -->\r\n                <div class=\"flex flex-wrap gap-3 max-w-[1130px] mx-auto mt-8 b767:mt-0 \r\n                    \">\r\n\r\n                    \r\n                    <div class=\"testimonial-box overflow-hidden bg-color5 rounded-[20px] b767:p-9 p-7 flex flex-col justify-between\r\n                    w-full b767:w-[calc(50%-6px)]\">\r\n\r\n                        <div class=\"flex gap-3\">\r\n                            <span class=\"box-number testimonial-box-number flex text-[10px] font-bold h-[32px] w-[32px] rounded-full bg-color2 justify-center items-center\">\r\n                                01                            <\/span>\r\n\r\n                                                        <div class=\"inline-flex z-10 font-semibold text-color4 bg-black py-2 px-6 rounded-3xl text-xs\">\r\n                                Coursebox AI                            <\/div>\r\n                                                    <\/div>\r\n\r\n                                                    <div class=\"b1600:py-[86px] z-10 b1024:py-60 py-40 b1600:px-60 b1400:px-40 font-medium leading-[150%] b767:text-[21px]\">\r\n                                <p>\u201cAI Advancements did a fantastic job at implementing AI chatbot tutors in our online training course software. Our customers are always looking for innovative ways to engage their learners, and that is exactly what they get with this amazing tech.\u201d<\/p>\n                            <\/div>\r\n                        \r\n                        <div class=\"z-10 flex justify-between items-end\">\r\n                            <div>\r\n                                <div class=\"font-bold leading-none\">Alex<\/div>\r\n                                                                    <div>CMO of Coursebox AI<\/div>\r\n                                                            <\/div>\r\n                                                            <div class=\"\">\r\n                                    <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/03\/6f13ba112b5398743526bc5a8e209f1138e8adb6.jpg\" \r\n                                        alt=\"Coursebox AI e-learning platform small logo thumbnail with purple 3D box icon and company name\" \r\n                                        width=\"auto\" \r\n                                        height=\"60\"\r\n                                        class=\"h-[60px] w-auto rounded-[10px]\">\r\n                                <\/div>\r\n                                                    <\/div>\r\n\r\n                    <\/div>\r\n\r\n                    \r\n                    <div class=\"testimonial-box overflow-hidden bg-color5 rounded-[20px] b767:p-9 p-7 flex flex-col justify-between\r\n                    w-full b767:w-[calc(50%-6px)]\">\r\n\r\n                        <div class=\"flex gap-3\">\r\n                            <span class=\"box-number testimonial-box-number flex text-[10px] font-bold h-[32px] w-[32px] rounded-full bg-color2 justify-center items-center\">\r\n                                02                            <\/span>\r\n\r\n                                                        <div class=\"inline-flex z-10 font-semibold text-color4 bg-black py-2 px-6 rounded-3xl text-xs\">\r\n                                Curtin University                            <\/div>\r\n                                                    <\/div>\r\n\r\n                                                    <div class=\"b1600:py-[86px] z-10 b1024:py-60 py-40 b1600:px-60 b1400:px-40 font-medium leading-[150%] text-[15px]\">\r\n                                <p>\u201cWe highly commend the AI team at AI Advancements, particularly Sean and Sam, for their outstanding contributions to our research projects at Curtin University. They successfully delivered several AI solutions with professional quality, demonstrating technical excellence and strong attention to detail.<\/p>\n<p>What stood out most was their clear and responsive communication, as well as their genuine dedication to customer satisfaction. Throughout the collaboration, they provided valuable advice on the latest AI technologies, helping us significantly improve our workflow and decision-making processes.<\/p>\n<p>It was a pleasure working with a team so committed to both innovation and service. We look forward to future collaborations with AI Advancements.\u201d<\/p>\n                            <\/div>\r\n                        \r\n                        <div class=\"z-10 flex justify-between items-end\">\r\n                            <div>\r\n                                <div class=\"font-bold leading-none\">Sonny Pham<\/div>\r\n                                                                    <div>Associate Professor<\/div>\r\n                                                            <\/div>\r\n                                                            <div class=\"\">\r\n                                    <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/03\/fe391a62f9a69290482800f8c1f2b1fd73ca9a57.jpg\" \r\n                                        alt=\"Curtin University small logo thumbnail with gold shield emblem and university name text\" \r\n                                        width=\"auto\" \r\n                                        height=\"60\"\r\n                                        class=\"h-[60px] w-auto rounded-[10px]\">\r\n                                <\/div>\r\n                                                    <\/div>\r\n\r\n                    <\/div>\r\n\r\n                    \r\n                <\/div>\r\n                            <\/div>\r\n        <\/div>\r\n\r\n  <\/section>\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n\r\n  \n\n    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\n        <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\n\n    <!-- BLOCK CODING STARTS HERE -->\n    <section \n        id=\"\" \n        data-name=\"acf_contact-form\"\n        data-lazyload=\"1\" \n        class=\"relative \" \n        style=\"z-index: 0; background-color:#FFFFFF;\">\n        <div id=\"contact-form-section\" class=\"bg-color4 b767:pt-100 pt-80 pb-80\">\n            <div class=\"container\">\n                <div class=\"flex flex-col b1024:flex-row justify-between gap-10\">\n                    <div class=\"b1024:w-[267px] b1200:w-[400px] text-center b1024:text-start\">\n                                                                                                                                        <h2 class=\"h2 animate-watch standard__headline block tracking-[-0.06em] mb-10\">Enquire now<\/h2>\n                                                                                                                                                            <div class=\"\">\n                                <p>Talk to us about where your teams lose time today; searching for information, updating systems, or repeating the same tasks.<\/p>\n<p>We\u2019ll help you identify where AI Chatbots can automate work, improve access to information, and integrate cleanly with how your organisation already operates.<\/p>\n                            <\/div>\n                                            <\/div>\n                    <div class=\"contact-shortcode frontend form b1024:w-[783px]\">\n                        <script>\nvar gform;gform||(document.a