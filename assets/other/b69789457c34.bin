68x853.webp 768w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/WhatsApp-Image-2026-08-13-at-13.00.41.webp 800w\"\r\n                                        sizes=\"auto, 160px\"\r\n                                        alt=\"\" \/>\r\n                                <\/div>\r\n                            <\/div>\r\n                                                    <div class=\"splide__slide\">\r\n                                <div class=\"slider-logo h-full\">\r\n                                    <img decoding=\"async\"\r\n                                        loading=\"lazy\"\r\n                                        style=\"width: 160px; height: 70px;\"\r\n                                        width=\"160\"\r\n                                        height=\"70\"\r\n                                        class=\"h-[70px] b767:h-[100px] w-[160px] object-contain\"\r\n                                        src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/images-300x72.png\"\r\n                                        srcset=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/images-300x72.png 300w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/images.png 738w\"\r\n                                        sizes=\"auto, 160px\"\r\n                                        alt=\"\" \/>\r\n                                <\/div>\r\n                            <\/div>\r\n                                            <\/div>\r\n                <\/div>\r\n            <\/div>\r\n            \r\n            <div class=\"b1024:mb-[130px] mb-[80px]\"><\/div>\r\n                                    <div class=\"container\">\r\n                <div class=\"ls-border relative\"><\/div>\r\n            <\/div>\r\n                    <\/div>\r\n\r\n        <style>\r\n        .logo_slider .splide__list { will-change: transform; }\r\n        .logo_slider .splide__track { contain: layout;}\r\n        .slider-logo img {\r\n            aspect-ratio: 160 \/ 100;\r\n        }\r\n        <\/style>\r\n\r\n  <\/section>\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n\r\n  \n\n  <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n  <section \r\n      id=\"\" \r\n      data-name=\"acf_custom-project\"\r\n      data-lazyload=\"1\" \r\n      class=\"relative \" \r\n      style=\"z-index: 0;\">\r\n      <div class=\"b767:py-100 py-80\">\r\n        <div class=\"container\">\r\n                            <div class=\"subheading-wrap text-center\">\r\n                        <h2 class=\" animate-watch standard__headline inline-flex font-semibold text-color1 bg-color4 py-2 px-6 rounded-3xl text-xs b1024:mb-[90px] mb-10 !tracking-[-0.02em]\">Our AI Strategy consulting projects<\/h2>\n                    <\/div>\r\n                        <div class=\"b1024:mb-[90px] mb-10 \">\r\n                                    <div class=\"heading-wrap max-w-[900px] mx-auto text-center mb-10\">\r\n                                <h3 class=\"h2 animate-watch standard__headline block\">What AI Strategy looks like when it delivers in the real world<\/h3>\n                        <\/div>\r\n                                                    <div class=\"summary-wrap text-center max-w-[669px] mx-auto\">\r\n                        <blockquote data-start=\"665\" data-end=\"1016\">\n<p class=\"PDq2pG_selectionAnchorContainer\" data-start=\"667\" data-end=\"1016\">A strong AI strategy gives teams the clarity to act and the confidence to invest. These case studies show how that translates into real improvements across operations, efficiency, and decision-making.<\/p>\n<p class=\"PDq2pG_selectionAnchorContainer\" data-start=\"667\" data-end=\"1016\">Explore our <a href=\"https:\/\/aiadvancements.com.au\/case-studies\/\">AI strategy case studies<\/a> to see how we&#8217;ve helped Australian organisations turn AI opportunities into practical, actionable roadmaps.<\/p>\n<\/blockquote>\n<p data-start=\"1018\" data-end=\"1033\">\n<p>&nbsp;<\/p>\n                    <\/div>\r\n                            <\/div>\r\n        <\/div>\r\n        <div class=\"splide project_slider\" aria-label=\"project slider\">\r\n            <div class=\"splide__track\">\r\n                <ul class=\"splide__list\">\r\n                    \r\n                            <li class=\"splide__slide\">\r\n                                <div class=\"bg-color4 b1400:py-100 b1400:px-[115px] b1200:p-80 b767:p-60 px-20 py-60 flex flex-col b1024:flex-row h-full text-center b767:text-start\">\r\n                                    \r\n                                    <!-- LEFT -->\r\n                                    <div class=\"flex flex-col justify-between b1024:w-[337px] b767:mb-10 mb-8 b1024:mb-0 gap-10\">\r\n                                        \r\n                                        <h3 class=\"b1024:text-[40px] text-3xl font-normal leading-none\">\r\n                                            Glass Co Metro: A Board-Ready AI Roadmap That Delivered $100K+ in Value Within Two Months                                        <\/h3>\r\n\r\n                                        <div>\r\n                                            <img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"683\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/glassco-metro-1024x683.png\" class=\"w-full object-cover rounded-[10px] wp-post-image\" alt=\"Glass Co Metro company logo showing a black star in a square frame icon with bold company name, alongside AI Advancements logo and AI Strategy service label\" srcset=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/glassco-metro-1024x683.png 1024w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/glassco-metro-300x200.png 300w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/glassco-metro-768x512.png 768w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/glassco-metro.png 1536w\" sizes=\"auto, (max-width: 1024px) 100vw, 1024px\" \/>                                        <\/div>\r\n\r\n                                    <\/div>\r\n\r\n                                    <!-- RIGHT -->\r\n                                    <div class=\"flex flex-col justify-between flex-1 b1400:pl-[86px] b1200:pl-60 b1400:ml-[86px] b1200:ml-[60px] b1024:pl-40 b1024:ml-10 b1024:border-l b1024:border-color1\">\r\n                                        \r\n                                        <div class=\"text-base\">\r\n                                            A board-ready roadmap narrowed 20+ AI ideas to 7 investment-ready use cases, two of which delivered over $100K in value within two months of build.                                        <\/div>\r\n\r\n                                        <div class=\"flex mt-8\">\r\n                                            <a href=\"https:\/\/aiadvancements.com.au\/case-study\/ai-tech-assessment-and-roadmap\/\" class=\"btn btn-solidcolor1 flex justify-center items-center gap-2 overflow-hidden mx-auto b767:mx-0\">\r\n                                                <span class=\"block circle relative\"><\/span>\r\n                                                <div class=\"button-text z-10\">Read more<\/div>\r\n                                            <\/a>\r\n                                        <\/div>\r\n\r\n                                    <\/div>\r\n\r\n                                <\/div>\r\n                            <\/li>\r\n\r\n                        \r\n                            <li class=\"splide__slide\">\r\n                                <div class=\"bg-color4 b1400:py-100 b1400:px-[115px] b1200:p-80 b767:p-60 px-20 py-60 flex flex-col b1024:flex-row h-full text-center b767:text-start\">\r\n                                    \r\n                                    <!-- LEFT -->\r\n                                    <div class=\"flex flex-col justify-between b1024:w-[337px] b767:mb-10 mb-8 b1024:mb-0 gap-10\">\r\n                                        \r\n                                        <h3 class=\"b1024:text-[40px] text-3xl font-normal leading-none\">\r\n                                            Scott Park Group: Using AI to Decode Thousands of AP Emails &#8211; and Build the Case for Automation                                        <\/h3>\r\n\r\n                                        <div>\r\n                                            <img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"683\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/scott-park-group-1024x683.png\" class=\"w-full object-cover rounded-[10px] wp-post-image\" alt=\"Scott Park Group logo with red company name text and red diamond shape with white star, overlaid on email envelope icons background representing AI-powered email analysis for the Scott Park Group\" srcset=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/scott-park-group-1024x683.png 1024w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/scott-park-group-300x200.png 300w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/scott-park-group-768x512.png 768w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/scott-park-group.png 1536w\" sizes=\"auto, (max-width: 1024px) 100vw, 1024px\" \/>                                        <\/div>\r\n\r\n                                    <\/div>\r\n\r\n                                    <!-- RIGHT -->\r\n                                    <div class=\"flex flex-col justify-between flex-1 b1400:pl-[86px] b1200:pl-60 b1400:ml-[86px] b1200:ml-[60px] b1024:pl-40 b1024:ml-10 b1024:border-l b1024:border-color1\">\r\n                                        \r\n                                        <div class=\"text-base\">\r\n                                            LLM-driven analysis of thousands of AP emails gave Scott Park Group a validated automation roadmap, without exposing a single piece of sensitive content.                                        <\/div>\r\n\r\n                                        <div class=\"flex mt-8\">\r\n                                            <a href=\"https:\/\/aiadvancements.com.au\/case-study\/ai-email-agent-case-study\/\" class=\"btn btn-solidcolor1 flex justify-center items-center gap-2 overflow-hidden mx-auto b767:mx-0\">\r\n                                                <span class=\"block circle relative\"><\/span>\r\n                                                <div class=\"button-text z-10\">Read more<\/div>\r\n                                            <\/a>\r\n                                        <\/div>\r\n\r\n                                    <\/div>\r\n\r\n                                <\/div>\r\n                            <\/li>\r\n\r\n                                        <\/ul>   \r\n            <\/div>\r\n        <\/div>\r\n    <\/div>\r\n  <\/section>\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n\r\n  \n\n  <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n  <section \r\n      id=\"\" \r\n      data-name=\"acf_testimonials\"\r\n      data-lazyload=\"1\" \r\n      class=\"relative \" \r\n      style=\"z-index: 0;\">\r\n        <div class=\"testimonials-area b1024:py-[120px] py-80 bg-color3\">\r\n            <div class=\"container\">\r\n                                    <div class=\"subheading-wrap text-center\">\r\n                                <h2 class=\" animate-watch standard__headline inline-flex font-semibold text-color1 bg-color2 py-2 px-6 rounded-3xl text-xs mx-auto b767:mx-0 b767:mb-16 mb-10\">Hear from the teams we work with<\/h2>\n                        <\/div>\r\n                                <div class=\"grid grid-cols-1 b767:grid-cols-2 gap-6 b1024:mb-[90px] mb-[70px] text-center b767:text-start max-w-[1130px] mx-auto\">\r\n                                            <div class=\"heading-wrap w-full b767:w-auto\">\r\n                                    <h3 class=\"h2 animate-watch standard__headline block\">Why WA teams <br>are working with us<\/h3>\n                            <\/div>\r\n                                                                <div class=\"summary-wrap text-center b767:text-start b1024:pl-[60px] b1400:pl-[116px]\">\r\n                            <p>Teams across WA rely on us for our AI-native expertise, our responsiveness, and the confidence we bring to complex operational environments. Here\u2019s what our clients say about working with our AI strategy consultants:<\/p>\n                        <\/div>\r\n                                    <\/div>\r\n            \r\n\r\n\r\n                \r\n                \r\n                <!-- SLIDER -->\r\n                <div class=\"testimonials-wrap pl-10 b767:pl-6 b1400:pl-0\">\r\n                    <div class=\"testimonials_slider splide overflow-visible\">\r\n                        <div class=\"splide__track overflow-visible\">\r\n                            <div class=\"splide__list flex\">\r\n\r\n                                \r\n                                <div class=\"splide__slide testimonial-box overflow-hidden bg-color5 rounded-[20px] b767:p-9 p-7 flex flex-col justify-between transition-transform duration-500 ease-out origin-bottom hover:scale-y-[1.05]\">\r\n\r\n                                    <div class=\"flex\">\r\n                                        <span class=\"box-number testimonial-box-number flex text-[10px] font-bold transition-all duration-700 h-[32px] w-[32px] rounded-full bg-color2 justify-center items-center\">\r\n                                            01                                        <\/span>\r\n                                                                                <div class=\"inline-flex z-10 font-semibold text-color4 bg-black py-2 px-6 rounded-3xl text-xs\">\r\n                                            Operations Manager                                        <\/div>\r\n                                                                            <\/div>\r\n\r\n                                                                            <div class=\"b1600:py-[86px] z-10 b1024:py-60 py-40 b1600:px-60 b1400:px-40 font-medium leading-[150%] b767:text-[21px]\">\r\n                                            <p>&#8220;AIA facilitators were extremely engaging, breaking down complex topics into simple language to guide our understanding of what is possible. They were focused on our business context helping us identify valuable operational excellence use cases.&#8221;<\/p>\n                                        <\/div>\r\n                                    \r\n                                    <div class=\"z-10 flex justify-between items-end\">\r\n                                        <div>\r\n                                            <div class=\"font-bold leading-none\">Gina<\/div>\r\n                                                                                    <\/div>\r\n                                                                                    <div class=\"\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/03\/b92eb21f9f3ce477b0f57013407526287e5f97a5.jpg\" \r\n                                                    alt=\"Glass Co Metro small logo showing star icon in a frame with company name, used as a client profile identifier\" \r\n                                                    class=\"h-[60px] w-auto rounded-[10px]\">\r\n                                            <\/div>\r\n                                                                            <\/div>\r\n\r\n                                <\/div>\r\n\r\n                                \r\n                                <div class=\"splide__slide testimonial-box overflow-hidden bg-color5 rounded-[20px] b767:p-9 p-7 flex flex-col justify-between transition-transform duration-500 ease-out origin-bottom hover:scale-y-[1.05]\">\r\n\r\n                                    <div class=\"flex\">\r\n                                        <span class=\"box-number testimonial-box-number flex text-[10px] font-bold transition-all duration-700 h-[32px] w-[32px] rounded-full bg-color2 justify-center items-center\">\r\n                                            02                                        <\/span>\r\n                                                                                <div class=\"inline-flex z-10 font-semibold text-color4 bg-black py-2 px-6 rounded-3xl text-xs\">\r\n                                            Coursebox AI                                        <\/div>\r\n                                                                            <\/div>\r\n\r\n                                                                            <div class=\"b1600:py-[86px] z-10 b1024:py-60 py-40 b1600:px-60 b1400:px-40 font-medium leading-[150%] b767:text-[21px]\">\r\n                                            <p>\u201cAI Advancements did a fantastic job at implementing AI chatbot tutors in our online training course software. Our customers are always looking for innovative ways to engage their learners, and that is exactly what they get with this amazing tech.\u201d<\/p>\n                                        <\/div>\r\n                                    \r\n                                    <div class=\"z-10 flex justify-between items-end\">\r\n                                        <div>\r\n                                            <div class=\"font-bold leading-none\">Alex<\/div>\r\n                                                                                            <div>CMO of Coursebox AI<\/div>\r\n                                                                                    <\/div>\r\n                                                                                    <div class=\"\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/03\/6f13ba112b5398743526bc5a8e209f1138e8adb6.jpg\" \r\n                                                    alt=\"Coursebox AI e-learning platform small logo thumbnail with purple 3D box icon and company name\" \r\n                                                    class=\"h-[60px] w-auto rounded-[10px]\">\r\n                                            <\/div>\r\n                                                                            <\/div>\r\n\r\n                                <\/div>\r\n\r\n                                \r\n                                <div class=\"splide__slide testimonial-box overflow-hidden bg-color5 rounded-[20px] b767:p-9 p-7 flex flex-col justify-between transition-transform duration-500 ease-out origin-bottom hover:scale-y-[1.05]\">\r\n\r\n                                    <div class=\"flex\">\r\n                                        <span class=\"box-number testimonial-box-number flex text-[10px] font-bold transition-all duration-700 h-[32px] w-[32px] rounded-full bg-color2 justify-center items-center\">\r\n                                            03                                        <\/span>\r\n                                                                                <div class=\"inline-flex z-10 font-semibold text-color4 bg-black py-2 px-6 rounded-3xl text-xs\">\r\n                                            Zen Hosting                                        <\/div>\r\n                                                                            <\/div>\r\n\r\n                                                                            <div class=\"b1600:py-[86px] z-10 b1024:py-60 py-40 b1600:px-60 b1400:px-40 font-medium leading-[150%] b767:text-[21px]\">\r\n                                            <p>\u201cSam and Sean are highly skilled, reliable and bring exceptional expertise to AI consultancy. They deliver practical, tailored solutions and are a pleasure to work with.\u201d<\/p>\n                                        <\/div>\r\n                                    \r\n                                    <div class=\"z-10 flex justify-between items-end\">\r\n                                        <div>\r\n                                            <div class=\"font-bold leading-none\">Travis Bellos<\/div>\r\n                                                                                    <\/div>\r\n                                                                                    <div class=\"\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/zenhosting.png\" \r\n                                                    alt=\"ZenHosting logo - red dot matrix grid icon alongside ZenHosting text in black and red on transparent background\" \r\n                                                    class=\"h-[60px] w-auto rounded-[10px]\">\r\n                                            <\/div>\r\n                                                                            <\/div>\r\n\r\n                                <\/div>\r\n\r\n                                \r\n                            <\/div>\r\n                        <\/div>\r\n                    <\/div>\r\n\r\n                    <div class=\"splide__arrows testimonals-nav flex justify-start gap-2 mt-4\">\r\n                          <button class=\"splide__arrow splide__arrow--prev w-[43px] h-[43px] group flex justify-center items-center rounded-[6px] bg-color1 hover:bg-color2 overflow-hidden transition duration-500 ease-in cursor-pointer hover:color1\" aria-label=\"go to previous slide\">\n    <span class=\"icon\">\n      <svg width=\"8\" height=\"9\" viewBox=\"0 0 8 9\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M0.5 3.16669C-0.166666 3.55159 -0.166667 4.51384 0.5 4.89874L5.75 7.92983C6.41667 8.31473 7.25 7.8336 7.25 7.0638L7.25 1.00163C7.25 0.231826 6.41667 -0.2493 5.75 0.135601L0.5 3.16669Z\" fill=\"#C2CEE8\"\/>\n      <\/svg>\n    <\/span>\n  <\/button>\n\n  <button class=\"splide__arrow splide__arrow--next w-[43px] h-[43px] group flex justify-center items-center rounded-[6px] bg-color1 hover:bg-color2 overflow-hidden transition duration-500 ease-in cursor-pointer hover:color1\" aria-label=\"go to next slide\">\n    <span class=\"icon\">\n      <svg width=\"8\" height=\"9\" viewBox=\"0 0 8 9\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M6.75 3.16669C7.41667 3.55159 7.41667 4.51384 6.75 4.89874L1.5 7.92983C0.833334 8.31473 5.4712e-07 7.8336 5.80769e-07 7.0638L8.45755e-07 1.00163C8.79404e-07 0.231826 0.833334 -0.2493 1.5 0.135601L6.75 3.16669Z\" fill=\"#C2CEE8\"\/><\/svg>\n    <\/span>\n  <\/button>\n                      <\/div>\r\n                <\/div>\r\n\r\n                            <\/div>\r\n        <\/div>\r\n\r\n  <\/section>\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n\r\n  \n\n  <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\n    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\n\n  <!-- BLOCK CODING STARTS HERE -->\n  <section \n      id=\"\" \n      data-name=\"acf_img-with-text\"\n      data-lazyload=\"1\" \n      class=\"relative \" \n      style=\"z-index: 0;\">\n      <div class=\"img-with-text-area relative b767:py-100 py-80\">\n        <div class=\"container relative\">\n            <div class=\"iwt-content-wrap grid grid-cols-1 b1024:grid-cols-2 items-center b1400:px-80\">\n                <div class=\"iwt-content b1024:pr-40 b1200:pr-80 b1400:pr-[100px] text-center b1024:text-start mb-14 b1024:mb-0\">\n                                            <div class=\"hero-heading\">\n                                <h2 class=\"h2 animate-watch standard__headline block mb-6 b767:mb-10\">Talk to our team <br>about your AI <br>Strategy<\/h2>\n                            <\/div>\n                                                                <div class=\"hero-summary b1024:max-w-[438px] my-10 b1024:my-16\">\n                            <p>AI Strategy doesn\u2019t need to be complex or overwhelming. Our Perth-based team helps you understand where AI can add real value, what\u2019s actually feasible, and the smartest place to start.<\/p>\n<p>Whether you need a clear roadmap, a fast Kickstarter, or guidance on your next steps, we\u2019ll translate your goals into a practical, actionable plan, and support you through delivery if you choose to move ahead.<\/p>\n                        <\/div>\n                                        <div class=\"button-wrap flex flex-col b767:flex-row items-center justify-center b1024:justify-start gap-3 overflow-hidden\">\n                                    <a href=\"https:\/\/aiadvancements.com.au\/contact\/\" target=\"\" class=\"btn btn-solidcolor1 speak-btn flex items-center gap-3 overflow-hidden\">\n                <span class=\"block circle relative\"><\/span>\n                <span class=\"button-text z-10\">Speak to us<\/span>\n            <\/a>\n                                                <a href=\"\/#services\" target=\"\" class=\"btn outline-color1 text-center overflow-hidden relative z-10\">\n                See our services            <\/a>\n                                <\/div>\n                <\/div>\n                <div class=\"iwt-img relative\">\n                                                                <div class=\"overlay-color2\"><\/div>\n                        <div class=\"overlay-color6\"><\/div>\n                        <div class=\"ai-text-two text-xs bg-color2 leading-none pt-[5px] pb-[6px] px-[9px] rounded-3xl\">&lt;ai.advancements&gt;<\/div>\n                                                                                    <picture class=\"w-full h-full\"><source media=\"(min-width: 481px)\" srcset=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/03\/Mask-group2.jpg\"><img decoding=\"async\" class=\"w-full h-full\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/03\/Mask-group2.jpg\" alt=\"Two smiling AI Advancements consultants, one with beard in foreground and another behind, representing the approachable AI Strategy consulting team\" style=\"object-fit:contain;object-position:center;\" loading=\"lazy\" width=\"553\" height=\"707\" \/><\/picture>                                    <\/div>\n            <\/div>\n        <\/div>\n      <\/div>\n  <\/section>\n  <!-- BLOCK CODING STARTS HERE -->\n\n  ","protected":false},"excerpt":{"rendered":"","protected":false},"author":5,"featured_media":0,"parent":0,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"","meta":{"_acf_changed":false,"footnotes":""},"class_list":["post-437","page","type-page","status-publish","hentry"],"acf":[],"_links":{"self":[{"href":"https:\/\/aiadvancements.com.au\/wp-json\/wp\/v2\/pages\/437","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/aiadvancements.com.au\/wp-json\/wp\/v2\/pages"}],"about":[{"href":"https:\/\/aiadvancements.com.au\/wp-json\/wp\/v2\/types\/page"}],"author":[{"embeddable":true,"href":"https:\/\/aiadvancements.com.au\/wp-json\/wp\/v2\/users\/5"}],"replies":[{"embeddable":true,"href":"https:\/\/aiadvancements.com.au\/wp-json\/wp\/v2\/comments?post=437"}],"version-history":[{"count":76,"href":"https:\/\/aiadvancements.com.au\/wp-json\/wp\/v2\/pages\/437\/revisions"}],"predecessor-version":[{"id":2315,"href":"https:\/\/aiadvancements.com.au\/wp-json\/wp\/v2\/pages\/437\/revisions\/2315"}],"wp:attachment":[{"href":"https:\/\/aiadvancements.com.au\/wp-json\/wp\/v2\/media?parent=437"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}