{"id":437,"date":"2026-03-08T15:56:19","date_gmt":"2026-03-08T15:56:19","guid":{"rendered":"https:\/\/aiadvancements.dilatevps1.cloudsites.net.au\/?page_id=437"},"modified":"2026-08-10T15:32:50","modified_gmt":"2026-08-10T07:32:50","slug":"ai-strategy","status":"publish","type":"page","link":"https:\/\/aiadvancements.com.au\/ai-strategy\/","title":{"rendered":"AI Strategy"},"content":{"rendered":"    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\n        <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\n\n    <!-- BLOCK CODING STARTS HERE -->\n    <section \n        id=\"\" \n        data-name=\"acf_internal-hero\"\n        data-lazyload=\"1\" \n        class=\"relative \" \n        style=\"z-index: 0; background-color:#FFFFFF;\">\n        <div class=\"bg-color5 b1200:pt-200 b767:pt-180 pt-150\">\n            <div class=\"container\">\n                <div class=\"internal-hero-details max-w-[912px] mx-auto b1024:pb-24 b767:pb-20 pb-12\">\n\t\t\t\t\t                    <div class=\"text-center flex items-center mb-[44px]\">\n                        <div class=\"h-[32px] w-[32px] rounded-full bg-color2 flex items-center justify-center\">\n                            <svg width=\"19\" height=\"8\" viewBox=\"0 0 30 13\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M10.1112 0C10.1112 5.75168 5.57492 10.4294 0 10.4294V12.6557C5.60316 12.6557 10.3408 8.76349 11.8042 3.46214V12.6329H13.9649V0H10.11H10.1112Z\" fill=\"#131924\"\/><path d=\"M19.8559 0H16.001V12.6342H18.1617V3.46214C19.6251 8.76223 24.364 12.6557 29.9659 12.6557V10.4294C24.391 10.4294 19.8547 5.75041 19.8547 0H19.8559Z\" fill=\"#131924\"\/><\/svg>\n                        <\/div>\n\t\t\t\t\t\t        <h1 class=\" animate-watch standard__headline inline-flex font-semibold text-color1 bg-color4 py-[11px] px-6 rounded-3xl text-xs super-title\">AI Strategy Consulting for Perth &#038; Australian Organisations<\/h1>\n                        <\/div>\n\t\t\t\t\t\n                    \n                    \n                        <!-- HEADLINE + BELOW HEADLINE -->\n                        <div>\n                                    <h2 class=\"h1 animate-watch standard__headline block tracking-[-0.06em]\">AI Strategy<\/h2>\n                                        <h3 class=\"h3 animate-watch standard__headline block text-color1 b767:mb-10 b767:mt-10 mt-8\">AI is complex, crowded with hype, and shifting by the week. We provide clarity and direction through a grounded strategy that shows where AI can genuinely strengthen your business today. <\/h3>\n    \n                            <div class=\"button-wrap inline-flex flex-col b767:flex-row gap-3 mt-[30px]\">\n                                            <a href=\"https:\/\/aiadvancements.com.au\/contact\/\" target=\"\" class=\"btn btn-solidcolor1 speak-btn flex items-center gap-3 overflow-hidden\">\n                <span class=\"block circle relative\"><\/span>\n                <span class=\"button-text z-10\">Speak to a human<\/span>\n            <\/a>\n                                                        <a href=\"\/#services\" target=\"\" class=\"btn btn-secondary-alt outline-color1 text-center overflow-hidden relative z-10\">\n                Explore our AI services            <\/a>\n                                        <\/div>\n                        <\/div>\n\n                                    <\/div>\n            <\/div>\n            \n                        <div class=\"internal-hero-video video-expand-wrapper\">\n\n                <div class=\"hero-video-wrapper relative\">\n\n                    <!-- ===================== -->\n                    <!-- MEDIA -->\n                    <!-- ===================== -->\n                    <div class=\"desktop-media\">\n\n                        \n                        \n                            <!-- DESKTOP VIDEO -->\n                                                        <div class=\"hero-oembed desktop-only w-full h-full\">\n                                <iframe \n                                    src=\"https:\/\/player.vimeo.com\/video\/1192473123?autoplay=0&#038;muted=0&#038;background=0&#038;controls=1&#038;title=0&#038;byline=0&#038;portrait=0&#038;dnt=1&#038;sidedock=0\" \n                                    frameborder=\"0\" \n                                    allow=\"autoplay; fullscreen\" \n                                    allowfullscreen>\n                                <\/iframe>\n                            <\/div>\n\n                            <!-- MOBILE VIDEO -->\n                                                        <div class=\"hero-oembed mobile-only w-full h-full\">\n                                <iframe \n                                    src=\"https:\/\/player.vimeo.com\/video\/1192480911?autoplay=0&#038;muted=0&#038;background=0&#038;controls=1&#038;title=0&#038;byline=0&#038;portrait=0&#038;dnt=1&#038;sidedock=0\" \n                                    frameborder=\"0\" \n                                    allow=\"autoplay; fullscreen\" \n                                    allowfullscreen>\n                                <\/iframe>\n                            <\/div>\n\n                        \n                    <\/div>\n\n                    <!-- ===================== -->\n                    <!-- THUMBNAIL -->\n                    <!-- ===================== -->\n                                            <div class=\"video-thumbnail absolute inset-0 z-20\">\n                            <picture class=\"w-full h-full\"><source media=\"(min-width: 481px)\" srcset=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/05\/image-1.jpg\"><img decoding=\"async\" class=\"w-full h-full\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/05\/image-1.jpg\" alt=\"AI Advancements consultant smiling with text inviting viewers to get started with AI strategy for their business\" style=\"object-fit:cover;object-position:center;\" loading=\"lazy\" width=\"1643\" height=\"917\" \/><\/picture>                        <\/div>\n                    \n                    <!-- ===================== -->\n                    <!-- PLAY BUTTON -->\n                    <!-- ===================== -->\n                                            <button class=\"video-toggle absolute inset-0 flex items-center justify-center z-30\">\n                            <span class=\"play-btn flex items-center justify-center\">\n                                <svg width=\"98\" height=\"98\" viewBox=\"0 0 98 98\" fill=\"none\">\n                                    <circle cx=\"49\" cy=\"49\" r=\"49\" fill=\"#FCFF6A\"\/>\n                                    <path d=\"M68 49L39.5 65.4545L39.5 32.5455L68 49Z\" fill=\"#131924\"\/>\n                                <\/svg>\n                            <\/span>\n                        <\/button>\n                    \n                <\/div>\n\n            <\/div>\n                    <\/div>\n    <\/section>\n    <!-- BLOCK CODING STARTS HERE -->\n\n    \n\n  <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n \r\n  <!-- BLOCK CODING STARTS HERE -->\r\n<section\r\n      id=\"\"\r\n      data-name=\"acf_ai-strategy-services\"\r\n      data-lazyload=\"1\"\r\n      class=\"relative \"\r\n      style=\"z-index: 0;\">\r\n    <div id=\"services\" class=\"b1024:py-[124px] py-[80px]\">\r\n        <div class=\"container\">\r\n            <div class=\"max-w-[900px] mx-auto grid grid-cols-1 b1024:grid-cols-2 gap-0 b1024:gap-[68px]\">\r\n                   \r\n                                    <div class=\"heading-wrap text-center b767:text-start\">\r\n                                <h2 class=\"h2 animate-watch standard__headline block mb-10\">Our AI Strategy services<\/h2>\n                        <\/div>\r\n                               \r\n                                    <div class=\"summary-wrap text-center b767:text-start\">\r\n                        <p>Executives come to us when they know AI matters, but don\u2019t yet know where to start. Our AI strategy services give you clarity, direction, and a practical path forward, built by a Perth-based team that works with AI every day.<\/p>\n                    <\/div>\r\n                 \r\n            <\/div>\r\n \r\n            <!-- Strategy CONTENT -->\r\n                            <div class=\"strategy-contents max-w-[1130px] mx-auto mt-10 b767:mt-[90px] grid grid-cols-1 b1024:grid-cols-2 gap-[70px]\">\r\n                                            <div class=\"stategy-content-item\">\r\n                            <div class=\"strategy-circle-content pb-[60px] mb-8 relative\">\r\n                                <div class=\"strategy-circle mx-auto bg-[#FCFF6A] flex flex-col justify-center items-center rounded-full max-w-[530px] max-h-[530px] h-full w-full aspect-square relative overflow-hidden\">\r\n \r\n                                                                            <h3 class=\"text-center\">AI Roadmap<\/h3>\r\n                                     \r\n                                                                            <div class=\"stategy-text leading-[20px] b767:leading-[24px] text-[12px] b767:text-base max-w-[315px] mx-auto\">\r\n                                            <p>A comprehensive, end-to-end strategy engagement for organisations that want a clear, organisation-wide plan for AI adoption. <\/p>\n<p>We set up AI governance, train your teams, collect and prioritise use cases, and map the highest-value AI opportunities. The result is a board-ready roadmap with timelines, costs, feasibility and expected value, giving you confidence to invest and move.<\/p>\n                                        <\/div>\r\n                                     \r\n                                <\/div>\r\n                            <\/div>\r\n \r\n                                                                                        <div class=\"strategy-list-content\">\r\n \r\n                                                                            <div class=\"strategy-list-content-item\">\r\n \r\n                                                                                            <h3>What\u2019s included<\/h3>\n<ul>\n<li>Comprehensive AI Governance Framework<\/li>\n<li>AI upskilling workshop\/s<\/li>\n<li>AI use case collection<\/li>\n<li>Structured prioritisation workshop<\/li>\n<li>Technically map the top 5 use cases<\/li>\n<li>Consolidated AI roadmap report<\/li>\n<li>AI acceptable use policy and AI governance review<\/li>\n<\/ul>\n                                             \r\n                                        <\/div>\r\n                                                                            <div class=\"strategy-list-content-item\">\r\n \r\n                                                                                            <h3>Value you can measure<\/h3>\n<ul>\n<li>Clear enterprise-wide AI direction<\/li>\n<li>Governance alignment and risk reduction<\/li>\n<li>Prioritised pipeline of high-value AI initiatives<\/li>\n<li>Accurate costings and implementation sequencing<\/li>\n<li>Board alignment and approval for next steps<\/li>\n<\/ul>\n                                             \r\n                                        <\/div>\r\n                                     \r\n                                <\/div>\r\n                                                    <\/div>\r\n                                            <div class=\"stategy-content-item\">\r\n                            <div class=\"strategy-circle-content pb-[60px] mb-8 relative\">\r\n                                <div class=\"strategy-circle mx-auto bg-[#FCFF6A] flex flex-col justify-center items-center rounded-full max-w-[530px] max-h-[530px] h-full w-full aspect-square relative overflow-hidden\">\r\n \r\n                                                                            <h3 class=\"text-center\">AI Kickstarter<\/h3>\r\n                                     \r\n                                                                            <div class=\"stategy-text leading-[20px] b767:leading-[24px] text-[12px] b767:text-base max-w-[315px] mx-auto\">\r\n                                            <p>A streamlined version of the AI Roadmap for small\u2013medium organisations that need clarity fast. One workshop, a focused prioritisation session, and deep dives into your top three AI opportunities that align with your business goals.<\/p>\n<p>You receive a clear roadmap with costs, technical requirements, and business value, everything you need to take immediate action.<\/p>\n                                        <\/div>\r\n                                     \r\n                                <\/div>\r\n                            <\/div>\r\n \r\n                                                                                        <div class=\"strategy-list-content\">\r\n \r\n                                                                            <div class=\"strategy-list-content-item\">\r\n \r\n                                                                                            <h3>What\u2019s included<\/h3>\n<ul>\n<li>Leadership workshop to understand your goals and processes<\/li>\n<li>Collection and prioritisation of AI use cases<\/li>\n<li>Technically map the top three use cases (and the costings, feasibility, and technical architecture for each)<\/li>\n<li>Clear action plan for your first AI projects<\/li>\n<\/ul>\n                                             \r\n                                        <\/div>\r\n                                                                            <div class=\"strategy-list-content-item\">\r\n \r\n                                                                                            <h3>Value you can measure<\/h3>\n<ul>\n<li>Immediate clarity on where to start<\/li>\n<li>Fast prioritisation of high-impact opportunities<\/li>\n<li>Technical confidence with expert-defined solutions<\/li>\n<li>Roadmap to move straight into development<\/li>\n<\/ul>\n                                             \r\n                                        <\/div>\r\n                                     \r\n                                <\/div>\r\n                                                    <\/div>\r\n                                    <\/div>\r\n                        <div class=\"button-wrap inline-flex flex-col b767:flex-row justify-center gap-3 b1024:mt-14 mt-10 w-full\">\r\n                            <a href=\"https:\/\/aiadvancements.com.au\/contact\/\" target=\"\" class=\"btn btn-solidcolor1 speak-btn flex items-center gap-3 overflow-hidden\">\n                <span class=\"block circle relative\"><\/span>\n                <span class=\"button-text z-10\">Speak to a human<\/span>\n            <\/a>\n                                        <\/div>\r\n        <\/div>\r\n    <\/div>\r\n\r\n\r\n<\/section>\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n \r\n  \n\n  <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n \r\n  <!-- BLOCK CODING STARTS HERE -->\r\n<section\r\n      id=\"\"\r\n      data-name=\"acf_approach-tab\"\r\n      data-lazyload=\"1\"\r\n      class=\"relative \"\r\n      style=\"z-index: 0;\">\r\n    <div class=\"b1024:py-[124px] py-[80px] bg-color3 \" style=\"background-color: \">\r\n        <div class=\"container\">\r\n            <div class=\"max-w-[1130px] mx-auto\">\r\n                <div class=\"approach-title max-w-[664px] mx-auto b767:mb-[74px] mb-12 text-center \">\r\n                                            <div class=\"heading-wrap flex-1\">\r\n                                    <h2 class=\"h2 animate-watch standard__headline block mb-10\">Our approach to building your AI Strategy<\/h2>\n                            <\/div>\r\n                                        <div class=\"summary-wrap ml-auto\">\r\n                                                    <div class=\"approach-text\">\r\n                                <p>Our process is designed to remove the overwhelm. We work with your team to understand your goals, prioritise your strongest AI opportunities, and turn them into a clear, practical roadmap you can act on immediately.<\/p>\n                            <\/div>\r\n                                                \r\n                                            <\/div>\r\n                <\/div>\r\n            <\/div>\r\n        <\/div>\r\n        <div class=\"approach-content\">\r\n\r\n            <!-- TAB BUTTONS -->\r\n            <div class=\"tab-button-group flex justify-center gap-6 mb-11\">\r\n                                                                                                <button class=\"tab-button\" data-tab=\"0\">\r\n                            AI Roadmap                        <\/button>\r\n                                                                                                    <button class=\"tab-button\" data-tab=\"1\">\r\n                            AI Kickstarter                        <\/button>\r\n                                                <\/div>\r\n\r\n            <!-- TAB CONTENT -->\r\n            <div class=\"tab-contents\">\r\n\r\n                                                        \r\n                    <div class=\"tab-content-list transition-opacity duration-300\">\r\n\r\n                                                                            <div class=\"tab-content-row\">\r\n                                <div class=\"tab-content-inner gap-5 b767:gap-0 flex-col b767:flex-row\">\r\n                                    <div class=\"number-and-image w-full flex gap-4 justify-start b767:justify-between b767:w-2\/5\">\r\n                                        <div class=\"row-number text-[40px] b767:text-[80px] b991:text-[100px] leading-[1] text-[#131924]\">\r\n                                            01                                        <\/div>\r\n\r\n                                                                                                                            <div class=\"tab-content-image hidden b767:block\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/Establish-governance-and-readiness.jpg\" alt=\"Two smiling AI professionals in dark shirts representing the AI strategy step to establish governance and readiness within an organisation\">\r\n                                            <\/div>\r\n                                        \r\n                                                                                    <div class=\"title-wraper b767:hidden\">\r\n                                                                                                    <div class=\"super-title b767:hidden mb-2 b767:text-xl text-base\">\r\n                                                        Governance                                                    <\/div>\r\n                                                \r\n                                                                                                    <div class=\"h3 b767:hidden\">\r\n                                                        Establish governance and readiness                                                    <\/div>\r\n                                                                                            <\/div>\r\n                                                                            <\/div>\r\n\r\n                                    <div class=\"tab-content-title w-full b767:w-1\/2 b767:pt-10 flex gap-3 items-center b767:block\">\r\n                                                                                    <div class=\"super-title hidden b767:block mb-7 b767:text-xl text-base\">\r\n                                                Governance                                            <\/div>\r\n                                        \r\n                                                                                    <h3 class=\"hidden b767:block pb-[28px]\">\r\n                                                Establish governance and readiness                                            <\/h3>\r\n                                        \r\n                                                                                                                            <div class=\"tab-content-image hidden b767:hidden\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/Establish-governance-and-readiness.jpg\" alt=\"Two smiling AI professionals in dark shirts representing the AI strategy step to establish governance and readiness within an organisation\">\r\n                                            <\/div>\r\n                                        \r\n                                                                                    <div class=\"tab-content-description w-full b767:w-full\">\r\n                                                <p>We review your existing policies and develop a comprehensive AI Governance Framework that aligns with your requirements. This ensures AI is adopted safely, responsibly, and consistently across your organisation.<\/p>\n                                            <\/div>\r\n                                                                            <\/div>\r\n                                <\/div>\r\n                            <\/div>\r\n\r\n                                                                            <div class=\"tab-content-row\">\r\n                                <div class=\"tab-content-inner gap-5 b767:gap-0 flex-col b767:flex-row\">\r\n                                    <div class=\"number-and-image w-full flex gap-4 justify-start b767:justify-between b767:w-2\/5\">\r\n                                        <div class=\"row-number text-[40px] b767:text-[80px] b991:text-[100px] leading-[1] text-[#131924]\">\r\n                                            02                                        <\/div>\r\n\r\n                                                                                                                            <div class=\"tab-content-image hidden b767:block\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/Train-your-teams-and-spark-ideas.jpg\" alt=\"AI trainer with glasses in dark shirt presenting enthusiastically in front of AI Advancements backdrop, representing the step to train your teams and spark ideas\">\r\n                                            <\/div>\r\n                                        \r\n                                                                                    <div class=\"title-wraper b767:hidden\">\r\n                                                                                                    <div class=\"super-title b767:hidden mb-2 b767:text-xl text-base\">\r\n                                                        Training                                                    <\/div>\r\n                                                \r\n                                                                                                    <div class=\"h3 b767:hidden\">\r\n                                                        Train your teams and spark ideas                                                    <\/div>\r\n                                                                                            <\/div>\r\n                                                                            <\/div>\r\n\r\n                                    <div class=\"tab-content-title w-full b767:w-1\/2 b767:pt-10 flex gap-3 items-center b767:block\">\r\n                                                                                    <div class=\"super-title hidden b767:block mb-7 b767:text-xl text-base\">\r\n                                                Training                                            <\/div>\r\n                                        \r\n                                                                                    <h3 class=\"hidden b767:block pb-[28px]\">\r\n                                                Train your teams and spark ideas                                            <\/h3>\r\n                                        \r\n                                                                                                                            <div class=\"tab-content-image hidden b767:hidden\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/Train-your-teams-and-spark-ideas.jpg\" alt=\"AI trainer with glasses in dark shirt presenting enthusiastically in front of AI Advancements backdrop, representing the step to train your teams and spark ideas\">\r\n                                            <\/div>\r\n                                        \r\n                                                                                    <div class=\"tab-content-description w-full b767:w-full\">\r\n                                                <p>We deliver tailored workshops across your departments to build foundational AI understanding and demonstrate real examples relevant to your operations. These sessions inspire informed thinking and uncover early opportunities.<\/p>\n                                            <\/div>\r\n                                                                            <\/div>\r\n                                <\/div>\r\n                            <\/div>\r\n\r\n                                                                            <div class=\"tab-content-row\">\r\n                                <div class=\"tab-content-inner gap-5 b767:gap-0 flex-col b767:flex-row\">\r\n                                    <div class=\"number-and-image w-full flex gap-4 justify-start b767:justify-between b767:w-2\/5\">\r\n                                        <div class=\"row-number text-[40px] b767:text-[80px] b991:text-[100px] leading-[1] text-[#131924]\">\r\n                                            03                                        <\/div>\r\n\r\n                                                                                                                            <div class=\"tab-content-image hidden b767:block\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/Collect-and-prioritise-AI-use-case.jpg\" alt=\"Person working at a large monitor displaying code or terminal, representing the AI strategy step to collect and prioritise AI use cases\">\r\n                                            <\/div>\r\n                                        \r\n                                                                                    <div class=\"title-wraper b767:hidden\">\r\n                                                                                                    <div class=\"super-title b767:hidden mb-2 b767:text-xl text-base\">\r\n                                                        Prioritise                                                    <\/div>\r\n                                                \r\n                                                                                                    <div class=\"h3 b767:hidden\">\r\n                                                        Collect and prioritise AI use case                                                    <\/div>\r\n                                                                                            <\/div>\r\n                                                                            <\/div>\r\n\r\n                                    <div class=\"tab-content-title w-full b767:w-1\/2 b767:pt-10 flex gap-3 items-center b767:block\">\r\n                                                                                    <div class=\"super-title hidden b767:block mb-7 b767:text-xl text-base\">\r\n                                                Prioritise                                            <\/div>\r\n                                        \r\n                                                                                    <h3 class=\"hidden b767:block pb-[28px]\">\r\n                                                Collect and prioritise AI use case                                            <\/h3>\r\n                                        \r\n                                                                                                                            <div class=\"tab-content-image hidden b767:hidden\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/Collect-and-prioritise-AI-use-case.jpg\" alt=\"Person working at a large monitor displaying code or terminal, representing the AI strategy step to collect and prioritise AI use cases\">\r\n                                            <\/div>\r\n                                        \r\n                                                                                    <div class=\"tab-content-description w-full b767:w-full\">\r\n                                                <p>We gather potential use cases from across your organisation and run a structured prioritisation workshop with senior leaders. Together, we identify which opportunities offer the greatest value, feasibility, and impact.<\/p>\n                                            <\/div>\r\n                                                                            <\/div>\r\n                                <\/div>\r\n                            <\/div>\r\n\r\n                                                                            <div class=\"tab-content-row\">\r\n                                <div class=\"tab-content-inner gap-5 b767:gap-0 flex-col b767:flex-row\">\r\n                                    <div class=\"number-and-image w-full flex gap-4 justify-start b767:justify-between b767:w-2\/5\">\r\n                                        <div class=\"row-number text-[40px] b767:text-[80px] b991:text-[100px] leading-[1] text-[#131924]\">\r\n                                            04                                        <\/div>\r\n\r\n                                                                                                                            <div class=\"tab-content-image hidden b767:block\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/Map-the-top-use-cases.jpg\" alt=\"Professional in dark shirt presenting at a whiteboard, representing the AI strategy step to map the top use cases\">\r\n                                            <\/div>\r\n                                        \r\n                                                                                    <div class=\"title-wraper b767:hidden\">\r\n                                                \r\n                                                                                                    <div class=\"h3 b767:hidden\">\r\n                                                        Map the top use cases                                                    <\/div>\r\n                                                                                            <\/div>\r\n                                                                            <\/div>\r\n\r\n                                    <div class=\"tab-content-title w-full b767:w-1\/2 b767:pt-10 flex gap-3 items-center b767:block\">\r\n                                        \r\n                                                                                    <h3 class=\"hidden b767:block pb-[28px]\">\r\n                                                Map the top use cases                                            <\/h3>\r\n                                        \r\n                                                                                                                            <div class=\"tab-content-image hidden b767:hidden\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/Map-the-top-use-cases.jpg\" alt=\"Professional in dark shirt presenting at a whiteboard, representing the AI strategy step to map the top use cases\">\r\n                                            <\/div>\r\n                                        \r\n                                                                                    <div class=\"tab-content-description w-full b767:w-full\">\r\n                                                <p>We work closely with subject matter experts to analyse your highest-priority opportunities. Each use case is mapped in detail, including workflow design, technical and data requirements, integration needs, risks, cost estimates, and timelines.<\/p>\n                                            <\/div>\r\n                                                                            <\/div>\r\n                                <\/div>\r\n                            <\/div>\r\n\r\n                                                                            <div class=\"tab-content-row\">\r\n                                <div class=\"tab-content-inner gap-5 b767:gap-0 flex-col b767:flex-row\">\r\n                                    <div class=\"number-and-image w-full flex gap-4 justify-start b767:justify-between b767:w-2\/5\">\r\n                                        <div class=\"row-number text-[40px] b767:text-[80px] b991:text-[100px] leading-[1] text-[#131924]\">\r\n                                            05                                        <\/div>\r\n\r\n                                                                                                                            <div class=\"tab-content-image hidden b767:block\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/Deliver-your-board-ready-AI-roadmap.jpg\" alt=\"Two business professionals in dark shirts having a consultation meeting, representing the AI strategy step to deliver a board-ready AI roadmap\">\r\n                                            <\/div>\r\n                                        \r\n                                                                                    <div class=\"title-wraper b767:hidden\">\r\n                                                \r\n                                                                                                    <div class=\"h3 b767:hidden\">\r\n                                                        Deliver your board ready AI roadmap                                                    <\/div>\r\n                                                                                            <\/div>\r\n                                                                            <\/div>\r\n\r\n                                    <div class=\"tab-content-title w-full b767:w-1\/2 b767:pt-10 flex gap-3 items-center b767:block\">\r\n                                        \r\n                                                                                    <h3 class=\"hidden b767:block pb-[28px]\">\r\n                                                Deliver your board ready AI roadmap                                            <\/h3>\r\n                                        \r\n                                                                                                                            <div class=\"tab-content-image hidden b767:hidden\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/Deliver-your-board-ready-AI-roadmap.jpg\" alt=\"Two business professionals in dark shirts having a consultation meeting, representing the AI strategy step to deliver a board-ready AI roadmap\">\r\n                                            <\/div>\r\n                                        \r\n                                                                                    <div class=\"tab-content-description w-full b767:w-full\">\r\n                                                <p>We consolidate all insights into a clear AI strategy and roadmap. This includes your priority use cases, investment requirements, implementation timeline, governance recommendations, and next steps. We then present the roadmap to your board for alignment and approval.<\/p>\n                                            <\/div>\r\n                                                                            <\/div>\r\n                                <\/div>\r\n                            <\/div>\r\n\r\n                                                                            <div class=\"tab-content-row\">\r\n                                <div class=\"tab-content-inner gap-5 b767:gap-0 flex-col b767:flex-row\">\r\n                                    <div class=\"number-and-image w-full flex gap-4 justify-start b767:justify-between b767:w-2\/5\">\r\n                                        <div class=\"row-number text-[40px] b767:text-[80px] b991:text-[100px] leading-[1] text-[#131924]\">\r\n                                            06                                        <\/div>\r\n\r\n                                                                                                                            <div class=\"tab-content-image hidden b767:block\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/Move-into-delivery.jpg\" alt=\"Smiling professional with glasses in dark shirt working at a computer setup, representing the AI strategy step to move into delivery\">\r\n                                            <\/div>\r\n                                        \r\n                                                                                    <div class=\"title-wraper b767:hidden\">\r\n                                                \r\n                                                                                                    <div class=\"h3 b767:hidden\">\r\n                                                        Move into delivery                                                    <\/div>\r\n                                                                                            <\/div>\r\n                                                                            <\/div>\r\n\r\n                                    <div class=\"tab-content-title w-full b767:w-1\/2 b767:pt-10 flex gap-3 items-center b767:block\">\r\n                                        \r\n                                                                                    <h3 class=\"hidden b767:block pb-[28px]\">\r\n                                                Move into delivery                                            <\/h3>\r\n                                        \r\n                                                                                                                            <div class=\"tab-content-image hidden b767:hidden\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/Move-into-delivery.jpg\" alt=\"Smiling professional with glasses in dark shirt working at a computer setup, representing the AI strategy step to move into delivery\">\r\n                                            <\/div>\r\n                                        \r\n                                                                                    <div class=\"tab-content-description w-full b767:w-full\">\r\n                                                <p>Once approved, your organisation can progress directly into implementation, either through fixed-fee AI development (with no further scoping required) or via our AI transformation service, embedding an AI specialist within your team on a time-and-materials basis for AI implementation.<\/p>\n                                            <\/div>\r\n                                                                            <\/div>\r\n                                <\/div>\r\n                            <\/div>\r\n\r\n                                                \r\n                    <\/div>\r\n\r\n                                                                            \r\n                    <div class=\"tab-content-list transition-opacity duration-300\">\r\n\r\n                                                                            <div class=\"tab-content-row\">\r\n                                <div class=\"tab-content-inner gap-5 b767:gap-0 flex-col b767:flex-row\">\r\n                                    <div class=\"number-and-image w-full flex gap-4 justify-start b767:justify-between b767:w-2\/5\">\r\n                                        <div class=\"row-number text-[40px] b767:text-[80px] b991:text-[100px] leading-[1] text-[#131924]\">\r\n                                            01                                        <\/div>\r\n\r\n                                                                                                                            <div class=\"tab-content-image hidden b767:block\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/03\/photo5-1.jpg\" alt=\"Two AI Advancements consultants smiling broadly together, representing the friendly and collaborative AI Strategy consulting team\">\r\n                                            <\/div>\r\n                                        \r\n                                                                                    <div class=\"title-wraper b767:hidden\">\r\n                                                \r\n                                                                                                    <div class=\"h3 b767:hidden\">\r\n                                                        Understand your goals and context                                                    <\/div>\r\n                                                                                            <\/div>\r\n                                                                            <\/div>\r\n\r\n                                    <div class=\"tab-content-title w-full b767:w-1\/2 b767:pt-10 flex gap-3 items-center b767:block\">\r\n                                        \r\n                                                                                    <h3 class=\"hidden b767:block pb-[28px]\">\r\n                                                Understand your goals and context                                            <\/h3>\r\n                                        \r\n                                                                                                                            <div class=\"tab-content-image hidden b767:hidden\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/03\/photo5-1.jpg\" alt=\"Two AI Advancements consultants smiling broadly together, representing the friendly and collaborative AI Strategy consulting team\">\r\n                                            <\/div>\r\n                                        \r\n                                                                                    <div class=\"tab-content-description w-full b767:w-full\">\r\n                                                <p>We start with a focused session to understand your business, key priorities, and where you and your team feel most pressure, capacity, compliance, efficiency, or competitiveness.<\/p>\n                                            <\/div>\r\n                                                                            <\/div>\r\n                                <\/div>\r\n                            <\/div>\r\n\r\n                                                                            <div class=\"tab-content-row\">\r\n                                <div class=\"tab-content-inner gap-5 b767:gap-0 flex-col b767:flex-row\">\r\n                                    <div class=\"number-and-image w-full flex gap-4 justify-start b767:justify-between b767:w-2\/5\">\r\n                                        <div class=\"row-number text-[40px] b767:text-[80px] b991:text-[100px] leading-[1] text-[#131924]\">\r\n                                            02                                        <\/div>\r\n\r\n                                                                                                                            <div class=\"tab-content-image hidden b767:block\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/03\/photo5-1.jpg\" alt=\"Two AI Advancements consultants smiling broadly together, representing the friendly and collaborative AI Strategy consulting team\">\r\n                                            <\/div>\r\n                                        \r\n                                                                                    <div class=\"title-wraper b767:hidden\">\r\n                                                \r\n                                                                                                    <div class=\"h3 b767:hidden\">\r\n                                                        Leadership workshop                                                    <\/div>\r\n                                                                                            <\/div>\r\n                                                                            <\/div>\r\n\r\n                                    <div class=\"tab-content-title w-full b767:w-1\/2 b767:pt-10 flex gap-3 items-center b767:block\">\r\n                                        \r\n                                                                                    <h3 class=\"hidden b767:block pb-[28px]\">\r\n                                                Leadership workshop                                            <\/h3>\r\n                                        \r\n                                                                                                                            <div class=\"tab-content-image hidden b767:hidden\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/03\/photo5-1.jpg\" alt=\"Two AI Advancements consultants smiling broadly together, representing the friendly and collaborative AI Strategy consulting team\">\r\n                                            <\/div>\r\n                                        \r\n                                                                                    <div class=\"tab-content-description w-full b767:w-full\">\r\n                                                <p>We run a workshop with your leadership or management team to build foundational AI understanding, unpack surface pain points, and explore where AI could remove bottlenecks or create new value.<\/p>\n                                            <\/div>\r\n                                                                            <\/div>\r\n                                <\/div>\r\n                            <\/div>\r\n\r\n                                                                            <div class=\"tab-content-row\">\r\n                                <div class=\"tab-content-inner gap-5 b767:gap-0 flex-col b767:flex-row\">\r\n                                    <div class=\"number-and-image w-full flex gap-4 justify-start b767:justify-between b767:w-2\/5\">\r\n                                        <div class=\"row-number text-[40px] b767:text-[80px] b991:text-[100px] leading-[1] text-[#131924]\">\r\n                                            03                                        <\/div>\r\n\r\n                                                                                                                            <div class=\"tab-content-image hidden b767:block\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/03\/photo5-1.jpg\" alt=\"Two AI Advancements consultants smiling broadly together, representing the friendly and collaborative AI Strategy consulting team\">\r\n                                            <\/div>\r\n                                        \r\n                                                                                    <div class=\"title-wraper b767:hidden\">\r\n                                                \r\n                                                                                                    <div class=\"h3 b767:hidden\">\r\n                                                        Collect and prioritise AI use cases                                                    <\/div>\r\n                                                                                            <\/div>\r\n                                                                            <\/div>\r\n\r\n                                    <div class=\"tab-content-title w-full b767:w-1\/2 b767:pt-10 flex gap-3 items-center b767:block\">\r\n                                        \r\n                                                                                    <h3 class=\"hidden b767:block pb-[28px]\">\r\n                                                Collect and prioritise AI use cases                                            <\/h3>\r\n                                        \r\n                                                                                                                            <div class=\"tab-content-image hidden b767:hidden\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/03\/photo5-1.jpg\" alt=\"Two AI Advancements consultants smiling broadly together, representing the friendly and collaborative AI Strategy consulting team\">\r\n                                            <\/div>\r\n                                        \r\n                                                                                    <div class=\"tab-content-description w-full b767:w-full\">\r\n                                                <p>Following the workshop, we capture all potential AI use cases and prioritise with the leadership team based on value and impact to identify the three strongest AI opportunities for your organisation.<\/p>\n                                            <\/div>\r\n                                                                            <\/div>\r\n                                <\/div>\r\n                            <\/div>\r\n\r\n                                                                            <div class=\"tab-content-row\">\r\n                                <div class=\"tab-content-inner gap-5 b767:gap-0 flex-col b767:flex-row\">\r\n                                    <div class=\"number-and-image w-full flex gap-4 justify-start b767:justify-between b767:w-2\/5\">\r\n                                        <div class=\"row-number text-[40px] b767:text-[80px] b991:text-[100px] leading-[1] text-[#131924]\">\r\n                                            04                                        <\/div>\r\n\r\n                                                                                                                            <div class=\"tab-content-image hidden b767:block\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/03\/photo5-1.jpg\" alt=\"Two AI Advancements consultants smiling broadly together, representing the friendly and collaborative AI Strategy consulting team\">\r\n                                            <\/div>\r\n                                        \r\n                                                                                    <div class=\"title-wraper b767:hidden\">\r\n                                                \r\n                                                                                                    <div class=\"h3 b767:hidden\">\r\n                                                        Map your top three use cases                                                    <\/div>\r\n                                                                                            <\/div>\r\n                                                                            <\/div>\r\n\r\n                                    <div class=\"tab-content-title w-full b767:w-1\/2 b767:pt-10 flex gap-3 items-center b767:block\">\r\n                                        \r\n                                                                                    <h3 class=\"hidden b767:block pb-[28px]\">\r\n                                                Map your top three use cases                                            <\/h3>\r\n                                        \r\n                                                                                                                            <div class=\"tab-content-image hidden b767:hidden\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/03\/photo5-1.jpg\" alt=\"Two AI Advancements consultants smiling broadly together, representing the friendly and collaborative AI Strategy consulting team\">\r\n                                            <\/div>\r\n                                        \r\n                                                                                    <div class=\"tab-content-description w-full b767:w-full\">\r\n                                                <p>We work closely with subject matter experts to analyse your three highest-priority opportunities. Each use case is mapped in detail, including workflow design, technical requirements, integration needs, risks, cost estimates, and timelines.<\/p>\n                                            <\/div>\r\n                                                                            <\/div>\r\n                                <\/div>\r\n                            <\/div>\r\n\r\n                                                                            <div class=\"tab-content-row\">\r\n                                <div class=\"tab-content-inner gap-5 b767:gap-0 flex-col b767:flex-row\">\r\n                                    <div class=\"number-and-image w-full flex gap-4 justify-start b767:justify-between b767:w-2\/5\">\r\n                                        <div class=\"row-number text-[40px] b767:text-[80px] b991:text-[100px] leading-[1] text-[#131924]\">\r\n                                            05                                        <\/div>\r\n\r\n                                                                                                                            <div class=\"tab-content-image hidden b767:block\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/03\/photo5-1.jpg\" alt=\"Two AI Advancements consultants smiling broadly together, representing the friendly and collaborative AI Strategy consulting team\">\r\n                                            <\/div>\r\n                                        \r\n                                                                                    <div class=\"title-wraper b767:hidden\">\r\n                                                \r\n                                                                                                    <div class=\"h3 b767:hidden\">\r\n                                                        Deliver your starter AI roadmap                                                    <\/div>\r\n                                                                                            <\/div>\r\n                                                                            <\/div>\r\n\r\n                                    <div class=\"tab-content-title w-full b767:w-1\/2 b767:pt-10 flex gap-3 items-center b767:block\">\r\n                                        \r\n                                                                                    <h3 class=\"hidden b767:block pb-[28px]\">\r\n                                                Deliver your starter AI roadmap                                            <\/h3>\r\n                                        \r\n                                                                                                                            <div class=\"tab-content-image hidden b767:hidden\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/03\/photo5-1.jpg\" alt=\"Two AI Advancements consultants smiling broadly together, representing the friendly and collaborative AI Strategy consulting team\">\r\n                                            <\/div>\r\n                                        \r\n                                                                                    <div class=\"tab-content-description w-full b767:w-full\">\r\n                                                <p>You receive a clear, practical roadmap outlining the three priority AI projects,  including approach, technical rundown, integration considerations, estimated cost, and expected value.<\/p>\n                                            <\/div>\r\n                                                                            <\/div>\r\n                                <\/div>\r\n                            <\/div>\r\n\r\n                                                \r\n                    <\/div>\r\n\r\n                                    \r\n            <\/div>\r\n\r\n            <!-- TAB BUTTONS -->\r\n            <div class=\"tab-button-group flex justify-center gap-6 mt-11\">\r\n                                                                                                <button class=\"tab-button\" data-tab=\"0\">\r\n                            AI Roadmap                        <\/button>\r\n                                                                                                    <button class=\"tab-button\" data-tab=\"1\">\r\n                            AI Kickstarter                        <\/button>\r\n                                                <\/div>\r\n\r\n        <\/div>\r\n    <\/div>\r\n<\/section>\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n \r\n  \n\n  <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->