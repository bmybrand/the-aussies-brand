will-change: transform; }\r\n        .logo_slider .splide__track { contain: layout;}\r\n        .slider-logo img {\r\n            aspect-ratio: 160 \/ 100;\r\n        }\r\n        <\/style>\r\n\r\n  <\/section>\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n\r\n  \n\n  <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n  <section \r\n      id=\"\" \r\n      data-name=\"acf_testimonials\"\r\n      data-lazyload=\"1\" \r\n      class=\"relative \" \r\n      style=\"z-index: 0;\">\r\n        <div class=\"testimonials-area b1024:py-[120px] py-80 bg-color3\">\r\n            <div class=\"container\">\r\n                                    <div class=\"subheading-wrap text-center\">\r\n                                <h2 class=\" animate-watch standard__headline inline-flex font-semibold text-color1 bg-color2 py-2 px-6 rounded-3xl text-xs mx-auto b767:mx-0 b767:mb-16 mb-10\">Hear from teams learning to use ChatGPT responsibly at work<\/h2>\n                        <\/div>\r\n                                <div class=\"grid grid-cols-1 b767:grid-cols-2 gap-6 b1024:mb-[90px] mb-[70px] text-center b767:text-start max-w-[1130px] mx-auto\">\r\n                                            <div class=\"heading-wrap w-full b767:w-auto\">\r\n                                    <h3 class=\"h2 animate-watch standard__headline block\">ChatGPT training built for real business use<\/h3>\n                            <\/div>\r\n                                                                <div class=\"summary-wrap text-center b767:text-start b1024:pl-[60px] b1400:pl-[116px]\">\r\n                            <p>Teams come to our ChatGPT workshop looking for clarity and leave with confidence.<\/p>\n<p>Here\u2019s how organisations describe the impact on their teams.<\/p>\n                        <\/div>\r\n                                    <\/div>\r\n            \r\n\r\n\r\n                \r\n                                <!-- GRID -->\r\n                <div class=\"flex flex-wrap gap-3 max-w-[1130px] mx-auto mt-8 b767:mt-0 \r\n                    \">\r\n\r\n                    \r\n                    <div class=\"testimonial-box overflow-hidden bg-color5 rounded-[20px] b767:p-9 p-7 flex flex-col justify-between\r\n                    w-full b767:w-[calc(50%-6px)]\">\r\n\r\n                        <div class=\"flex gap-3\">\r\n                            <span class=\"box-number testimonial-box-number flex text-[10px] font-bold h-[32px] w-[32px] rounded-full bg-color2 justify-center items-center\">\r\n                                01                            <\/span>\r\n\r\n                                                        <div class=\"inline-flex z-10 font-semibold text-color4 bg-black py-2 px-6 rounded-3xl text-xs\">\r\n                                Primary School                            <\/div>\r\n                                                    <\/div>\r\n\r\n                                                    <div class=\"b1600:py-[86px] z-10 b1024:py-60 py-40 b1600:px-60 b1400:px-40 font-medium leading-[150%] b767:text-[21px]\">\r\n                                <p>&#8220;Mind blowing! Going home to play on the AI tools!?<\/p>\n                            <\/div>\r\n                        \r\n                        <div class=\"z-10 flex justify-between items-end\">\r\n                            <div>\r\n                                <div class=\"font-bold leading-none\">Naomi Jones<\/div>\r\n                                                                    <div>Hampton Park Primary School Teacher<\/div>\r\n                                                            <\/div>\r\n                                                            <div class=\"\">\r\n                                    <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/03\/3f5eb2d9dc4444beff1295849d0f14c61ba1bf72.jpg\" \r\n                                        alt=\"Hampton Park Primary School small logo thumbnail showing school emblem with bird and school name text\" \r\n                                        width=\"auto\" \r\n                                        height=\"60\"\r\n                                        class=\"h-[60px] w-auto rounded-[10px]\">\r\n                                <\/div>\r\n                                                    <\/div>\r\n\r\n                    <\/div>\r\n\r\n                    \r\n                    <div class=\"testimonial-box overflow-hidden bg-color5 rounded-[20px] b767:p-9 p-7 flex flex-col justify-between\r\n                    w-full b767:w-[calc(50%-6px)]\">\r\n\r\n                        <div class=\"flex gap-3\">\r\n                            <span class=\"box-number testimonial-box-number flex text-[10px] font-bold h-[32px] w-[32px] rounded-full bg-color2 justify-center items-center\">\r\n                                02                            <\/span>\r\n\r\n                                                        <div class=\"inline-flex z-10 font-semibold text-color4 bg-black py-2 px-6 rounded-3xl text-xs\">\r\n                                Education Research Solutions                            <\/div>\r\n                                                    <\/div>\r\n\r\n                                                    <div class=\"b1600:py-[86px] z-10 b1024:py-60 py-40 b1600:px-60 b1400:px-40 font-medium leading-[150%] b767:text-[21px]\">\r\n                                <p>\u201cExcellent explanations and demonstrations. The potential exhibited by Samuel is outstanding. Education is to be transformed through the agency of AI in the hands of creative problem solvers.&#8221;<\/p>\n                            <\/div>\r\n                        \r\n                        <div class=\"z-10 flex justify-between items-end\">\r\n                            <div>\r\n                                <div class=\"font-bold leading-none\">Robin Clarke<\/div>\r\n                                                            <\/div>\r\n                                                            <div class=\"\">\r\n                                    <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/03\/dc27e5890eb6333f8f5f1a4784956afaffcc4fea.jpg\" \r\n                                        alt=\"Personal brand logo with yellow circle background and black C lettermark, used as a profile identifier\" \r\n                                        width=\"auto\" \r\n                                        height=\"60\"\r\n                                        class=\"h-[60px] w-auto rounded-[10px]\">\r\n                                <\/div>\r\n                                                    <\/div>\r\n\r\n                    <\/div>\r\n\r\n                    \r\n                <\/div>\r\n                            <\/div>\r\n        <\/div>\r\n\r\n  <\/section>\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n\r\n  \n\n    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\n        <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\n\n    <!-- BLOCK CODING STARTS HERE -->\n    <section \n        id=\"\" \n        data-name=\"acf_contact-form\"\n        data-lazyload=\"1\" \n        class=\"relative \" \n        style=\"z-index: 0; background-color:#FFFFFF;\">\n        <div id=\"contact-form-section\" class=\"bg-color4 b767:pt-100 pt-80 pb-80\">\n            <div class=\"container\">\n                <div class=\"flex flex-col b1024:flex-row justify-between gap-10\">\n                    <div class=\"b1024:w-[267px] b1200:w-[400px] text-center b1024:text-start\">\n                                                                                                                                        <h2 class=\"h2 animate-watch standard__headline block tracking-[-0.06em] mb-10\">Enquire now<\/h2>\n