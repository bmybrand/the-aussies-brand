     <\/div>\r\n                                                    <div class=\"splide__slide\">\r\n                                <div class=\"slider-logo h-full\">\r\n                                    <img decoding=\"async\"\r\n                                        loading=\"lazy\"\r\n                                        style=\"width: 160px; height: 70px;\"\r\n                                        width=\"160\"\r\n                                        height=\"70\"\r\n                                        class=\"h-[70px] b767:h-[100px] w-[160px] object-contain\"\r\n                                        src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/WhatsApp-Image-2026-08-13-at-13.00.41-270x300.webp\"\r\n                                        srcset=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/WhatsApp-Image-2026-08-13-at-13.00.41-270x300.webp 270w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/WhatsApp-Image-2026-08-13-at-13.00.41-768x853.webp 768w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/WhatsApp-Image-2026-08-13-at-13.00.41.webp 800w\"\r\n                                        sizes=\"auto, 160px\"\r\n                                        alt=\"\" \/>\r\n                                <\/div>\r\n                            <\/div>\r\n                                                    <div class=\"splide__slide\">\r\n                                <div class=\"slider-logo h-full\">\r\n                                    <img decoding=\"async\"\r\n                                        loading=\"lazy\"\r\n                                        style=\"width: 160px; height: 70px;\"\r\n                                        width=\"160\"\r\n                                        height=\"70\"\r\n                                        class=\"h-[70px] b767:h-[100px] w-[160px] object-contain\"\r\n                                        src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/images-300x72.png\"\r\n                                        srcset=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/images-300x72.png 300w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/08\/images.png 738w\"\r\n                                        sizes=\"auto, 160px\"\r\n                                        alt=\"\" \/>\r\n                                <\/div>\r\n                            <\/div>\r\n                                            <\/div>\r\n                <\/div>\r\n            <\/div>\r\n            \r\n            <div class=\"b1024:mb-[130px] mb-[80px]\"><\/div>\r\n                                    <div class=\"container\">\r\n                <div class=\"ls-border relative\"><\/div>\r\n            <\/div>\r\n                    <\/div>\r\n\r\n        <style>\r\n        .logo_slider .splide__list { will-change: transform; }\r\n        .logo_slider .splide__track { contain: layout;}\r\n        .slider-logo img {\r\n            aspect-ratio: 160 \/ 100;\r\n        }\r\n        <\/style>\r\n\r\n  <\/section>\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n\r\n  \n\n  <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n  <section \r\n      id=\"\" \r\n      data-name=\"acf_custom-project\"\r\n      data-lazyload=\"1\" \r\n      class=\"relative \" \r\n      style=\"z-index: 0;\">\r\n      <div class=\"b767:py-100 py-80\">\r\n        <div class=\"container\">\r\n                            <div class=\"subheading-wrap text-center\">\r\n                        <h2 class=\" animate-watch standard__headline inline-flex font-semibold text-color1 bg-color4 py-2 px-6 rounded-3xl text-xs b1024:mb-[90px] mb-10 !tracking-[-0.02em]\">AI training services delivered locally in Perth<\/h2>\n                    <\/div>\r\n                        <div class=\"b1024:mb-[90px] mb-10 two-column-content\">\r\n                                    <div class=\"heading-wrap max-w-[900px] mx-auto text-center mb-10\">\r\n                                <h3 class=\"h2 animate-watch standard__headline block\">Real-world results from local AI training<\/h3>\n                        <\/div>\r\n                                                    <div class=\"summary-wrap text-center max-w-[669px] mx-auto\">\r\n                        <p>We deliver AI workshops directly to Perth-based organisations, led by our AI-native practitioners. Every session is run by the same team that designs and builds custom AI systems.<\/p>\n<p>These case studies show how teams across different industries have applied practical AI skills to reduce workload, improve confidence, and generate measurable value from artificial intelligence.<\/p>\n<p>Explore our <a class=\"decorated-link\" href=\"https:\/\/aiadvancements.com.au\/case-studies\/?utm_source=chatgpt.com\" target=\"_new\" rel=\"noopener\" data-start=\"713\" data-end=\"784\">AI training case studies<\/a> to see how organisations have applied AI training in real-world environments.<\/p>\n<p data-start=\"866\" data-end=\"895\">\n                    <\/div>\r\n                            <\/div>\r\n        <\/div>\r\n        <div class=\"splide project_slider\" aria-label=\"project slider\">\r\n            <div class=\"splide__track\">\r\n                <ul class=\"splide__list\">\r\n                    \r\n                            <li class=\"splide__slide\">\r\n                                <div class=\"bg-color4 b1400:py-100 b1400:px-[115px] b1200:p-80 b767:p-60 px-20 py-60 flex flex-col b1024:flex-row h-full text-center b767:text-start\">\r\n                                    \r\n                                    <!-- LEFT -->\r\n                                    <div class=\"flex flex-col justify-between b1024:w-[337px] b767:mb-10 mb-8 b1024:mb-0 gap-10\">\r\n                                        \r\n                                        <h3 class=\"b1024:text-[40px] text-3xl font-normal leading-none\">\r\n                                            Hampton Park Primary School: 50 Teachers, One Workshop, AI Tools Built Into Every Classroom                                        <\/h3>\r\n\r\n                                        <div>\r\n                                            <img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"683\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/chatgpt-training-1024x683.png\" class=\"w-full object-cover rounded-[10px] wp-post-image\" alt=\"Woman with long light hair laughing with joy during a ChatGPT training workshop at Hampton Park Primary School with other training participants visible in the background\" srcset=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/chatgpt-training-1024x683.png 1024w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/chatgpt-training-300x200.png 300w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/chatgpt-training-768x512.png 768w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/chatgpt-training.png 1536w\" sizes=\"auto, (max-width: 1024px) 100vw, 1024px\" \/>                                        <\/div>\r\n\r\n                                    <\/div>\r\n\r\n                                    <!-- RIGHT -->\r\n                                    <div class=\"flex flex-col justify-between flex-1 b1400:pl-[86px] b1200:pl-60 b1400:ml-[86px] b1200:ml-[60px] b1024:pl-40 b1024:ml-10 b1024:border-l b1024:border-color1\">\r\n                                        \r\n                                        <div class=\"text-base\">\r\n                                            50 Hampton Park teachers walked into a PD day buried in report season admin and walked out with AI tools they&#039;d built themselves.                                        <\/div>\r\n\r\n                                        <div class=\"flex mt-8\">\r\n                                            <a href=\"https:\/\/aiadvancements.com.au\/case-study\/ai-in-education-training\/\" class=\"btn btn-solidcolor1 flex justify-center items-center gap-2 overflow-hidden mx-auto b767:mx-0\">\r\n                                                <span class=\"block circle relative\"><\/span>\r\n                                                <div class=\"button-text z-10\">Read more<\/div>\r\n                                            <\/a>\r\n                                        <\/div>\r\n\r\n                                    <\/div>\r\n\r\n                                <\/div>\r\n                            <\/li>\r\n\r\n                        \r\n                            <li class=\"splide__slide\">\r\n                                <div class=\"bg-color4 b1400:py-100 b1400:px-[115px] b1200:p-80 b767:p-60 px-20 py-60 flex flex-col b1024:flex-row h-full text-center b767:text-start\">\r\n                                    \r\n                                    <!-- LEFT -->\r\n                                    <div class=\"flex flex-col justify-between b1024:w-[337px] b767:mb-10 mb-8 b1024:mb-0 gap-10\">\r\n                                        \r\n                                        <h3 class=\"b1024:text-[40px] text-3xl font-normal leading-none\">\r\n                                            Tusk Finance: From Asking ChatGPT Questions to Building Their Own AI Agents, In One Workshop                                        <\/h3>\r\n\r\n                                        <div>\r\n                                            <img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"683\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/chatgpt-tusk-finance-1024x683.png\" class=\"w-full object-cover rounded-[10px] wp-post-image\" alt=\"ChatGPT OpenAI green app icon and Tusk Finance logo side by side, representing the Advanced ChatGPT Training service delivered for Tusk Finance\" srcset=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/chatgpt-tusk-finance-1024x683.png 1024w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/chatgpt-tusk-finance-300x200.png 300w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/chatgpt-tusk-finance-768x512.png 768w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/chatgpt-tusk-finance.png 1536w\" sizes=\"auto, (max-width: 1024px) 100vw, 1024px\" \/>                                        <\/div>\r\n\r\n                                    <\/div>\r\n\r\n                                    <!-- RIGHT -->\r\n                                    <div class=\"flex flex-col justify-between flex-1 b1400:pl-[86px] b1200:pl-60 b1400:ml-[86px] b1200:ml-[60px] b1024:pl-40 b1024:ml-10 b1024:border-l b1024:border-color1\">\r\n                                        \r\n                                        <div class=\"text-base\">\r\n                                            Tusk Finance&#039;s leadership team walked in as ChatGPT users and walked out having each built their own AI agent.                                        <\/div>\r\n\r\n                                        <div class=\"flex mt-8\">\r\n                                            <a href=\"https:\/\/aiadvancements.com.au\/case-study\/advanced-chatgpt-training-workshop\/\" class=\"btn btn-solidcolor1 flex justify-center items-center gap-2 overflow-hidden mx-auto b767:mx-0\">\r\n                                                <span class=\"block circle relative\"><\/span>\r\n                                                <div class=\"button-text z-10\">Read more<\/div>\r\n                                            <\/a>\r\n                                        <\/div>\r\n\r\n                                    <\/div>\r\n\r\n                                <\/div>\r\n                            <\/li>\r\n\r\n                        \r\n                            <li class=\"splide__slide\">\r\n                                <div class=\"bg-color4 b1400:py-100 b1400:px-[115px] b1200:p-80 b767:p-60 px-20 py-60 flex flex-col b1024:flex-row h-full text-center b767:text-start\">\r\n                                    \r\n                                    <!-- LEFT -->\r\n                                    <div class=\"flex flex-col justify-between b1024:w-[337px] b767:mb-10 mb-8 b1024:mb-0 gap-10\">\r\n                                        \r\n                                        <h3 class=\"b1024:text-[40px] text-3xl font-normal leading-none\">\r\n                                            Lennox Hill: Turning a Marketing Agency&#8217;s Dev Team Into Confident AI Coders in a Single Two-Hour Session                                        <\/h3>\r\n\r\n                                        <div>\r\n                                            <img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"683\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/cursor-mcp-1024x683.png\" class=\"w-full object-cover rounded-[10px] wp-post-image\" alt=\"Cursor AI IDE and Model Context Protocol logos side by side on dark background, showing the integration between Cursor developer tool and MCP for AI-powered development\" srcset=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/cursor-mcp-1024x683.png 1024w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/cursor-mcp-300x200.png 300w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/cursor-mcp-768x512.png 768w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/cursor-mcp.png 1536w\" sizes=\"auto, (max-width: 1024px) 100vw, 1024px\" \/>                                        <\/div>\r\n\r\n                                    <\/div>\r\n\r\n                                    <!-- RIGHT -->\r\n                                    <div class=\"flex flex-col justify-between flex-1 b1400:pl-[86px] b1200:pl-60 b1400:ml-[86px] b1200:ml-[60px] b1024:pl-40 b1024:ml-10 b1024:border-l b1024:border-color1\">\r\n                                        \r\n                                        <div class=\"text-base\">\r\n                                            A two-hour Cursor workshop gave Lennox Hill&#039;s developers a practical AI coding playbook, plus a roadmap for their own custom MCP tooling.                                        <\/div>\r\n\r\n                                        <div class=\"flex mt-8\">\r\n                                            <a href=\"https:\/\/aiadvancements.com.au\/case-study\/ai-for-developers-training\/\" class=\"btn btn-solidcolor1 flex justify-center items-center gap-2 overflow-hidden mx-auto b767:mx-0\">\r\n                                                <span class=\"block circle relative\"><\/span>\r\n                                                <div class=\"button-text z-10\">Read more<\/div>\r\n                                            <\/a>\r\n                                        <\/div>\r\n\r\n                                    <\/div>\r\n\r\n                                <\/div>\r\n                            <\/li>\r\n\r\n                        \r\n                            <li class=\"splide__slide\">\r\n                                <div class=\"bg-color4 b1400:py-100 b1400:px-[115px] b1200:p-80 b767:p-60 px-20 py-60 flex flex-col b1024:flex-row h-full text-center b767:text-start\">\r\n                                    \r\n                                    <!-- LEFT -->\r\n                                    <div class=\"flex flex-col justify-between b1024:w-[337px] b767:mb-10 mb-8 b1024:mb-0 gap-10\">\r\n                                        \r\n                                        <h3 class=\"b1024:text-[40px] text-3xl font-normal leading-none\">\r\n                                            AI for Leaders: Building the Strategic AI Capability That Organisations Actually Need                                        <\/h3>\r\n\r\n                                        <div>\r\n                                            <img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"768\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/leadership-training-1024x768.jpg\" class=\"w-full object-cover rounded-[10px] wp-post-image\" alt=\"Business leaders and professionals in a boardroom attending AI Leadership Training with a presentation screen showing Large Language Models including Microsoft Copilot, OpenAI and Google Gemini logos\" srcset=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/leadership-training-1024x768.jpg 1024w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/leadership-training-300x225.jpg 300w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/leadership-training-768x576.jpg 768w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/leadership-training-1536x1152.jpg 1536w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/leadership-training.jpg 1920w\" sizes=\"auto, (max-width: 1024px) 100vw, 1024px\" \/>                                        <\/div>\r\n\r\n                                    <\/div>\r\n\r\n                                    <!-- RIGHT -->\r\n                                    <div class=\"flex flex-col justify-between flex-1 b1400:pl-[86px] b1200:pl-60 b1400:ml-[86px] b1200:ml-[60px] b1024:pl-40 b1024:ml-10 b1024:border-l b1024:border-color1\">\r\n                                        \r\n                                        <div class=\"text-base\">\r\n                                            One leadership team walked out with 20+ AI use cases and a $100K+ roadmap engagement, in a single 4-hour session.                                        <\/div>\r\n\r\n                                        <div class=\"flex mt-8\">\r\n                                            <a href=\"https:\/\/aiadvancements.com.au\/case-study\/leadership-training\/\" class=\"btn btn-solidcolor1 flex justify-center items-center gap-2 overflow-hidden mx-auto b767:mx-0\">\r\n                                                <span class=\"block circle relative\"><\/span>\r\n                                                <div class=\"button-text z-10\">Read more<\/div>\r\n                                            <\/a>\r\n                                        <\/div>\r\n\r\n                                    <\/div>\r\n\r\n                                <\/div>\r\n                            <\/li>\r\n\r\n                        \r\n                            <li class=\"splide__slide\">\r\n                                <div class=\"bg-color4 b1400:py-100 b1400:px-[115px] b1200:p-80 b767:p-60 px-20 py-60 flex flex-col b1024:flex-row h-full text-center b767:text-start\">\r\n                                    \r\n                                    <!-- LEFT -->\r\n                                    <div class=\"flex flex-col justify-between b1024:w-[337px] b767:mb-10 mb-8 b1024:mb-0 gap-10\">\r\n                                        \r\n                                        <h3 class=\"b1024:text-[40px] text-3xl font-normal leading-none\">\r\n                                            Football West: 50+ Staff. 4 Hours. A Whole Organisation Ready to Use AI From Day One.                                        <\/h3>\r\n\r\n                                        <div>\r\n                                            <img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"576\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/football-west-training-1024x576.jpg\" class=\"w-full object-cover rounded-[10px] wp-post-image\" alt=\"Wide-angle photo of Football West AI training day showing many participants including staff in football jerseys seated at tables with laptops in a modern conference room with presentation screens\" srcset=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/football-west-training-1024x576.jpg 1024w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/football-west-training-300x169.jpg 300w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/football-west-training-768x432.jpg 768w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/football-west-training-1536x864.jpg 1536w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/football-west-training.jpg 1920w\" sizes=\"auto, (max-width: 1024px) 100vw, 1024px\" \/>                                        <\/div>\r\n\r\n                                    <\/div>\r\n\r\n                                    <!-- RIGHT -->\r\n                                    <div class=\"flex flex-col justify-between flex-1 b1400:pl-[86px] b1200:pl-60 b1400:ml-[86px] b1200:ml-[60px] b1024:pl-40 b1024:ml-10 b1024:border-l b1024:border-color1\">\r\n                                        \r\n                                        <div class=\"text-base\">\r\n                                            50+ Football West staff went from zero to hands-on AI capable in a single 4-hour session, walking out with a curated toolkit and their own use cases.                                        <\/div>\r\n\r\n                                        <div class=\"flex mt-8\">\r\n                                            <a href=\"https:\/\/aiadvancements.com.au\/case-study\/ai-fundamentals-training-football-west\/\" class=\"btn btn-solidcolor1 flex justify-center items-center gap-2 overflow-hidden mx-auto b767:mx-0\">\r\n                                                <span class=\"block circle relative\"><\/span>\r\n                                                <div class=\"button-text z-10\">Read more<\/div>\r\n                                            <\/a>\r\n                                        <\/div>\r\n\r\n                                    <\/div>\r\n\r\n                                <\/div>\r\n                            <\/li>\r\n\r\n                        \r\n                            <li class=\"splide__slide\">\r\n                                <div class=\"bg-color4 b1400:py-100 b1400:px-[115px] b1200:p-80 b767:p-60 px-20 py-60 flex flex-col b1024:flex-row h-full text-center b767:text-start\">\r\n                                    \r\n                                    <!-- LEFT -->\r\n                                    <div class=\"flex flex-col justify-between b1024:w-[337px] b767:mb-10 mb-8 b1024:mb-0 gap-10\">\r\n                                        \r\n                                        <h3 class=\"b1024:text-[40px] text-3xl font-normal leading-none\">\r\n                                            City of Canning: 15 AI Use Cases, a Shared Language, and a Leadership Team Ready to Act                                        <\/h3>\r\n\r\n                                        <div>\r\n                                            <img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"683\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/city-of-canning-1024x683.png\" class=\"w-full object-cover rounded-[10px] wp-post-image\" alt=\"City of Canning Western Australia local government logo showing dark navy geometric C-shaped shield icon with stylized lines alongside bold City of Canning text\" srcset=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/city-of-canning-1024x683.png 1024w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/city-of-canning-300x200.png 300w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/city-of-canning-768x512.png 768w, https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/city-of-canning.png 1536w\" sizes=\"auto, (max-width: 1024px) 100vw, 1024px\" \/>                                        <\/div>\r\n\r\n                                    <\/div>\r\n\r\n                                    <!-- RIGHT -->\r\n                                    <div class=\"flex flex-col justify-between flex-1 b1400:pl-[86px] b1200:pl-60 b1400:ml-[86px] b1200:ml-[60px] b1024:pl-40 b1024:ml-10 b1024:border-l b1024:border-color1\">\r\n                                        \r\n                                        <div class=\"text-base\">\r\n                                            A tailored AI for Leaders workshop gave City of Canning&#039;s senior team a shared language, a governance-first approach, and 15 ready-to-act AI use cases.                                        <\/div>\r\n\r\n                                        <div class=\"flex mt-8\">\r\n                                            <a href=\"https:\/\/aiadvancements.com.au\/case-study\/local-government-ai-leaders-training\/\" class=\"btn btn-solidcolor1 flex justify-center items-center gap-2 overflow-hidden mx-auto b767:mx-0\">\r\n                                                <span class=\"block circle relative\"><\/span>\r\n                                                <div class=\"button-text z-10\">Read more<\/div>\r\n                                            <\/a>\r\n                                        <\/div>\r\n\r\n                                    <\/div>\r\n\r\n                                <\/div>\r\n                            <\/li>\r\n\r\n                                        <\/ul>   \r\n            <\/div>\r\n        <\/div>\r\n    <\/div>\r\n  <\/section>\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n\r\n  \n\n  <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n  <section \r\n      id=\"\" \r\n      data-name=\"acf_testimonials\"\r\n      data-lazyload=\"1\" \r\n      class=\"relative \" \r\n      style=\"z-index: 0;\">\r\n        <div class=\"testimonials-area b1024:py-[120px] py-80 bg-color3\">\r\n            <div class=\"container\">\r\n                                    <div class=\"subheading-wrap text-center\">\r\n                                <h2 class=\" animate-watch standard__headline inline-flex font-semibold text-color1 bg-color2 py-2 px-6 rounded-3xl text-xs mx-auto b767:mx-0 b767:mb-16 mb-10\">Hear from people benefiting from our AI training<\/h2>\n                        <\/div>\r\n                                <div class=\"grid grid-cols-1 b767:grid-cols-2 gap-6 b1024:mb-[90px] mb-[70px] text-center b767:text-start max-w-[1130px] mx-auto\">\r\n                                            <div class=\"heading-wrap w-full b767:w-auto\">\r\n                                    <h3 class=\"h2 animate-watch standard__headline block\">Training that makes a difference<\/h3>\n                            <\/div>\r\n                                                                <div class=\"summary-wrap text-center b767:text-start b1024:pl-[60px] b1400:pl-[116px]\">\r\n                            <p>Our training is designed to deliver immediate, practical value. Hear from teams who have used our AI training to apply AI effectively in their day-to-day roles.<\/p>\n                        <\/div>\r\n                                    <\/div>\r\n            \r\n\r\n\r\n                \r\n                \r\n                <!-- SLIDER -->\r\n                <div class=\"testimonials-wrap pl-10 b767:pl-6 b1400:pl-0\">\r\n                    <div class=\"testimonials_slider splide overflow-visible\">\r\n                        <div class=\"splide__track overflow-visible\">\r\n                            <div class=\"splide__list flex\">\r\n\r\n                                \r\n                                <div class=\"splide__slide testimonial-box overflow-hidden bg-color5 rounded-[20px] b767:p-9 p-7 flex flex-col justify-between transition-transform duration-500 ease-out origin-bottom hover:scale-y-[1.05]\">\r\n\r\n                                    <div class=\"flex\">\r\n                                        <span class=\"box-number testimonial-box-number flex text-[10px] font-bold transition-all duration-700 h-[32px] w-[32px] rounded-full bg-color2 justify-center items-center\">\r\n                                            01                                        <\/span>\r\n                                                                                <div class=\"inline-flex z-10 font-semibold text-color4 bg-black py-2 px-6 rounded-3xl text-xs\">\r\n                                            Primary School                                        <\/div>\r\n                                                                            <\/div>\r\n\r\n                                                                            <div class=\"b1600:py-[86px] z-10 b1024:py-60 py-40 b1600:px-60 b1400:px-40 font-medium leading-[150%] b767:text-[21px]\">\r\n                                            <p>&#8220;Mind blowing! Going home to play on the AI tools!?<\/p>\n                                        <\/div>\r\n                                    \r\n                                    <div class=\"z-10 flex justify-between items-end\">\r\n                                        <div>\r\n                                            <div class=\"font-bold leading-none\">Naomi Jones<\/div>\r\n                                                                                            <div>Hampton Park Primary School Teacher<\/div>\r\n                                                                                    <\/div>\r\n                                                                                    <div class=\"\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/03\/3f5eb2d9dc4444beff1295849d0f14c61ba1bf72.jpg\" \r\n                                                    alt=\"Hampton Park Primary School small logo thumbnail showing school emblem with bird and school name text\" \r\n                                                    class=\"h-[60px] w-auto rounded-[10px]\">\r\n                                            <\/div>\r\n                                                                            <\/div>\r\n\r\n                                <\/div>\r\n\r\n                                \r\n                                <div class=\"splide__slide testimonial-box overflow-hidden bg-color5 rounded-[20px] b767:p-9 p-7 flex flex-col justify-between transition-transform duration-500 ease-out origin-bottom hover:scale-y-[1.05]\">\r\n\r\n                                    <div class=\"flex\">\r\n                                        <span class=\"box-number testimonial-box-number flex text-[10px] font-bold transition-all duration-700 h-[32px] w-[32px] rounded-full bg-color2 justify-center items-center\">\r\n                                            02                                        <\/span>\r\n                                                                                <div class=\"inline-flex z-10 font-semibold text-color4 bg-black py-2 px-6 rounded-3xl text-xs\">\r\n                                            Education Research Solutions                                        <\/div>\r\n                                                                            <\/div>\r\n\r\n                                                                            <div class=\"b1600:py-[86px] z-10 b1024:py-60 py-40 b1600:px-60 b1400:px-40 font-medium leading-[150%] b767:text-[21px]\">\r\n                                            <p>\u201cExcellent explanations and demonstrations. The potential exhibited by Samuel is outstanding. Education is to be transformed through the agency of AI in the hands of creative problem solvers.&#8221;<\/p>\n                                        <\/div>\r\n                                    \r\n                                    <div class=\"z-10 flex justify-between ite