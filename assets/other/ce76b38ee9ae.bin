{"id":616,"date":"2026-03-10T11:39:56","date_gmt":"2026-03-10T11:39:56","guid":{"rendered":"https:\/\/aiadvancements.dilatevps1.cloudsites.net.au\/?page_id=616"},"modified":"2026-08-10T15:39:54","modified_gmt":"2026-08-10T07:39:54","slug":"ai-training","status":"publish","type":"page","link":"https:\/\/aiadvancements.com.au\/ai-training\/","title":{"rendered":"AI Training"},"content":{"rendered":"    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\n        <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\n\n    <!-- BLOCK CODING STARTS HERE -->\n    <section \n        id=\"\" \n        data-name=\"acf_internal-hero\"\n        data-lazyload=\"1\" \n        class=\"relative \" \n        style=\"z-index: 0; background-color:#FFFFFF;\">\n        <div class=\"bg-color5 b1200:pt-200 b767:pt-180 pt-150\">\n            <div class=\"container\">\n                <div class=\"internal-hero-details max-w-[912px] mx-auto b1024:pb-24 b767:pb-20 pb-12\">\n\t\t\t\t\t                    <div class=\"text-center flex items-center mb-[44px]\">\n                        <div class=\"h-[32px] w-[32px] rounded-full bg-color2 flex items-center justify-center\">\n                            <svg width=\"19\" height=\"8\" viewBox=\"0 0 30 13\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M10.1112 0C10.1112 5.75168 5.57492 10.4294 0 10.4294V12.6557C5.60316 12.6557 10.3408 8.76349 11.8042 3.46214V12.6329H13.9649V0H10.11H10.1112Z\" fill=\"#131924\"\/><path d=\"M19.8559 0H16.001V12.6342H18.1617V3.46214C19.6251 8.76223 24.364 12.6557 29.9659 12.6557V10.4294C24.391 10.4294 19.8547 5.75041 19.8547 0H19.8559Z\" fill=\"#131924\"\/><\/svg>\n                        <\/div>\n\t\t\t\t\t\t        <h1 class=\" animate-watch standard__headline inline-flex font-semibold text-color1 bg-color4 py-[11px] px-6 rounded-3xl text-xs super-title\">AI Workshop in Australia<\/h1>\n                        <\/div>\n\t\t\t\t\t\n                    \n                    \n                        <!-- HEADLINE + BELOW HEADLINE -->\n                        <div>\n                                    <h2 class=\"h1 animate-watch standard__headline block tracking-[-0.06em]\">AI Workshops<\/h2>\n                                        <h3 class=\"h3 animate-watch standard__headline block text-color1 b767:mb-10 b767:mt-10 mt-8\">Our AI workshops help your teams understand artificial intelligence in practical terms, identify high-value use cases within your business, and build the confidence to apply AI tools immediately. <br \/>\r\n<br \/>\r\nWe focus on real operational scenarios, so your people leave with clear direction, practical skills, and the ability to start creating measurable value from AI tools from day one.<\/h3>\n    \n                            <div class=\"button-wrap inline-flex flex-col b767:flex-row gap-3 mt-[30px]\">\n                                            <a href=\"https:\/\/aiadvancements.com.au\/contact\/\" target=\"\" class=\"btn btn-solidcolor1 speak-btn flex items-center gap-3 overflow-hidden\">\n                <span class=\"block circle relative\"><\/span>\n                <span class=\"button-text z-10\">Speak to a human<\/span>\n            <\/a>\n                                                        <a href=\"\/#services\" target=\"\" class=\"btn outline-color1 text-center overflow-hidden relative z-10\">\n                Explore Our AI Services            <\/a>\n                                        <\/div>\n                        <\/div>\n\n                                    <\/div>\n            <\/div>\n            \n                        <div class=\"internal-hero-video video-expand-wrapper\">\n\n                <div class=\"hero-video-wrapper relative\">\n\n                    <!-- ===================== -->\n                    <!-- MEDIA -->\n                    <!-- ===================== -->\n                    <div class=\"desktop-media\">\n\n                        \n                        \n                            <!-- DESKTOP VIDEO -->\n                                                        <div class=\"hero-oembed desktop-only w-full h-full\">\n                                <iframe \n                                    src=\"https:\/\/player.vimeo.com\/video\/1192463008?autoplay=0&#038;muted=0&#038;background=0&#038;controls=1&#038;title=0&#038;byline=0&#038;portrait=0&#038;dnt=1&#038;sidedock=0\" \n                                    frameborder=\"0\" \n                                    allow=\"autoplay; fullscreen\" \n                                    allowfullscreen>\n                                <\/iframe>\n                            <\/div>\n\n                            <!-- MOBILE VIDEO -->\n                                                        <div class=\"hero-oembed mobile-only w-full h-full\">\n                                <iframe \n                                    src=\"https:\/\/player.vimeo.com\/video\/1192504834?autoplay=0&#038;muted=0&#038;background=0&#038;controls=1&#038;title=0&#038;byline=0&#038;portrait=0&#038;dnt=1&#038;sidedock=0\" \n                                    frameborder=\"0\" \n                                    allow=\"autoplay; fullscreen\" \n                                    allowfullscreen>\n                                <\/iframe>\n                            <\/div>\n\n                        \n                    <\/div>\n\n                    <!-- ===================== -->\n                    <!-- THUMBNAIL -->\n                    <!-- ===================== -->\n                                            <div class=\"video-thumbnail absolute inset-0 z-20\">\n                            <picture class=\"w-full h-full\"><source media=\"(min-width: 481px)\" srcset=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/05\/image-3.jpg\"><img decoding=\"async\" class=\"w-full h-full\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/05\/image-3.jpg\" alt=\"AI Advancements team member inviting businesses to come speak with them about AI training solutions\" style=\"object-fit:cover;object-position:center;\" loading=\"lazy\" width=\"1642\" height=\"917\" \/><\/picture>                        <\/div>\n                    \n                    <!-- ===================== -->\n                    <!-- PLAY BUTTON -->\n                    <!-- ===================== -->\n                                            <button class=\"video-toggle absolute inset-0 flex items-center justify-center z-30\">\n                            <span class=\"play-btn flex items-center justify-center\">\n                                <svg width=\"98\" height=\"98\" viewBox=\"0 0 98 98\" fill=\"none\">\n                                    <circle cx=\"49\" cy=\"49\" r=\"49\" fill=\"#FCFF6A\"\/>\n                                    <path d=\"M68 49L39.5 65.4545L39.5 32.5455L68 49Z\" fill=\"#131924\"\/>\n                                <\/svg>\n                            <\/span>\n                        <\/button>\n                    \n                <\/div>\n\n            <\/div>\n                    <\/div>\n    <\/section>\n    <!-- BLOCK CODING STARTS HERE -->\n\n    \n\n  <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n  <section \r\n      id=\"\" \r\n      data-name=\"acf_ai-training-services\"\r\n      data-lazyload=\"1\" \r\n      class=\"relative \" \r\n      style=\"z-index: 0;\">\r\n      <div id=\"services\" class=\"b1200:py-[112] b1024:py-[100px] py-80\">\r\n            <div class=\"container\">\r\n                                    <div class=\"flex justify-center\">\r\n                                <h2 class=\" animate-watch standard__headline inline-flex font-semibold text-color1 bg-color4 py-2 px-6 rounded-3xl text-xs super-title\">Our AI training services <\/h2>\n                        <\/div>\r\n                                <div class=\"grid grid-cols-1 b767:grid-cols-2 gap-x-9 mt-12 b767:mb-16 mb-10 max-w-[1130px] mx-auto text-center b767:text-start\">\r\n                                            <div class=\"\">\r\n                                    <h3 class=\"h2 animate-watch standard__headline block mb-6 b767:mb-0\">Practical, relevant AI training<\/h3>\n                            <\/div>\r\n                                                                <div class=\"summary\">\r\n                            <p>Our AI workshops are designed to meet your team at their current level of understanding, then work directly with you to apply AI to your specific workflows. We focus on practical implementation, not theory-heavy explanations.<\/p>\n<p>During the session, we collaborate with your team to identify where AI can add value across your existing systems and processes.<\/p>\n<p>Instead of generic examples, we tailor the session to your real tools, real constraints, and real operational priorities, so your people leave knowing exactly how AI fits into their day-to-day work.<\/p>\n                        <\/div>\r\n                                    <\/div>\r\n                \r\n                                <div class=\"grid grid-cols-1 b767:grid-cols-2 b1024:grid-cols-3 gap-6\">\r\n                                            <div class=\"training-services-list group bg-color4 b1200:py-12 py-9 px-5 b1200:px-11 rounded-[10px] flex flex-col justify-between relative overflow-hidden\">\r\n                            <div class=\"h-full relative\">\r\n                                <div class=\"h-[59px] w-[59px] rounded-full bg-color2 group-hover:bg-color1 duration-[.6s] flex items-center justify-center\">\r\n                                    <svg class=\"fill-color1 group-hover:fill-color4 transition duration-[.6s]\" width=\"33\" height=\"14\" viewBox=\"0 0 30 13\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\">\r\n                                        <path d=\"M10.1112 0C10.1112 5.75168 5.57492 10.4294 0 10.4294V12.6557C5.60316 12.6557 10.3408 8.76349 11.8042 3.46214V12.6329H13.9649V0H10.11H10.1112Z\"\/>\r\n                                        <path d=\"M19.8559 0H16.001V12.6342H18.1617V3.46214C19.6251 8.76223 24.364 12.6557 29.9659 12.6557V10.4294C24.391 10.4294 19.8547 5.75041 19.8547 0H19.8559Z\"\/>\r\n                                    <\/svg>\r\n                                <\/div>\r\n                                <div class=\"internal-training\">\r\n                                                                            <h3 class=\"my-5 b1200:text-[35px] text-3xl\">\r\n                                            AI Fundamentals                                        <\/h3>\r\n                                                                                                            <div class=\"grid grid-cols-2 gap-3 pb-5 mb-5 border-b border-color1\">\r\n                                        <div>\r\n                                            <span class=\"block font-medium text-xs mb-[17px]\">Duration<\/span>\r\n                                            <div class=\"font-medium text-[22px]\">4 hours<\/div>\r\n                                        <\/div>\r\n                                        <div class=\"border-l border-color1 pl-3\">\r\n                                            <span class=\"block font-medium text-xs mb-[17px]\">Cost<\/span>\r\n                                            <div class=\"font-medium text-[22px]\">$3,500<\/div>\r\n                                        <\/div>\r\n                                    <\/div>\r\n                                                                                                                <div class=\"\">\r\n                                            <p>This foundational AI workshop helps teams understand what AI is, and just as importantly, what it isn\u2019t, so they can approach it with clarity and confidence.<\/p>\n<p>Participants learn core AI concepts, common misconceptions, and how AI is already being used to improve productivity and automation in real organisations.<\/p>\n                                        <\/div>\r\n                                                                    <\/div>\r\n                            <\/div>\r\n                            <div class=\"flex mt-14\">\r\n                                                                    \r\n                                    <a class=\"training-service-btn btn-solidcolor3 rounded-[50px]\" href=\"https:\/\/aiadvancements.com.au\/ai-fundamentals\/\" target=\"_self\">\r\n                                        <div class=\"btn inline-flex items-center gap-2 overflow-hidden relative z-50\">\r\n                                            <span class=\"block circle relative\"><\/span>\r\n                                            <div class=\"button-text z-10\">Learn more<\/div>\r\n                                        <\/div>\r\n                                    <\/a>\r\n                                                            <\/div>\r\n                        <\/div>\r\n                                            <div class=\"training-services-list group bg-color4 b1200:py-12 py-9 px-5 b1200:px-11 rounded-[10px] flex flex-col justify-between relative overflow-hidden\">\r\n                            <div class=\"h-full relative\">\r\n                                <div class=\"h-[59px] w-[59px] rounded-full bg-color2 group-hover:bg-color1 duration-[.6s] flex items-center justify-center\">\r\n                                    <svg class=\"fill-color1 group-hover:fill-color4 transition duration-[.6s]\" width=\"33\" height=\"14\" viewBox=\"0 0 30 13\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\">\r\n                                        <path d=\"M10.1112 0C10.1112 5.75168 5.57492 10.4294 0 10.4294V12.6557C5.60316 12.6557 10.3408 8.76349 11.8042 3.46214V12.6329H13.9649V0H10.11H10.1112Z\"\/>\r\n                                        <path d=\"M19.8559 0H16.001V12.6342H18.1617V3.46214C19.6251 8.76223 24.364 12.6557 29.9659 12.6557V10.4294C24.391 10.4294 19.8547 5.75041 19.8547 0H19.8559Z\"\/>\r\n                                    <\/svg>\r\n                                <\/div>\r\n                                <div class=\"internal-training\">\r\n                                                                            <h3 class=\"my-5 b1200:text-[35px] text-3xl\">\r\n                                            Copilot                                        <\/h3>\r\n                                                                                                            <div class=\"grid grid-cols-2 gap-3 pb-5 mb-5 border-b border-color1\">\r\n                                        <div>\r\n                                            <span class=\"block font-medium text-xs mb-[17px]\">Duration<\/span>\r\n                                            <div class=\"font-medium text-[22px]\">3 hours<\/div>\r\n                                        <\/div>\r\n                                        <div class=\"border-l border-color1 pl-3\">\r\n                                            <span class=\"block font-medium text-xs mb-[17px]\">Cost<\/span>\r\n                                            <div class=\"font-medium text-[22px]\">$3,000<\/div>\r\n                                        <\/div>\r\n                                    <\/div>\r\n                                                                                                                <div class=\"\">\r\n                                            <p>This hands-on session shows teams how to get real results from Microsoft 365 Copilot across tools they already use.<\/p>\n<p>Training focuses on effective use of Copilot in apps like Word, Teams, and SharePoint, including how to provide context and work with simple AI agents.<\/p>\n                                        <\/div>\r\n                                                                    <\/div>\r\n                            <\/div>\r\n                            <div class=\"flex mt-14\">\r\n                                                                    \r\n                                    <a class=\"training-service-btn btn-solidcolor3 rounded-[50px]\" href=\"https:\/\/aiadvancements.com.au\/copilot-workshop\/\" target=\"_self\">\r\n                                        <div class=\"btn inline-flex items-center gap-2 overflow-hidden relative z-50\">\r\n                                            <span class=\"block circle relative\"><\/span>\r\n                                            <div class=\"button-text z-10\">Learn more<\/div>\r\n                                        <\/div>\r\n                                    <\/a>\r\n                                                            <\/div>\r\n                        <\/div>\r\n                                            <div class=\"training-services-list group bg-color4 b1200:py-12 py-9 px-5 b1200:px-11 rounded-[10px] flex flex-col justify-between relative overflow-hidden\">\r\n                            <div class=\"h-full relative\">\r\n                                <div class=\"h-[59px] w-[59px] rounded-full bg-color2 group-hover:bg-color1 duration-[.6s] flex items-center justify-center\">\r\n                                    <svg class=\"fill-color1 group-hover:fill-color4 transition duration-[.6s]\" width=\"33\" height=\"14\" viewBox=\"0 0 30 13\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\">\r\n                                        <path d=\"M10.1112 0C10.1112 5.75168 5.57492 10.4294 0 10.4294V12.6557C5.60316 12.6557 10.3408 8.76349 11.8042 3.46214V12.6329H13.9649V0H10.11H10.1112Z\"\/>\r\n                                        <path d=\"M19.8559 0H16.001V12.6342H18.1617V3.46214C19.6251 8.76223 24.364 12.6557 29.9659 12.6557V10.4294C24.391 10.4294 19.8547 5.75041 19.8547 0H19.8559Z\"\/>\r\n                                    <\/svg>\r\n                                <\/div>\r\n                                <div class=\"internal-training\">\r\n                                                                            <h3 class=\"my-5 b1200:text-[35px] text-3xl\">\r\n                                            Claude                                        <\/h3>\r\n                                                                                                            <div class=\"grid grid-cols-2 gap-3 pb-5 mb-5 border-b border-color1\">\r\n                                        <div>\r\n                                            <span class=\"block font-medium text-xs mb-[17px]\">Duration<\/span>\r\n                                            <div class=\"font-medium text-[22px]\">3 hours<\/div>\r\n                                        <\/div>\r\n                                        <div class=\"border-l border-color1 pl-3\">\r\n                                            <span class=\"block font-medium text-xs mb-[17px]\">Cost<\/span>\r\n                                            <div class=\"font-medium text-[22px]\">$3,000<\/div>\r\n                                        <\/div>\r\n                                    <\/div>\r\n                                                                                                                <div class=\"\">\r\n                                            <p>This workshop shows teams how to get the most out of Claude and its advanced functionality like skills, connectors and Cowork.<\/p>\n<p>It focuses on practical demonstrations and challenges that allow participants to start automating their work with AI.<\/p>\n                                        <\/div>\r\n                                                                    <\/div>\r\n                            <\/div>\r\n                            <div class=\"flex mt-14\">\r\n                                                                    \r\n                                    <a class=\"training-service-btn btn-solidcolor3 rounded-[50px]\" href=\"https:\/\/aiadvancements.com.au\/claude-workshop\/\" target=\"_self\">\r\n                                        <div class=\"btn inline-flex items-center gap-2 overflow-hidden relative z-50\">\r\n                                            <span class=\"block circle relative\"><\/span>\r\n                                            <div class=\"button-text z-10\">Learn more<\/div>\r\n                                        <\/div>\r\n                                    <\/a>\r\n                                                            <\/div>\r\n                        <\/div>\r\n                                            <div class=\"training-services-list group bg-color4 b1200:py-12 py-9 px-5 b1200:px-11 rounded-[10px] flex flex-col justify-between relative overflow-hidden\">\r\n                            <div class=\"h-full relative\">\r\n                                <div class=\"h-[59px] w-[59px] rounded-full bg-color2 group-hover:bg-color1 duration-[.6s] flex items-center justify-center\">\r\n                                    <svg class=\"fill-color1 group-hover:fill-color4 transition duration-[.6s]\" width=\"33\" height=\"14\" viewBox=\"0 0 30 13\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\">\r\n                                        <path d=\"M10.1112 0C10.1112 5.75168 5.57492 10.4294 0 10.4294V12.6557C5.60316 12.6557 10.3408 8.76349 11.8042 3.46214V12.6329H13.9649V0H10.11H10.1112Z\"\/>\r\n                                        <path d=\"M19.8559 0H16.001V12.6342H18.1617V3.46214C19.6251 8.76223 24.364 12.6557 29.9659 12.6557V10.4294C24.391 10.4294 19.8547 5.75041 19.8547 0H19.8559Z\"\/>\r\n                                    <\/svg>\r\n                                <\/div>\r\n                                <div class=\"internal-training\">\r\n                                                                            <h3 class=\"my-5 b1200:text-[35px] text-3xl\">\r\n                                            ChatGPT                                        <\/h3>\r\n                                                                                                            <div class=\"grid grid-cols-2 gap-3 pb-5 mb-5 border-b border-color1\">\r\n                                        <div>\r\n                                            <span class=\"block font-medium text-xs mb-[17px]\">Duration<\/span>\r\n                                            <div class=\"font-medium text-[22px]\">2 hours<\/div>\r\n                                        <\/div>\r\n                                        <div class=\"border-l border-color1 pl-3\">\r\n                                            <span class=\"block font-medium text-xs mb-[17px]\">Cost<\/span>\r\n                                            <div class=\"font-medium text-[22px]\">$2,000<\/div>\r\n                                        <\/div>\r\n                                    <\/div>\r\n                                                                                                                <div class=\"\">\r\n                                            <p>Learn how to get more value from ChatGPT while understanding where the risks sit.<\/p>\n<p>Teams learn how large language models work, how to use ChatGPT effectively day to day, and how to tailor it to real business workflows.<\/p>\n                                        <\/div>\r\n                                                                    <\/div>\r\n                            <\/div>\r\n                            <div class=\"flex mt-14\">\r\n                                                                    \r\n                                    <a class=\"training-service-btn btn-solidcolor3 rounded-[50px]\" href=\"https:\/\/aiadvancements.com.au\/chatgpt-workshop\/\" target=\"_self\">\r\n                                        <div class=\"btn inline-flex items-center gap-2 overflow-hidden relative z-50\">\r\n                                            <span class=\"block circle relative\"><\/span>\r\n                                            <div class=\"button-text z-10\">Learn more<\/div>\r\n                                        <\/div>\r\n                                    <\/a>\r\n                                                            <\/div>\r\n                        <\/div>\r\n                                            <div class=\"training-services-list group bg-color4 b1200:py-12 py-9 px-5 b1200:px-11 rounded-[10px] flex flex-col justify-between relative overflow-hidden\">\r\n                            <div class=\"h-full relative\">\r\n                                <div class=\"h-[59px] w-[59px] rounded-full bg-color2 group-hover:bg-color1 duration-[.6s] flex items-center justify-center\">\r\n                                    <svg class=\"fill-color1 group-hover:fill-color4 transition duration-[.6s]\" width=\"33\" height=\"14\" viewBox=\"0 0 30 13\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\">\r\n                                        <path d=\"M10.1112 0C10.1112 5.75168 5.57492 10.4294 0 10.4294V12.6557C5.60316 12.6557 10.3408 8.76349 11.8042 3.46214V12.6329H13.9649V0H10.11H10.1112Z\"\/>\r\n                                        <path d=\"M19.8559 0H16.001V12.6342H18.1617V3.46214C19.6251 8.76223 24.364 12.6557 29.9659 12.6557V10.4294C24.391 10.4294 19.8547 5.75041 19.8547 0H19.8559Z\"\/>\r\n                                    <\/svg>\r\n                                <\/div>\r\n                                <div class=\"internal-training\">\r\n                                                                            <h3 class=\"my-5 b1200:text-[35px] text-3xl\">\r\n                                            AI for Leaders                                        <\/h3>\r\n                                                                                                            <div class=\"grid grid-cols-2 gap-3 pb-5 mb-5 border-b border-color1\">\r\n                                        <div>\r\n                                            <span class=\"block font-medium text-xs mb-[17px]\">Duration<\/span>\r\n                                            <div class=\"font-medium text-[22px]\">4 hours<\/div>\r\n                                        <\/div>\r\n                                        <div class=\"border-l border-color1 pl-3\">\r\n                                            <span class=\"block font-medium text-xs mb-[17px]\">Cost<\/span>\r\n                                            <div class=\"font-medium text-[22px]\">$6,000<\/div>\r\n                                        <\/div>\r\n                                    <\/div>\r\n                                                                                                                <div class=\"\">\r\n                                            <p>This course helps leaders understand where AI genuinely adds value and where it doesn\u2019t, so they can make informed strategic decisions.<\/p>\n<p>It covers governance, risk, and operational readiness, giving leaders a clear view of how to adopt AI safely and responsibly.<\/p>\n                                        <\/div>\r\n                                                                    <\/div>\r\n                            <\/div>\r\n                            <div class=\"flex mt-14\">\r\n                                                                    \r\n                                    <a class=\"training-service-btn btn-solidcolor3 rounded-[50px]\" href=\"https:\/\/aiadvancements.com.au\/ai-for-leaders\/\" target=\"_self\">\r\n                                        <div class=\"btn inline-flex items-center gap-2 overflow-hidden relative z-50\">\r\n                                            <span class=\"block circle relative\"><\/span>\r\n                                            <div class=\"button-text z-10\">Learn more<\/div>\r\n                                        <\/div>\r\n                                    <\/a>\r\n                                                            <\/div>\r\n                        <\/div>\r\n                                            <div class=\"training-services-list group bg-color4 b1200:py-12 py-9 px-5 b1200:px-11 rounded-[10px] flex flex-col justify-between relative overflow-hidden\">\r\n                            <div class=\"h-full relative\">\r\n                                <div class=\"h-[59px] w-[59px] rounded-full bg-color2 group-hover:bg-color1 duration-[.6s] flex items-center justify-center\">\r\n                                    <svg class=\"fill-color1 group-hover:fill-color4 transition duration-[.6s]\" width=\"33\" height=\"14\" viewBox=\"0 0 30 13\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\">\r\n                                        <path d=\"M10.1112 0C10.1112 5.75168 5.57492 10.4294 0 10.4294V12.6557C5.60316 12.6557 10.3408 8.76349 11.8042 3.46214V12.6329H13.9649V0H10.11H10.1112Z\"\/>\r\n                                        <path d=\"M19.8559 0H16.001V12.6342H18.1617V3.46214C19.6251 8.76223 24.364 12.6557 29.9659 12.6557V10.4294C24.391 10.4294 19.8547 5.75041 19.8547 0H19.8559Z\"\/>\r\n                                    <\/svg>\r\n                                <\/div>\r\n                                <div class=\"internal-training\">\r\n                                                                            <h3 class=\"my-5 b1200:text-[35px] text-3xl\">\r\n                                            Looking for something else?                                        <\/h3>\r\n                                                                                                                                                    <div class=\"\">\r\n                                            <p>Not every team fits neatly into a standard course, and that\u2019s expected. We offer tailored <a href=\"https:\/\/aiadvancements.com.au\/ai-training\/\">AI training<\/a> designed around your people, your tools, and the problems you actually need to solve.<\/p>\n                                        <\/div>\r\n                                                                    <\/div>\r\n                            <\/div>\r\n                            <div class=\"flex mt-14\">\r\n                                                                    \r\n                                    <a class=\"training-service-btn btn-solidcolor3 rounded-[50px]\" href=\"https:\/\/aiadvancements.com.au\/contact\/\" target=\"_self\">\r\n                                        <div class=\"btn inline-flex items-center gap-2 overflow-hidden relative z-50\">\r\n                                            <span class=\"block circle relative\"><\/span>\r\n                                            <div class=\"button-text z-10\">Learn more<\/div>\r\n                                        <\/div>\r\n                                    <\/a>\r\n                                                            <\/div>\r\n                        <\/div>\r\n                                    <\/div>\r\n                            <\/div>\r\n        <\/div>\r\n  <\/section>\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n\r\n  \n\n  <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n \r\n  <!-- BLOCK CODING STARTS HERE -->\r\n<section\r\n      id=\"\"\r\n      data-name=\"acf_approach-tab\"\r\n      data-lazyload=\"1\"\r\n      class=\"relative \"\r\n      style=\"z-index: 0;\">\r\n    <div class=\"b1024:py-[124px] py-[80px] bg-color3 \" style=\"background-color: \">\r\n        <div class=\"container\">\r\n            <div class=\"max-w-[1130px] mx-auto\">\r\n                <div class=\"approach-title max-w-[664px] mx-auto b767:mb-[74px] mb-12 text-center two-column-content\">\r\n                                            <div class=\"heading-wrap flex-1\">\r\n                                    <h2 class=\"h2 animate-watch standard__headline block mb-10\">Simple, practical <br>training, delivered your way<\/h2>\n                            <\/div>\r\n                                        <div class=\"summary-wrap ml-auto\">\r\n                                                    <div class=\"approach-text\">\r\n                                <p>Our AI training is designed to be straightforward, flexible, and immediately useful. We start by understanding your organisation, your people, and the tools you already use, then tailor the session to deliver practical outcomes from day one.<\/p>\n<p>Every workshop is interactive, grounded in real scenarios, and led by AI-native practitioners who adapt the session as questions and priorities emerge.<\/p>\n                            <\/div>\r\n                                                \r\n                                            <\/div>\r\n                <\/div>\r\n            <\/div>\r\n        <\/div>\r\n        <div class=\"approach-content\">\r\n\r\n            <!-- TAB BUTTONS -->\r\n            <div class=\"tab-button-group flex justify-center gap-6 mb-11\">\r\n                                                                                                <button class=\"tab-button\" data-tab=\"0\">\r\n                                                    <\/button>\r\n                                                <\/div>\r\n\r\n            <!-- TAB CONTENT -->\r\n            <div class=\"tab-contents\">\r\n\r\n                                                        \r\n                    <div class=\"tab-content-list transition-opacity duration-300\">\r\n\r\n                                                                            <div class=\"tab-content-row\">\r\n                                <div class=\"tab-content-inner gap-5 b767:gap-0 flex-col b767:flex-row\">\r\n                                    <div class=\"number-and-image w-full flex gap-4 justify-start b767:justify-between b767:w-2\/5\">\r\n                                        <div class=\"row-number text-[40px] b767:text-[80px] b991:text-[100px] leading-[1] text-[#131924]\">\r\n                                            01                                        <\/div>\r\n\r\n                                                                                                                            <div class=\"tab-content-image hidden b767:block\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/Establish-governance-and-readiness.jpg\" alt=\"Two smiling AI professionals in dark shirts representing the AI strategy step to establish governance and readiness within an organisation\">\r\n                                            <\/div>\r\n                                        \r\n                                                                                    <div class=\"title-wraper b767:hidden\">\r\n                                                \r\n                                                                                                    <div class=\"h3 b767:hidden\">\r\n                                                        Free consultation                                                    <\/div>\r\n                                                                                            <\/div>\r\n                                                                            <\/div>\r\n\r\n                                    <div class=\"tab-content-title w-full b767:w-1\/2 b767:pt-10 flex gap-3 items-center b767:block\">\r\n                                        \r\n                                                                                    <h3 class=\"hidden b767:block pb-[28px]\">\r\n                                                Free consultation                                            <\/h3>\r\n                                        \r\n                                                                                                                            <div class=\"tab-content-image hidden b767:hidden\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/Establish-governance-and-readiness.jpg\" alt=\"Two smiling AI professionals in dark shirts representing the AI strategy step to establish governance and readiness within an organisation\">\r\n                                            <\/div>\r\n                                        \r\n                                                                                    <div class=\"tab-content-description w-full b767:w-full\">\r\n                                                <p>You begin with a free consultation to explore what you want your team to achieve. We help you determine which AI workshop is the right fit based on your current level of AI maturity, your operational priorities, and the outcomes you want to see.<\/p>\n                                            <\/div>\r\n                                                                            <\/div>\r\n                                <\/div>\r\n                            <\/div>\r\n\r\n                                                                            <div class=\"tab-content-row\">\r\n                                <div class=\"tab-content-inner gap-5 b767:gap-0 flex-col b767:flex-row\">\r\n                                    <div class=\"number-and-image w-full flex gap-4 justify-start b767:justify-between b767:w-2\/5\">\r\n                                        <div class=\"row-number text-[40px] b767:text-[80px] b991:text-[100px] leading-[1] text-[#131924]\">\r\n                                            02                                        <\/div>\r\n\r\n                                                                                                                            <div class=\"tab-content-image hidden b767:block\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/Design-conversation-flows-that-complete-work.jpg\" alt=\"Two professionals in a collaborative discussion around a table, representing the AI chatbot step to design conversation flows that complete work\">\r\n                                            <\/div>\r\n                                        \r\n                                                                                    <div class=\"title-wraper b767:hidden\">\r\n                                                \r\n                                                                                                    <div class=\"h3 b767:hidden\">\r\n                                                        Kickoff meeting                                                    <\/div>\r\n                                                                                            <\/div>\r\n                                                                            <\/div>\r\n\r\n                                    <div class=\"tab-content-title w-full b767:w-1\/2 b767:pt-10 flex gap-3 items-center b767:block\">\r\n                                        \r\n                                                                                    <h3 class=\"hidden b767:block pb-[28px]\">\r\n                                                Kickoff meeting                                            <\/h3>\r\n                                        \r\n                                                                                                                            <div class=\"tab-content-image hidden b767:hidden\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/Design-conversation-flows-that-complete-work.jpg\" alt=\"Two professionals in a collaborative discussion around a table, representing the AI chatbot step to design conversation flows that complete work\">\r\n                                            <\/div>\r\n                                        \r\n                                                                                    <div class=\"tab-content-description w-full b767:w-full\">\r\n                                                <p>Once you proceed, we hold a dedicated kickoff meeting to align on expectations, confirm objectives, and identify any areas you want prioritised. <\/p>\n<p>If required, we tailor elements of the session to your organisation\u2019s systems and workflows so the workshop reflects how your business actually operates.<\/p>\n                                            <\/div>\r\n                                                                            <\/div>\r\n                                <\/div>\r\n                            <\/div>\r\n\r\n                                                                            <div class=\"tab-content-row\">\r\n                                <div class=\"tab-content-inner gap-5 b767:gap-0 flex-col b767:flex-row\">\r\n                                    <div class=\"number-and-image w-full flex gap-4 justify-start b767:justify-between b767:w-2\/5\">\r\n                                        <div class=\"row-number text-[40px] b767:text-[80px] b991:text-[100px] leading-[1] text-[#131924]\">\r\n                                            03                                        <\/div>\r\n\r\n                                                                                                                            <div class=\"tab-content-image hidden b767:block\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/Design-the-AI-reporting-agent.jpg\" alt=\"Close-up of hands typing on a keyboard, representing the AI automation process step to design the AI reporting agent\">\r\n                                            <\/div>\r\n                                        \r\n                                                                                    <div class=\"title-wraper b767:hidden\">\r\n                                                \r\n                                                                                                    <div class=\"h3 b767:hidden\">\r\n                                                        Workshop delivery                                                    <\/div>\r\n                                                                                            <\/div>\r\n                                                                            <\/div>\r\n\r\n                                    <div class=\"tab-content-title w-full b767:w-1\/2 b767:pt-10 flex gap-3 items-center b767:block\">\r\n                                        \r\n                                                                                    <h3 class=\"hidden b767:block pb-[28px]\">\r\n                                                Workshop delivery                                            <\/h3>\r\n                                        \r\n                                                                                                                            <div class=\"tab-content-image hidden b767:hidden\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/Design-the-AI-reporting-agent.jpg\" alt=\"Close-up of hands typing on a keyboard, representing the AI automation process step to design the AI reporting agent\">\r\n                                            <\/div>\r\n                                        \r\n                                                                                    <div class=\"tab-content-description w-full b767:w-full\">\r\n                                                <p>We run the AI workshop in person at your office, at our office in Osborne Park, or online if required. <\/p>\n<p>The session is interactive and hands-on, focused on real use cases and practical application rather than theory. Your team works directly with AI tools and leaves with clear, usable capability.<\/p>\n                                            <\/div>\r\n                                                                            <\/div>\r\n                                <\/div>\r\n                            <\/div>\r\n\r\n                                                                            <div class=\"tab-content-row\">\r\n                                <div class=\"tab-content-inner gap-5 b767:gap-0 flex-col b767:flex-row\">\r\n                                    <div class=\"number-and-image w-full flex gap-4 justify-start b767:justify-between b767:w-2\/5\">\r\n                                        <div class=\"row-number text-[40px] b767:text-[80px] b991:text-[100px] leading-[1] text-[#131924]\">\r\n                                            04                                        <\/div>\r\n\r\n                                                                                                                            <div class=\"tab-content-image hidden b767:block\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/Refine-standardise-and-scale-1.jpg\" alt=\"Developer working at a large monitor displaying code, representing the process to refine, standardise, and scale AI solutions\">\r\n                                            <\/div>\r\n                                        \r\n                                                                                    <div class=\"title-wraper b767:hidden\">\r\n                                                \r\n                                                                                                    <div class=\"h3 b767:hidden\">\r\n                                                        Post-workshop support                                                    <\/div>\r\n                                                                                            <\/div>\r\n                                                                            <\/div>\r\n\r\n                                    <div class=\"tab-content-title w-full b767:w-1\/2 b767:pt-10 flex gap-3 items-center b767:block\">\r\n                                        \r\n                                                                                    <h3 class=\"hidden b767:block pb-[28px]\">\r\n                                                Post-workshop support                                            <\/h3>\r\n                                        \r\n                                                                                                                            <div class=\"tab-content-image hidden b767:hidden\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/Refine-standardise-and-scale-1.jpg\" alt=\"Developer working at a large monitor displaying code, representing the process to refine, standardise, and scale AI solutions\">\r\n                                            <\/div>\r\n                                        \r\n                                                                                    <div class=\"tab-content-description w-full b767:w-full\">\r\n                                                <p>After the session, our team remains available to answer follow-up questions and help you identify next steps. This might mean refining use cases, running additional workshops, or exploring custom AI development.<\/p>\n                                            <\/div>\r\n                                                                            <\/div>\r\n                                <\/div>\r\n                            <\/div>\r\n\r\n                                                \r\n                    <\/div>\r\n\r\n                                    \r\n            <\/div>\r\n\r\n            <!-- TAB BUTTONS -->\r\n            <div class=\"tab-button-group flex justify-center gap-6 mt-11\">\r\n                                                                                                <button class=\"tab-button\" data-tab=\"0\">\r\n                                                    <\/button>\r\n                                                <\/div>\r\n\r\n        <\/div>\r\n    <\/div>\r\n<\/section>\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n \r\n  \n\n  <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n  <section \r\n      id=\"\" \r\n      data-name=\"acf_logo-slider\"\r\n      data-lazyload=\"1\" \r\n      class=\"relative \" \r\n      style=\"z-index: 0;\">\r\n        <div class=\"logo-slider-area pt-[145px]\">\r\n            <div class=\"container\">\r\n                <div class=\"logo-slider-title text-center flex items-center justify-center mb-16 b767:mb-[72px]\">\r\n                    <div class=\"ls-title-icon h-[48px] w-[48px] rounded-full bg-color2 flex items-center justify-center\">\r\n                        <svg width=\"30\" height=\"13\" viewBox=\"0 0 30 13\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M10.1112 0C10.1112 5.75168 5.57492 10.4294 0 10.4294V12.6557C5.60316 12.6557 10.3408 8.76349 11.8042 3.46214V12.6329H13.9649V0H10.11H10.1112Z\" fill=\"#131924\"\/><path d=\"M19.8559 0H16.001V12.6342H18.1617V3.46214C19.6251 8.76223 24.364 12.6557 29.9659 12.6557V10.4294C24.3