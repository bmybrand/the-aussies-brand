                                        <\/div>\r\n\r\n                                                                            <div class=\"b1600:py-[86px] z-10 b1024:py-60 py-40 b1600:px-60 b1400:px-40 font-medium leading-[150%] b767:text-[21px]\">\r\n                                            <p>\u201cHighly recommend Samuel and team for AI consults!\u201d<\/p>\n                                        <\/div>\r\n                                    \r\n                                    <div class=\"z-10 flex justify-between items-end\">\r\n                                        <div>\r\n                                            <div class=\"font-bold leading-none\">Matt Cahill<\/div>\r\n                                                                                    <\/div>\r\n                                                                                    <div class=\"\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/images-removebg-preview1.png\" \r\n                                                    alt=\"Signifi Media logo - bold text with teal geometric diamond icon on transparent background\" \r\n                                                    class=\"h-[60px] w-auto rounded-[10px]\">\r\n                                            <\/div>\r\n                                                                            <\/div>\r\n\r\n                                <\/div>\r\n\r\n                                \r\n                            <\/div>\r\n                        <\/div>\r\n                    <\/div>\r\n\r\n                    <div class=\"splide__arrows testimonals-nav flex justify-start gap-2 mt-4\">\r\n                          <button class=\"splide__arrow splide__arrow--prev w-[43px] h-[43px] group flex justify-center items-center rounded-[6px] bg-color1 hover:bg-color2 overflow-hidden transition duration-500 ease-in cursor-pointer hover:color1\" aria-label=\"go to previous slide\">\n    <span class=\"icon\">\n      <svg width=\"8\" height=\"9\" viewBox=\"0 0 8 9\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M0.5 3.16669C-0.166666 3.55159 -0.166667 4.51384 0.5 4.89874L5.75 7.92983C6.41667 8.31473 7.25 7.8336 7.25 7.0638L7.25 1.00163C7.25 0.231826 6.41667 -0.2493 5.75 0.135601L0.5 3.16669Z\" fill=\"#C2CEE8\"\/>\n      <\/svg>\n    <\/span>\n  <\/button>\n\n  <button class=\"splide__arrow splide__arrow--next w-[43px] h-[43px] group flex justify-center items-center rounded-[6px] bg-color1 hover:bg-color2 overflow-hidden transition duration-500 ease-in cursor-pointer hover:color1\" aria-label=\"go to next slide\">\n    <span class=\"icon\">\n      <svg width=\"8\" height=\"9\" viewBox=\"0 0 8 9\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M6.75 3.16669C7.41667 3.55159 7.41667 4.51384 6.75 4.89874L1.5 7.92983C0.833334 8.31473 5.4712e-07 7.8336 5.80769e-07 7.0638L8.45755e-07 1.00163C8.79404e-07 0.231826 0.833334 -0.2493 1.5 0.135601L6.75 3.16669Z\" fill=\"#C2CEE8\"\/><\/svg>\n    <\/span>\n  <\/button>\n                      <\/div>\r\n                <\/div>\r\n\r\n                            <\/div>\r\n        <\/div>\r\n\r\n  <\/section>\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n\r\n  \n\n  <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\n    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\n\n  <!-- BLOCK CODING STARTS HERE -->\n  <section \n      id=\"\" \n      data-name=\"acf_img-with-text\"\n      data-lazyload=\"1\" \n      class=\"relative \" \n      style=\"z-index: 0;\">\n      <div class=\"img-with-text-area relative b767:py-100 py-80\">\n        <div class=\"container relative\">\n            <div class=\"iwt-content-wrap grid grid-cols-1 b1024:grid-cols-2 items-center b1400:px-80\">\n                <div class=\"iwt-content b1024:pr-40 b1200:pr-80 b1400:pr-[100px] text-center b1024:text-start mb-14 b1024:mb-0\">\n                                            <div class=\"hero-heading\">\n                                <h2 class=\"h2 animate-watch standard__headline block mb-6 b767:mb-10\">Build real AI skills<\/h2>\n                            <\/div>\n                                                                <div class=\"hero-summary b1024:max-w-[438px] my-10 b1024:my-16\">\n                            <p>AI only delivers value when your people know how to use it properly. Our AI workshops equip teams with practical skills they can apply inside your existing systems, helping them find information faster, draft reports and emails more efficiently, and reduce time spent on repetitive tasks.<\/p>\n<p>If you want your team working smarter, not harder, speak with us to understand which workshop fits your people, your goals, and your broader AI strategy.<\/p>\n                        <\/div>\n                                        <div class=\"button-wrap flex flex-col b767:flex-row items-center justify-center b1024:justify-start gap-3 overflow-hidden\">\n                                    <a href=\"https:\/\/aiadvancements.com.au\/contact\/\" target=\"\" class=\"btn btn-solidcolor1 speak-btn flex items-center gap-3 overflow-hidden\">\n                <span class=\"block circle relative\"><\/span>\n                <span class=\"button-text z-10\">Speak to us<\/span>\n            <\/a>\n                                                <a href=\"\/#services\" target=\"\" class=\"btn outline-color1 text-center overflow-hidden relative z-10\">\n                See our services            <\/a>\n                                <\/div>\n                <\/div>\n                <div class=\"iwt-img relative\">\n                                                                <div class=\"overlay-color2\"><\/div>\n                        <div class=\"overlay-color6\"><\/div>\n                        <div class=\"ai-text-two text-xs bg-color2 leading-none pt-[5px] pb-[6px] px-[9px] rounded-3xl\">&lt;ai.advancements&gt;<\/div>\n                                                                                    <picture class=\"w-full h-full\"><source media=\"(min-width: 481px)\" srcset=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/03\/Mask-group2.jpg\"><img decoding=\"async\" class=\"w-full h-full\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/03\/Mask-group2.jpg\" alt=\"Two smiling AI Advancements consultants, one with beard in foreground and another behind, representing the approachable AI Strategy consulting team\" style=\"object-fit:contain;object-position:center;\" loading=\"lazy\" width=\"553\" height=\"707\" \/><\/picture>                                    <\/div>\n            <\/div>\n        <\/div>\n      <\/div>\n  <\/section>\n  <!-- BLOCK CODING STARTS HERE -->\n\n  ","protected":false},"excerpt":{"rendered":"","protected":false},"author":5,"featured_media":0,"parent":0,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"","meta":{"_acf_changed":false,"footnotes":""},"class_list":["post-616","page","type-page","status-publish","hentry"],"acf":[],"_links":{"self":[{"href":"https:\/\/aiadvancements.com.au\/wp-json\/wp\/v2\/pages\/616","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/aiadvancements.com.au\/wp-json\/wp\/v2\/pages"}],"about":[{"href":"https:\/\/aiadvancements.com.au\/wp-json\/wp\/v2\/types\/page"}],"author":[{"embeddable":true,"href":"https:\/\/aiadvancements.com.au\/wp-json\/wp\/v2\/users\/5"}],"replies":[{"embeddable":true,"href":"https:\/\/aiadvancements.com.au\/wp-json\/wp\/v2\/comments?post=616"}],"version-history":[{"count":46,"href":"https:\/\/aiadvancements.com.au\/wp-json\/wp\/v2\/pages\/616\/revisions"}],"predecessor-version":[{"id":2319,"href":"https:\/\/aiadvancements.com.au\/wp-json\/wp\/v2\/pages\/616\/revisions\/2319"}],"wp:attachment":[{"href":"https:\/\/aiadvancements.com.au\/wp-json\/wp\/v2\/media?parent=616"}],"curies":[{"name"