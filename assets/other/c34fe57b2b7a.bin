{"id":1116,"date":"2026-04-01T02:10:58","date_gmt":"2026-04-01T02:10:58","guid":{"rendered":"https:\/\/aiadvancements.dilatevps1.cloudsites.net.au\/?page_id=1116"},"modified":"2026-08-10T17:10:58","modified_gmt":"2026-08-10T09:10:58","slug":"learning-hub","status":"publish","type":"page","link":"https:\/\/aiadvancements.com.au\/learning-hub\/","title":{"rendered":"Learning hub"},"content":{"rendered":"    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\n        <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\n\n    <!-- BLOCK CODING STARTS HERE -->\n    <section \n        id=\"\" \n        data-name=\"acf_internal-hero\"\n        data-lazyload=\"1\" \n        class=\"relative \" \n        style=\"z-index: 0; background-color:#FFFFFF;\">\n        <div class=\"bg-color5 b1200:pt-200 b767:pt-180 pt-150\">\n            <div class=\"container\">\n                <div class=\"internal-hero-details max-w-[912px] mx-auto b1024:pb-24 b767:pb-20 pb-12\">\n\t\t\t\t\t                    <div class=\"text-center flex items-center mb-[44px]\">\n                        <div class=\"h-[32px] w-[32px] rounded-full bg-color2 flex items-center justify-center\">\n                            <svg width=\"19\" height=\"8\" viewBox=\"0 0 30 13\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M10.1112 0C10.1112 5.75168 5.57492 10.4294 0 10.4294V12.6557C5.60316 12.6557 10.3408 8.76349 11.8042 3.46214V12.6329H13.9649V0H10.11H10.1112Z\" fill=\"#131924\"\/><path d=\"M19.8559 0H16.001V12.6342H18.1617V3.46214C19.6251 8.76223 24.364 12.6557 29.9659 12.6557V10.4294C24.391 10.4294 19.8547 5.75041 19.8547 0H19.8559Z\" fill=\"#131924\"\/><\/svg>\n                        <\/div>\n\t\t\t\t\t\t        <h1 class=\" animate-watch standard__headline inline-flex font-semibold text-color1 bg-color4 py-[11px] px-6 rounded-3xl text-xs super-title\">AI Insights &#038; Resources for Australian Businesses<\/h1>\n                        <\/div>\n\t\t\t\t\t\n                    \n                    \n                        <!-- HEADLINE + SUMMARY -->\n                        <div class=\"grid grid-cols-1 b1024:grid-cols-2 b1024:mt-16 b767:mt-10 mt-8 b767:gap-y-10 gap-y-8\">\n                            <div class=\"flex flex-col justify-end\">\n                                <div class=\"h-full\">\n                                            <h2 class=\"h1 animate-watch standard__headline block tracking-[-0.06em]\">Learning hub<\/h2>\n                                    <\/div>\n\n                                <div class=\"button-wrap hidden b1024:inline-flex flex-col b600:flex-row gap-3 mt-[30px] b1024:items-end\">\n                                                <a href=\"https:\/\/aiadvancements.com.au\/case-studies\/\" target=\"\" class=\"btn btn-solidcolor1 speak-btn flex items-center gap-3 overflow-hidden\">\n                <span class=\"block circle relative\"><\/span>\n                <span class=\"button-text z-10\">Learn more<\/span>\n            <\/a>\n                                                            <a href=\"https:\/\/aiadvancements.com.au\/ai-training\/\" target=\"\" class=\"btn btn-secondary-alt outline-color1 text-center overflow-hidden relative z-10\">\n                Our workshops            <\/a>\n                                            <\/div>\n                            <\/div>\n\n                            <div class=\"b1024:pl-[61px] mb-10 b1024:mb-0\">\n                                <p>Here we bring together AI news and insights shaped by real work, projects we\u2019re delivering, tools we\u2019re testing, and questions we\u2019re being asked by clients.<\/p>\n<p>It\u2019s a place to share what we\u2019re learning as we build, train, and iterate with AI inside organisations.<\/p>\n<p>Explore our <a class=\"decorated-link\" href=\"https:\/\/aiadvancements.com.au\/ai-chatbots\/\" target=\"_new\" rel=\"noopener\" data-start=\"810\" data-end=\"878\">AI chatbot development<\/a> service to see how we turn AI concepts into practical solutions for businesses.<\/p>\n                                <div class=\"button-wrap inline-flex b1024:hidden flex-col b767:flex-row gap-3 mt-[30px]\">\n                                                <a href=\"https:\/\/aiadvancements.com.au\/case-studies\/\" target=\"\" class=\"btn btn-solidcolor1 speak-btn flex items-center gap-3 overflow-hidden\">\n                <span class=\"block circle relative\"><\/span>\n                <span class=\"button-text z-10\">Learn more<\/span>\n            <\/a>\n                                                            <a href=\"https:\/\/aiadvancements.com.au\/ai-training\/\" target=\"\" class=\"btn btn-secondary-alt outline-color1 text-center overflow-hidden relative z-10\">\n                Our workshops            <\/a>\n                                            <\/div>\n                            <\/div>\n                        <\/div>\n\n                                    <\/div>\n            <\/div>\n            \n                    <\/div>\n    <\/section>\n    <!-- BLOCK CODING STARTS HERE -->\n\n    \n\n    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\n        <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\n\n    <!-- BLOCK CODING STARTS HERE -->\n    <section \n        id=\"\" \n        data-name=\"acf_blog-main\"\n        data-lazyload=\"1\" \n        class=\"relative \" \n        style=\"z-index: 0;\">\n        <div class=\"py-80\">\n            <div class=\"container\">\n                <div class=\"grid grid-cols-2 b767:grid-cols-4 b767:flex justify-center gap-3 b1024:mb-[72px] mb-10 max-w-[750px] mx-auto\">\n\n                \n                <button type=\"button\" class=\"filter-btn flex-1 blog-pages font-semibold text-color1 bg-color4 py-2 px-4 rounded-3xl text-xs text-center hover:bg-color2 transition active\" data-filter=\"all\">All<\/button>\n\n                                                            <button type=\"button\" class=\"