{"id":1256,"date":"2026-04-01T18:41:59","date_gmt":"2026-04-01T18:41:59","guid":{"rendered":"https:\/\/aiadvancements.dilatevps1.cloudsites.net.au\/?page_id=1256"},"modified":"2026-08-09T21:54:23","modified_gmt":"2026-08-09T13:54:23","slug":"computer-vision","status":"publish","type":"page","link":"https:\/\/aiadvancements.com.au\/ai-development\/computer-vision\/","title":{"rendered":"Computer Vision"},"content":{"rendered":"    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\n        <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\n\n    <!-- BLOCK CODING STARTS HERE -->\n    <section \n        id=\"\" \n        data-name=\"acf_internal-hero\"\n        data-lazyload=\"1\" \n        class=\"relative \" \n        style=\"z-index: 0; background-color:#FFFFFF;\">\n        <div class=\"bg-color5 b1200:pt-200 b767:pt-180 pt-150\">\n            <div class=\"container\">\n                <div class=\"internal-hero-details max-w-[912px] mx-auto b1024:pb-24 b767:pb-20 pb-12\">\n\t\t\t\t\t                    <div class=\"text-center flex items-center mb-[44px]\">\n                        <div class=\"h-[32px] w-[32px] rounded-full bg-color2 flex items-center justify-center\">\n                            <svg width=\"19\" height=\"8\" viewBox=\"0 0 30 13\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M10.1112 0C10.1112 5.75168 5.57492 10.4294 0 10.4294V12.6557C5.60316 12.6557 10.3408 8.76349 11.8042 3.46214V12.6329H13.9649V0H10.11H10.1112Z\" fill=\"#131924\"\/><path d=\"M19.8559 0H16.001V12.6342H18.1617V3.46214C19.6251 8.76223 24.364 12.6557 29.9659 12.6557V10.4294C24.391 10.4294 19.8547 5.75041 19.8547 0H19.8559Z\" fill=\"#131924\"\/><\/svg>\n                        <\/div>\n\t\t\t\t\t\t        <h1 class=\" animate-watch standard__headline inline-flex font-semibold text-color1 bg-color4 py-[11px] px-6 rounded-3xl text-xs super-title\">Computer Vision AI for Perth &#038; Australian Industry<\/h1>\n                        <\/div>\n\t\t\t\t\t\n                    \n                    \n                        <!-- HEADLINE + SUMMARY -->\n                        <div class=\"grid grid-cols-1 b1024:grid-cols-2 b1024:mt-16 b767:mt-10 mt-8 b767:gap-y-10 gap-y-8\">\n                            <div class=\"flex flex-col justify-end\">\n                                <div class=\"h-full\">\n                                            <h2 class=\"h1 animate-watch standard__headline block tracking-[-0.06em]\">Computer Vision<\/h2>\n                                    <\/div>\n\n                                <div class=\"button-wrap hidden b1024:inline-flex flex-col b600:flex-row gap-3 mt-[30px] b1024:items-end\">\n                                                <a href=\"https:\/\/aiadvancements.com.au\/contact\/\" target=\"\" class=\"btn btn-solidcolor1 speak-btn flex items-center gap-3 overflow-hidden\">\n                <span class=\"block circle relative\"><\/span>\n                <span class=\"button-text z-10\">Speak to a human<\/span>\n            <\/a>\n                                                            <a href=\"\/#services\" target=\"\" class=\"btn btn-secondary-alt outline-color1 text-center overflow-hidden relative z-10\">\n                Explore our services            <\/a>\n                                            <\/div>\n                            <\/div>\n\n                            <div class=\"b1024:pl-[61px] mb-10 b1024:mb-0\">\n                                <blockquote data-start=\"2506\" data-end=\"3140\">\n<p class=\"PDq2pG_selectionAnchorContainer\" data-start=\"2508\" data-end=\"2839\">We engineer computer vision systems for Perth businesses that use cameras and visual data to understand what is happening in real-world environments. Our solutions help mining and manufacturing organisations turn images and video into actionable insight, enabling them to detect, interpret, and respond to events automatically.<\/p>\n<p data-start=\"2844\" data-end=\"3140\">Our computer vision solutions support object detection and classification, visual inspection, defect detection, production-line monitoring, and image-based data capture. They are designed to integrate with existing infrastructure and operate securely across on-premises or cloud environments.<\/p>\n<p data-start=\"2844\" data-end=\"3140\">For a real-world example, see our <a href=\"https:\/\/aiadvancements.com.au\/case-studies\/\">Makoto production line monitoring case study<\/a>, which shows how computer vision can be used to monitor production and identify issues in real time.<\/p>\n<\/blockquote>\n<p data-start=\"3142\" data-end=\"3217\">\n                                <div class=\"button-wrap inline-flex b1024:hidden flex-col b767:flex-row gap-3 mt-[30px]\">\n                                                <a href=\"https:\/\/aiadvancements.com.au\/contact\/\" target=\"\" class=\"btn btn-solidcolor1 speak-btn flex items-center gap-3 overflow-hidden\">\n                <span class=\"block circle relative\"><\/span>\n                <span class=\"button-text z-10\">Speak to a human<\/span>\n            <\/a>\n                                                            <a href=\"\/#services\" target=\"\" class=\"btn btn-secondary-alt outline-color1 text-center overflow-hidden relative z-10\">\n                Explore our services            <\/a>\n                                            <\/div>\n                            <\/div>\n                        <\/div>\n\n                                    <\/div>\n            <\/div>\n            \n                        <div class=\"internal-hero-video video-expand-wrapper\">\n\n                <div class=\"hero-video-wrapper relative\">\n\n                    <!-- ===================== -->\n                    <!-- MEDIA -->\n                    <!-- ===================== -->\n                    <div class=\"desktop-media\">\n\n                        \n                        \n                            <!-- DESKTOP VIDEO -->\n                                                        <div class=\"hero-oembed desktop-only w-full h-full\">\n                                <iframe \n                                    src=\"https:\/\/player.vimeo.com\/video\/1192507327?autoplay=0&#038;muted=0&#038;background=0&#038;controls=1&#038;title=0&#038;byline=0&#038;portrait=0&#038;dnt=1&#038;sidedock=0\" \n                                    frameborder=\"0\" \n                                    allow=\"autoplay; fullscreen\" \n                                    allowfullscreen>\n                                <\/iframe>\n                            <\/div>\n\n                            <!-- MOBILE VIDEO -->\n                                                        <div class=\"hero-oembed mobile-only w-full h-full\">\n                                <iframe \n                                    src=\"https:\/\/player.vimeo.com\/video\/1192506987?autoplay=0&#038;muted=0&#038;background=0&#038;controls=1&#038;title=0&#038;byline=0&#038;portrait=0&#038;dnt=1&#038;sidedock=0\" \n                                    frameborder=\"0\" \n                                    allow=\"autoplay; fullscreen\" \n                                    allowfullscreen>\n                                <\/iframe>\n                            <\/div>\n\n                        \n                    <\/div>\n\n                    <!-- ===================== -->\n                    <!-- THUMBNAIL -->\n                    <!-- ===================== -->\n                                            <div class=\"video-thumbnail absolute inset-0 z-20\">\n                            <picture class=\"w-full h-full\"><source media=\"(min-width: 481px)\" srcset=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/05\/image-7.jpg\"><img decoding=\"async\" class=\"w-full h-full\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/05\/image-7.jpg\" alt=\"AI Advancements consultant discussing how to build a computer vision system for your business\" style=\"object-fit:cover;object-position:center;\" loading=\"lazy\" width=\"1638\" height=\"909\" \/><\/picture>                        <\/div>\n                    \n                    <!-- ===================== -->\n                    <!-- PLAY BUTTON -->\n                    <!-- ===================== -->\n                                            <button class=\"video-toggle absolute inset-0 flex items-center justify-center z-30\">\n                            <span class=\"play-btn flex items-center justify-center\">\n                                <svg width=\"98\" height=\"98\" viewBox=\"0 0 98 98\" fill=\"none\">\n                                    <circle cx=\"49\" cy=\"49\" r=\"49\" fill=\"#FCFF6A\"\/>\n                                    <path d=\"M68 49L39.5 65.4545L39.5 32.5455L68 49Z\" fill=\"#131924\"\/>\n                                <\/svg>\n                            <\/span>\n                        <\/button>\n                    \n                <\/div>\n\n            <\/div>\n                    <\/div>\n    <\/section>\n    <!-- BLOCK CODING STARTS HERE -->\n\n    \n\n  <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n \r\n  <!-- BLOCK CODING STARTS HERE -->\r\n<section\r\n      id=\"\"\r\n      data-name=\"acf_approach-tab\"\r\n      data-lazyload=\"1\"\r\n      class=\"relative \"\r\n      style=\"z-index: 0;\">\r\n    <div class=\"b1024:py-[124px] py-[80px] bg-color3 list-bg\" style=\"background-color: #ffffff\">\r\n        <div class=\"container\">\r\n            <div class=\"max-w-[1130px] mx-auto\">\r\n                <div class=\"approach-title max-w-[664px] mx-auto b767:mb-[74px] mb-12 text-center two-column-content\">\r\n                                            <div class=\"heading-wrap flex-1\">\r\n                                    <h2 class=\"h2 animate-watch standard__headline block mb-10\">Computer vision built <br>for real-world environments<\/h2>\n                            <\/div>\r\n                                        <div class=\"summary-wrap ml-auto\">\r\n                                                    <div class=\"approach-text\">\r\n                                <p>Our computer vision solutions are designed to operate in live environments, integrating with your existing infrastructure or running independently where required.<\/p>\n<p>Here\u2019s how we design and deploy AI object detection systems that deliver reliable results without disrupting operations:<\/p>\n                            <\/div>\r\n                                                \r\n                                            <\/div>\r\n                <\/div>\r\n            <\/div>\r\n        <\/div>\r\n        <div class=\"approach-content\">\r\n\r\n            <!-- TAB BUTTONS -->\r\n            <div class=\"tab-button-group flex justify-center gap-6 mb-11\">\r\n                                                                                                <button class=\"tab-button\" data-tab=\"0\">\r\n                                                    <\/button>\r\n                                                <\/div>\r\n\r\n            <!-- TAB CONTENT -->\r\n            <div class=\"tab-contents\">\r\n\r\n                                                        \r\n                    <div class=\"tab-content-list transition-opacity duration-300\">\r\n\r\n                                                                            <div class=\"tab-content-row\">\r\n                                <div class=\"tab-content-inner gap-5 b767:gap-0 flex-col b767:flex-row\">\r\n                                    <div class=\"number-and-image w-full flex gap-4 justify-start b767:justify-between b767:w-2\/5\">\r\n                                        <div class=\"row-number text-[40px] b767:text-[80px] b991:text-[100px] leading-[1] text-[#131924]\">\r\n                                            01                                        <\/div>\r\n\r\n                                                                                                                            <div class=\"tab-content-image hidden b767:block\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/Understand-your-reporting-process-and-bottlenecks-1.jpg\" alt=\"AI Advancements consultant presenting and smiling in front of branded backdrop, illustrating the step to understand your reporting process and bottlenecks\">\r\n                                            <\/div>\r\n                                        \r\n                                                                                    <div class=\"title-wraper b767:hidden\">\r\n                                                                                                    <div class=\"super-title b767:hidden mb-2 b767:text-xl text-base\">\r\n                                                        Assessment                                                    <\/div>\r\n                                                \r\n                                                                                                    <div class=\"h3 b767:hidden\">\r\n                                                        Understand the visual environment and objectives                                                    <\/div>\r\n                                                                                            <\/div>\r\n                                                                            <\/div>\r\n\r\n                                    <div class=\"tab-content-title w-full b767:w-1\/2 b767:pt-10 flex gap-3 items-center b767:block\">\r\n                                                                                    <div class=\"super-title hidden b767:block mb-7 b767:text-xl text-base\">\r\n                                                Assessment                                            <\/div>\r\n                                        \r\n                                                                                    <h3 class=\"hidden b767:block pb-[28px]\">\r\n                                                Understand the visual environment and objectives                                            <\/h3>\r\n                                        \r\n                                                                                                                            <div class=\"tab-content-image hidden b767:hidden\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/Understand-your-reporting-process-and-bottlenecks-1.jpg\" alt=\"AI Advancements consultant presenting and smiling in front of branded backdrop, illustrating the step to understand your reporting process and bottlenecks\">\r\n                                            <\/div>\r\n                                        \r\n                                                                                    <div class=\"tab-content-description w-full b767:w-full\">\r\n                                                <p>We start by assessing your physical environment, camera placement, lighting conditions, and what needs to be detected or analysed. This ensures AI object detection and defect detection are designed around real operational conditions, not idealised scenarios.<\/p>\n                                            <\/div>\r\n                                                                            <\/div>\r\n                                <\/div>\r\n                            <\/div>\r\n\r\n                                                                            <div class=\"tab-content-row\">\r\n                                <div class=\"tab-content-inner gap-5 b767:gap-0 flex-col b767:flex-row\">\r\n                                    <div class=\"number-and-image w-full flex gap-4 justify-start b767:justify-between b767:w-2\/5\">\r\n                                        <div class=\"row-number text-[40px] b767:text-[80px] b991:text-[100px] leading-[1] text-[#131924]\">\r\n                                            02                                        <\/div>\r\n\r\n                                                                                                                            <div class=\"tab-content-image hidden b767:block\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/Design-the-AI-reporting-agent-1.jpg\" alt=\"Close-up of hands typing on a keyboard representing the process to design the AI reporting agent\">\r\n                                            <\/div>\r\n                                        \r\n                                                                                    <div class=\"title-wraper b767:hidden\">\r\n                                                                                                    <div class=\"super-title b767:hidden mb-2 b767:text-xl text-base\">\r\n                                                        Modelling                                                    <\/div>\r\n                                                \r\n                                                                                                    <div class=\"h3 b767:hidden\">\r\n                                                        Design the computer vision model                                                    <\/div>\r\n                                                                                            <\/div>\r\n                                                                            <\/div>\r\n\r\n                                    <div class=\"tab-content-title w-full b767:w-1\/2 b767:pt-10 flex gap-3 items-center b767:block\">\r\n                                                                                    <div class=\"super-title hidden b767:block mb-7 b767:text-xl text-base\">\r\n                                                Modelling                                            <\/div>\r\n                                        \r\n                                                                                    <h3 class=\"hidden b767:block pb-[28px]\">\r\n                                                Design the computer vision model                                            <\/h3>\r\n                                        \r\n                                                                                                                            <div class=\"tab-content-image hidden b767:hidden\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/Design-the-AI-reporting-agent-1.jpg\" alt=\"Close-up of hands typing on a keyboard representing the process to design the AI reporting agent\">\r\n                                            <\/div>\r\n                                        \r\n                                                                                    <div class=\"tab-content-description w-full b767:w-full\">\r\n                                                <p>We design and train computer vision models for tasks such as object detection, object classification, defect detection, or OCR. Accuracy, performance, and edge cases are considered from the outset to ensure dependable results in production.<\/p>\n                                            <\/div>\r\n                                                                            <\/div>\r\n                                <\/div>\r\n                            <\/div>\r\n\r\n                                                                            <div class=\"tab-content-row\">\r\n                                <div class=\"tab-content-inner gap-5 b767:gap-0 flex-col b767:flex-row\">\r\n                                    <div class=\"number-and-image w-full flex gap-4 justify-start b767:justify-between b767:w-2\/5\">\r\n                                        <div class=\"row-number text-[40px] b767:text-[80px] b991:text-[100px] leading-[1] text-[#131924]\">\r\n                                            03                                        <\/div>\r\n\r\n                                                                                                                            <div class=\"tab-content-image hidden b767:block\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/Automate-report-creation-and-insights-1.jpg\" alt=\"Two professionals in dark shirts working together at a computer desk in an office, representing AI-powered automated report creation and insights\">\r\n                                            <\/div>\r\n                                        \r\n                                                                                    <div class=\"title-wraper b767:hidden\">\r\n                                                                                                    <div class=\"super-title b767:hidden mb-2 b767:text-xl text-base\">\r\n                                                        Deployment                                                    <\/div>\r\n                                                \r\n                                                                                                    <div class=\"h3 b767:hidden\">\r\n                                                        Deploy cameras and processing systems                                                    <\/div>\r\n                                                                                            <\/div>\r\n                                                                            <\/div>\r\n\r\n                                    <div class=\"tab-content-title w-full b767:w-1\/2 b767:pt-10 flex gap-3 items-center b767:block\">\r\n                                                                                    <div class=\"super-title hidden b767:block mb-7 b767:text-xl text-base\">\r\n                                                Deployment                                            <\/div>\r\n                                        \r\n                                                                                    <h3 class=\"hidden b767:block pb-[28px]\">\r\n                                                Deploy cameras and processing systems                                            <\/h3>\r\n                                        \r\n                                                                                                                            <div class=\"tab-content-image hidden b767:hidden\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/Automate-report-creation-and-insights-1.jpg\" alt=\"Two professionals in dark shirts working together at a computer desk in an office, representing AI-powered automated report creation and insights\">\r\n                                            <\/div>\r\n                                        \r\n                                                                                    <div class=\"tab-content-description w-full b767:w-full\">\r\n                                                <p>We deploy camera systems and processing infrastructure tailored to your security and performance requirements. Solutions can run fully on-premises to keep visual data local, or in the cloud where scalability and centralised processing are needed.<\/p>\n                                            <\/div>\r\n                                                                            <\/div>\r\n                                <\/div>\r\n                            <\/div>\r\n\r\n                                                                            <div class=\"tab-content-row\">\r\n                                <div class=\"tab-content-inner gap-5 b767:gap-0 flex-col b767:flex-row\">\r\n                                    <div class=\"number-and-image w-full flex gap-4 justify-start b767:justify-between b767:w-2\/5\">\r\n                                        <div class=\"row-number text-[40px] b767:text-[80px] b991:text-[100px] leading-[1] text-[#131924]\">\r\n                                            04                                        <\/div>\r\n\r\n                                                                                                                            <div class=\"tab-content-image hidden b767:block\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/Integrate-with-your-data-sources-1.jpg\" alt=\"Professional in dark shirt working at a laptop, representing the AI implementation step to integrate with your data sources\">\r\n                                            <\/div>\r\n                                        \r\n                                                                                    <div class=\"title-wraper b767:hidden\">\r\n                                                                                                    <div class=\"super-title b767:hidden mb-2 b767:text-xl text-base\">\r\n                                                        Enablement                                                    <\/div>\r\n                                                \r\n                                                                                                    <div class=\"h3 b767:hidden\">\r\n                                                        Integrate with operational workflows                                                    <\/div>\r\n                                                                                            <\/div>\r\n                                                                            <\/div>\r\n\r\n                                    <div class=\"tab-content-title w-full b767:w-1\/2 b767:pt-10 flex gap-3 items-center b767:block\">\r\n                                                                                    <div class=\"super-title hidden b767:block mb-7 b767:text-xl text-base\">\r\n                                                Enablement                                            <\/div>\r\n                                        \r\n                                                                                    <h3 class=\"hidden b767:block pb-[28px]\">\r\n                                                Integrate with operational workflows                                            <\/h3>\r\n                                        \r\n                                                                                                                            <div class=\"tab-content-image hidden b767:hidden\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/Integrate-with-your-data-sources-1.jpg\" alt=\"Professional in dark shirt working at a laptop, representing the AI implementation step to integrate with your data sources\">\r\n                                            <\/div>\r\n                                        \r\n                                                                                    <div class=\"tab-content-description w-full b767:w-full\">\r\n                                                <p>Computer vision outputs, such as detected objects and information extracted from images and scanned documents, are integrated directly into your existing systems, dashboards, or alerts, enabling teams to respond to visual events in real time. This turns visual data into actionable signals rather than isolated outputs.<\/p>\n                                            <\/div>\r\n                                                                            <\/div>\r\n                                <\/div>\r\n                            <\/div>\r\n\r\n                                                                            <div class=\"tab-content-row\">\r\n                                <div class=\"tab-content-inner gap-5 b767:gap-0 flex-col b767:flex-row\">\r\n                                    <div class=\"number-and-image w-full flex gap-4 justify-start b767:justify-between b767:w-2\/5\">\r\n                                        <div class=\"row-number text-[40px] b767:text-[80px] b991:text-[100px] leading-[1] text-[#131924]\">\r\n                                            05                                        <\/div>\r\n\r\n                                                                                                                            <div class=\"tab-content-image hidden b767:block\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/Refine-standardise-and-scale-1.jpg\" alt=\"Developer working at a large monitor displaying code, representing the process to refine, standardise, and scale AI solutions\">\r\n                                            <\/div>\r\n                                        \r\n                                                                                    <div class=\"title-wraper b767:hidden\">\r\n                                                                                                    <div class=\"super-title b767:hidden mb-2 b767:text-xl text-base\">\r\n                                                        Scaling                                                     <\/div>\r\n                                                \r\n                                                                                                    <div class=\"h3 b767:hidden\">\r\n                                                        Monitor, refine, and scale                                                    <\/div>\r\n                                                                                            <\/div>\r\n                                                                            <\/div>\r\n\r\n                                    <div class=\"tab-content-title w-full b767:w-1\/2 b767:pt-10 flex gap-3 items-center b767:block\">\r\n                                                                                    <div class=\"super-title hidden b767:block mb-7 b767:text-xl text-base\">\r\n                                                Scaling                                             <\/div>\r\n                                        \r\n                                                                                    <h3 class=\"hidden b767:block pb-[28px]\">\r\n                                                Monitor, refine, and scale                                            <\/h3>\r\n                                        \r\n                                                                                                                            <div class=\"tab-content-image hidden b767:hidden\">\r\n                                                <img decoding=\"async\" src=\"https:\/\/aiadvancements.com.au\/wp-content\/uploads\/2026\/04\/Refine-standardise-and-scale-1.jpg\" alt=\"Developer working at a large monitor displaying code, representing the process to refine, standardise, and scale AI solutions\">\r\n                                            <\/div>\r\n                                        \r\n                                                                                    <div class=\"tab-content-description w-full b767:w-full\">\r\n                                                <p>We continuously monitor detection accuracy and system performance, refining models as conditions change. As requirements grow, computer vision systems can scale across additional cameras, locations, or use cases.<\/p>\n                                            <\/div>\r\n                                                                            <\/div>\r\n                                <\/div>\r\n                            <\/div>\r\n\r\n                                                \r\n                    <\/div>\r\n\r\n                                    \r\n            <\/div>\r\n\r\n            <!-- TAB BUTTONS -->\r\n            <div class=\"tab-button-group flex justify-center gap-6 mt-11\">\r\n                                                                                                <button class=\"tab-button\" data-tab=\"0\">\r\n                                                    <\/button>\r\n                                                <\/div>\r\n\r\n        <\/div>\r\n    <\/div>\r\n<\/section>\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n \r\n  \n\n\n\n  <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n  <section \r\n      id=\"\" \r\n      data-name=\"acf_about-our-service\"\r\n      data-lazyload=\"1\" \r\n      class=\"relative \" \r\n      style=\"z-index: 0;\">\r\n      <div class=\"our-values-area py-80 b767:py-100 bg-color1\">\r\n            <div class=\"container\">\r\n                                <div class=\"grid grid-cols-1 b767:grid-cols-2 b1024:grid-cols-3 b1200:grid-cols-4 gap-y-10 gap-x-6\">\r\n                                            <div class=\"border-b border-color4 pb-40 text-color4\">\r\n                            <div class=\"h-[59px] w-[59px] rounded-full bg-color2 flex items-center justify-center\">\r\n                                <svg width=\"33\" height=\"14\" viewBox=\"0 0 30 13\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M10.1112 0C10.1112 5.75168 5.57492 10.4294 0 10.4294V12.6557C5.60316 12.6557 10.3408 8.76349 11.8042 3.46214V12.6329H13.9649V0H10.11H10.1112Z\" fill=\"#131924\"\/><path d=\"M19.8559 0H16.001V12.6342H18.1617V3.46214C19.6251 8.76223 24.364 12.6557 29.9659 12.6557V10.4294C24.391 10.4294 19.8547 5.75041 19.8547 0H19.8559Z\" fill=\"#131924\"\/><\/svg>\r\n                            <\/div>\r\n                                                            <h3 class=\"my-5\">\r\n                                    Faster, more consistent visual checks                                <\/h3>\r\n                                                                                        <div class=\"\">\r\n                                    <p>AI object detection automates visual inspections in real time, reducing reliance on manual checks and improving consistency across sites, shifts, and environments.<\/p>\n                                <\/div>\r\n                                                    <\/div>\r\n                                            <div class=\"border-b border-color4 pb-40 text-color4\">\r\n                            <div class=\"h-[59px] w-[59px] rounded-full bg-color2 flex items-center justify-center\">\r\n                                <svg width=\"33\" height=\"14\" viewBox=\"0 0 30 13\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M10.1112 0C10.1112 5.75168 5.57492 10.4294 0 10.4294V12.6557C5.60316 12.6557 10.3408 8.76349 11.8042 3.46214V12.6329H13.9649V0H10.11H10.1112Z\" fill=\"#131924\"\/><path d=\"M19.8559 0H16.001V12.6342H18.1617V3.46214C19.6251 8.76223 24.364 12.6557 29.9659 12.6557V10.4294C24.391 10.4294 19.8547 5.75041 19.8547 0H19.8559Z\" fill=\"#131924\"\/><\/svg>\r\n                            <\/div>\r\n                                                            <h3 class=\"my-5\">\r\n                                    Reduced errors and rework                                <\/h3>\r\n                                                                                        <div class=\"\">\r\n                                    <p>AI defect detection identifies issues early and accurately, helping teams minimise human error, reduce rework, and maintain higher quality standards.<\/p>\n                                <\/div>\r\n                                                    <\/div>\r\n                                            <div class=\"border-b border-color4 pb-40 text-color4\">\r\n                            <div class=\"h-[59px] w-[59px] rounded-full bg-color2 flex items-center justify-center\">\r\n                                <svg width=\"33\" height=\"14\" viewBox=\"0 0 30 13\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M10.1112 0C10.1112 5.75168 5.57492 10.4294 0 10.4294V12.6557C5.60316 12.6557 10.3408 8.76349 11.8042 3.46214V12.6329H13.9649V0H10.11H10.1112Z\" fill=\"#131924\"\/><path d=\"M19.8559 0H16.001V12.6342H18.1617V3.46214C19.6251 8.76223 24.364 12.6557 29.9659 12.6557V10.4294C24.391 10.4294 19.8547 5.75041 19.8547 0H19.8559Z\" fill=\"#131924\"\/><\/svg>\r\n                            <\/div>\r\n                                                            <h3 class=\"my-5\">\r\n                                    Real-time operational visibility                                <\/h3>\r\n                                                                                        <div class=\"\">\r\n                                    <p>Computer vision systems turn live camera feeds into actionable signals, enabling teams to monitor conditions, detect events, and respond faster as situations change.<\/p>\n                                <\/div>\r\n                                                    <\/div>\r\n                                            <div class=\"border-b border-color4 pb-40 text-color4\">\r\n                            <div class=\"h-[59px] w-[59px] rounded-full bg-color2 flex items-center justify-center\">\r\n                                <svg width=\"33\" height=\"14\" viewBox=\"0 0 30 13\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\"><path d=\"M10.1112 0C10.1112 5.75168 5.57492 10.4294 0 10.4294V12.6557C5.60316 12.6557 10.3408 8.76349 11.8042 3.46214V12.6329H13.9649V0H10.11H10.1112Z\" fill=\"#131924\"\/><path d=\"M19.8559 0H16.001V12.6342H18.1617V3.46214C19.6251 8.76223 24.364 12.6557 29.9659 12.6557V10.4294C24.391 10.4294 19.8547 5.75041 19.8547 0H19.8559Z\" fill=\"#131924\"\/><\/svg>\r\n                            <\/div>\r\n                                                            <h3 class=\"my-5\">\r\n                                    Secure and scalable deployment                                <\/h3>\r\n                                                                                        <div class=\"\">\r\n                                    <p>Solutions can be deployed on-premises to keep visual data local or in the cloud to support scale, giving organisations control over security, performance, and growth.<\/p>\n                                <\/div>\r\n                                                    <\/div>\r\n                                    <\/div>\r\n                            <\/div>\r\n        <\/div>\r\n  <\/section>\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n\r\n  \n\n  <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n    <!-- GUTENBERG EDITOR BLOCK PREVIEW - DO NOT REMOVE  -->\r\n\r\n  <!-- BLOCK CODING STARTS HERE -->\r\n  <section \r\n      id=\"\" \r\n      data-name=\"acf_logo-slider\"\r\n      data-lazyload=\"1\" \r\n      class=\"relative \" \r\n      style=\"z-index: 0;\">\r\n        <div class=\"logo-slider-area pt-[145px]\">\r\n            <div class=\"container\">\r\n