{
  "framework": null,
  "buildCommand": "npm run vercel-build",
  "installCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/wp-content/uploads/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "functions": {
    "api/contact.js": {
      "memory": 128,
      "maxDuration": 10
    }
  }
}
